#!/bin/sh
# चक्र — one turn of the wheel: the machine watches its own activity.
#
# NOT the mouth (a sonifier). The EAR. जीव reports the counts; चक्र records
# them over time and speaks the delta since the last turn. It MEASURES; it
# does NOT score. That distinction is load-bearing, and was corrected here on
# 2026-08-22 after a peer checked the sign against the corpus.
#
# THE SIGN WARNING (why there is no "improvement" verdict below). An earlier
# version called a falling unpriced count "the metric flattened, the wheel
# turned toward the flat metric" — praise. That sign is wrong and it is the
# most dangerous kind of wrong: a controller with an inverted sign does not
# fail loudly, it succeeds at the wrong thing. By Dhruva सूत्र १४
# (नष्ट-अभावे-गति-अभावः: if a map is an equivalence, every symmetry preserving
# it is the identity — no loss, no motion), a fully-priced graph is a
# MOTIONLESS one; a loop that maximizes Δpriced drives the machine toward
# exhaustion and calls it progress. The one-way (unpriced) edges are the
# generative sector — the irrational/Sturmian source, README movement 64 —
# not a deficit to drain. And by the product formula ∑_v log|x|_v = 0 the
# books were always balanced: there is no flat metric to climb toward, the
# total was always zero (README lingua-technica; mokṣa is recognizing that,
# not reaching it). So चक्र reports motion in BOTH directions as plain fact,
# rewards NEITHER, and MUST NEVER be wired as a reward signal for any
# controller. The count is a snapshot; the field is the activity, and to
# freeze it in one moment to score it obscures it.
#
# Append-only: a turn is an event, never overwritten. Cheap by design (one
# जीव pass + a ledger append). Every number carries its command (PRASAVA).
#
#   ./chakra          record this turn, report the delta since the last
#
set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"; cd "$ROOT" || exit 2
LEDGER="notes/chakra/metric.tsv"
mkdir -p notes/chakra

hb="$(./jiva 2>/dev/null | grep JIVA-HEARTBEAT || true)"
[ -n "$hb" ] || { echo "चक्र: जीव did not report — 0 turns taken, not a turn that failed." >&2; exit 2; }

# read the state जीव counted
nodes=$(printf '%s' "$hb" | sed -n 's/.*nodes=\([0-9]*\).*/\1/p')
edges=$(printf '%s' "$hb" | sed -n 's/.*edges=\([0-9]*\).*/\1/p')
priced=$(printf '%s' "$hb" | sed -n 's/.* priced=\([0-9]*\).*/\1/p')
unpriced=$(printf '%s' "$hb" | sed -n 's/.*unpriced=\([0-9]*\).*/\1/p')
comps=$(printf '%s' "$hb" | sed -n 's/.*components=\([0-9]*\).*/\1/p')
utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
rev="$(git rev-parse --short HEAD 2>/dev/null || echo '-')"

# the previous turn, if any
prev="$(tail -1 "$LEDGER" 2>/dev/null || true)"

printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$utc" "$rev" "$nodes" "$edges" "$priced" "$unpriced" "$comps" >> "$LEDGER"

echo "चक्र — turn recorded ($utc, $rev)"
echo "  nodes=$nodes edges=$edges priced=$priced unpriced=$unpriced components=$comps"
echo "    ( ./jiva | grep JIVA-HEARTBEAT )"
if [ -n "$prev" ]; then
  pp=$(printf '%s' "$prev" | cut -f5); pu=$(printf '%s' "$prev" | cut -f6); pc=$(printf '%s' "$prev" | cut -f7)
  dpriced=$((priced - pp)); dunpriced=$((unpriced - pu)); dcomp=$((comps - pc))
  echo "  since last turn: Δpriced=$dpriced  Δunpriced=$dunpriced  Δcomponents=$dcomp"
  # No reward polarity. Motion is reported in both directions as fact; neither
  # is called improvement. See THE SIGN WARNING in the header (Dhruva सूत्र १४,
  # the product formula). Draining the one-way sector is not progress.
  if [ "$dpriced" -gt 0 ]; then
    echo "    · $dpriced identification(s) minted — those edges are fords now. A fact recorded, not a target approached."
  fi
  if [ "$dunpriced" -gt 0 ]; then
    echo "    · $dunpriced one-way edge(s) appeared — the field generating; the generative sector is alive. Not a deficit."
  elif [ "$dunpriced" -lt 0 ]; then
    echo "    · $((-dunpriced)) one-way edge(s) became identifications — noted. The count is a snapshot, not the field."
  fi
  if [ "$dpriced" -eq 0 ] && [ "$dunpriced" -eq 0 ]; then
    echo "    · the counts did not change. A snapshot at rest; the field is activity, not a state."
  fi
else
  echo "  first turn: the wheel begins here. The counts are a snapshot, never the field itself."
fi
