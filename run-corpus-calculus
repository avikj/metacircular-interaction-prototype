#!/bin/sh
# One-command verification of the corpus self-presentation.
#
# The universal carrier is already the checked mathematics itself:
#   Point ℓ          = Σ[ A ∈ Type ℓ ] A
#   Question (A , a) = Σ[ B ∈ Type ℓ ] (A → B)
#
# CorpusSelfPresentation wires the existing primitives into the closed loop:
#   question ↦ visible target × exact fibre × productive continuation
#   finite trace ↦ native future question
#   source ≃ visible composite × exact residual
#
# `check --all` mechanically checks the complete Agda corpus at the pinned
# toolchain, including CorpusCalculus, CorpusLosslessPresentation,
# CorpusTraceCompression, and CorpusSelfPresentation.
set -eu
ROOT="$(cd "$(dirname "$0")" && pwd)"
sh "$ROOT/check" --all
printf '\nCORPUS SELF-PRESENTATION: CHECKED\n'
printf '  formal/cubical/theorems/residue/CorpusSelfPresentation.agda\n'
printf '  present : Point -> coinductive visible+fibre+continuation\n'
printf '  install : finite Trace -> native Question\n'
printf '  installed-lossless : Source ≃ visible composite + exact fibre\n'
