#!/bin/sh
set -eu
ROOT="$(cd "$(dirname "$0")" && pwd)"
python3 "$ROOT/scripts/run-corpus-calculus.py" "$@"
PREFIX="${MATH_PREFIX:-$HOME}"
AGDA="$PREFIX/.local/bin/agda"
[ -x "$AGDA" ] || AGDA="$(command -v agda)"
LIBFILE="$PREFIX/.agda-pin/libraries"
"$AGDA" \
  "--library-file=$LIBFILE" \
  -l fibre -l natural-machine -l rescued-lanes \
  -i "$ROOT/generated" \
  "$ROOT/formal/cubical/theorems/residue/CorpusFinalPresentation.agda"
printf '%s\n' 'FINAL CORPUS PRESENTATION GREEN'
printf '%s\n' '  behavioralPresentation = full-future quotient meanings + exact realization fibres'
printf '%s\n' '  relationalLoci         = checked generators factored once + exact realization families'
printf '%s\n' '  interactivePresentation= infinite guarded continuation of the factored loci'
