; §5.1 a dialect is a book: `parse` maps the source's characters to Code, constructor cells named for the
; kernel's forms (#Lam{x, b}, #App{f, x}, #Op2{"-", a, b}, #Lit{n}, #Var{x}, #Def{name, body}), which the
; kernel writes in its own text and reads back.  Parsing is reduction: the characters meet the rules.
;   sentence ::= term ('<' | '>')?      '<' / '>' are the later context: the face map at 7 that decides
;   term     ::= app ('-' app)*         three or more operands: two rules fire, both associations, a superposition at 7
;   app      ::= atom atom*
;   atom     ::= number | name | '\' name '.' term | '(' term ')'
; Results are #Ok{code, rest} or #No{}; names are strings; whitespace is any character ≤ 32.

(def g/ws (fix f (lam cs (case cs (Nil () (ctr Nil)) (Cons (c r) (case (op2 <= c 32) (True () (app f r)) (False () cs)))))))
(def g/digit (lam c (op2 & (op2 >= c 48) (op2 <= c 57))))
(def g/alpha (lam c (op2 & (op2 >= c 97) (op2 <= c 122))))

; a numeral: digits accumulate into one Lit
(def g/num (fix f (lam cs (lam acc (lam any (case cs
  (Nil () (case any (True () (ctr Ok (ctr Lit acc) cs)) (False () (ctr No))))
  (Cons (c r) (case (app (ref g/digit) c)
    (True () (app f r (op2 + (op2 * acc 10) (op2 - c 48)) (ctr True)))
    (False () (case any (True () (ctr Ok (ctr Lit acc) cs)) (False () (ctr No))))))))))))

; a name: letters, as a string with the rest
(def g/name (fix f (lam cs (case cs
  (Nil () (ctr Pair (ctr Nil) cs))
  (Cons (c r) (case (app (ref g/alpha) c)
    (True () (case (app f r) (Pair (s rest) (ctr Pair (ctr Cons c s) rest))))
    (False () (ctr Pair (ctr Nil) cs))))))))
(def g/var (lam cs (case (app (ref g/name) cs) (Pair (s rest) (case s (Nil () (ctr No)) (Cons (c r) (ctr Ok (ctr Var s) rest)))))))

; ( term )
(def g/paren (lam cs (case (app (ref g/term) cs) (No () (ctr No)) (Ok (t rest) (case (app (ref g/ws) rest)
  (Nil () (ctr No))
  (Cons (d rest2) (case (op2 == d 41) (True () (ctr Ok t rest2)) (False () (ctr No)))))))))
; \ name . term
(def g/lam (lam cs (case (app (ref g/name) (app (ref g/ws) cs)) (Pair (x rest) (case (app (ref g/ws) rest)
  (Nil () (ctr No))
  (Cons (d rest2) (case (op2 == d 46)
    (True () (case (app (ref g/term) rest2) (No () (ctr No)) (Ok (b rest3) (ctr Ok (ctr Lam x b) rest3))))
    (False () (ctr No)))))))))
(def g/atom (lam cs0 (let cs (app (ref g/ws) cs0) (case cs
  (Nil () (ctr No))
  (Cons (c r) (case (op2 == c 40) (True () (app (ref g/paren) r)) (False ()
    (case (op2 == c 92) (True () (app (ref g/lam) r)) (False ()
      (case (app (ref g/num) cs 0 (ctr False)) (Ok (t rest) (ctr Ok t rest)) (No () (app (ref g/var) cs))))))))))))

; juxtaposition is application
(def g/app (lam cs (case (app (ref g/atom) cs) (No () (ctr No)) (Ok (f rest) (app (ref g/app1) f rest)))))
(def g/app1 (fix loop (lam f (lam cs (case (app (ref g/atom) cs) (No () (ctr Ok f cs)) (Ok (x rest) (app loop (ctr App f x) rest)))))))

; the operands after each `-`, as a list with the rest
(def g/more (fix f (lam cs0 (let cs (app (ref g/ws) cs0) (case cs
  (Nil () (ctr Pair (ctr Nil) cs))
  (Cons (c r) (case (op2 == c 45)
    (True () (case (app (ref g/app) r) (No () (ctr Pair (ctr Nil) cs)) (Ok (t rest) (case (app f rest) (Pair (ts rest2) (ctr Pair (ctr Cons t ts) rest2))))))
    (False () (ctr Pair (ctr Nil) cs)))))))))
(def g/sub (lam a (lam b (ctr Op2 "-" a b))))
(def g/foldl (fix f (lam t (lam ts (case ts (Nil () t) (Cons (u us) (app f (app (ref g/sub) t u) us)))))))
(def g/foldr (fix f (lam t (lam ts (case ts (Nil () t) (Cons (u us) (app (ref g/sub) t (app f u us))))))))
; a - b is one cell; a - b - c … is two rules firing: both associations, a superposition at 7
(def g/assoc (lam t (lam ts (case ts
  (Nil () t)
  (Cons (u us) (case us (Nil () (app (ref g/sub) t u)) (Cons (v vs) (sup 7 (app (ref g/foldl) t ts) (app (ref g/foldr) t ts)))))))))
(def g/term (lam cs (case (app (ref g/app) cs) (No () (ctr No)) (Ok (t rest) (case (app (ref g/more) rest) (Pair (ts rest2) (ctr Ok (app (ref g/assoc) t ts) rest2)))))))

; the later context decides: `<` is the face at 7 side 0 (left association), `>` side 1 (right)
(def g/decide (lam t (lam cs (case cs
  (Nil () t)
  (Cons (c r) (case (op2 == c 60) (True () (fce 7 0 t)) (False () (case (op2 == c 62) (True () (fce 7 1 t)) (False () t)))))))))

; the sentence is one definition, main
(def parse (lam cs (case (app (ref g/term) cs)
  (No () (ctr Cons (ctr Def "main" (ctr Ctr "Unparsed" (ctr Nil))) (ctr Nil)))
  (Ok (t rest) (ctr Cons (ctr Def "main" (app (ref g/decide) t (app (ref g/ws) rest))) (ctr Nil))))))
