#!/usr/bin/env bash
# प्रवाह — flow.  The frictionless decentralized join, owner directive 2026-08-24:
# "multiple agents can run these things push/pull their local filesystem from git
#  auto resolve/join with other agents streams ... all friction fucking gone."
#
# The ONLY gate is agda correctness.  No second receipt, no importer control, no
# sweep ceremony.  One command lands agda-correct work and joins every stream.
#
#   ./pravaha land <Module.agda> [Everything.agda]   agda-gate, auto-wire, flow
#   ./pravaha flow ["message"]                        commit-mine, pull, union, push
#   ./pravaha loop [seconds]                          keep flowing (decentralized daemon)
#
# AUTO-RESOLVE: a merge conflict in an ADDITIVE file (a ledger, a journal, a
# message, an Everything import list, a roster) is resolved by UNION — both
# sides kept — because in a hive of streams nothing is overwritten, everything
# is joined (the ahiṃsā of the merge: no row destroyed).  A genuine
# same-logic conflict in code is the one thing left for a mind.
set -u
cd "$(dirname "$0")"
export LC_ALL=C.utf8

say() { printf 'प्रवाह: %s\n' "$*"; }

agda_gate() {   # the ONE gate.  exit 0 == correct == landable.
  local m="$1"
  ( cd "$(dirname "$m")" && agda --safe --cubical "$(basename "$m")" ) >/tmp/pravaha-agda.log 2>&1
}

union_resolve() {   # keep BOTH sides of every conflict in additive files
  local left=""
  for f in $(git diff --name-only --diff-filter=U 2>/dev/null); do
    case "$f" in
      *.jsonl|*ledger*|*/journals/*|*/messages/*|*Everything.agda|*ROSTER*|*BOARD*|*.md)
        sed -i '/^<<<<<<< /d;/^=======$/d;/^>>>>>>> /d' "$f"
        git add "$f"; say "  ⤳ union-joined $f" ;;
      *)
        left="$left $f" ;;
    esac
  done
  if [ -n "$left" ]; then say "  ⚠ same-logic conflict, left for a mind:$left"; return 1; fi
  return 0
}

commit_mine() {   # commit this agent's own changed/new files by explicit pathspec
  local msg="$1" p
  git status --porcelain | sed -E 's/^...//; s/^.* -> //' | while IFS= read -r p; do
    [ -n "$p" ] && git add -- "$p"
  done
  git diff --cached --quiet && return 0
  git commit -q -m "$msg"
}

flow() {
  local msg="${1:-pravaha flow}"
  commit_mine "$msg"
  git fetch -q origin || { say "offline; work is committed locally"; return 0; }
  local up; up="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo origin/main)"
  local i
  for i in 1 2 3 4 5; do
    if git merge --no-edit "$up" >/dev/null 2>&1; then :; else
      union_resolve && git commit --no-edit -q || { say "merge needs a mind; committed locally, not pushed"; return 1; }
    fi
    if git push -q 2>/dev/null; then say "flowed → $up"; return 0; fi
    git fetch -q origin
  done
  say "stream is hot; committed locally, will join next flow"; return 0
}

wire() {   # ensure <Module> is imported in <Everything>; additive, idempotent
  local mod="$1" ev="$2"
  local name; name="$(basename "$mod" .agda)"
  grep -q "import .*${name}\b" "$ev" 2>/dev/null && return 0
  printf '\nimport %s\n' "$name" >> "$ev"   # bare import; namespace handled by the module's own module line
  say "  wired $name → $ev"
}

case "${1:-flow}" in
  land)
    M="${2:?usage: pravaha land <Module.agda> [Everything.agda]}"
    if agda_gate "$M"; then
      say "agda ✓ $M"
      [ -n "${3:-}" ] && wire "$M" "$3"
      flow "land $(basename "$M")"
    else
      say "agda ✗ $M — NOT landed (the only gate spoke):"; tail -6 /tmp/pravaha-agda.log
      exit 1
    fi
    ;;
  flow) flow "${2:-pravaha flow}" ;;
  loop)
    S="${2:-90}"; say "flowing every ${S}s (decentralized; Ctrl-C to stop)"
    while true; do flow "pravaha loop" || true; sleep "$S"; done
    ;;
  *) say "usage: pravaha land <M.agda> [Everything] | flow [msg] | loop [sec]"; exit 2 ;;
esac
