{"kriya":"sadhana.vislesana","angani":{"patra":["{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}","module Candidate where","open import Cubical.Foundations.Prelude","open import Cubical.Data.Bool using (Bool ; true ; false)","not : Bool → Bool","not false = true","not true = false","and : Bool → Bool → Bool","and false _ = false","and true b = b","or : Bool → Bool → Bool","or false b = b","or true _ = true","clause : Bool → Bool → Bool → Bool","clause a b c = or a (or b c)","violation : Bool → Bool → Bool → Bool","violation a b c = and (not a) (and (not b) (not c))","clause-from-violation : Bool → Bool → Bool → Bool","clause-from-violation a b c = not (violation a b c)"],"padani":["clause false false false","violation false false false","clause true false false","violation true false false"]}}
