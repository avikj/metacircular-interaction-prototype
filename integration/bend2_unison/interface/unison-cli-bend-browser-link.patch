+-- The local codebase server supplies the authentication token in its base
+-- URL. A stored Bend member has one stable URL across presentation renames.
+bendBrowserUrl :: S.Id -> Cli (Maybe Text)
+bendBrowserUrl (Ref.Id objectId memberIndex) = do
+  env <- ask
+  case env.serverBaseUrl of
+    Nothing -> pure Nothing
+    Just baseUrl -> do
+      digest <- liftIO $ Codebase.runTransaction env.codebase $
+        Hash.toByteString <$> Q.expectPrimaryHashByObjectId objectId
+      let base = Text.dropEnd 4 (Server.urlFor Server.Api baseUrl)
+          suffix = Text.pack (hexBytes digest ++ "/" ++ show memberIndex)
+      pure (Just (base <> "/ui/bend/component/" <> suffix))
+  where
+    hexBytes = concatMap byteHex . Bytes.unpack
+    byteHex byte = [alphabet !! fromIntegral (byte `div` 16),alphabet !! fromIntegral (byte `mod` 16)]
+    alphabet = "0123456789abcdef"
