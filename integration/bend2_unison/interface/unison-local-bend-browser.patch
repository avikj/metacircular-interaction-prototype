 serveUI :: FilePath -> Server WebUI
-serveUI path _ = serveIndex path
+serveUI path route = case route of
+  ["bend", "component", _, _] -> pure (RawHtml bendBrowserHtml)
+  _ -> serveIndex path
+
+-- This local inspector uses native Bend component addresses. It is served by
+-- UCM itself, so it also works when the separately distributed UI is absent.
+bendBrowserHtml :: Lazy.ByteString
+bendBrowserHtml = BLU.fromString $ unlines
+  [ "<!doctype html><html lang='en'><meta charset='utf-8'>"
+  , "<meta name='viewport' content='width=device-width, initial-scale=1'>"
+  , "<title>Bend component</title>"
+  , "<style>body{font:15px system-ui;margin:0;background:#10141c;color:#e4e9f2}header{padding:1rem 2rem;border-bottom:1px solid #344052}main{display:grid;grid-template-columns:minmax(20rem,1fr) minmax(20rem,1fr);gap:1rem;padding:1rem 2rem}section{min-width:0}button,select{background:#263344;color:inherit;border:1px solid #53647a;border-radius:4px;padding:.35rem .6rem}button{cursor:pointer}button:hover{background:#39516b}.node{display:block;margin:.15rem 0;text-align:left;font:13px ui-monospace,monospace}.selected{background:#49688c}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#1b2432;padding:.8rem;border-radius:5px}a{color:#92c7ff}small{color:#aab8ca}@media(max-width:760px){main{display:block}}</style>"
+  , "<header><h1>Bend component</h1><div id='identity'></div><label>Root <select id='root'><option value='body'>body</option><option value='type'>type</option><option value='hit'>HIT type</option></select></label> <label>Constructor ordinal <input id='constructor' type='number' min='0' style='width:5em'></label> <button id='load'>Open</button></header>"
+  , "<main><section><h2>Term tree</h2><div id='tree'></div></section><section><h2>Selected subterm</h2><small id='address'></small><h3>Checked type</h3><pre id='type'></pre><div id='peers'></div><h3>Dependencies</h3><div id='deps'></div><h3>Authored presentations</h3><div id='presentations'></div><p id='error' role='alert'></p></section></main>"
+  , "<script>const parts=location.pathname.split('/ui/bend/component/');const coords=(parts[1]||'').split('/');const digest=coords[0],member=coords[1];const api=parts[0]+'/api/bend/subterm';let tree=null,selected=[];const el=id=>document.getElementById(id);const label=n=>n.kind==='node'?n.tag:n.kind+(n.value===undefined?'':': '+n.value);const pathText=p=>p.length?p.join(','):'root';const address=(d,m)=>parts[0]+'/ui/bend/component/'+d+'/'+m;function renderNode(n,p,host){const b=document.createElement('button');b.className='node'+(p.join(',')===selected.join(',')?' selected':'');b.textContent=pathText(p)+'  '+label(n);b.style.marginLeft=(p.length*14)+'px';b.onclick=()=>select(p);host.appendChild(b);(n.children||[]).forEach((child,i)=>renderNode(child,[...p,i],host));}function renderTree(){el('tree').replaceChildren();if(tree)renderNode(tree,[],el('tree'));}function setText(id,value){el(id).textContent=value;}function show(data){const p=data.projection;setText('address',p.address.digest+'/'+p.address.member+' '+p.address.root+' '+pathText(p.address.path));setText('type',JSON.stringify(p.type,null,2));const same=el('peers');same.replaceChildren();if(data.semanticPeers&&data.semanticPeers.length){const heading=document.createElement('h3');heading.textContent='Same checked Nat value';same.appendChild(heading);for(const peer of data.semanticPeers){const a=document.createElement('a');a.href=address(peer.digest,peer.member);a.textContent=peer.digest.slice(0,16)+'/'+peer.member;same.append(a,document.createElement('br'));}}const deps=el('deps');deps.replaceChildren();for(const dep of p.dependencies){const a=document.createElement('a');if(dep.digest){a.href=address(dep.digest,dep.member);a.textContent=dep.digest.slice(0,16)+'/'+dep.member;}else{a.textContent=dep.name;}deps.append(a,document.createElement('br'));}const pres=el('presentations');pres.replaceChildren();for(const item of data.presentations){const row=document.createElement('p');row.textContent=item.authoredName+' — '+item.sourcePath+(item.span?' '+JSON.stringify(item.span):'')+(item.error?' ('+item.error+')':'');pres.appendChild(row);}}async function select(p){selected=p;renderTree();const q=new URLSearchParams({digest,member,root:el('root').value,path:p.join(',')});setText('error','');try{const r=await fetch(api+'?'+q);if(!r.ok)throw Error(await r.text());show(await r.json());history.replaceState(null,'',location.pathname+'?root='+encodeURIComponent(el('root').value)+'&path='+p.join(','));}catch(e){setText('error',String(e));}}async function load(){selected=[];const q=new URLSearchParams({digest,member,root:el('root').value});setText('error','');try{const r=await fetch(api+'?'+q);if(!r.ok)throw Error(await r.text());const data=await r.json();tree=data.projection.term;renderTree();show(data);}catch(e){tree=null;renderTree();setText('error',String(e));}}el('identity').textContent=digest+'/'+member;el('load').onclick=()=>{const ordinal=el('constructor').value;const root=ordinal===''?'body':'constructor:'+ordinal;if(ordinal!=='')el('root').append(new Option(root,root));el('root').value=root;load();};el('root').onchange=()=>{el('constructor').value='';load();};const params=new URLSearchParams(location.search);if(params.has('root')){const root=params.get('root');if(root.startsWith('constructor:')){el('root').append(new Option(root,root));}el('root').value=root;}load().then(()=>{if(params.has('path'))select(params.get('path').split(',').filter(Boolean).map(Number));});</script></html>"
