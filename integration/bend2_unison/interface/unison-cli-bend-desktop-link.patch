+
+    serveBendMemberLinkEndpoint mayName mayKind = case mayName of
+      Nothing -> pure Nothing
+      Just name -> do
+        root <- Backend.resolveProjectRootHash codebase projectAndBranchName
+        branch <- liftIO $ Codebase.expectBranchForHash codebase root
+        let names = Branch.toNames (Branch.head branch)
+            candidates = case mayKind of
+              Just "term" -> mapMaybe Referent.toTermReferenceId (Set.toList (Names.termsNamed names name))
+              Just "type" -> mapMaybe Reference.toId (Set.toList (Names.typesNamed names name))
+              _ -> []
+        case candidates of
+          [Id digest member] -> do
+            isBend <- liftIO $ Codebase.runTransaction codebase do
+              maybeOid <- Q.loadObjectIdForPrimaryHash digest
+              maybe (pure False) (fmap isJust . Q.loadBendBytes) maybeOid
+            pure $ if isBend
+              then Just ("/codebase/ui/bend/component/" <> hexDigest (Hash.toByteString digest) <> "/" <> Text.pack (show member)
+                <> if mayKind == Just "type" then "?root=hit" else "")
+              else Nothing
+          _ -> pure Nothing
 
+    hexDigest = Text.pack . concatMap (padHex . fromIntegral) . Strict.unpack
+    padHex n = let digits = showHex (n :: Int) "" in if length digits == 1 then '0' : digits else digits
