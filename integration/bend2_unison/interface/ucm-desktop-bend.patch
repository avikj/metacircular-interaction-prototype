+bendMemberLink : WorkspaceContext -> Reference.Reference -> Endpoint
+bendMemberLink context ref =
+    let
+        kind =
+            case ref of
+                Reference.TermReference _ ->
+                    "term"
+
+                Reference.TypeReference _ ->
+                    "type"
+
+                _ ->
+                    "constructor"
+
+        name =
+            Reference.fqn ref
+                |> Maybe.map FQN.toString
+                |> Maybe.withDefault ""
+    in
+    GET
+        { path = baseCodePathFromContext context ++ [ "bend", "member-link" ]
+        , queryParams = [ string "name" name, string "kind" kind ]
+        }
+
