+-- | Like 'doParseBook', with declaration offsets in the supplied source
+-- string. Callers can convert them to UTF-8 byte offsets for persistence.
+doParseBookWithSpans :: FilePath -> String -> Either String (Book, [(Name, (Int, Int))])
+doParseBookWithSpans file input =
+  case evalState (runParserT p file input) (ParserState True input [] M.empty) of
+    Left err -> Left (formatError input err)
+    Right (book, spans) -> Right (adjustBook book, spans)
+  where
+    p = do
+      skip
+      result <- parseBookWithSpans
+      skip
+      eof
+      return result
+
