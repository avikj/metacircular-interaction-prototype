+-- | Parse the same Book while retaining the parser's exact character offsets
+-- for each authored top-level declaration. A type declaration contributes
+-- the same span to its generated definition and optional HIT declaration.
+parseBookWithSpans :: Parser (Book, [(Name, (Int, Int))])
+parseBookWithSpans = do
+  _ <- many (try parseImport)
+  entries <- many $ do
+    start <- getOffset
+    entry@(name, _, _) <- parseDefinition
+    end <- getOffset
+    return (entry, (name, (start, end)))
+  let defs = [(name, defn) | ((name, defn, _), _) <- entries]
+      hits = [hit | ((_, _, Just hit), _) <- entries]
+  return (Book (M.fromList defs) (M.fromList hits), map snd entries)
+
