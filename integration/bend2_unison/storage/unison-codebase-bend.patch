+-- | Persist a checked Bend2 component and index dependencies for every member.
+-- The caller supplies the component hash, versioned codec bytes, and resolved
+-- codebase references produced from the same checked component. This function
+-- does not interpret Bend2 syntax or emit HVM code.
+saveBendComponent ::
+  HashHandle ->
+  Hash ->
+  ByteString ->
+  [(C.Reference.Pos, [S.Reference])] ->
+  Transaction ObjectId
+saveBendComponent hh h bytes memberDependencies = do
+  hashId <- saveHashHash h
+  objectId <- saveObject hh hashId ObjectType.BendComponent bytes
+  for_ memberDependencies \(memberIndex, dependencies) ->
+    addToDependentsIndex dependencies (S.Reference.Id objectId memberIndex)
+  pure objectId
+
+-- | Record an identity only when established by a named version of the
+-- Bend2 checker. This is an index, not the executable component address.
+saveBendSemanticIdentity :: ObjectId -> C.Reference.Pos -> Text -> Hash -> Transaction ()
+saveBendSemanticIdentity componentObjectId componentIndex semanticsVersion normalFormHash = do
+  normalFormHashId <- saveHashHash normalFormHash
+  execute
+    [sql|
+      INSERT INTO bend_semantic_identity
+        (component_object_id, component_index, semantics_version, normal_form_hash_id)
+      VALUES (:componentObjectId, :componentIndex, :semanticsVersion, :normalFormHashId)
+      ON CONFLICT DO NOTHING
+    |]
+
+findBendMembersBySemanticIdentity :: Text -> Hash -> Transaction [S.Reference.Id]
+findBendMembersBySemanticIdentity semanticsVersion normalFormHash = do
+  let normalFormHash32 = Hash32.fromHash normalFormHash
+  queryListRow
+    [sql|
+      SELECT b.component_object_id, b.component_index
+      FROM bend_semantic_identity b
+      JOIN hash h ON h.id = b.normal_form_hash_id
+      WHERE b.semantics_version = :semanticsVersion
+        AND h.base32 = :normalFormHash32 COLLATE NOCASE
+    |]
+
+-- | Keep exact authored bytes apart from the checked component object.
+saveBendPresentation :: ObjectId -> C.Reference.Pos -> ByteString -> ByteString -> C.Reference.Pos -> C.Reference.Pos -> Text -> Transaction ()
+saveBendPresentation componentObjectId componentIndex sourceDigest sourceUtf8 sourceStartByte sourceEndByte authoredName =
+  execute
+    [sql|
+      INSERT INTO bend_presentation
+        (component_object_id, component_index, source_digest, source_utf8,
+         source_start_byte, source_end_byte, authored_name)
+      VALUES
+        (:componentObjectId, :componentIndex, :sourceDigest, :sourceUtf8,
+         :sourceStartByte, :sourceEndByte, :authoredName)
+      ON CONFLICT DO NOTHING
+    |]
+
+loadBendPresentations :: ObjectId -> C.Reference.Pos -> Transaction [(ByteString, ByteString, C.Reference.Pos, C.Reference.Pos, Text)]
+loadBendPresentations componentObjectId componentIndex =
+  queryListRow
+    [sql|
+      SELECT source_digest, source_utf8, source_start_byte, source_end_byte, authored_name
+      FROM bend_presentation
+      WHERE component_object_id = :componentObjectId
+        AND component_index = :componentIndex
+      ORDER BY id
+    |]
+
+findBendMembersByAuthoredName :: Text -> Transaction [S.Reference.Id]
+findBendMembersByAuthoredName authoredName =
+  queryListRow
+    [sql|
+      SELECT DISTINCT component_object_id, component_index
+      FROM bend_presentation
+      WHERE authored_name = :authoredName
+      ORDER BY component_object_id, component_index
+    |]
