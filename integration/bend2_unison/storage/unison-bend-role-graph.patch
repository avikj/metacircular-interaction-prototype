+data DependencyRef = LocalDependency !Int | ExternalDependency !ByteString !Int
+  deriving stock (Eq, Ord, Show)
+
+-- (dependent is a type, dependency reference, dependency is a type).
+type RoleDependency = (Bool, DependencyRef, Bool)
+
+-- Read dependency roles from the canonical payload itself. This reader works
+-- for objects admitted before role-aware graph queries existed and for sync
+-- imports, so no database backfill or wire change is needed.
+memberRoleDependencies :: ByteString -> Either String (Vector [RoleDependency])
+memberRoleDependencies = runGetS do
+  magic <- getByteString 4
+  unless (magic == "B2CF") (fail "invalid Bend component magic")
+  version <- getWord8
+  unless (version == 2) (fail "unsupported Bend component version")
+  root <- getFlat
+  case root of
+    FNode "CanonicalBendComponentV2" members ->
+      Vector.fromList <$> traverse memberDependencies members
+    _ -> fail "invalid canonical Bend component root"
+  where
+    memberDependencies (FNode "Member" [term, typ]) =
+      pure (walk False term ++ walk True typ)
+    memberDependencies _ = fail "invalid canonical Bend member"
+
+    walk dependentIsType = \case
+      FNode "Absent" [] -> []
+      FNode "HTy" [hit, args] -> typeRef hit ++ walk dependentIsType args
+      FNode "HCon" [hit, _, params, args, intervals] ->
+        typeRef hit ++ concatMap (walk dependentIsType) [params, args, intervals]
+      FNode "CtorRef" [hit, _] -> typeRef hit
+      node@(FNode tag _)
+        | tag == "LocalRef" || tag == "ExternalRef" ->
+            maybe [] (\ref -> [(dependentIsType, ref, False)]) (reference node)
+      FNode _ children -> concatMap (walk dependentIsType) children
+      _ -> []
+      where
+        typeRef node = maybe [] (\ref -> [(dependentIsType, ref, True)]) (reference node)
+
+    reference (FNode "LocalRef" [FNumber n]) =
+      Just (LocalDependency (fromIntegral n))
+    reference (FNode "ExternalRef" [FNode "Digest" octets, FNumber n]) = do
+      bytes <- traverse octet octets
+      if length bytes == 64
+        then Just (ExternalDependency (Bytes.pack bytes) (fromIntegral n))
+        else Nothing
+    reference _ = Nothing
+    octet (FNumber n) | n <= 255 = Just (fromIntegral n)
+    octet _ = Nothing
+
+data FlatView = FNode !ByteString ![FlatView] | FNumber !Word64 | FOther
+
+getFlat :: (MonadGet m) => m FlatView
+getFlat = do
+  tag <- getWord8
+  case tag of
+    3 -> FNode <$> getString <*> (getCount >>= \count -> replicateM count getFlat)
+    5 -> FNumber <$> getWord64
+    6 -> FNumber <$> getWord64
+    _ -> skipTagged tag >> pure FOther
+
+getWord64 :: (MonadGet m) => m Word64
+getWord64 = do
+  octets <- replicateM 8 getWord8
+  pure (foldl' (\n octet -> n * 256 + fromIntegral octet) 0 octets)
+
 memberRoles :: ByteString -> Either String (Vector MemberRoles)
 memberRoles = runGetS getRoles
 
