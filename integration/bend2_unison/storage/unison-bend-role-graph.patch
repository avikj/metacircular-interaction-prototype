+                BendFormat.ExternalDependency digest slot ->
+                  dependencyHash == Just digest && fromIntegral dependencyIndex == slot
+              roles (dependentIsType, _, dependencyIsType) =
+                (if dependentIsType then TypeRole else TermRole,
+                 if dependencyIsType then TypeRole else TermRole)
+              matched = map roles (filter matches possible)
+          pure (if null matched then Nothing else Just matched)
