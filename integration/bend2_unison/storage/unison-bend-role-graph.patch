+    bendEdgeRoles (C.Reference.Id dependentOid dependentIndex) dependency =
+      case dependency of
+        C.Reference.ReferenceBuiltin _ -> pure Nothing
+        C.Reference.ReferenceDerived (C.Reference.Id dependencyOid dependencyIndex) -> do
