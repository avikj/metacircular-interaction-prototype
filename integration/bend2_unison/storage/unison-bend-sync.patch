+module U.Codebase.Sqlite.Bend.Format where
+
+import Control.Monad (replicateM, unless, when)
+import Data.ByteString (ByteString)
+import Data.Bytes.Get (MonadGet, getByteString, getWord8, runGetS)
+import Data.Vector (Vector)
+import qualified Data.Vector as Vector
+import Data.Word (Word8, Word64)
+import Data.Text (Text)
+
+data SyncBendFormat' hash = SyncBendFormat
+  { componentBytes :: !ByteString,
+    localMemberDependencies :: !(Vector (Word64, Word64)),
+    memberDependencies :: !(Vector (Word64, hash, Word64)),
+    authoredPresentations :: !(Vector (Word64, ByteString, ByteString, Word64, Word64, Text, Text))
+  }
+  deriving stock (Eq, Show)
+
+-- A canonical slot may carry a definition, a HIT, or both. This small reader
+-- lets codebase2 classify dependency graph edges without depending on Bend's
+-- compiler (which itself depends on codebase2). The complete payload is
+-- validated by Bend's canonical decoder at the Share ingestion boundary.
+data MemberRoles = MemberRoles
+  { hasTerm :: !Bool,
+    hasType :: !Bool
+  }
+  deriving stock (Eq, Show)
+
+memberRoles :: ByteString -> Either String (Vector MemberRoles)
+memberRoles = runGetS getRoles
+
+getRoles :: (MonadGet m) => m (Vector MemberRoles)
+getRoles = do
+  magic <- getByteString 4
+  unless (magic == "B2CF") (fail "invalid Bend component magic")
+  version <- getWord8
+  unless (version == 2) (fail "unsupported Bend component version")
+  expectNode "CanonicalBendComponentV2" >>= \count ->
+    Vector.fromList <$> replicateM count getMember
+
+getMember :: (MonadGet m) => m MemberRoles
+getMember = do
+  count <- expectNode "Member"
+  unless (count == 2) (fail "invalid Bend member arity")
+  hasTerm <- getPresence
+  hasType <- getPresence
+  when (not hasTerm && not hasType) (fail "empty Bend member")
+  pure MemberRoles {hasTerm, hasType}
+
+getPresence :: (MonadGet m) => m Bool
+getPresence = do
+  tag <- getWord8
+  case tag of
+    3 -> do
+      name <- getString
+      count <- getCount
+      if name == "Absent"
+        then unless (count == 0) (fail "invalid absent Bend member") >> pure False
+        else replicateM count skipFlat >> pure True
+    _ -> skipTagged tag >> pure True
+
+expectNode :: (MonadGet m) => ByteString -> m Int
+expectNode expected = do
+  tag <- getWord8
+  unless (tag == 3) (fail "expected Bend node")
+  name <- getString
+  unless (name == expected) (fail "unexpected Bend node")
+  getCount
+
+skipFlat :: (MonadGet m) => m ()
+skipFlat = getWord8 >>= skipTagged
+
+skipTagged :: (MonadGet m) => Word8 -> m ()
+skipTagged tag = case tag of
+  0 -> skipBytes 8
+  1 -> getString >> skipBytes 8
+  2 -> getString >> pure ()
+  3 -> do
+    _ <- getString
+    count <- getCount
+    replicateM count skipFlat >> pure ()
+  4 -> getString >> pure ()
+  5 -> skipBytes 8
+  6 -> skipBytes 8
+  7 -> skipBytes 8
+  8 -> skipBytes 8
+  9 -> skipBytes 4
+  10 -> skipBytes 1
+  _ -> fail "invalid Bend flat tag"
+
+getString :: (MonadGet m) => m ByteString
+getString = getCount >>= getByteString
+
+getCount :: (MonadGet m) => m Int
+getCount = do
+  octets <- replicateM 4 getWord8
+  pure (foldl' (\n octet -> n * 256 + fromIntegral octet) 0 octets)
+
+skipBytes :: (MonadGet m) => Int -> m ()
+skipBytes n = getByteString n >> pure ()
