+-- | Keep the V2 CBOR attachment in sync with the union of authored source
+-- presentations when a canonical component was already owned by the target.
+refreshCopiedBendPresentations :: (QueryM m) => UserId -> CausalId -> m ()
+refreshCopiedBendPresentations codebaseOwner causalId = do
+  components <- queryListRows @(ComponentHashId, ByteString) [sql|
+    SELECT sb.component_hash_id, sb.entity_bytes
+    FROM bend_components_reachable_from_causals(ARRAY[#{causalId}]) reachable
+      JOIN sandboxed_bend_components sb
+        ON sb.component_hash_id = reachable.component_hash_id
+       AND sb.user_id = #{codebaseOwner}
+  |]
+  for_ components \(componentHashId, blob) -> do
+    bend <- case S.decodeTypedTempEntity TempEntityType.BendComponentType blob of
+      Right (SqliteEntity.B format) -> pure format
+      Left err -> unrecoverableError $ InternalServerError "bend-format-invalid" err
+      Right _ -> unrecoverableError $ MissingExpectedEntity "Stored Bend component had a different entity kind"
+    rows <- queryListRows @(Int64, ByteString, ByteString, Int64, Int64, Text, Text) [sql|
+      SELECT member_index, source_digest, source_utf8, source_start_byte,
+             source_end_byte, authored_name, source_path
+      FROM bend_component_presentations
+      WHERE user_id = #{codebaseOwner} AND component_hash_id = #{componentHashId}
+      ORDER BY member_index, source_digest, source_start_byte,
+               source_end_byte, authored_name, source_path
+    |]
+    let forms = Vector.fromList
+          [(fromIntegral member, digest, source, fromIntegral start, fromIntegral end, name, path)
+           | (member,digest,source,start,end,name,path) <- rows]
+        merged :: TempEntity
+        merged = SqliteEntity.B (bend {BendFormat.authoredPresentations = forms})
+        CBORBytes serialized = SyncV2.serialiseCBORBytes merged
+    bytesId <- Defn.ensureBytesIdsOf id (BL.toStrict serialized)
+    execute_ [sql|
+      INSERT INTO serialized_components (user_id, component_hash_id, bytes_id)
+      VALUES (#{codebaseOwner}, #{componentHashId}, #{bytesId})
+      ON CONFLICT (user_id, component_hash_id)
+        DO UPDATE SET bytes_id = EXCLUDED.bytes_id
+    |]
 
