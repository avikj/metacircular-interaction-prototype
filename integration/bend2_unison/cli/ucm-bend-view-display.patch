+
+-- `display` on a native Bend term executes the same stored checked closure
+-- through HVM4 as `bend.run`; Unison's evaluator cannot hydrate this object.
+handleBendDisplay :: OutputLocation -> Ref.Id -> Cli ()
+handleBendDisplay location ref = do
+  env <- ask
+  loaded <- liftIO $ Codebase.runTransaction env.codebase (BendStorage.loadDependencyClosedEntryBookByHashRef ref)
+  case loaded of
+    Left err -> reportEntry err
+    Right (entry, book) -> case BendExecution.selectEntryAsMain entry book of
+      Left err -> reportEntry err
+      Right (Book definitions _) | Just (_, _, All _ _) <- Map.lookup "main" definitions ->
+        Cli.respond (Output.Literal "Bend2: display needs an applied value; use view for this function definition")
+      Right selected -> do
+        hvm <- liftIO $ fromMaybe "hvm" <$> lookupEnv "HVM4"
+        outcome <- liftIO $ BendExecution.runCachedCheckedBook hvm selected
+        case outcome of
+          Left err -> Cli.respond (Output.Literal (fromString ("HVM4: " ++ show err)))
+          Right result -> case location of
+            ConsoleLocation -> Cli.respond (Output.Literal (fromString (BendExecution.output result ++ BendExecution.diagnostics result)))
+            FileLocation path _ -> do
+              liftIO (writeFile path (BendExecution.output result))
+              Cli.respond (Output.Literal (fromString ("Bend2: wrote HVM4 result to " ++ path)))
+            LatestFileLocation _ -> Cli.respond (Output.Literal (fromString (BendExecution.output result ++ BendExecution.diagnostics result)))
 
 reportEntry :: String -> Cli ()
 reportEntry err = Cli.respond (Output.Literal (fromString ("Bend2: " ++ err)))
