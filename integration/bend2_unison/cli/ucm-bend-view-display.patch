 -- | Handle a @ShowDefinitionI@ input command, i.e. `view` or `edit`.
 handleShowDefinition :: OutputLocation -> ShowDefinitionScope -> List.NonEmpty (HQ.HashQualified Name) -> Cli ()
 handleShowDefinition outputLoc showDefinitionScope originalQuery = do
+  case outputLoc of
+    ConsoleLocation -> do
+      remaining <- filterM (fmap not . showBendDefinition showDefinitionScope) (List.NonEmpty.toList originalQuery)
+      for_ (List.NonEmpty.nonEmpty remaining) (handleShowDefinitionUnison outputLoc showDefinitionScope)
+    _ -> handleShowDefinitionUnison outputLoc showDefinitionScope originalQuery
+
+-- Bend members have native component objects and authored Bend source. They
+-- cannot be hydrated as Unison term/type objects by definitionsByName.
+showBendDefinition :: ShowDefinitionScope -> HQ.HashQualified Name -> Cli Bool
+showBendDefinition scope query = do
+  names <- case scope of
+    ShowDefinitionLocal -> Cli.currentNames
+    ShowDefinitionGlobal -> Names.makeAbsolute . Branch.toNames . Branch.head <$> Cli.getCurrentProjectRoot
+  let termRefs = mapMaybe Referent.toTermReferenceId (Set.toList (Names.lookupHQTerm Names.IncludeSuffixes query names))
+      typeRefs = mapMaybe Reference.toId (Set.toList (Names.lookupHQType Names.IncludeSuffixes query names))
+      refs = Set.toList (Set.fromList (termRefs ++ typeRefs))
+  presentations <- for refs \(Id digest member) -> Cli.runTransaction do
+    maybeObjectId <- Q.loadObjectIdForPrimaryHash digest
+    case maybeObjectId of
+      Nothing -> pure Nothing
+      Just objectId -> do
+        maybeBend <- Q.loadBendBytes objectId
+        case maybeBend of
+          Nothing -> pure Nothing
+          Just _ -> do
+            forms <- Q.loadBendPresentations objectId member
+            pure (Just forms)
+  if null refs || any isNothing presentations
+    then pure False
+    else do
+      for_ (concat (catMaybes presentations)) \(_, source, start, end, authoredName, path) -> do
+        let bytes = Bytes.take (fromIntegral end - fromIntegral start) (Bytes.drop (fromIntegral start) source)
+            body = either (const "<invalid UTF-8 in stored Bend source>") Text.unpack (Text.decodeUtf8' bytes)
+        Cli.respond (Literal (fromString ("Bend2 " ++ Text.unpack authoredName ++ " (" ++ Text.unpack path ++ "):\n" ++ body)))
+      pure True
+
