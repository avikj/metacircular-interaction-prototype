+  -- Native Bend components have their own checked declaration format.  The
+  -- Unison synthesis merge hydrates every changed type as a Unison decl, so
+  -- merge their names and causal histories directly instead.
+  env <- ask
+  hasBend <- Cli.runTransaction do
+    aliceBranch <- Codebase.expectBranchForHashTx env.codebase aliceCausalHash
+    bobBranch <- Codebase.expectBranchForHashTx env.codebase bobCausalHash
+    or <$> traverse branchHasBend [aliceBranch, bobBranch]
+  if hasBend && lcaCausalHash /= Just aliceCausalHash && lcaCausalHash /= Just bobCausalHash
+    then do
+      bobBranch <- liftIO (Codebase.expectBranchForHash env.codebase bobCausalHash)
+      _ <- Cli.updateAtM
+        ("merge " <> into @Text (ProjectUtils.justTheNames branches.bob))
+        (PP.projectBranchRoot branches.alice)
+        (\aliceBranch -> liftIO (BranchMerge.merge'' (Codebase.lca env.codebase) BranchMerge.RegularMerge bobBranch aliceBranch))
+      Cli.respond (Output.Literal "Bend2: merged branch histories; conflicting names retain both references")
+    else doMerge
+      MergeInfo
+        { alice =
+            AliceMergeInfo
+              { causalHash = aliceCausalHash,
+                projectAndBranch = branches.alice
+              },
+          bob =
+            BobMergeInfo
+              { causalHash = bobCausalHash,
+                source = MergeSource'LocalProjectBranch branches.bob
+              },
+          lca =
+            LcaMergeInfo
+              { causalHash = lcaCausalHash
+              },
+          description = "merge " <> into @Text (ProjectUtils.justTheNames branches.bob)
+        }
+
+branchHasBend :: Branch Transaction -> Transaction Bool
+branchHasBend branch = do
+  let refs = Names.referenceIds (Branch.toNames (Branch.head branch))
+  or <$> traverse isBendRef (Set.toList (refs.terms <> refs.types))
+  where
+    isBendRef (Ref.Id hash _) = do
+      maybeOid <- Queries.loadObjectIdForPrimaryHash hash
+      maybe (pure False) (fmap isJust . Queries.loadBendBytes) maybeOid
 
