+module Unison.Codebase.Editor.HandleInput.BendLoad
+  ( handleBendFileChanged,
+    handleBendLoad,
+    handleBendRun,
+  )
+where
+
+import Bend.UCM.Execution qualified as BendExecution
+import Bend.UCM.Storage qualified as BendStorage
+import Control.Exception (evaluate)
+import Control.Exception qualified as Exception
+import Control.Monad.Reader (ask)
+import Core.Admission qualified as BendAdmission
+import Core.Provenance qualified as BendProvenance
+import Core.CLI qualified as Bend
+import Core.Type (Book)
+import Data.Map.Strict qualified as Map
+import Data.Set qualified as Set
+import Data.Text qualified as Text
+import System.Directory (makeAbsolute)
+import System.Environment (lookupEnv)
+import System.Exit (ExitCode)
+import Unison.Cli.Monad (Cli)
+import Unison.Cli.Monad qualified as Cli
+import Unison.Cli.MonadUtils qualified as Cli
+import Unison.Cli.NamesUtils qualified as Cli
+import Unison.Codebase qualified as Codebase
+import Unison.Codebase.Branch qualified as Branch
+import Unison.Codebase.BranchUtil qualified as BranchUtil
+import Unison.Codebase.Editor.Output qualified as Output
+import Unison.Codebase.Path qualified as Path
+import Unison.Prelude
+import Unison.Names qualified as Names
+import Unison.Referent qualified as Referent
+import Unison.Syntax.Name qualified as Name
+import U.Codebase.Sqlite.Reference qualified as S
+
+-- | A watched .bend file goes through Bend2 import resolution and checking,
+-- then its checked components enter UCM's native object store.
+handleBendFileChanged :: Text -> Text -> Cli ()
+handleBendFileChanged path source = do
+  admitted <- liftIO (checkBendFile (Text.unpack path) (Text.unpack source))
+  case admitted of
+    Left err -> Cli.respond (Output.Literal (fromString ("Bend2: " ++ err)))
+    Right checked -> do
+      saved <- saveAndLink path checked
+      Cli.respond . Output.Literal . fromString $ case saved of
+        Left err -> "Bend2 codebase: " ++ err
+        Right refs ->
+          "Bend2: checked and stored "
+            ++ show (length (BendAdmission.checkedMembers checked))
+            ++ " declarations ("
+            ++ show (length refs)
+            ++ " addressed names) from "
+            ++ Text.unpack path
+
+handleBendLoad :: FilePath -> Cli ()
+handleBendLoad path = do
+  sourceResult <- liftIO $ Exception.try (readFile path >>= \s -> evaluate (length s) >> pure s)
+  case sourceResult of
+    Left (err :: IOException) -> Cli.respond (Output.Literal (fromString (show err)))
+    Right source -> handleBendFileChanged (Text.pack path) (Text.pack source)
+
+-- | A native UCM command: the file is checked by Bend2, then its full
+-- cubical HVM4 net runs. It never enters Unison's term evaluator.
+handleBendRun :: FilePath -> Cli ()
+handleBendRun path
+  | not (Text.isSuffixOf ".bend" (Text.pack path)) = runStoredName path
+  | otherwise = runSourceFile path
+
+runSourceFile :: FilePath -> Cli ()
+runSourceFile path = do
+  sourceResult <- liftIO $ Exception.try (readFile path >>= \s -> evaluate (length s) >> pure s)
+  case sourceResult of
+    Left (err :: IOException) -> Cli.respond (Output.Literal (fromString (show err)))
+    Right source -> do
+      admitted <- liftIO (checkBendFile path source)
+      case admitted of
+        Left err -> Cli.respond (Output.Literal (fromString ("Bend2: " ++ err)))
+        Right checked -> do
+          saved <- saveAndLink (Text.pack path) checked
+          case saved of
+            Left err -> Cli.respond (Output.Literal (fromString ("Bend2 codebase: " ++ err)))
+            Right refs -> case Map.lookup "main" refs of
+              Nothing -> Cli.respond (Output.Literal "Bend2: no main definition")
+              Just mainRef -> do
+                env <- ask
+                loaded <- liftIO $ Codebase.runTransaction env.codebase (BendStorage.loadDependencyClosedEntryBook mainRef)
+                case loaded of
+                  Left err -> Cli.respond (Output.Literal (fromString ("Bend2 codebase: " ++ err)))
+                  Right (entry, book) -> either reportEntry runChecked (BendExecution.selectEntryAsMain entry book)
+
+-- | Resolve an already admitted member in the current project branch. The
+-- branch's hash/member reference selects a precise version, so old source
+-- presentations with the same authored name cannot hijack this run.
+runStoredName :: String -> Cli ()
+runStoredName name = do
+  names <- Cli.currentNames
+  let found = do
+        parsed <- maybe (Left ("invalid UCM name: " ++ name)) Right (Name.parseText (Text.pack name))
+        case Set.toList (Names.termsNamed names parsed) of
+          [referent] -> maybe
+            (Left ("name is not an executable term: " ++ name))
+            Right
+            (Referent.toTermReferenceId referent)
+          [] -> Left ("no term named " ++ name ++ " in the current branch")
+          _ -> Left ("ambiguous term name in the current branch: " ++ name)
+  case found of
+    Left err -> Cli.respond (Output.Literal (fromString ("Bend2 codebase: " ++ err)))
+    Right ref -> do
+      env <- ask
+      loaded <- liftIO $ Codebase.runTransaction env.codebase (BendStorage.loadDependencyClosedEntryBookByHashRef ref)
+      case loaded of
+        Left err -> Cli.respond (Output.Literal (fromString ("Bend2 codebase: " ++ err)))
+        Right (entry, book) -> either reportEntry runChecked (BendExecution.selectEntryAsMain entry book)
+
+reportEntry :: String -> Cli ()
+reportEntry err = Cli.respond (Output.Literal (fromString ("Bend2: " ++ err)))
+
+-- | Add checked addresses to both the native object store and the current
+-- project's causal branch. A branch step contains refs to the same canonical
+-- component members that were just persisted.
+saveAndLink :: Text -> BendAdmission.CheckedSource -> Cli (Either String (Map.Map String S.Id))
+saveAndLink path checked =
+  case BendStorage.branchBindings checked of
+    Left err -> pure (Left err)
+    Right (terms, types) -> do
+      current <- Cli.currentNames
+      case (traverse (termActions current) terms, traverse (typeActions current) types) of
+        (Right termEdits, Right typeEdits) -> do
+          env <- ask
+          saved <- liftIO $ Codebase.runTransaction env.codebase (BendStorage.saveCheckedSource checked)
+          case saved of
+            Left err -> pure (Left err)
+            Right _ -> do
+              pp <- Cli.getCurrentProjectPath
+              Cli.stepAt ("bend.load " <> path) (pp, Branch.batchUpdates (concat termEdits <> concat typeEdits))
+              pure saved
+        (Left err, _) -> pure (Left err)
+        (_, Left err) -> pure (Left err)
+  where
+    parsed name = maybe
+      (Left ("Bend2 name cannot enter UCM branch: " ++ name))
+      Right
+      (Name.parseText (Text.pack name))
+    termActions current (name, referent) = do
+      unisonName <- parsed name
+      let split = Path.splitFromName unisonName
+          old = Set.toList (Names.termsNamed current unisonName)
+      pure (map (BranchUtil.makeDeleteTermName split) old <> [BranchUtil.makeAddTermName split referent])
+    typeActions current (name, reference) = do
+      unisonName <- parsed name
+      let split = Path.splitFromName unisonName
+          old = Set.toList (Names.typesNamed current unisonName)
+      pure (map (BranchUtil.makeDeleteTypeName split) old <> [BranchUtil.makeAddTypeName split reference])
+
+runChecked :: Book -> Cli ()
+runChecked book = do
+  hvm <- liftIO $ fromMaybe "hvm" <$> lookupEnv "HVM4"
+  outcome <- liftIO $ BendExecution.runCheckedBook hvm book
+  Cli.respond . Output.Literal . fromString $ case outcome of
+    Left err -> "HVM4: " ++ show err
+    Right result -> BendExecution.output result ++ BendExecution.diagnostics result
+
+checkBendFile :: FilePath -> String -> IO (Either String BendAdmission.CheckedSource)
+checkBendFile path source = do
+  absolutePath <- makeAbsolute path
+  parsed <- Exception.try (Bend.parseFile absolutePath) :: IO (Either ExitCode Book)
+  case parsed of
+    Left err -> pure (Left ("import or parse failed: " ++ show err))
+    Right book -> do
+      origins <- BendProvenance.collectFileOrigins absolutePath book
+      pure $ case origins of
+        Left err -> Left err
+        Right found -> either (Left . renderAdmission) Right
+          (BendAdmission.admitBookWithOrigins absolutePath source book found)
+
+renderAdmission :: BendAdmission.AdmissionError -> String
+renderAdmission = \case
+  BendAdmission.ParseFailure err -> "parse: " ++ err
+  BendAdmission.DefinitionTypeFailure name err -> "type of " ++ name ++ ": " ++ show err
+  BendAdmission.DefinitionTermFailure name err -> "definition " ++ name ++ ": " ++ show err
+  BendAdmission.HitTypeFailure name err -> "HIT " ++ name ++ ": " ++ show err
+  BendAdmission.HitConstructorFailure hit ctor err -> "HIT " ++ hit ++ "." ++ ctor ++ ": " ++ show err
+  BendAdmission.OriginFailure err -> "source: " ++ err
