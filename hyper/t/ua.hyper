; not : Bool ≃ Bool as a coherent equivalence (the fibre of not over y is contractible with centre (not y, refl))
(def not (lam b (case b (True () (ctr False)) (False () (ctr True)))))
(def not-equiv (ctr Pair not (lam y (ctr Pair (ctr Pair (not y) (plm _ y))
                                              (lam w (case w (Pair (x p) (plm i (ctr Pair (not (app p (inot i))) (plm j (app p (ior (inot i) j))))))))))))
(def negPath (ua (ctr Bool) (ctr Bool) not-equiv))
; uaβ: transport along ua e computes to e's function, by reduction
(def fwd-true  (trp negPath i0 i1 (ctr True)))
(def fwd-false (trp negPath i0 i1 (ctr False)))
(def bwd-true  (trp negPath i1 i0 (ctr True)))
; the Glue boundary: at a true face the type IS the partial type
(def glue-at-0 (app negPath i0))
(def glue-at-1 (app negPath i1))
(def main (ctr Pair fwd-true bwd-true))
