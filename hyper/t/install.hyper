; §8 install: an operation is replaced by another once a certificate (a path between them, at their type) checks.
; notnot reduces to id after the install; the kernel counts one R_INSTALL row where it counted two case rows.

(def neg : (ctr Pi (ctr Bool) (lam x (ctr Bool))) = (lam x (case x (False () (ctr True)) (True () (ctr False)))))
(def negLnv : (ctr Pi (ctr Bool) (lam x (ctr Path (lam _ (ctr Bool)) (app (ref neg) (app (ref neg) x)) x)))
  = (lam x (case x (False () (plm _ (ctr False))) (True () (plm _ (ctr True))))))
(def notnot : (ctr Pi (ctr Bool) (lam x (ctr Bool))) = (lam x (app (ref neg) (app (ref neg) x))))
(def id : (ctr Pi (ctr Bool) (lam x (ctr Bool))) = (lam x x))
(def cert : (ctr Path (lam _ (ctr Pi (ctr Bool) (lam x (ctr Bool)))) (ref notnot) (ref id))
  = (plm i (lam x (app (app (ref negLnv) x) i))))
(install notnot id cert)

(def main (app (ref notnot) (ctr True)))
