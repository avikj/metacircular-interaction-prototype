; the joint state (formal/cubical/theorems/logic/Jiva_…): two parts are projections of one joint; independence is the
; comparison ⟨p,q⟩ being an equivalence, entanglement its fibre; a living step refuses to descend to a marginal.
(def bools (sup 7 (ctr True) (ctr False)))
(def product (sup 8 (ctr Pair (ctr True) (ctr True)) (sup 9 (ctr Pair (ctr True) (ctr False)) (sup 10 (ctr Pair (ctr False) (ctr True)) (ctr Pair (ctr False) (ctr False))))))
(def left (lam j (proj 0 j)))
(def right (lam j (proj 1 j)))
(def id (lam j j))
(def unit (lam j (ctr Tt)))
; the living step: the visible part is rewritten by consulting the hidden part (controlled not)
(def xor (lam a (lam b (case a (False () b) (True () (case b (False () (ctr True)) (True () (ctr False))))))))
(def cnot (lam j (case j (Pair (a b) (ctr Pair (app xor a b) b)))))
; the dead step: not on the visible part alone
(def not (lam a (case a (False () (ctr True)) (True () (ctr False)))))
(def dead (lam j (case j (Pair (a b) (ctr Pair (app not a) b)))))
