#!/bin/sh
# oracle — point the kernel at anything.
#
#   sh scripts/oracle formal/cubical/Foo.agda      a file in the corpus
#   sh scripts/oracle path/to/Anywhere.agda        a file anywhere
#   ... | sh scripts/oracle -                      a whole module on stdin
#
# The wire's `sadhana` verb speaks an eight-symbol fragment; this is the
# other road: the ARBITRARY entrance.  An algorithm here is an Agda
# definition, its analysis is the theorems stated beside it, and the
# kernel's whole input is the module — so the module IS the request.
#
# The discipline is ProofGate.hs's, kept exactly:
#   * the two controls are watched FIRST, in this process, this run:
#     (zero + x) ≡ x must check, and (suc x) ≡ x must fail with a
#     LOCATED type error.  A kernel not seen rejecting a falsehood
#     certifies nothing; a green then would be a fact about this
#     container reported as a fact about mathematics.
#   * the answer is one JSON object: a saṃkramaṇa or a doṣa-lekha.
#     There is no third road.  No booleans, no floats, no null — the
#     wire's grammar (Wire.hs) holds here too.
#   * `agda says no` and `agda is not usable here` are two facts and
#     are never merged: control failure exits 3 and claims nothing
#     about the mathematics.
#   * a green over a pragma without --safe is a weaker green, and the
#     answer says so instead of hiding it (postulates would pass).
#
# Exit: 0 saṃkramaṇa, 1 doṣa-lekha (kernel examined and rejected),
#       2 turned back at the door (no such file, no module header),
#       3 karaṇa-doṣa (the instrument failed its own controls).
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
INC="$ROOT/formal/cubical"
# per-PROCESS, not per-user: two sessions asking at once must not share a
# last.log — a race here once answered one module's question with another
# module's rejection (observed 2026-09-01, Sha256 vs TwinPrimesFakeProof)
OUT="${ORACLE_OUT:-${TMPDIR:-/tmp}/oracle-$(id -u)-$$}"
mkdir -p "$OUT"
export LC_ALL=en_US.UTF-8   # ProofGate: agda's child throws on a bare locale before agda runs

AGDA="${AGDA:-agda}"
TOOLCHAIN=$("$AGDA" --version 2>/dev/null | head -1)
[ -n "$TOOLCHAIN" ] || {
  printf '{"uttara":"dosalekha","jati":"karana-dosa","hetu":"no agda on PATH; the kernel does not exist here"}\n'
  exit 3; }

# ------------------------------------------------------------------ escape
jesc() { # stdin -> one JSON-safe string body (no surrounding quotes)
  awk 'BEGIN{ORS=""} {gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); gsub(/\t/,"\\t"); gsub(/\r/,""); if(NR>1) printf "\\n"; printf "%s",$0}'
}

run_agda() { # $1=dir $2=file -> stdout+stderr captured in $OUT/last.log, returns agda's exit
  ( cd "$ROOT" && "$AGDA" -i "$INC" -i "$1" --library=cubical "$2" ) >"$OUT/last.log" 2>&1
}

# a file already living in a library governs itself: agda walks up from the
# file to its own .agda-lib (the corpus's natural-machine.agda-lib names its
# twenty include roots and its cubical), and flags from here would fight it.
run_agda_native() { # $1=file — run from the file's own directory so the
  # walk-up finds the nearest .agda-lib (observed: agda 2.8.0 roots the
  # project at the cwd, not at the input file)
  ( cd "$(dirname "$1")" && "$AGDA" "$(basename "$1")" ) >"$OUT/last.log" 2>&1
}

# ------------------------------------------------------------------ controls
CTRL="$OUT/controls"
rm -rf "$CTRL"; mkdir -p "$CTRL"
cat >"$CTRL/CanaryTrue.agda" <<'EOF'
{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}
module CanaryTrue where
open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
canary : (x : ℕ) → (zero + x) ≡ x
canary x = refl
EOF
cat >"$CTRL/CanaryFalse.agda" <<'EOF'
{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}
module CanaryFalse where
open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
canary : (x : ℕ) → (suc x) ≡ x
canary x = refl
EOF

if ! run_agda "$CTRL" "$CTRL/CanaryTrue.agda"; then
  err=$(head -6 "$OUT/last.log" | jesc)
  printf '{"uttara":"dosalekha","jati":"karana-dosa","hetu":"the positive control did not check: (zero + x) ≡ x was refused, so this environment cannot certify anything","saksin":"%s"}\n' "$err"
  exit 3
fi
if run_agda "$CTRL" "$CTRL/CanaryFalse.agda"; then
  printf '{"uttara":"dosalekha","jati":"karana-dosa","hetu":"the negative control PASSED: the kernel accepted (suc x) ≡ x by refl; it is not checking proofs and every green from it is void"}\n'
  exit 3
fi
if ! grep -q "CanaryFalse.agda:" "$OUT/last.log"; then
  err=$(head -6 "$OUT/last.log" | jesc)
  printf '{"uttara":"dosalekha","jati":"karana-dosa","hetu":"the negative control failed WITHOUT a located type error — that is an environment crash, not a rejection, and the two must not be merged","saksin":"%s"}\n' "$err"
  exit 3
fi

# ------------------------------------------------------------------ the target
case "${1:-}" in
  "")
    printf '{"uttara":"dosalekha","jati":"dvara","hetu":"nothing to check: give a .agda file, or - for a module on stdin"}\n'
    exit 2 ;;
  -)
    SRC="$OUT/stdin.agda.in"; cat >"$SRC"
    MOD=$(sed -n 's/^module[[:space:]]\{1,\}\([A-Za-z0-9_.'"'"'-]\{1,\}\)[[:space:]].*/\1/p' "$SRC" | head -1)
    [ -n "$MOD" ] || {
      printf '{"uttara":"dosalekha","jati":"dvara","hetu":"no `module X where` header found on stdin; the kernel addresses a module by its name and there is none"}\n'
      exit 2; }
    DIR="$OUT/stdin"; rm -rf "$DIR"; mkdir -p "$DIR"
    FILE="$DIR/$(printf %s "$MOD" | tr '.' '/').agda"
    mkdir -p "$(dirname "$FILE")"; cp "$SRC" "$FILE"
    NAMED="stdin, module $MOD" ;;
  *)
    [ -f "$1" ] || {
      printf '{"uttara":"dosalekha","jati":"dvara","hetu":"no such file: %s"}\n' "$(printf %s "$1" | jesc)"
      exit 2; }
    FILE=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
    DIR=$(dirname "$FILE")
    NAMED=$(printf %s "$1" | jesc) ;;
esac

RAKSA="--safe"
head -3 "$FILE" | grep -q -- "--safe" || RAKSA="ASAFE — the pragma does not carry --safe; a postulate would pass, so this green certifies typing, not truth"

t0=$(date +%s)
if [ "${1:-}" = "-" ]; then run_agda "$DIR" "$FILE"; else run_agda_native "$FILE"; fi
if [ $? -eq 0 ]; then
  t1=$(date +%s)
  printf '{"uttara":"samkramana","kriya":"oracle","nirnaya":{"sthana":"syad-asti"},"pramanya":{"marga":"kernel","saksin":"agda typechecked the module; the two controls were watched first in this run — (zero + x) ≡ x checked and (suc x) ≡ x produced a located type error"},"patra":"%s","raksa":"%s","yantra":"%s","kala-kshana":%s,"vyaya":["WHY each theorem holds: checked terms close steps, they do not explain them","whatever the module chose not to state — a green covers the stated theorems and nothing beside them"]}\n' \
    "$NAMED" "$(printf %s "$RAKSA" | jesc)" "$(printf %s "$TOOLCHAIN" | jesc)" "$((t1 - t0))"
  exit 0
else
  t1=$(date +%s)
  err=$(head -12 "$OUT/last.log" | jesc)
  printf '{"uttara":"dosalekha","kriya":"oracle","nirnaya":{"sthana":"syan-nasti"},"hetu":"agda examined the module and rejected it; its own first lines are carried, not paraphrased","saksin":"%s","patra":"%s","yantra":"%s","kala-kshana":%s,"sesa":["a rejection is a fact about THIS module; it is not a claim that any statement in it is false","the full log: %s"]}\n' \
    "$err" "$NAMED" "$(printf %s "$TOOLCHAIN" | jesc)" "$((t1 - t0))" "$(printf %s "$OUT/last.log" | jesc)"
  exit 1
fi
