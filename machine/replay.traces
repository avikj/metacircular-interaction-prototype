lem13 : (x : ℕ) → suc (x) ≡ (suc (zero) + x)
lem13 x = refl
candidate : (x y : ℕ) → (suc (x) + y) ≡ suc ((x + y))
candidate x zero = addZero (suc (x)) ∙ sym (cong (λ h → suc (h)) (addZero (x)))
candidate x (suc y) = addSuc (suc (x)) (y) ∙ cong (λ h → suc (h)) (candidate (x) (y)) ∙ sym (cong (λ h → suc (h)) (addSuc (x) (y)))
