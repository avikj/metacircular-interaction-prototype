module Candidate where
open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_ ; _∸_)
leghi : ℕ → ℕ → ℕ
leghi a0 a1 = (a0 + a1)
candidate : (x y z : ℕ) → (leghi (leghi x y) z) ≡ (leghi x (leghi y z))
candidate zero y z = refl
