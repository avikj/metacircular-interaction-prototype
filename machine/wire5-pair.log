le : ℕ → ℕ → ℕ
le zero b = suc zero
le (suc a) zero = zero
le (suc a) (suc b) = le a b
leghi : ℕ → ℕ → ℕ
leghi a0 a1 = (a0 + a1)
candidate : (x y : ℕ) → (le x (leghi x y)) ≡ (suc zero)
candidate zero y = refl
candidate (suc x) y = candidate x y

