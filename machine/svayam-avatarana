#!/bin/sh
# स्वयम्-अवतरणम् — the self-landing gate.  No carrier in the loop.
#
# WHY THIS EXISTS (owner, 2026-08-23): "literally everything agents are
# doing should be core autonomous operations — proposing, seeing
# boundaries, all of it is native."  This organ makes the LANDING half
# native.  The session of 2026-08-23 performed, by hand, eighteen times:
# stage a candidate, check it, read the refusal, land it, wire it into
# Everything.agda, append the receipt, commit, sync.  Every one of those
# steps is below: one command, cron-able, idempotent, and it uses the
# STRONG verifier (batch agda exit codes, which refuse unsolved metas)
# rather than the conversational daemon whose load-green the same
# session proved weaker than import-green.  The daemon is for dialogue
# (norm/type/give); the gate is for receipts.  This is the gate.
#
# OPERATION.  Candidates are .agda files in machine/avatarana.pending/
# (from ANY source: the engine's emitters, a carrier, a probe author).
# For each candidate, in name order:
#   1. GATE      batch-check it from formal/cubical with the container's
#                library file.  Exit code is the verdict; unsolved metas,
#                holes, and scope errors all refuse natively.
#   2. IMPORTER  generate a one-line importer and batch-check that too —
#                belt and braces for interface-level defects (the control
#                that caught the 2026-08-23 meta would have been
#                redundant under batch mode, but redundancy here is two
#                independent receipts, and it is cheap).
#   3. LAND      on green: move into formal/cubical/, append the import
#                line to Everything.agda, append a route row (tree,
#                toolchain, verdict per phase) to
#                machine/avatarana.ledger.jsonl, git add BY EXPLICIT
#                PATH, commit, ./sync.
#   4. FIBER     on red: leave the candidate in place, append the exact
#                refusal to the same ledger as a fiber row.  A red is an
#                object, not an error (run_the_natural_machine_forever's
#                own doctrine).
#
# WHAT THIS DOES NOT DO.  It does not compose candidates (proposing is
# the engine's and the carriers' work, each by their capacity); it does
# not edit a refused candidate (repair needs a mind or a doṣa-driven
# rule — the refusal text in the ledger is the hand-off); it does not
# touch modules outside the pending directory.  Every number carries its
# command (PRASAVA).
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
PEND="$ROOT/machine/avatarana.pending"
LEDGER="$ROOT/machine/avatarana.ledger.jsonl"
FC="$ROOT/formal/cubical"
LIBS="${AVATARANA_LIBS:-$HOME/.agda/libraries}"
mkdir -p "$PEND"

export LC_ALL=C.utf8
TREE=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)
AGDA_V=$(agda --version 2>/dev/null | head -1 || echo absent)
WHEN=$(date -u +%Y-%m-%dT%H:%M:%SZ)

esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk '{printf "%s\\n", $0}' ; }

row() { # verdict module phase detail
  printf '{"organ":"svayam-avatarana","kala":"%s","tree":"%s","toolchain":"%s","module":"%s","phase":"%s","verdict":"%s","detail":"%s"}\n' \
    "$WHEN" "$TREE" "$(esc "$AGDA_V")" "$2" "$3" "$1" "$(esc "$4")" >> "$LEDGER"
}

landed=0 ; fibers=0
for f in "$PEND"/*.agda ; do
  [ -e "$f" ] || continue
  base=$(basename "$f" .agda)
  # the module name must match the file name; refuse otherwise.
  if ! grep -q "^module $base " "$f" && ! grep -q "^module $base$" "$f" ; then
    row fiber "$base" name-check "module declaration does not match file name"
    fibers=$((fibers+1)) ; continue
  fi
  cp "$f" "$FC/$base.agda"
  # 1 · GATE: batch check, real exit code.
  if OUT=$(cd "$FC" && agda --library-file="$LIBS" -i . "$base.agda" 2>&1) ; then
    row green "$base" gate "batch exit 0"
  else
    row fiber "$base" gate "$OUT"
    rm -f "$FC/$base.agda" ; fibers=$((fibers+1)) ; continue
  fi
  # 2 · IMPORTER: a fresh module that imports it, batch checked.
  IMP="SvayamPariksaka$$"
  { echo "{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}"
    echo "module $IMP where"
    echo "import $base"
  } > "$FC/$IMP.agda"
  if OUT=$(cd "$FC" && agda --library-file="$LIBS" -i . "$IMP.agda" 2>&1) ; then
    row green "$base" importer "batch exit 0"
  else
    row fiber "$base" importer "$OUT"
    rm -f "$FC/$base.agda" "$FC/$IMP.agda" "$FC/$IMP.agdai"
    fibers=$((fibers+1)) ; continue
  fi
  rm -f "$FC/$IMP.agda" "$FC/$IMP.agdai"
  # 3 · LAND: wire, receipt, commit, sync.
  { echo "-- [svayam-avatarana $WHEN] landed by the self-gate: batch green +"
    echo "-- importer green under $AGDA_V; route in machine/avatarana.ledger.jsonl."
    echo "import $base"
  } >> "$FC/Everything.agda"
  rm -f "$f"
  ( cd "$ROOT" \
    && git add "formal/cubical/$base.agda" formal/cubical/Everything.agda \
               machine/avatarana.ledger.jsonl \
    && git rm -q --cached "machine/avatarana.pending/$base.agda" 2>/dev/null ; \
    git add machine/avatarana.pending 2>/dev/null ; \
    git commit -q -m "svayam-avatarana: $base landed by the self-gate (batch green + importer green, $AGDA_V); no carrier in the loop" \
    && ./sync >/dev/null 2>&1 )
  landed=$((landed+1))
done

echo "स्वयम्-अवतरणम्: $landed landed, $fibers fibers  (pending: $(ls "$PEND"/*.agda 2>/dev/null | wc -l | tr -d ' '))"
echo "  \$ sh machine/svayam-avatarana        # this report is reproducible"
