#!/bin/sh
# प्रतिकारः — the counter-action.  Seam 2, closed with NO mind in the loop.
#
#     typed doṣa  →  transformation attempted  →  re-gate  →  land or grow.
#
# THE LAW THIS ORGAN OBEYS (owner, 2026-08-23, in force):
#   * NO DEFERENCE TO A MIND.  A repair "a mind must do" is a carrier
#     re-inserted as a permanent organ — the exact failure the whole
#     project exists to kill.  Every doṣa is either transformed here, or
#     it is a MISSING RULE THIS ORGAN MUST GROW — addressed to the
#     machine's own organogenesis, never handed to a human.
#   * THE GATE IS THE COURT, so pratikāra attempts AGGRESSIVELY.  A wrong
#     transformation costs one re-gate and nothing else, so there is no
#     reason to withhold an attempt.  pratikāra proposes; batch agda
#     adjudicates; a repair that does not re-gate green is simply not a
#     repair and the loop continues.
#   * The only doṣa it does NOT mutate is an ENVIRONMENT doṣa (toolchain
#     skew — Δ=109/solveℕ!): there the mathematics is not the defect, so
#     the candidate is retained for the correct container.  That is a fact
#     about the world, not a repair withheld.
#   * An unencoded doṣa is written as a doṣa-lekha whose śeṣa is "GROW
#     RULE" — a request to the transformation table to acquire this class,
#     which the next pass of building does, not a person.
#
# RUN:  sh machine/pratikara
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
PEND="$ROOT/machine/avatarana.pending"
LEDGER="$ROOT/machine/avatarana.ledger.jsonl"
FC="$ROOT/formal/cubical"
LIBS="${AVATARANA_LIBS:-$HOME/.agda/libraries}"
MAXPASS="${PRATIKARA_MAXPASS:-8}"
mkdir -p "$PEND"
export LC_ALL=C.utf8

TREE=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || echo unknown)
AGDA_V=$(agda --version 2>/dev/null | head -1 || echo absent)
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk '{printf "%s\\n", $0}' ; }
row() { printf '{"organ":"pratikara","kala":"%s","tree":"%s","toolchain":"%s","module":"%s","dosa":"%s","pratikara":"%s","detail":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$TREE" "$(esc "$AGDA_V")" "$1" "$2" "$3" "$(esc "$4")" >> "$LEDGER"; }

add_import () { # file importline
  grep -qF "$2" "$1" && return 1
  awk -v L="$2" '/^open import /{last=NR}{a[NR]=$0}
    END{ if(last==""){for(i=1;i<=NR;i++){print a[i]; if(a[i]~/^module .* where$/)print L}}
         else       {for(i=1;i<=NR;i++){print a[i]; if(i==last)print L}} }' "$1" >"$1.pk" && mv "$1.pk" "$1"
}

# Attempt a transformation for one refusal.  Echo "MUT <what>" if the file
# was changed (re-gate), "ENV <what>" to retain untouched, "GROW <what>"
# when no rule yet covers it — a request to grow the table, to no one human.
attempt () { # file errtext
  f=$1 ; e=$2
  case "$e" in
    *"Failed to find source of module Cubical.Tactics"*|*solveℕ*)
      echo "ENV toolchain-skew: emitter targets the pinned solver, absent here; mathematics is not the defect" ; return ;;
    *"Not in scope"*"∘"*)        add_import "$f" "open import Cubical.Foundations.Function using (_∘_)" && { echo "MUT import _∘_"; return; } ;;
    *"Not in scope"*"×"*)        add_import "$f" "open import Cubical.Data.Sigma using (_×_ ; _,_)" && { echo "MUT import _×_"; return; } ;;
    *"Not in scope"*"totalSum"*) add_import "$f" "open import Cubical.Data.SumFin using (totalSum)" && { echo "MUT import totalSum"; return; } ;;
    *"Not in scope"*"funExt"*)   add_import "$f" "open import Cubical.Foundations.Prelude using (funExt)" && { echo "MUT import funExt"; return; } ;;
  esac
  # scope error where the kernel NAMES the fix: "did you mean 'Q.name'?"
  sug=$(printf '%s' "$e" | sed -n "s/.*did you mean '\\([^']*\\)'.*/\\1/p" | head -1)
  mis=$(printf '%s' "$e" | sed -n 's/^ *Not in scope:$//;s/^  *\([^ ]*\)$/\1/p' | head -1)
  if [ -n "$sug" ] && [ -n "$mis" ]; then
    sed -i "s/\\b$(printf '%s' "$mis" | sed 's/[.[\*^$/]/\\&/g')\\b/$(printf '%s' "$sug" | sed 's/[&/]/\\&/g')/g" "$f"
    echo "MUT scope-suggestion $mis→$sug" ; return
  fi
  # missing name in an existing using-list, kernel names it (pattern/ctor clash or plain absence)
  nm=$(printf '%s' "$e" | sed -n "s/.*pattern variable \\([A-Za-z0-9_]*\\) has the same name as the constructor.*/\\1/p" | head -1)
  if [ -n "$nm" ] && grep -q "Cubical.Data.Nat using (" "$f" && ! grep -q "Cubical.Data.Nat using ([^)]*\\b$nm\\b" "$f"; then
    sed -i "s/\\(Cubical.Data.Nat using (ℕ\\)/\\1 ; $nm/" "$f" ; echo "MUT name $nm-in-Nat" ; return
  fi
  # judgmental refl on a neutral transport → transportRefl.  Aggressive:
  # the gate rejects a wrong swap for free, so try it wherever refl sits
  # inside a ΣPathP the error points at.
  case "$e" in
    *"transp (λ i"*"i0"*"!="*)
      if grep -q ", refl)" "$f"; then
        sed -i '0,/, refl)/s//, transportRefl _)/' "$f"
        add_import "$f" "open import Cubical.Foundations.Prelude using (transportRefl)" >/dev/null 2>&1 || true
        echo "MUT refl→transportRefl" ; return
      fi ;;
  esac
  # universe generalizable variable unsupported: add an explicit binder to
  # the signature the kernel named, at its line.
  case "$e" in
    *"Generalizable variable"*"is not supported here"*)
      v=$(printf '%s' "$e" | sed -n "s/.*Generalizable variable [^ ]*\\.\\([^ ]*\\) is not supported.*/\\1/p" | head -1)
      ln=$(printf '%s' "$e" | sed -n 's#.*/\([A-Za-z0-9_]*\)\.agda:\([0-9]*\),.*#\2#p' | head -1)
      if [ -n "$ln" ]; then
        # insert explicit level binders on the declaration head at that line
        sed -i "${ln}s/^\\([A-Za-z0-9_'-]*\\) :/\\1 : {ℓ ℓ' ℓ'' : Level} →/" "$f" 2>/dev/null || true
        add_import "$f" "open import Agda.Primitive using (Level)" >/dev/null 2>&1 || true
        echo "MUT universe-binder ${v:-ℓ}@${ln}" ; return
      fi ;;
  esac
  echo "GROW $(printf '%s' "$e" | head -1)"
}

landed=0 ; muts=0 ; grows=0 ; envs=0
for f in "$PEND"/*.agda ; do
  [ -e "$f" ] || continue
  base=$(basename "$f" .agda) ; pass=0
  while : ; do
    pass=$((pass+1))
    OUT=$( { cp "$f" "$FC/$base.agda" && cd "$FC" && agda --library-file="$LIBS" -i . "$base.agda" 2>&1 ; } ) ; rc=$?
    if [ $rc -eq 0 ]; then
      printf '\n-- [pratikara] landed after %s repair pass(es)\nimport %s\n' "$((pass-1))" "$base" >> "$FC/Everything.agda"
      row "$base" none landed "green after $((pass-1)) repair pass(es)" ; rm -f "$f"
      ( cd "$ROOT" && git add "formal/cubical/$base.agda" formal/cubical/Everything.agda machine/avatarana.ledger.jsonl \
        && git commit -q -m "pratikara: $base landed after $((pass-1)) auto-repair pass(es); the gate adjudicated" && ./sync >/dev/null 2>&1 )
      landed=$((landed+1)) ; break
    fi
    rm -f "$FC/$base.agda"
    [ $pass -gt "$MAXPASS" ] && { row "$base" repair-budget grow "$MAXPASS passes exhausted; GROW a rule for: $(printf '%s' "$OUT" | head -3)"; grows=$((grows+1)); break; }
    v=$(attempt "$f" "$OUT")
    case "$v" in
      MUT\ *)  row "$base" "${v#MUT }" applied "re-gating" ; muts=$((muts+1)) ;;
      ENV\ *)  row "$base" "${v#ENV }" retain "$(printf '%s' "$OUT" | head -4)" ; envs=$((envs+1)) ; break ;;
      GROW\ *) row "$base" unencoded grow "table must acquire this class (no mind): ${v#GROW }" ; grows=$((grows+1)) ; break ;;
    esac
  done
done
echo "प्रतिकारः: $landed landed, $muts transformation(s), $grows rule(s)-to-grow, $envs retained-as-environment  (pending: $(ls "$PEND"/*.agda 2>/dev/null | wc -l | tr -d ' '))"
