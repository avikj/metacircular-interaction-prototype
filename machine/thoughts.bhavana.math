candidate	nrm2(bcx2(x,y,s(0),0),bcy(x,y,s(0),0))	nrm2(x,y)
candidate	bcx1(x,y,z,u)	bcx1(z,u,x,y)
candidate	bcx2(x,y,z,u)	bcx2(z,u,x,y)
candidate	bcy(x,y,z,u)	bcy(z,u,x,y)
candidate	bcx2(x,y,z,u)	+(bcx1(x,y,z,u),*(y,u))
candidate	bcx1(x,0,z,0)	*(x,z)
candidate	bcx2(x,0,z,0)	*(x,z)
candidate	bcx1(x,y,z,0)	*(x,z)
candidate	bcx2(x,y,z,0)	*(x,z)
candidate	bcy(x,y,z,0)	*(z,y)
candidate	bcy(x,0,z,0)	0
candidate	bcy(x,y,x,y)	*(s(s(0)),*(x,y))
candidate	nrm2(x,0)	*(x,x)
candidate	nrm2(0,y)	0
