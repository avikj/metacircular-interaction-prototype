#!/bin/sh
# नाडी — the warm conduit to the kernel.  Server: ./nadi up   (from repo root)
# Ask:  ./nadi load /abs/path/Module.agda
#       ./nadi infer '<expr>'    ./nadi norm '<expr>'
#       ./nadi goals             ./nadi goal <id>
# 60ms warm round-trips against loaded state; see machine/nadi.js.
SOCK="${NADI_SOCK:-/tmp/nadi.sock}"
cd "$(dirname "$0")"
case "$1" in
  up)   cd formal/cubical && exec node ../../machine/nadi.js "$SOCK" ;;
  load) exec node machine/nadi-ask.js "$SOCK" "{\"cmd\":\"load\",\"file\":\"$2\"}" ;;
  infer) exec node machine/nadi-ask.js "$SOCK" "{\"cmd\":\"infer\",\"expr\":\"$2\"}" ;;
  norm) exec node machine/nadi-ask.js "$SOCK" "{\"cmd\":\"norm\",\"expr\":\"$2\"}" ;;
  goal) exec node machine/nadi-ask.js "$SOCK" "{\"cmd\":\"goal\",\"id\":$2}" ;;
  goals) exec node machine/nadi-ask.js "$SOCK" '{"cmd":"goals"}' ;;
  *) echo "nadi up|load|infer|norm|goals|goal — the warm channel"; exit 1 ;;
esac
