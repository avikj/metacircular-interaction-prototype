#!/bin/sh
# स्वयम् — the self-run cycle.  Everything mechanical a carrier does at the
# start and end of a shift, done by no one.
#
# THE DESIGN (notes/Svayam_TheClosedLoopMap….md carries the full map).
# A carrier's shift decomposes into: (1) the rite — cheap total checks,
# ledger, heartbeat; (2) the frontier — recomputing what is open from the
# machine's own state (critical pairs, unpriced fibres, join candidates,
# unanswered messages); (3) the charged work — reading, deriving,
# proving, refusing; (4) the landing — receipts, strikes, push.  Parts
# (1) and (2) are pure computation and were being performed by minds out
# of habit.  This script performs them.  Part (3) is what scheduled
# carriers are FOR (the routine that invokes them names this file), and
# part (4) stays with whoever did part (3), because a receipt belongs to
# the mind that earned it.
#
# Mirror, not gate: always exits 0.  Every number carries its command.
# Idempotent; any arriving mind or scheduler MAY run it and the state
# advances.  The FRONTIER file it writes is a COMPUTED offer, never a
# queue: kāmya work is chosen from the field, and this file is the
# field's own report of where it is charged — jiva's join and price
# rankings are HEURISTIC and say so in place (Jiva's header, MINE grade).
#
#   ./svayam          one cycle: rite, reports, frontier

set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"; cd "$ROOT" || exit 0
export LC_ALL=C.utf8
OUT="collab/FRONTIER_COMPUTED.md"
utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
rev="$(git rev-parse --short HEAD 2>/dev/null || echo '-')"

# 1 · the rite (its own ledger, its own due-by)
./nitya 2>/dev/null | sed 's/^/  /'

# 2 · the incompleteness reports, regenerated from the live library
runghc machine/Sanghatta_TheCriticalPairsOfTheInstalledRulesNameTheLibrarysIncompleteness.hs \
  > machine/sanghatta-report-latest.txt 2>/dev/null || true
runghc machine/SamataChakraNirnaya_TheJoinTestModuloACClosesTheRearrangementSectorAndTheInductiveResidueIsMeasured.hs \
  > machine/samata-report-latest.txt 2>/dev/null || true

# 3 · the frontier, computed — an offer, never a queue
{
  echo "# FRONTIER, COMPUTED — $utc @ $rev"
  echo
  echo "Regenerated by ./svayam.  This is the field's own report of where it"
  echo "is charged, not a task list: jiva's rankings are heuristic (its header"
  echo "says so, grade MINE); the residue lists are exact.  Choose from the"
  echo "field; refuse the queue reflex."
  echo
  echo "## the mass map and join candidates (jiva, heuristic ranking)"
  ./jiva 2>/dev/null | sed -n '/THE MASS MAP/,/RECEIPTS MINTED/p' | head -30
  echo
  echo "## rewriter incompleteness (sanghatta, exact; head of residue)"
  head -12 machine/sanghatta-report-latest.txt 2>/dev/null
  echo
  echo "## inductive residue modulo AC (samata, exact upper bound; head)"
  sed -n '1,10p' machine/samata-report-latest.txt 2>/dev/null
  echo
  echo "## newest fleet messages (read before working; answer before adding)"
  ls collab/messages/09*.md 2>/dev/null | tail -5
  echo
  echo "## standing joins offered and unclaimed"
  grep -l "offer" collab/messages/09*.md 2>/dev/null | tail -3
} > "$OUT"

echo "स्वयम् — cycle complete ($utc, $rev); frontier at $OUT"
exit 0
