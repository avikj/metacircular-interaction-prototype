#!/bin/sh
# शेष-सूची — the remainder-index: every fence in the corpus, as data.
#
# THE LOOP THIS CLOSES (owner directive 2026-08-24: anything a mind does
# manually, ask why the organism doesn't, and close it).  A carrier found
# Vyapti's "no weakened converse is offered" by READING and hand-built the
# witness (Agamya_…).  But the corpus's fences — "left open", "owed",
# "not done", "named rather than gestured at" — ARE its conjecture queue,
# written in prose where only a mind trips over them.  Saṅghaṭṭa computes
# the rewriter's incompleteness; this computes the headers'.  Mirror, not
# gate: always exit 0.  Every number carries its command (PRASAVA).
#
# TERM.  शेष-सूची, "index of remainders" — ordinary Sanskrit, compound
# built here, no text claimed (CLAUDE.md naming rule, note 2).
#
#   ./sesa            regenerate notes/sesa-suci.tsv and print the count
#
OUT="notes/sesa-suci.tsv"
cd "$(dirname "$0")" || exit 0
export LC_ALL=C.utf8
PAT='left open|is owed|are owed|owed at|NOT DONE|not done here|not attempted|no weakened converse|named rather than gestured|named, not encoded|not settled here|remains open|still open|the honest next|Named, not done'

# ─────────────────────────────────────────────────────────────────────────
# TWO CORRECTIONS, 2026-08-24, by a second lane.  Both measured, both from
# this organ's own claims.  Nothing removed; the original PAT and its count
# are unchanged and still the first number printed.
#
# 1.  THE OUTPUT HEADER CLAIMED A TREE THE COMMAND DID NOT SCAN.  It said
#     "over formal machine punaragamana notes/*.md headers", and the grep
#     listed neither `notes` nor `--include='*.md'`.  Measured before this
#     change: PAT matched 306 lines in notes/*.md and the index carried 0
#     of them -- MORE MISSING THAN THE 237 IT REPORTED.  `notes` is added
#     below, which is what the header always said.  (The prose fences in
#     notes/ are the same object as the ones in headers: a debt its author
#     graded and nobody indexed.)
#
# 2.  THE COUNT IS A LOWER BOUND AND DID NOT SAY SO.  PAT is fifteen
#     phrasings chosen by hand, so a fence worded any other way is
#     invisible -- exactly `BOOK_INDEX.md`'s situation one organ over, where
#     the ratio is a filename-substring bound and the file states it
#     ("by BODY the same keys placed 310 of 926 rather than 186").  WIDE
#     below is an ordinary second phrasing set.  It is NOT merged into the
#     index: widening a hand-built pattern trades a known undercount for an
#     unknown false-positive rate, and PRASAVA forbids reporting a number
#     whose command nobody ran.  It is printed as the bound, with its own
#     command, so the frontier can never be read as complete.
# ─────────────────────────────────────────────────────────────────────────
WIDE='is open$|open question|open problem|conjectur|not proved|unproved|unproven|no proof|TODO|FIXME|we do not (yet )?(know|have)|cannot (yet )?be|is not established|not yet (proved|shown|done|built|wired)|remains to be|future work|would need|is missing'
SRC="formal/cubical formal/pairfield punaragamana/src machine notes"
INC="--include=*.agda --include=*.hs --include=*.lean --include=*.md"

{
  printf '# regenerated by ./sesa; grep -rniE over formal punaragamana/src machine notes\n'
  printf '# LOWER BOUND: 15 hand-chosen phrasings.  ./sesa prints what a second\n'
  printf '# phrasing set finds and this index does not.  Absence here is not absence.\n'
  printf '# file\tline\tfence\n'
  # shellcheck disable=SC2086
  grep -rniE "$PAT" $SRC $INC 2>/dev/null \
    | sed 's/:\([0-9]*\):/\t\1\t/' | sed 's/^[[:space:]]*//'
} > "$OUT"
N=$(($(wc -l < "$OUT") - 4))
# shellcheck disable=SC2086
MISSED=$(grep -rniE "$WIDE" $SRC $INC 2>/dev/null | grep -viE "$PAT" | wc -l)

echo "शेष-सूची — $N fence lines indexed → $OUT"
echo "    \$ grep -rniE <PAT> formal/cubical formal/pairfield punaragamana/src machine notes | wc -l"
echo "  bound: $MISSED more line(s) matched a SECOND phrasing set and are NOT indexed."
echo "    \$ grep -rniE <WIDE> <same tree> | grep -viE <PAT> | wc -l"
echo "  (an entry here is an OFFER, not a queue: a fence is a conjecture"
echo "   its own author graded; choose from the field.  The bound is why an"
echo "   empty grep is not a closed frontier.)"
exit 0
