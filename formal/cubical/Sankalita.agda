{-# OPTIONS --cubical --safe #-}

------------------------------------------------------------------------
-- सङ्कलितम् — आर्यभटस्य श्रेढी-योगः (आर्यभटीय-गणितपादः, ४९९ ई.) ।
--   एकोत्तर-सङ्कलितम् : 2·∑n = n(n+1) (भागं विना, योगेन कथितम्) ।
--
-- सूचना (honest): घन-सङ्कलितम् (∑k³ = (∑k)², आर्यभटस्य रत्नम्) अत्र न सिद्धम् —
-- ℕ-वलय-साधकः suc-रूपं न गृह्णाति, हस्त-साधनं च दीर्घम् ; अग्रिमं PROVE-कार्यम् ।
-- (the cube-sum gem ∑k³=(∑k)² is NOT formalized here — the ℕ solver chokes
-- on suc-headed forms and the hand proof is long; left as a future item,
-- not faked.  Only 2·∑k = n(n+1) is proved.)
------------------------------------------------------------------------

module Sankalita where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat
  using (ℕ ; zero ; suc ; _+_ ; _·_ ; ·-suc ; ·-comm ; +-assoc)
open import Cubical.Tactics.NatSolver.Reflection using (solve)

------------------------------------------------------------------------
-- सङ्कलितम् (∑ 1..n) ।
------------------------------------------------------------------------

∑ : ℕ → ℕ
∑ zero    = zero
∑ (suc n) = suc n + ∑ n

------------------------------------------------------------------------
-- द्विगुण-सङ्कलितम् — 2·∑n = n(n+1) ।
------------------------------------------------------------------------

private
  -- pure +-rearrangement (no suc → the ℕ solver handles it)
  पुनर्विन्यास : (a s : ℕ) → (a + s) + (a + s) ≡ (a + a) + (s + s)
  पुनर्विन्यास = solve

  -- (n+1 + n+1) + n(n+1) ≡ (n+1)(n+2) — by hand (suc-headed) via ·-suc
  समापन : (n : ℕ) → (suc n + suc n) + n · suc n ≡ suc n · suc (suc n)
  समापन n = sym
    ( ·-suc (suc n) (suc n)
    ∙ cong (suc n +_) (·-suc (suc n) n)
    ∙ cong (λ z → suc n + (suc n + z)) (·-comm (suc n) n)
    ∙ +-assoc (suc n) (suc n) (n · suc n) )

द्विगुण-सङ्कलितम् : (n : ℕ) → ∑ n + ∑ n ≡ n · suc n
द्विगुण-सङ्कलितम् zero    = refl
द्विगुण-सङ्कलितम् (suc n) =
    पुनर्विन्यास (suc n) (∑ n)
  ∙ cong ((suc n + suc n) +_) (द्विगुण-सङ्कलितम् n)
  ∙ समापन n

------------------------------------------------------------------------
-- उदाहरणम् — ∑1..4 = 10, 2·∑4 = 20 = 4·5 (refl-सिद्धम्) ।
------------------------------------------------------------------------

उदाहरणम्-योग : ∑ 4 ≡ 10
उदाहरणम्-योग = refl

उदाहरणम्-द्विगुण : ∑ 4 + ∑ 4 ≡ 4 · 5
उदाहरणम्-द्विगुण = द्विगुण-सङ्कलितम् 4
