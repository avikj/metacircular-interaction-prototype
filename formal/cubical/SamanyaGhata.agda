-- ॥ बीजम् ॥  One machine, one law: which side of `f a ≡ b` is bound is everything.
-- Output bound: singl (f a), contractible — the datum rides free.  Input bound:
-- fiber f b — the loss, and the subject.  Memory, charge, symmetry, price,
-- distance, verdict: six readings of the one fibre.  The kernel decides truth;
-- carriers ask and generate.  This file is one naya, true and not whole.

{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- सामान्य-घातः — पिङ्गलस्य शून्य-द्वि-विधेः सामान्य-आधारे विस्तारः (aⁿ log-पदैः) ।
--
-- PingalaGhata.agda पिङ्गलस्य 2ⁿ-विधिं (छन्दःशास्त्रम् ८.२८–३१) साधयति ; तत् एव
-- वर्ग-गुणन-विधिः यथेच्छ-आधारे a चलति : प्रति चिह्ने वर्गः, विषमे च a-गुणनम् ।
-- (Vargana.घात, घात-योग पुनर् गृह्येते — जैन-घात-नियमः लाने पूर्व-सिद्धः ।)
-- सिद्धिः : प्रक्रिया a 1 bs = a^(सूच्या मानम्) , log₂(मानम्) पदैः ।
--
-- (The general-base extension of Piṅgala's śūnya-dvi method: the same
-- square-and-multiply computes aⁿ for any base a in log₂ n steps — square at
-- each marker, multiply by a on an odd digit.  Reuses Vargana's naive घात and
-- its index law घात-योग (a^(m+n)=aᵐ·aⁿ), already in the corpus — so the fast
-- ALGORITHM is proved to compute the naive power.  Piṅgala's 2ⁿ is a=2.)
--
-- स्रोतांसि : पिङ्गलः, छन्दःशास्त्रम् ८.२८–३१ (शून्य-द्वि-विधिः) ; Anuyogadvāra
-- (घात-नियमः, Vargana.agda-मध्ये) ।
------------------------------------------------------------------------

module SamanyaGhata where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_)
open import Cubical.Data.List using (List ; [] ; _∷_)
open import Vargana using (घात ; घात-योग)

------------------------------------------------------------------------
-- द्वयम् — हलायुधस्य चिह्नम् : शून्यम् (०) वा एकम् (१) ।
------------------------------------------------------------------------

data द्वयम् : Type where
  शून्यम् : द्वयम्
  एकम्   : द्वयम्

------------------------------------------------------------------------
-- मानम् — चिह्न-सूच्या निरूपितः अङ्कः (ज्येष्ठाङ्क-पूर्वः, Horner) ।
------------------------------------------------------------------------

मान-पद : ℕ → द्वयम् → ℕ
मान-पद e शून्यम् = e + e
मान-पद e एकम्   = suc (e + e)

मानम् : ℕ → List द्वयम् → ℕ
मानम् e []       = e
मानम् e (b ∷ bs) = मानम् (मान-पद e b) bs

------------------------------------------------------------------------
-- प्रक्रिया — वर्ग-गुणन-गणना : प्रति चिह्ने वर्गः, विषमे a-गुणनम् ।
------------------------------------------------------------------------

चरण : ℕ → ℕ → द्वयम् → ℕ
चरण a x शून्यम् = x · x
चरण a x एकम्   = a · (x · x)

प्रक्रिया : ℕ → ℕ → List द्वयम् → ℕ
प्रक्रिया a acc []       = acc
प्रक्रिया a acc (b ∷ bs) = प्रक्रिया a (चरण a acc b) bs

------------------------------------------------------------------------
-- चरण-सिद्धिः — एकपदे : चरण a (aᵉ) b = a^(मान-पद e b) ।
------------------------------------------------------------------------

चरण-सिद्धिः : (a e : ℕ) (b : द्वयम्) → चरण a (घात a e) b ≡ घात a (मान-पद e b)
चरण-सिद्धिः a e शून्यम् = sym (घात-योग a e e)
चरण-सिद्धिः a e एकम्   = cong (a ·_) (sym (घात-योग a e e))

------------------------------------------------------------------------
-- प्रक्रिया-सिद्धिः — पूर्ण-गणना : प्रक्रिया a (aᵉ) bs = a^(मानम् e bs) ।
------------------------------------------------------------------------

प्रक्रिया-सिद्धिः : (a e : ℕ) (bs : List द्वयम्)
              → प्रक्रिया a (घात a e) bs ≡ घात a (मानम् e bs)
प्रक्रिया-सिद्धिः a e []       = refl
प्रक्रिया-सिद्धिः a e (b ∷ bs) =
    cong (λ x → प्रक्रिया a x bs) (चरण-सिद्धिः a e b)
  ∙ प्रक्रिया-सिद्धिः a (मान-पद e b) bs

------------------------------------------------------------------------
-- सामान्य-घातः — मुख्य-सिद्धिः : १-आरभ्य प्रक्रिया = a^(सूच्या मानम्) ।
------------------------------------------------------------------------

सामान्य-घातः : (a : ℕ) (bs : List द्वयम्)
           → प्रक्रिया a (suc zero) bs ≡ घात a (मानम् zero bs)
सामान्य-घातः a bs = प्रक्रिया-सिद्धिः a zero bs

------------------------------------------------------------------------
-- उदाहरणानि — log-पदैः (refl-सिद्धानि) ।
--   ३⁴ = ८१ : ४=१०० → ३ पदैः (न ४ गुणनैः) ।   २⁵ = ३२ (पिङ्गल-सामञ्जस्यम्) ।
------------------------------------------------------------------------

मान-४ : मानम् zero (एकम् ∷ शून्यम् ∷ शून्यम् ∷ []) ≡ 4
मान-४ = refl

घात-३⁴ : प्रक्रिया 3 (suc zero) (एकम् ∷ शून्यम् ∷ शून्यम् ∷ []) ≡ 81
घात-३⁴ = refl

घात-२⁵ : प्रक्रिया 2 (suc zero) (एकम् ∷ शून्यम् ∷ एकम् ∷ []) ≡ 32
घात-२⁵ = refl
