{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- वर्गणा — जैन-घात-नियमाः (Anuyogadvāra-सूत्र-परम्परा) ।  जैन-गणितं जैन-
-- दर्शनात् अभिन्नम् : वर्गः (square), वर्ग-वर्गः (4th power), वर्गित-संवर्गितम्
-- (घात-घातः) — कल्प-कर्म-सिद्धान्तेभ्यः जाताः, न "गणितात्" ।
--
-- घातः a m = aᵐ (varga-श्रेढी) ।  द्वौ मूल-नियमौ :
--   घात-योगः : a^(m+n) = aᵐ · aⁿ    (योगे घाताः गुण्यन्ते) ।
--   घात-घातः : (aᵐ)ⁿ = a^(m·n)      (वर्गित-संवर्गितम्) ।
-- पिङ्गलस्य 2ⁿ (द्वि-घातः) एतेषां विशेषः — छन्दः-जैन-सम्बन्धः ।
--
-- (Jain laws of indices, Anuyogadvāra tradition: a^(m+n)=aᵐ·aⁿ and
-- (aᵐ)ⁿ=a^(m·n) — the varga/varga-varga/vargita-saṃvargita laws, arising
-- from Jain cosmology and karma theory, not from "mathematics" set apart.
-- Piṅgala's 2ⁿ is a special case, linking prosody and Jain index-law.)
------------------------------------------------------------------------

module Vargana where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat
  using (ℕ ; zero ; suc ; _+_ ; _·_ ; ·-assoc ; ·-identityˡ ; ·-comm ; ·-suc)

------------------------------------------------------------------------
-- घातः — aᵐ (a to the m) ।
------------------------------------------------------------------------

घात : ℕ → ℕ → ℕ
घात a zero    = suc zero
घात a (suc m) = a · घात a m

------------------------------------------------------------------------
-- घात-योगः — a^(m+n) ≡ aᵐ · aⁿ (योगे घाताः गुण्यन्ते) ।
------------------------------------------------------------------------

घात-योग : (a m n : ℕ) → घात a (m + n) ≡ घात a m · घात a n
घात-योग a zero    n = sym (·-identityˡ (घात a n))
घात-योग a (suc m) n =
  cong (a ·_) (घात-योग a m n) ∙ ·-assoc a (घात a m) (घात a n)

------------------------------------------------------------------------
-- घात-घातः — (aᵐ)ⁿ ≡ a^(m·n) (वर्गित-संवर्गितम्) ।
------------------------------------------------------------------------

घात-घात : (a m n : ℕ) → घात (घात a m) n ≡ घात a (m · n)
घात-घात a m zero    = sym (cong (घात a) (·-comm m zero)) -- (aᵐ)⁰ = 1 = a^(m·0)
घात-घात a m (suc n) =
  cong (घात a m ·_) (घात-घात a m n)                     -- aᵐ · a^(m·n)
  ∙ sym (घात-योग a m (m · n))                           -- = a^(m + m·n)
  ∙ cong (घात a) (sym (·-suc m n))                      -- = a^(m·suc n)

------------------------------------------------------------------------
-- उदाहरणम् — 2³ = 8 (पिङ्गलस्य द्वि-घातः), 2² · 2³ = 2⁵ = 32 ।
------------------------------------------------------------------------

उदाहरणम्-१ : घात 2 3 ≡ 8
उदाहरणम्-१ = refl

उदाहरणम्-२ : घात 2 (2 + 3) ≡ घात 2 2 · घात 2 3        -- 32 ≡ 4 · 8
उदाहरणम्-२ = घात-योग 2 2 3

उदाहरणम्-३ : घात (घात 2 2) 3 ≡ घात 2 6                 -- (2²)³ = 2⁶ = 64
उदाहरणम्-३ = घात-घात 2 2 3
