{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- समास-न्यूनम् — यथेच्छ-अंश-गणे लघुतम-अंशात् अधः शून्यम् (सामान्य-न्यून-नियमः) ।
--
-- यदि अंश-गणस्य (ps) प्रत्येकः अंशः m-मानात् बृहत्तरः (suc n ≤ p सर्वेषु p ∈ ps,
-- अर्थात् प्रति अंश-मानम् suc p > suc n), तर्हि m = suc n न रच्यते : कोऽपि अंशः
-- न योग्यः ।  अतः length (सर्गः ps (suc n)) ≡ 0 ।  एतत् न्यून-शून्यस्य (एक-अंश)
-- द्वि-न्यून-शून्यस्य (द्वि-अंश) च यथेच्छ-कार्डिनल्-रूपम् — समास-आवृत्त्या
-- (योग-रूपेण) प्रति-अंशं रिक्त-अपाकरणेन शून्यीकृत्य ।
--
-- (Below the smallest part, over an ARBITRARY part-set: if every part of ps
--  exceeds m (suc n ≤ p for all p, i.e. each part-size suc p > suc n), then m
--  cannot be built — no part fits — so length(सर्गः ps (suc n)) ≡ 0.  The
--  arbitrary-cardinality form of न्यून-शून्यम् (single part) and
--  द्वि-न्यून-शून्यम् (two parts): the fold समास-आवृत्तिः zeroed part-by-part
--  through रिक्त-अपाकरणम्.)
--
-- स्रोतांसि : नारायणपण्डितः, गणितकौमुदी, अङ्कपाशः (१३५६) ; विरहाङ्कः (मेरुः) ।
------------------------------------------------------------------------

module SamasaNyuna where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
open import Cubical.Data.Nat.Order using (_≤_ ; suc-≤-suc)
open import Cubical.Data.Unit using (Unit ; tt)
open import Cubical.Data.Sigma using (_×_ ; _,_)
open import Cubical.Data.List using (List ; [] ; _∷_ ; map ; length)
open import SamasaMeruN
  using (सर्गः ; समास-आवृत्तिः ; योगः ; अपाकरणम् ; रिक्त-अपाकरणम्)

------------------------------------------------------------------------
-- सर्वे-बृहत् — अंश-गणस्य प्रत्येकः अंशः m = suc n-मानात् बृहत्तरः (न योग्यः) ।
------------------------------------------------------------------------

सर्वे-बृहत् : List ℕ → ℕ → Type
सर्वे-बृहत् []       n = Unit
सर्वे-बृहत् (p ∷ ps) n = (suc n ≤ p) × सर्वे-बृहत् ps n

------------------------------------------------------------------------
-- योग-शून्यम् — समास-आवृत्तेः योग-पदम् शून्यम् : प्रति-अंश-भागः रिक्तः ।
-- (अंश-सूची qs-मध्ये आगमनम् ; अपाकरणम् ps पूर्ण-गणे स्थिरम्, अर्थतः अनपेक्षम् ।)
------------------------------------------------------------------------

योग-शून्यम् : (ps : List ℕ) (n : ℕ) (qs : List ℕ) → सर्वे-बृहत् qs n
           → योगः ps (map (λ p → length (अपाकरणम् ps n (suc n) (suc p))) qs) ≡ 0
योग-शून्यम् ps n []        _        = refl
योग-शून्यम् ps n (p ∷ qs) (le , hs) =
  cong₂ _+_
    (cong length (रिक्त-अपाकरणम् ps n (suc n) (suc p) (suc-≤-suc le)))
    (योग-शून्यम् ps n qs hs)

------------------------------------------------------------------------
-- न्यून-शून्यम्-सामान्यम् — मुख्य-फलम् : सर्वे-बृहत् ⟹ मानं शून्यम् ।
------------------------------------------------------------------------

न्यून-शून्यम्-सामान्यम् : (ps : List ℕ) (n : ℕ) → सर्वे-बृहत् ps n
                     → length (सर्गः ps (suc n)) ≡ 0
न्यून-शून्यम्-सामान्यम् ps n h = समास-आवृत्तिः ps n ∙ योग-शून्यम् ps n ps h

------------------------------------------------------------------------
-- उदाहरणम् — {३,४,५}-गणे (ps = 2 ∷ 3 ∷ 4 ∷ []) m=2 शून्यम् (सर्वे अंशाः > 2) ।
------------------------------------------------------------------------

न्यून-३४५ : length (सर्गः (2 ∷ 3 ∷ 4 ∷ []) 2) ≡ 0
न्यून-३४५ = न्यून-शून्यम्-सामान्यम् (2 ∷ 3 ∷ 4 ∷ []) 1
             ((0 , refl) , (1 , refl) , (2 , refl) , tt)
