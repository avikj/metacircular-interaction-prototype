{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- मात्रामेरुः — विरहाङ्कस्य छन्दो-गणना (छन्दःशास्त्र-परम्परा, ~७०० ई.) ।
-- n-मात्राणां छन्दसां सङ्ख्या = M(n) ; M(n+2) = M(n+1) + M(n) — एषा एव
-- "फिबोनाची"-श्रेढी, पञ्च-शताब्दीभिः पूर्वम् (लिओनार्दो १२०२) ।  पिङ्गलः,
-- विरहाङ्कः, गोपालः, हेमचन्द्रः — सर्वे एताम् अजानन् ।
--
-- अत्र गणना प्रत्यक्ष-प्रस्तारस्य दैर्घ्येण सिध्यते (न केवलं पुनरावृत्ति-कल्पनया) :
-- सर्व n = n-मात्राणां सर्वच्छन्दांसि ; प्रथमाक्षरे लघु (१) वा गुरु (२) इति
-- विभागेन आवृत्तिः — एष एव विरहाङ्कस्य हेतुः ।
--
-- (Virahāṅka's metre-count: the number of metrical patterns of total weight
-- n is M(n), and M(n+2) = M(n+1) + M(n) — the "Fibonacci" sequence, five
-- centuries before Leonardo (1202).  Proved here as the LENGTH-recurrence of
-- the actual enumeration सर्व, split on whether the first syllable is a
-- लघु (1 mātrā) or a गुरु (2) — which is exactly Virahāṅka's reason.)
--
-- सूचना : "सर्व n" इति सम्यक् n-मात्रम् — रचनया स्पष्टम् (प्रत्येकं प्रक्षेपः
-- यथोचितां मात्राम् आदधाति) ; पूर्ण-साधुता (सौन्दर्यं-पूर्णता उभे) अग्रिमं
-- PROVE-कार्यम् ।  गणना-आवृत्तिः तु अत्र सिद्धा ।  (weight-correctness of सर्व
-- is evident by construction; full soundness+completeness is the next tooth.
-- The count recurrence itself is proved here.)
------------------------------------------------------------------------

module Matramerus where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
open import Cubical.Data.List using (List ; [] ; _∷_ ; _++_ ; map ; length)
open import Cubical.Data.List.Properties using (length-map)
open import Pingala using (अक्षर ; लघु ; गुरु ; छन्दस्)

------------------------------------------------------------------------
-- मात्रा — छन्दसः कुल-मात्रा (लघु = १, गुरु = २) ।
------------------------------------------------------------------------

मात्रा : छन्दस् → ℕ
मात्रा []          = zero
मात्रा (लघु ∷ ds)  = suc (मात्रा ds)
मात्रा (गुरु ∷ ds) = suc (suc (मात्रा ds))

------------------------------------------------------------------------
-- सर्व — n-मात्राणां सर्वच्छन्दांसि (Virahāṅka's split-enumeration) ।
--   ० → रिक्तम् एकम् ; १ → लघु एकम् ;
--   n+2 → (लघु प्रक्षिप्य n+1-भ्यः) ++ (गुरु प्रक्षिप्य n-भ्यः) ।
------------------------------------------------------------------------

सर्व : ℕ → List छन्दस्
सर्व zero          = ([]) ∷ []
सर्व (suc zero)    = (लघु ∷ []) ∷ []
सर्व (suc (suc n)) = map (लघु ∷_) (सर्व (suc n)) ++ map (गुरु ∷_) (सर्व n)

------------------------------------------------------------------------
-- length-++ — दैर्घ्यं योगे (स्वयं सिद्धम्, ग्रन्थालये नास्ति) ।
------------------------------------------------------------------------

length-++ : {A : Type} (xs ys : List A) → length (xs ++ ys) ≡ length xs + length ys
length-++ []       ys = refl
length-++ (x ∷ xs) ys = cong suc (length-++ xs ys)

------------------------------------------------------------------------
-- मात्रामेरुः — विरहाङ्कस्य आवृत्तिः : n+2-मात्राणां सङ्ख्या = (n+1)-सङ्ख्या
-- + n-सङ्ख्या ।  प्रस्तारस्य दैर्घ्येण सिद्धा ।
------------------------------------------------------------------------

मात्रामेरु : (n : ℕ)
          → length (सर्व (suc (suc n)))
          ≡ length (सर्व (suc n)) + length (सर्व n)
मात्रामेरु n =
    length-++ (map (लघु ∷_) (सर्व (suc n))) (map (गुरु ∷_) (सर्व n))
  ∙ cong₂ _+_ (length-map (लघु ∷_) (सर्व (suc n)))
              (length-map (गुरु ∷_) (सर्व n))

------------------------------------------------------------------------
-- उदाहरणम् — मात्रामेरुः = १,१,२,३,५,८,१३,… (refl-सिद्धम्) ।
------------------------------------------------------------------------

उदाहरणम्-४ : length (सर्व 4) ≡ 5
उदाहरणम्-४ = refl

उदाहरणम्-५ : length (सर्व 5) ≡ 8
उदाहरणम्-५ = refl

उदाहरणम्-६ : length (सर्व 6) ≡ 13
उदाहरणम्-६ = refl
