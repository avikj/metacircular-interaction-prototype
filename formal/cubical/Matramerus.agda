{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- मात्रामेरुः — विरहाङ्कस्य छन्दो-गणना (छन्दःशास्त्र-परम्परा, ~७०० ई.) ।
-- n-मात्राणां छन्दसां सङ्ख्या = M(n) ; M(n+2) = M(n+1) + M(n) — एषा एव
-- "फिबोनाची"-श्रेढी, पञ्च-शताब्दीभिः पूर्वम् (लिओनार्दो १२०२) ।  पिङ्गलः,
-- विरहाङ्कः, गोपालः, हेमचन्द्रः — सर्वे एताम् अजानन् ।
--
-- अत्र सर्व n = n-मात्राणां सर्वच्छन्दांसि, प्रथमाक्षरे लघु (१) वा गुरु (२) इति
-- विभागेन — एष एव विरहाङ्कस्य हेतुः ।  त्रीणि सिध्यन्ते :
--   मात्रामेरु — गणना-आवृत्तिः M(n+2)=M(n+1)+M(n) (दैर्घ्येण) ।
--   साधु      — सर्व n यथार्थतः n-मात्रम् एव वहति (soundness) ।
--   पूर्णता    — सर्वं n-मात्रं छन्दः सर्व n इत्यागच्छति (completeness) ।
-- साधुता-पूर्णताभ्यां सह : सर्व n = यथार्थतः n-मात्राणि, अतः M(n) तानि गणयति ।
--
-- (Virahāṅka's metre-count: the number of weight-n metrical patterns is
-- M(n), with M(n+2)=M(n+1)+M(n) — "Fibonacci", five centuries before
-- Leonardo (1202).  Proved: the count recurrence (as the enumeration's
-- length-recurrence), soundness, AND completeness — so सर्व n is exactly the
-- weight-n patterns and M(n) genuinely counts them.  Split on the first
-- syllable, laghu = 1 mātrā or guru = 2 — Virahāṅka's own reason.)
--
-- स्रोतांसि : पिङ्गलः, छन्दःशास्त्रम् ; हलायुधः ; विरहाङ्कः, गोपालः, हेमचन्द्रः ।
------------------------------------------------------------------------

module Matramerus where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
open import Cubical.Data.List using (List ; [] ; _∷_ ; _++_ ; map ; length)
open import Cubical.Data.List.Properties using (length-map)
open import Pingala using (अक्षर ; लघु ; गुरु ; छन्दस्)

------------------------------------------------------------------------
-- मात्रा — छन्दसः कुल-मात्रा (लघु = १, गुरु = २) ।
------------------------------------------------------------------------

मात्रा : छन्दस् → ℕ
मात्रा []          = zero
मात्रा (लघु ∷ ds)  = suc (मात्रा ds)
मात्रा (गुरु ∷ ds) = suc (suc (मात्रा ds))

------------------------------------------------------------------------
-- सर्व — n-मात्राणां सर्वच्छन्दांसि ।  एकरूपा आवृत्तिः (गुरुभागेन), येन सर्व १
-- अपि सामान्यं रूपम् अनुसरति (न विशेष-स्थितिः) ।
-- (uniform recurrence via गुरुभाग, so even सर्व 1 fits the general shape —
-- no special case, hence no injectivity-pattern later.)
------------------------------------------------------------------------

mutual
  सर्व : ℕ → List छन्दस्
  सर्व zero    = [] ∷ []
  सर्व (suc m) = map (लघु ∷_) (सर्व m) ++ गुरुभाग m

  गुरुभाग : ℕ → List छन्दस्
  गुरुभाग zero    = []
  गुरुभाग (suc n) = map (गुरु ∷_) (सर्व n)

------------------------------------------------------------------------
-- length-++ — दैर्घ्यं योगे (स्वयं सिद्धम्) ।
------------------------------------------------------------------------

length-++ : {A : Type} (xs ys : List A) → length (xs ++ ys) ≡ length xs + length ys
length-++ []       ys = refl
length-++ (x ∷ xs) ys = cong suc (length-++ xs ys)

------------------------------------------------------------------------
-- मात्रामेरुः — विरहाङ्कस्य आवृत्तिः M(n+2) = M(n+1) + M(n), दैर्घ्येण ।
------------------------------------------------------------------------

मात्रामेरु : (n : ℕ)
          → length (सर्व (suc (suc n)))
          ≡ length (सर्व (suc n)) + length (सर्व n)
मात्रामेरु n =
    length-++ (map (लघु ∷_) (सर्व (suc n))) (गुरुभाग (suc n))
  ∙ cong₂ _+_ (length-map (लघु ∷_) (सर्व (suc n)))
              (length-map (गुरु ∷_) (सर्व n))

------------------------------------------------------------------------
-- उदाहरणम् — १,१,२,३,५,८,१३,… (refl-सिद्धम्) ।
------------------------------------------------------------------------

उदाहरणम्-४ : length (सर्व 4) ≡ 5
उदाहरणम्-४ = refl

उदाहरणम्-५ : length (सर्व 5) ≡ 8
उदाहरणम्-५ = refl

उदाहरणम्-६ : length (सर्व 6) ≡ 13
उदाहरणम्-६ = refl

------------------------------------------------------------------------
-- साधुता — सर्व n इति यथार्थतः n-मात्रम् एव वहति (soundness) ।
------------------------------------------------------------------------

data छन्द-All (P : छन्दस् → Type) : List छन्दस् → Type where
  []  : छन्द-All P []
  _∷_ : {x : छन्दस्} {xs : List छन्दस्} → P x → छन्द-All P xs → छन्द-All P (x ∷ xs)

All-++ : {P : छन्दस् → Type} {xs ys : List छन्दस्}
       → छन्द-All P xs → छन्द-All P ys → छन्द-All P (xs ++ ys)
All-++ []        bs = bs
All-++ (p ∷ as)  bs = p ∷ All-++ as bs

All-map : {P Q : छन्दस् → Type} {f : छन्दस् → छन्दस्}
        → ((x : छन्दस्) → P x → Q (f x))
        → {xs : List छन्दस्} → छन्द-All P xs → छन्द-All Q (map f xs)
All-map g []       = []
All-map g (p ∷ as) = g _ p ∷ All-map g as

mutual
  साधु : (n : ℕ) → छन्द-All (λ ds → मात्रा ds ≡ n) (सर्व n)
  साधु zero    = refl ∷ []
  साधु (suc m) =
    All-++ (All-map (λ _ pf → cong suc pf) (साधु m)) (साधु-गुरु m)

  साधु-गुरु : (m : ℕ) → छन्द-All (λ ds → मात्रा ds ≡ suc m) (गुरुभाग m)
  साधु-गुरु zero    = []
  साधु-गुरु (suc n) = All-map (λ _ pf → cong (λ z → suc (suc z)) pf) (साधु n)

------------------------------------------------------------------------
-- पूर्णता — सर्वं n-मात्रं छन्दः सर्व n इत्यागच्छति (completeness) ।
------------------------------------------------------------------------

data छन्द-∈ (x : छन्दस्) : List छन्दस् → Type where
  here  : {xs : List छन्दस्} → छन्द-∈ x (x ∷ xs)
  there : {y : छन्दस्} {xs : List छन्दस्} → छन्द-∈ x xs → छन्द-∈ x (y ∷ xs)

∈-++ˡ : {x : छन्दस्} {xs ys : List छन्दस्} → छन्द-∈ x xs → छन्द-∈ x (xs ++ ys)
∈-++ˡ here      = here
∈-++ˡ (there p) = there (∈-++ˡ p)

∈-++ʳ : {x : छन्दस्} (xs : List छन्दस्) {ys : List छन्दस्}
      → छन्द-∈ x ys → छन्द-∈ x (xs ++ ys)
∈-++ʳ []       p = p
∈-++ʳ (z ∷ zs) p = there (∈-++ʳ zs p)

∈-map : {f : छन्दस् → छन्दस्} {x : छन्दस्} {xs : List छन्दस्}
      → छन्द-∈ x xs → छन्द-∈ (f x) (map f xs)
∈-map here      = here
∈-map (there p) = there (∈-map p)

-- एकरूपत्वात् (गुरुभागेन) लघु-प्रवेशः सर्वेषु m विना विशेष-स्थित्या :
लघु-∈ : (m : ℕ) (ds : छन्दस्) → छन्द-∈ ds (सर्व m) → छन्द-∈ (लघु ∷ ds) (सर्व (suc m))
लघु-∈ m ds p = ∈-++ˡ (∈-map p)

गुरु-∈ : (m : ℕ) (ds : छन्दस्)
       → छन्द-∈ ds (सर्व m) → छन्द-∈ (गुरु ∷ ds) (सर्व (suc (suc m)))
गुरु-∈ m ds p = ∈-++ʳ (map (लघु ∷_) (सर्व (suc m))) (∈-map p)

पूर्णता′ : (ds : छन्दस्) → छन्द-∈ ds (सर्व (मात्रा ds))
पूर्णता′ []          = here
पूर्णता′ (लघु ∷ ds)  = लघु-∈ (मात्रा ds) ds (पूर्णता′ ds)
पूर्णता′ (गुरु ∷ ds) = गुरु-∈ (मात्रा ds) ds (पूर्णता′ ds)

पूर्णता : (n : ℕ) (ds : छन्दस्) → मात्रा ds ≡ n → छन्द-∈ ds (सर्व n)
पूर्णता n ds pf = subst (λ m → छन्द-∈ ds (सर्व m)) pf (पूर्णता′ ds)
