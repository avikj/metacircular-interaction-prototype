{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- नष्टोद्दिष्टम् — प्रस्तारः सारणी न, क्रिया । (नष्ट/उद्दिष्ट स्थान-पृथक्-छेदेषु ।)
--
-- पिङ्गलः (छन्दःशास्त्रम् ८.२४–२८) प्रस्तारं न स्थापयति ; द्वे क्रिये लिखति ।
-- नष्टम् — स्थानं दत्तं, रूपं लभ्यते : सङ्ख्यां द्विधा कुरु ; समा चेत् गुरुः,
-- विषमा चेत् एकम् आधाय द्विधा, लघुः ; यावत् शून्यम् ।  उद्दिष्टम् — प्रतिलोमम् ।
-- 2ⁿ रूपाणि, सारणी शून्या, log n कालः ।
--
-- अत्र किं नवीनम् ।  PingalaPrastara.agda पिङ्गलस्य द्वि-छेदं (radix 2) साधयति :
-- nasta/uddista परस्पर-प्रतिलोमौ, Vak n ≃ Fin (sankhya n) ।  तत् एक-छेदम् ।
-- यन्त्रस्य (machine/) अन्वेषण-आकाशाः द्वि-छेदाः न सन्ति — पर्यावरण-जालकम्
-- (bound+1)-छेदम्, पद-जननं स्थान-प्रति-भिन्न-छेदम् ।  तस्मात् अत्र नष्ट/उद्दिष्टे
-- छेद-सूच्यां (rs : List ℕ, प्रति स्थाने suc r अङ्काः) विस्तारिते, परस्पर-प्रतिलोमे
-- साधिते, सङ्ख्या च गुणनफलम् ।  एतत् एव Prastara_*.hs-मध्ये चलति ।
--
-- यत् पिङ्गलस्य न उच्यते — छेद-सूची पिङ्गलस्य नास्ति ; तस्य छेदः द्वौ एव ।
-- स्थान-प्रति-भिन्न-छेदः अस्य लेखस्य विस्तारः, न पिङ्गले आरोपितः ।  द्वि-छेदे
-- प्रत्यागमनम् अधः दर्शितम् (एकरूप-सङ्ख्या) ।
--
-- अपि च, ४३-सूत्रस्य द्वे क्रिये : मेरु-पङ्क्तिः पूर्व-पङ्क्त्या जन्यते (एका पङ्क्तिः
-- स्मर्तव्या, त्रिकोणः न), मात्रामेरुः युगलेन (द्वे पदे स्मर्तव्ये, सूची न) ।
--
-- स्रोतांसि : पिङ्गलः, छन्दःशास्त्रम् ८.२४–२८ (नष्टम्, उद्दिष्टम्, सङ्ख्या),
-- ८.३४–३५ (मेरुप्रस्तारः) ; हलायुधः, मृतसञ्जीवनी (१०म शतकम्) ;
-- विरहाङ्कः, वृत्तजातिसमुच्चयः (मात्रामेरु-आवृत्तिः) ।
------------------------------------------------------------------------

module NastaUddista_TheRankUnrankAlgebraTheMachineRunsOn where

open import Cubical.Foundations.Prelude
open import Cubical.Foundations.Isomorphism using (Iso)
open import Cubical.Data.Nat
  using (ℕ ; zero ; suc ; _+_ ; _·_)
open import Cubical.Data.Nat.Properties
  using (+-zero ; +-suc ; +-comm ; +-assoc ; ·-suc ; ·-comm ; ·-distribˡ
        ; 0≡m·0 ; isSetℕ)
open import Cubical.Data.Nat.Order
  using (_<_ ; _≤_ ; ≤0→≡0 ; pred-≤-pred ; <-asym ; splitℕ-<
        ; ≤-trans ; +induction ; +inductionBase ; +inductionStep)
open import Cubical.Data.Nat.Mod
  using (_mod_ ; mod< ; modIndBase ; modIndStep ; quotient_/_
        ; ≡remainder+quotient)
open import Cubical.Data.List using (List ; [] ; _∷_ ; length)
open import Cubical.Data.Sigma using (Σ-syntax ; _×_ ; _,_ ; fst ; snd ; ΣPathP)
open import Cubical.Data.Unit using (Unit ; tt ; isPropUnit)
open import Cubical.Data.Fin using (Fin ; toℕ ; toℕ-injective)
open import Cubical.Data.Sum using (_⊎_ ; inl ; inr)
open import Cubical.Data.Empty using () renaming (rec to ⊥rec)

open import PingalaPrastara using (sankhya ; meru ; matra)

open Iso

------------------------------------------------------------------------
-- §१  छेद-सूची — प्रति स्थाने कति अङ्काः ।
--
-- rs : List ℕ ; स्थाने r इति लिखिते suc r अङ्काः (०…r) ।  suc-रूपेण
-- शून्य-छेदः असम्भवः, अतः पृथक् सिद्धिः न आवश्यका ।
-- पिङ्गले सर्वत्र r = 1 (लघु, गुरु) ।
------------------------------------------------------------------------

अङ्कस्थान : List ℕ → Type
अङ्कस्थान []       = Unit
अङ्कस्थान (r ∷ rs) = Fin (suc r) × अङ्कस्थान rs

-- सङ्ख्या-प्रत्ययः : कति रूपाणि ।  गुणनफलम्, न गणना ।
सङ्ख्या : List ℕ → ℕ
सङ्ख्या []       = 1
सङ्ख्या (r ∷ rs) = suc r · सङ्ख्या rs

------------------------------------------------------------------------
-- §२  उद्दिष्टम् — रूपं दत्तं, स्थानं लभ्यते ।
--
-- पिङ्गलवत् आदि-स्थानम् अल्प-मूल्यम् (छेदनं तत्रैव आरभते) ।
------------------------------------------------------------------------

उद्दिष्ट : (rs : List ℕ) → अङ्कस्थान rs → ℕ
उद्दिष्ट []       _        = 0
उद्दिष्ट (r ∷ rs) (d , ds) = toℕ d + suc r · उद्दिष्ट rs ds

------------------------------------------------------------------------
-- §३  नष्टम् — स्थानं दत्तं, रूपं लभ्यते ।
--
-- पिङ्गलस्य द्विधा-करणम् एव, छेदेन suc r ।  शेषः अङ्कः ; भागफलः अग्रे ।
-- वल्ली एव स्मृतिः : पृथक् सारणी नास्ति ।
------------------------------------------------------------------------

नष्ट : (rs : List ℕ) → ℕ → अङ्कस्थान rs
नष्ट []       k = tt
नष्ट (r ∷ rs) k = (k mod suc r , mod< r k) , नष्ट rs (quotient k / suc r)

------------------------------------------------------------------------
-- §४  छेदनस्य द्वे लेमे — अङ्कः पुनः लभ्यते, भागफलः पुनः लभ्यते ।
------------------------------------------------------------------------

-- स्थानान्तरम् : d + b·(suc u) = b + (d + b·u) ।  (b = suc n)
सरण : (n d u : ℕ) → d + suc n · suc u ≡ suc n + (d + suc n · u)
सरण n d u =
    cong (d +_) (·-suc (suc n) u)
  ∙ +-assoc d (suc n) (suc n · u)
  ∙ cong (_+ suc n · u) (+-comm d (suc n))
  ∙ sym (+-assoc (suc n) d (suc n · u))

शून्यगुण : (n d : ℕ) → d + suc n · zero ≡ d
शून्यगुण n d = cong (d +_) (sym (0≡m·0 (suc n))) ∙ +-zero d

-- शेषः अपरिवर्तितः : (d + b·u) mod b ≡ d mod b ।
शेष-योगः : (n d u : ℕ) → (d + suc n · u) mod suc n ≡ d mod suc n
शेष-योगः n d zero    = cong (_mod suc n) (शून्यगुण n d)
शेष-योगः n d (suc u) =
    cong (_mod suc n) (सरण n d u)
  ∙ modIndStep n (d + suc n · u)
  ∙ शेष-योगः n d u

-- भागफलः पुनः लभ्यते : d < b ⟹ quotient (d + b·u) / b ≡ u ।
भागफल-योगः : (n d u : ℕ) → d < suc n → (quotient (d + suc n · u) / suc n) ≡ u
भागफल-योगः n d zero    dp =
    cong (λ z → quotient z / suc n) (शून्यगुण n d)
  ∙ +inductionBase n (λ _ → ℕ) (λ _ _ → 0) (λ _ → suc) d dp
भागफल-योगः n d (suc u) dp =
    cong (λ z → quotient z / suc n) (सरण n d u)
  ∙ +inductionStep n (λ _ → ℕ) (λ _ _ → 0) (λ _ → suc) (d + suc n · u)
  ∙ cong suc (भागफल-योगः n d u dp)

------------------------------------------------------------------------
-- §५  नष्ट ∘ उद्दिष्ट ≡ id — रूपं लिखित्वा स्थानं गणयित्वा रूपं पुनः ।
------------------------------------------------------------------------

नष्टोद्दिष्ट : (rs : List ℕ) (ds : अङ्कस्थान rs) → नष्ट rs (उद्दिष्ट rs ds) ≡ ds
नष्टोद्दिष्ट []       ds       = isPropUnit tt ds
नष्टोद्दिष्ट (r ∷ rs) (d , ds) =
  ΣPathP ( toℕ-injective (शेष-योगः r (toℕ d) (उद्दिष्ट rs ds)
                          ∙ modIndBase r (toℕ d) (snd d))
         , (cong (नष्ट rs) (भागफल-योगः r (toℕ d) (उद्दिष्ट rs ds) (snd d))
            ∙ नष्टोद्दिष्ट rs ds) )

------------------------------------------------------------------------
-- §६  उद्दिष्ट ∘ नष्ट ≡ id — सीमायाम् ।
--
-- नष्ट सर्वस्मिन् ℕ चलति ; प्रस्तारे तु सङ्ख्या rs पङ्क्तयः एव, बहिः पुनरावृत्तिः ।
------------------------------------------------------------------------

-- गुणने एकरूपता : S ≤ q ⟹ b·S ≤ b·q ।
गुण-अनुलोम : (b S q : ℕ) → S ≤ q → (b · S) ≤ (b · q)
गुण-अनुलोम b S q (j , e) =
  b · j , ·-distribˡ b j S ∙ cong (b ·_) e

-- भागफलस्य सीमा : k < b·S ⟹ (quotient k / b) < S ।
भागफल-सीमा : (n S k : ℕ) → k < (suc n · S) → (quotient k / suc n) < S
भागफल-सीमा n S k kp with splitℕ-< (quotient k / suc n) S
... | inl q<S = q<S
... | inr S≤q = ⊥rec (<-asym kp केवलम्)
  where
    q : ℕ
    q = quotient k / suc n

    -- b·q ≤ k, यतः k = शेषः + b·q (≡remainder+quotient) ।
    गुणः≤k : (suc n · q) ≤ k
    गुणः≤k = (k mod suc n) , ≡remainder+quotient (suc n) k

    केवलम् : (suc n · S) ≤ k
    केवलम् = ≤-trans (गुण-अनुलोम (suc n) S q S≤q) गुणः≤k

उद्दिष्टनष्ट : (rs : List ℕ) (k : ℕ) → k < सङ्ख्या rs → उद्दिष्ट rs (नष्ट rs k) ≡ k
उद्दिष्टनष्ट []       k kp = sym (≤0→≡0 (pred-≤-pred kp))
उद्दिष्टनष्ट (r ∷ rs) k kp =
    cong (λ z → (k mod suc r) + suc r · z)
         (उद्दिष्टनष्ट rs (quotient k / suc r) (भागफल-सीमा r (सङ्ख्या rs) k kp))
  ∙ ≡remainder+quotient (suc r) k

------------------------------------------------------------------------
-- §७  सीमा — उद्दिष्टफलं स्वप्रस्तारस्य पङ्क्तिः ।
------------------------------------------------------------------------

उद्दिष्ट-सीमा : (rs : List ℕ) (ds : अङ्कस्थान rs) → उद्दिष्ट rs ds < सङ्ख्या rs
उद्दिष्ट-सीमा []       ds       = zero , refl
उद्दिष्ट-सीमा (r ∷ rs) (d , ds) = साक्षी , पथः
  where
    b S u m j d' : ℕ
    b  = suc r
    S  = सङ्ख्या rs
    u  = उद्दिष्ट rs ds
    d' = toℕ d
    m  = (snd d) .fst
    j  = (उद्दिष्ट-सीमा rs ds) .fst

    साक्षी : ℕ
    साक्षी = b · j + m

    m≡ : m + suc d' ≡ b
    m≡ = (snd d) .snd

    j≡ : j + suc u ≡ S
    j≡ = (उद्दिष्ट-सीमा rs ds) .snd

    -- अन्तः : m + suc (d' + b·u) ≡ b · suc u ।  (m ≡ b − suc d' इति m≡ ।)
    अन्तः : m + suc (d' + b · u) ≡ b · suc u
    अन्तः =
        +-assoc m (suc d') (b · u)
      ∙ cong (_+ b · u) m≡
      ∙ sym (·-suc b u)

    पथः : साक्षी + suc (d' + b · u) ≡ b · S
    पथः =
        sym (+-assoc (b · j) m (suc (d' + b · u)))
      ∙ cong ((b · j) +_) अन्तः
      ∙ ·-distribˡ b j (suc u)
      ∙ cong (b ·_) j≡

------------------------------------------------------------------------
-- §८  मुख्यसिद्धिः — अङ्कस्थान rs ≃ Fin (सङ्ख्या rs), उभयतः, स्पष्टक्रियाभ्याम् ।
--
-- न कोऽपि मार्गः अन्येन निरूपितः : उद्दिष्ट योगेन गुणनेन च लिखितम्, नष्ट
-- छेदनेन ; द्वे परिभ्रमणे पृथक् साधिते ।  सारणी न स्थाप्यते ।
------------------------------------------------------------------------

प्रस्तारः : (rs : List ℕ) → Iso (अङ्कस्थान rs) (Fin (सङ्ख्या rs))
fun      (प्रस्तारः rs) ds = उद्दिष्ट rs ds , उद्दिष्ट-सीमा rs ds
inv      (प्रस्तारः rs) i  = नष्ट rs (toℕ i)
rightInv (प्रस्तारः rs) i  = toℕ-injective (उद्दिष्टनष्ट rs (toℕ i) (snd i))
leftInv  (प्रस्तारः rs) ds = नष्टोद्दिष्ट rs ds

------------------------------------------------------------------------
-- §९  पिङ्गले प्रत्यागमनम् — एकरूप-द्विच्छेदः ।
--
-- छेद-सूची सर्वत्र १ (लघु, गुरु) ; तदा सङ्ख्या = पिङ्गलस्य 2ⁿ ।
------------------------------------------------------------------------

एकरूप : ℕ → ℕ → List ℕ
एकरूप zero    r = []
एकरूप (suc n) r = r ∷ एकरूप n r

एकरूप-सङ्ख्या : (n : ℕ) → सङ्ख्या (एकरूप n 1) ≡ sankhya n
एकरूप-सङ्ख्या zero    = refl
एकरूप-सङ्ख्या (suc n) =
    cong (λ z → 2 · z) (एकरूप-सङ्ख्या n)
  ∙ cong (sankhya n +_) (+-zero (sankhya n))

------------------------------------------------------------------------
-- §१०  मेरुप्रस्तारः — एका पङ्क्तिः स्मर्तव्या, त्रिकोणः न ।
--
-- हलायुधस्य नियमः : प्रत्येकं पदम् उपरिस्थयोः योगः ।  अत्र पङ्क्तिः पूर्वपङ्क्त्या
-- जन्यते ; या पङ्क्तिः धार्या सा एका ।  स्थानम् O(n), न O(n²) ।
------------------------------------------------------------------------

नयन : List ℕ → ℕ → ℕ           -- पङ्क्तेः k-तमं पदम्, बहिः शून्यम्
नयन []       k       = 0
नयन (x ∷ xs) zero    = x
नयन (x ∷ xs) (suc k) = नयन xs k

युग्म : List ℕ → List ℕ         -- पार्श्वयोः योगः
युग्म []       = []
युग्म (x ∷ xs) = (नयन xs 0 + x) ∷ युग्म xs

अग्रिम : List ℕ → List ℕ        -- अग्रिमा पङ्क्तिः, केवलं पूर्वया
अग्रिम xs = 1 ∷ युग्म xs

पङ्क्ति : ℕ → List ℕ
पङ्क्ति zero    = 1 ∷ []
पङ्क्ति (suc n) = अग्रिम (पङ्क्ति n)

-- युग्मस्य पदं द्वयोः उपरिस्थयोः योगः — हलायुधस्य नियमः, सूच्यां लिखितः ।
युग्म-नयन : (xs : List ℕ) (k : ℕ) → नयन (युग्म xs) k ≡ नयन xs (suc k) + नयन xs k
युग्म-नयन []       k       = refl
युग्म-नयन (x ∷ xs) zero    = refl
युग्म-नयन (x ∷ xs) (suc k) = युग्म-नयन xs k

-- सिद्धिः : जनिता पङ्क्तिः मेरु-पङ्क्तिः एव ।
पङ्क्ति-सत्य : (n k : ℕ) → नयन (पङ्क्ति n) k ≡ meru n k
पङ्क्ति-सत्य zero    zero    = refl
पङ्क्ति-सत्य zero    (suc k) = refl
पङ्क्ति-सत्य (suc n) zero    = refl
पङ्क्ति-सत्य (suc n) (suc k) =
    युग्म-नयन (पङ्क्ति n) k
  ∙ cong₂ _+_ (पङ्क्ति-सत्य n (suc k)) (पङ्क्ति-सत्य n k)

-- यत् धार्यं तत् परिमितम् : पङ्क्तेः दैर्घ्यं suc n, न (n+1)(n+2)/2 ।
युग्म-दैर्घ्य : (xs : List ℕ) → length (युग्म xs) ≡ length xs
युग्म-दैर्घ्य []       = refl
युग्म-दैर्घ्य (x ∷ xs) = cong suc (युग्म-दैर्घ्य xs)

पङ्क्ति-दैर्घ्य : (n : ℕ) → length (पङ्क्ति n) ≡ suc n
पङ्क्ति-दैर्घ्य zero    = refl
पङ्क्ति-दैर्घ्य (suc n) = cong suc (युग्म-दैर्घ्य (पङ्क्ति n) ∙ पङ्क्ति-दैर्घ्य n)

------------------------------------------------------------------------
-- §११  मात्रामेरुः — द्वे पदे स्मर्तव्ये, सूची न ।
--
-- विरहाङ्कस्य आवृत्तिः M(n+2) = M(n+1) + M(n) — अवस्था युगलम् एव ।
------------------------------------------------------------------------

युगल : ℕ → ℕ × ℕ
युगल zero    = 1 , 1
युगल (suc n) = snd (युगल n) , fst (युगल n) + snd (युगल n)

युगल-सत्य : (n : ℕ) → युगल n ≡ (matra n , matra (suc n))
युगल-सत्य zero    = refl
युगल-सत्य (suc n) =
  ΣPathP ( cong snd (युगल-सत्य n)
         , (cong (λ p → fst p + snd p) (युगल-सत्य n)
            ∙ +-comm (matra n) (matra (suc n))) )

मात्रामेरु-क्रिया : (n : ℕ) → fst (युगल n) ≡ matra n
मात्रामेरु-क्रिया n = cong fst (युगल-सत्य n)

------------------------------------------------------------------------
