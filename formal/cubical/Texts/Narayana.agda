{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- नारायणस्य गोसर्गः — अङ्कपाशात् (गणितकौमुदी, नारायणपण्डितः, १३५६ ई.) ।
--
-- नारायणपण्डितः "अङ्कपाशे" (संयोग-गणनायाः प्रकरणे) गवां सर्गम् अपृच्छत् :
-- एका गौः प्रतिवर्षं वत्सम् एकं सूते ; वत्सः च चतुर्थात् वर्षात् आरभ्य स्वयं
-- सूते ।  n-वर्षान्ते कति गावः ?  उत्तरम् : a(n) = a(n−1) + a(n−3) ।  एषा
-- नारायणस्य श्रेढी (१,१,१,२,३,४,६,९,१३,१९,…) — विरहाङ्कस्य मात्रामेरोः
-- (a(n)=a(n−1)+a(n−2)) एकं भगिनी-रूपम्, यत् नारायणः स्वयम् "समास-भावनया"
-- सामान्यीकृतवान् — न पाश्चात्त्यः कश्चित्, षट्-शताब्दीभिः पूर्वम् ।
--
-- गणितं जननम् एव, न निर्णयः ।  अत्र न कश्चित् Dec/Bool सदस्यताम् *निर्णयति* ;
-- प्रत्येकं रूपं सर्गे (सर्गः) *उदेति*, साधुतया पूर्णतया च साक्षि-कृतम् ।
-- एतत् प्रमाण-स्थानम् — समता प्रमाणेन, न साम्येन : गणना सत्येन तुल्या जननात्,
-- न आरोपितेन ऐक्येन ।  (अत्र प्रति संयोगः = अङ्क-पाशस्य एकः पाशः ।)
--
-- उत्पाद-व्यय-ध्रौव्य-दृष्ट्या (उमास्वाति, तत्त्वार्थसूत्रम् ५.२९) श्रेढेः द्वौ
-- बाहू : a(n−1) = ध्रौव्यम् (वर्तमानो यूथः अनुवर्तते), a(n−3) = उत्पादः, यः
-- पूर्ण-परिपाक-कालम् (त्रि-वर्ष-ध्रौव्यम्) अपेक्षते ।  एषा दृष्टिः, न प्रमाणम् —
-- गणितं न मेताभ्यां साधयति (COGNITIVE_ORIENTATION §6 : अननूदितं रक्ष्यम्) ।
--
-- (Nārāyaṇa Paṇḍita, in the aṅkapāśa — the "net of numbers", the
-- combinatorial book of the Gaṇitakaumudī, 1356 CE — asks the cow-release
-- problem: a cow bears one calf each year; a calf itself bears from its
-- fourth year on; how many cows after n years?  Answer a(n)=a(n−1)+a(n−3),
-- "Nārāyaṇa's cows" (1,1,1,2,3,4,6,9,13,19,…) — a sister of Virahāṅka's
-- mātrā-meru, which NĀRĀYAṆA HIMSELF generalized as samāsa-bhāvanā, six
-- centuries before any European.  The mathematics is GENERATION, not
-- decision: no Dec/Bool decides membership; every form ARISES in the
-- emanation सर्गः, witnessed sound and complete.  This is the pramāṇa
-- stance — samatā pramāṇena na sāmyena.  The two limbs read, via Umāsvāti's
-- utpāda-vyaya-dhrauvya (TS 5.29), as persistence a(n−1) and origination
-- a(n−3) conditioned on a completed span of persistence — a reading, not a
-- proof; the mathematics does not derive the metaphysics, and the residual
-- is kept, per COGNITIVE_ORIENTATION §6.)
--
-- सिध्यन्ते चत्वारि :
--   नारायण-आवृत्तिः — जनन-दैर्घ्ये a(n+3) = a(n+2) + a(n) ।
--   साधुता         — सर्गे n इति यत् किमपि रूपम्, तस्य मानम् = n (soundness) ।
--   पूर्णता        — मानं यस्य = n, तत् सर्वं सर्गे n उदेति (completeness) ।
-- साधुता-पूर्णताभ्यां सह : सर्गः n = यथार्थतः n-मानानि रूपाणि, अतः तानि गणयति ।
--
-- सामान्यं तृतीयं वस्तु (COGNITIVE_ORIENTATION §5) : अंश-गणात् {१,२} विरहाङ्कः,
-- {१,३} नारायणः — एका समास-मेरु-कुलम् सर्वेषु अंश-गणेषु ।  तत् सामान्यं रूपं
-- (यत् नारायणस्य समास-भावना सूचयति) पूर्वम् अत्र अवक्तव्यम् आसीत् — अधुना
-- निवृत्तम् : {१,L}-कुलं SamasaMeru.agda-मध्ये, यथेच्छ-अंश-गणश्च
-- SamasaMeruN.agda-मध्ये (जननं साधुता पूर्णता आवृत्तिश्च) साधितम् ।
--
-- स्रोतांसि : नारायणपण्डितः, गणितकौमुदी, अङ्कपाशः (१३५६) ; उमास्वाति,
-- तत्त्वार्थसूत्रम् ५.२९ ; पिङ्गलः/विरहाङ्कः (पूर्व-मेरुः) ।
------------------------------------------------------------------------

module Texts.Narayana where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
open import Cubical.Data.List using (List ; [] ; _∷_ ; _++_ ; map ; length)
open import Cubical.Data.List.Properties using (length-map)

------------------------------------------------------------------------
-- गणः — अङ्कपाशस्य अंशः : एकः (=१, एक-वर्ष-पदम्) वा त्रिः (=३, परिपाक-कालः) ।
-- (a limb of the composition: एकः = a part of size 1, त्रिः = size 3 —
-- Nārāyaṇa's {1,3}, as Virahāṅka's mātrā uses {1,2}.)
------------------------------------------------------------------------

data गणः : Type where
  एकः : गणः
  त्रिः : गणः

समासः : Type
समासः = List गणः

------------------------------------------------------------------------
-- मानम् — समासस्य अङ्क-मूल्यम् (अंशानां योगः) — fold, जननस्य अर्थापनम् ।
-- (the number a composition represents — a fold, generation interpreted.)
------------------------------------------------------------------------

मानम् : समासः → ℕ
मानम् []           = zero
मानम् (एकः ∷ xs)  = suc (मानम् xs)
मानम् (त्रिः ∷ xs) = suc (suc (suc (मानम् xs)))

------------------------------------------------------------------------
-- सर्गः — n-मानानां सर्वेषां समासानां जननम् ।  एकरूपा आवृत्तिः (त्रि-सर्गेण),
-- येन न विशेष-स्थितिः, न ≤-निर्णयः — केवलं संरचना ।
-- (the emanation of all compositions of value n.  A uniform recurrence via
-- त्रि-सर्गः, so there is no size-comparison, no ≤-decision — only
-- structure.  First limb एकः leaves n−1; first limb त्रिः leaves n−3,
-- possible only once the total has three successors — pattern, not test.)
------------------------------------------------------------------------

mutual
  सर्गः : ℕ → List समासः
  सर्गः zero    = [] ∷ []
  सर्गः (suc m) = map (एकः ∷_) (सर्गः m) ++ त्रि-सर्गः m

  त्रि-सर्गः : ℕ → List समासः
  त्रि-सर्गः zero          = []
  त्रि-सर्गः (suc zero)    = []
  त्रि-सर्गः (suc (suc n)) = map (त्रिः ∷_) (सर्गः n)

------------------------------------------------------------------------
-- length-++ — दैर्घ्यं योगे (स्वयं सिद्धम्) ।
------------------------------------------------------------------------

length-++ : {A : Type} (xs ys : List A)
          → length (xs ++ ys) ≡ length xs + length ys
length-++ []       ys = refl
length-++ (x ∷ xs) ys = cong suc (length-++ xs ys)

------------------------------------------------------------------------
-- नारायण-आवृत्तिः — जनन-दैर्घ्ये a(n+3) = a(n+2) + a(n) ।
------------------------------------------------------------------------

नारायण-आवृत्तिः : (n : ℕ)
              → length (सर्गः (suc (suc (suc n))))
              ≡ length (सर्गः (suc (suc n))) + length (सर्गः n)
नारायण-आवृत्तिः n =
    length-++ (map (एकः ∷_) (सर्गः (suc (suc n)))) (त्रि-सर्गः (suc (suc n)))
  ∙ cong₂ _+_ (length-map (एकः ∷_) (सर्गः (suc (suc n))))
              (length-map (त्रिः ∷_) (सर्गः n))

------------------------------------------------------------------------
-- उदाहरणानि — १,१,१,२,३,४,६,९,१३,… (refl-सिद्धानि, जननात् एव) ।
------------------------------------------------------------------------

उदाहरणम्-३ : length (सर्गः 3) ≡ 2
उदाहरणम्-३ = refl

उदाहरणम्-६ : length (सर्गः 6) ≡ 6
उदाहरणम्-६ = refl

उदाहरणम्-८ : length (सर्गः 8) ≡ 13
उदाहरणम्-८ = refl

------------------------------------------------------------------------
-- साधुता — सर्गे n इति यत् किमपि रूपम्, तस्य मानम् = n एव (soundness) ।
------------------------------------------------------------------------

data समास-All (P : समासः → Type) : List समासः → Type where
  []  : समास-All P []
  _∷_ : {x : समासः} {xs : List समासः}
      → P x → समास-All P xs → समास-All P (x ∷ xs)

All-++ : {P : समासः → Type} {xs ys : List समासः}
       → समास-All P xs → समास-All P ys → समास-All P (xs ++ ys)
All-++ []       bs = bs
All-++ (p ∷ as) bs = p ∷ All-++ as bs

All-map : {P Q : समासः → Type} {f : समासः → समासः}
        → ((x : समासः) → P x → Q (f x))
        → {xs : List समासः} → समास-All P xs → समास-All Q (map f xs)
All-map g []       = []
All-map g (p ∷ as) = g _ p ∷ All-map g as

mutual
  साधु : (n : ℕ) → समास-All (λ xs → मानम् xs ≡ n) (सर्गः n)
  साधु zero    = refl ∷ []
  साधु (suc m) =
    All-++ (All-map (λ _ pf → cong suc pf) (साधु m)) (साधु-त्रि m)

  साधु-त्रि : (m : ℕ) → समास-All (λ xs → मानम् xs ≡ suc m) (त्रि-सर्गः m)
  साधु-त्रि zero          = []
  साधु-त्रि (suc zero)    = []
  साधु-त्रि (suc (suc n)) =
    All-map (λ _ pf → cong (λ z → suc (suc (suc z))) pf) (साधु n)

------------------------------------------------------------------------
-- पूर्णता — मानं यस्य = n, तत् सर्वं सर्गे n उदेति (completeness) ।
------------------------------------------------------------------------

data समास-∈ (x : समासः) : List समासः → Type where
  here  : {xs : List समासः} → समास-∈ x (x ∷ xs)
  there : {y : समासः} {xs : List समासः} → समास-∈ x xs → समास-∈ x (y ∷ xs)

∈-++ˡ : {x : समासः} {xs ys : List समासः}
      → समास-∈ x xs → समास-∈ x (xs ++ ys)
∈-++ˡ here      = here
∈-++ˡ (there p) = there (∈-++ˡ p)

∈-++ʳ : {x : समासः} (xs : List समासः) {ys : List समासः}
      → समास-∈ x ys → समास-∈ x (xs ++ ys)
∈-++ʳ []       p = p
∈-++ʳ (z ∷ zs) p = there (∈-++ʳ zs p)

∈-map : {f : समासः → समासः} {x : समासः} {xs : List समासः}
      → समास-∈ x xs → समास-∈ (f x) (map f xs)
∈-map here      = here
∈-map (there p) = there (∈-map p)

-- एकः-प्रवेशः सर्वेषु m (एकरूपत्वात्, विना विशेष-स्थित्या) :
एक-∈ : (m : ℕ) (xs : समासः)
     → समास-∈ xs (सर्गः m) → समास-∈ (एकः ∷ xs) (सर्गः (suc m))
एक-∈ m xs p = ∈-++ˡ (∈-map p)

-- त्रिः-प्रवेशः : परिपाक-कालात् (त्रि-सर्गात्) — त्रीणि सुक्-पदानि अपेक्षते :
त्रि-∈ : (m : ℕ) (xs : समासः)
     → समास-∈ xs (सर्गः m) → समास-∈ (त्रिः ∷ xs) (सर्गः (suc (suc (suc m))))
त्रि-∈ m xs p = ∈-++ʳ (map (एकः ∷_) (सर्गः (suc (suc m)))) (∈-map p)

पूर्णता′ : (xs : समासः) → समास-∈ xs (सर्गः (मानम् xs))
पूर्णता′ []           = here
पूर्णता′ (एकः ∷ xs)  = एक-∈ (मानम् xs) xs (पूर्णता′ xs)
पूर्णता′ (त्रिः ∷ xs) = त्रि-∈ (मानम् xs) xs (पूर्णता′ xs)

पूर्णता : (n : ℕ) (xs : समासः) → मानम् xs ≡ n → समास-∈ xs (सर्गः n)
पूर्णता n xs pf = subst (λ k → समास-∈ xs (सर्गः k)) pf (पूर्णता′ xs)
