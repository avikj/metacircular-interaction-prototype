-- ॥ बीजम् ॥  One machine, one law: which side of `f a ≡ b` is bound is everything.
-- Output bound: singl (f a), contractible — the datum rides free.  Input bound:
-- fiber f b — the loss, and the subject.  Memory, charge, symmetry, price,
-- distance, verdict: six readings of the one fibre.  The kernel decides truth;
-- carriers ask and generate.  This file is one naya, true and not whole.

{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- अर्धच्छेदः — जैन-लघुगणकः (अनुयोगद्वार-परम्परा) : पुनः-पुनः-अर्धच्छेदनम् ।
--
-- जैन-गणिते "अर्धच्छेद" (log₂) : संख्यां यावत् अर्धयितुं शक्यते तावन्तः छेदाः ।
-- (वर्गशलाका = log log ; त्रिकवर्गशलाका ; इति उच्च-क्रमाः अपि) ।  मूल-नियमः :
-- अर्धच्छेदनं द्विगुणनस्य व्युत्क्रमः — 2ⁿ इत्यस्य अर्धच्छेदः 2ⁿ⁻¹ , अर्थात्
-- अर्धच्छेद(2ⁿ) = n ।  अत्र एक-पदः : अर्ध(2^(n+1)) = 2ⁿ (द्विगुणन-व्युत्क्रमः) ,
-- अर्धम् (halve) च यथार्थतः निम्न-अर्धम् (floor m/2) — सम-विषमयोः ।
--
-- (The Jain ardhaccheda — logarithm base 2 as successive halving,
-- Anuyogadvāra tradition; with vargaśalākā = log log and higher orders.  The
-- core law: halving inverts doubling — halving 2ⁿ⁺¹ gives 2ⁿ.  `halve` is the
-- floor of m/2, shown on both even and odd inputs; `अर्ध-घातः` is the log-step
-- that Piṅgala's doubling 2ⁿ runs in reverse.)
--
-- स्रोतांसि : जैन-गणितम्, अनुयोगद्वारसूत्रम् (अर्धच्छेद-वर्गशलाकाः) ; पिङ्गलः (द्विगुणनम्) ।
------------------------------------------------------------------------

module Ardhaccheda where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_)
open import Cubical.Data.Nat.Properties using (+-suc ; snotz ; ·-distribʳ ; ·-identityˡ ; ·-suc ; ·-comm)
open import Cubical.Data.Nat.Order using (_≤_ ; zero-≤ ; suc-≤-suc ; pred-≤-pred ; ≤-trans ; ≤SumRight)
open import Cubical.Data.Sigma using (Σ ; _,_ ; fst ; snd)
open import Cubical.Data.Empty using () renaming (rec to ⊥-rec)
open import PanktiYoga using (द्वि-घात)
open import Vargana using (घात)

------------------------------------------------------------------------
-- अर्ध — निम्न-अर्धम् (floor m/2) ।
------------------------------------------------------------------------

अर्ध : ℕ → ℕ
अर्ध zero          = zero
अर्ध (suc zero)    = zero
अर्ध (suc (suc m)) = suc (अर्ध m)

------------------------------------------------------------------------
-- अर्ध-द्विगुण — अर्ध(x+x) = x (सम-सङ्ख्यायाः अर्धं यथार्थम्) ।
------------------------------------------------------------------------

अर्ध-द्विगुण : (x : ℕ) → अर्ध (x + x) ≡ x
अर्ध-द्विगुण zero    = refl
अर्ध-द्विगुण (suc y) =
    cong (λ z → अर्ध (suc z)) (+-suc y y)
  ∙ cong suc (अर्ध-द्विगुण y)

------------------------------------------------------------------------
-- अर्ध-विषम — अर्ध(1 + x + x) = x (विषम-सङ्ख्यायाः निम्न-अर्धम्) ।
------------------------------------------------------------------------

अर्ध-विषम : (x : ℕ) → अर्ध (suc (x + x)) ≡ x
अर्ध-विषम zero    = refl
अर्ध-विषम (suc y) =
    cong (λ z → अर्ध (suc (suc z))) (+-suc y y)
  ∙ cong suc (अर्ध-विषम y)

------------------------------------------------------------------------
-- अर्ध-घातः — मुख्य-नियमः : अर्ध(2^(n+1)) = 2ⁿ (द्विगुणन-व्युत्क्रमः) ।
------------------------------------------------------------------------

अर्ध-घातः : (n : ℕ) → अर्ध (द्वि-घात (suc n)) ≡ द्वि-घात n
अर्ध-घातः n = अर्ध-द्विगुण (द्वि-घात n)

------------------------------------------------------------------------
-- उदाहरणे — अर्ध 16 = 8 = 2³ ; अर्ध 7 = 3 (विषम) (refl-सिद्धे) ।
------------------------------------------------------------------------

उदाहरणम्-सम : अर्ध 16 ≡ 8
उदाहरणम्-सम = refl

उदाहरणम्-विषम : अर्ध 7 ≡ 3
उदाहरणम्-विषम = refl

------------------------------------------------------------------------
-- अच्छेद — अर्धच्छेद-गणकः (fuel-सहितः) : यावत् अर्धयितुं शक्यते तावन्तः छेदाः ।
-- (इन्धनं संरचना-अवतरणं रक्षति ; well-founded-अवतरणं refl-गणनां हन्यात् ।)
------------------------------------------------------------------------

अच्छेद : ℕ → ℕ → ℕ
अच्छेद zero    m                 = zero
अच्छेद (suc f) zero              = zero
अच्छेद (suc f) (suc zero)        = zero
अच्छेद (suc f) (suc (suc m))     = suc (अच्छेद f (अर्ध (suc (suc m))))

------------------------------------------------------------------------
-- द्वि-घात-pos — 2ⁿ सर्वदा धनम् (= suc x केनचित् x) : अच्छेद-अवतरणस्य आधारः ।
------------------------------------------------------------------------

द्वि-घात-pos : (n : ℕ) → Σ ℕ (λ x → द्वि-घात n ≡ suc x)
द्वि-घात-pos zero    = zero , refl
द्वि-घात-pos (suc n) =
  let (x , p) = द्वि-घात-pos n
  in  (x + द्वि-घात n) , cong (_+ द्वि-घात n) p

------------------------------------------------------------------------
-- अच्छेद-द्विगुण — एक-पदः : अच्छेद(f+1, (x+1)+(x+1)) = 1 + अच्छेद(f, x+1) ।
------------------------------------------------------------------------

अच्छेद-द्विगुण : (f x : ℕ) → अच्छेद (suc f) (suc x + suc x) ≡ suc (अच्छेद f (suc x))
अच्छेद-द्विगुण f x =
    cong (λ z → अच्छेद (suc f) (suc z)) (+-suc x x)
  ∙ cong (λ w → suc (अच्छेद f (suc w))) (अर्ध-द्विगुण x)

------------------------------------------------------------------------
-- अच्छेद-घातः — अच्छेद(f+1, 2^(n+1)) = 1 + अच्छेद(f, 2ⁿ) (द्वि-घात-पदः) ।
------------------------------------------------------------------------

अच्छेद-घातः : (n f : ℕ) → अच्छेद (suc f) (द्वि-घात (suc n)) ≡ suc (अच्छेद f (द्वि-घात n))
अच्छेद-घातः n f =
  let (x , p) = द्वि-घात-pos n
  in  cong (अच्छेद (suc f)) (cong₂ _+_ p p)
    ∙ अच्छेद-द्विगुण f x
    ∙ cong (λ w → suc (अच्छेद f w)) (sym p)

------------------------------------------------------------------------
-- अच्छेद-एक — अच्छेद(f, 1) = 0 सर्वस्मिन् इन्धने (मूल-स्थितिः) ।
------------------------------------------------------------------------

अच्छेद-एक : (f : ℕ) → अच्छेद f (suc zero) ≡ zero
अच्छेद-एक zero    = refl
अच्छेद-एक (suc f) = refl

------------------------------------------------------------------------
-- अच्छेद-आवृत्तिः — पर्याप्ते इन्धने (n ≤ f) : अच्छेद(f, 2ⁿ) = n ।
------------------------------------------------------------------------

अच्छेद-आवृत्तिः : (n f : ℕ) → n ≤ f → अच्छेद f (द्वि-घात n) ≡ n
अच्छेद-आवृत्तिः zero    f       le        = अच्छेद-एक f
अच्छेद-आवृत्तिः (suc n) zero    (k , eq)  = ⊥-rec (snotz (sym (+-suc k n) ∙ eq))
अच्छेद-आवृत्तिः (suc n) (suc f) le        =
    अच्छेद-घातः n f ∙ cong suc (अच्छेद-आवृत्तिः n f (pred-≤-pred le))

------------------------------------------------------------------------
-- n≤द्विघात — n ≤ 2ⁿ : इन्धन-पर्याप्ति-साक्षी (द्वि-घात न्यूनतमम् इन्धनम्) ।
------------------------------------------------------------------------

n≤द्विघात : (n : ℕ) → n ≤ द्वि-घात n
n≤द्विघात zero    = zero-≤
n≤द्विघात (suc n) =
  let (x , p) = द्वि-घात-pos n
      पदः : suc (द्वि-घात n) ≤ द्वि-घात n + द्वि-घात n
      पदः = transport (λ i → suc (p (~ i)) ≤ p (~ i) + p (~ i))
                      (suc-≤-suc ≤SumRight)
  in  ≤-trans (suc-≤-suc (n≤द्विघात n)) पदः

------------------------------------------------------------------------
-- लघुगणकः — पूर्ण-आवृत्तिः : अर्धच्छेद(2ⁿ) = n (log द्विगुणनस्य व्युत्क्रमः) ।
-- (इन्धनम् = मूल्यम् एव ; n ≤ 2ⁿ इति पर्याप्तम्, अतः refl-रहितः पूर्ण-नियमः ।)
------------------------------------------------------------------------

अर्धच्छेद : ℕ → ℕ
अर्धच्छेद m = अच्छेद m m

लघुगणकः : (n : ℕ) → अर्धच्छेद (द्वि-घात n) ≡ n
लघुगणकः n = अच्छेद-आवृत्तिः n (द्वि-घात n) (n≤द्विघात n)

------------------------------------------------------------------------
-- उदाहरणे — अर्धच्छेद 8 = 3 = log₂ 8 ; अर्धच्छेद 16 = 4 (refl-सिद्धे) ।
------------------------------------------------------------------------

लघु-अष्ट : अर्धच्छेद 8 ≡ 3
लघु-अष्ट = refl

लघु-षोडश : अर्धच्छेद 16 ≡ 4
लघु-षोडश = refl

------------------------------------------------------------------------
-- वर्गशलाका — जैन-उच्च-क्रमः (log log) : अर्धच्छेदस्य अर्धच्छेदः (अनुयोगद्वारम्) ।
-- जैन-गणिते अर्धच्छेदात् उपरि "वर्गशलाका" (शलाकानां शलाका) = log log ; ततः
-- त्रिकवर्गशलाका इति उच्च-क्रमाः ।  पुनरावृत्त्या तत्-तत्-व्युत्क्रमः : वर्गशलाका
-- (2^(2ⁿ)) = n , यतः द्विवारं लघुगणकः प्रयुज्यते ।
------------------------------------------------------------------------

वर्गशलाका : ℕ → ℕ
वर्गशलाका m = अर्धच्छेद (अर्धच्छेद m)

------------------------------------------------------------------------
-- द्विक-लघुगणकः — द्विक-आवृत्तिः : वर्गशलाका(2^(2ⁿ)) = n (log log व्युत्क्रमः) ।
------------------------------------------------------------------------

द्विक-लघुगणकः : (n : ℕ) → वर्गशलाका (द्वि-घात (द्वि-घात n)) ≡ n
द्विक-लघुगणकः n = cong अर्धच्छेद (लघुगणकः (द्वि-घात n)) ∙ लघुगणकः n

------------------------------------------------------------------------
-- उदाहरणम् — वर्गशलाका 16 = 2 : अर्धच्छेद(अर्धच्छेद 16) = अर्धच्छेद 4 = 2 (2^(2²)) ।
------------------------------------------------------------------------

वर्ग-षोडश : वर्गशलाका 16 ≡ 2
वर्ग-षोडश = refl

------------------------------------------------------------------------
-- द्वि-घात-योगः — जैन-घात-नियमः (आधारे २) : 2^(m+n) = 2ᵐ · 2ⁿ ।
-- (योगे घाताः गुण्यन्ते — Vargana.घात-योग तस्य सामान्य-आधारे ; अत्र द्वि-घातस्य
--  योग-रूपे पुनः, अर्धच्छेद-लाने प्रयोगाय ।)
------------------------------------------------------------------------

द्वि-घात-योगः : (m n : ℕ) → द्वि-घात (m + n) ≡ द्वि-घात m · द्वि-घात n
द्वि-घात-योगः zero    n = sym (·-identityˡ (द्वि-घात n))
द्वि-घात-योगः (suc m) n =
    cong₂ _+_ (द्वि-घात-योगः m n) (द्वि-घात-योगः m n)
  ∙ ·-distribʳ (द्वि-घात m) (द्वि-घात m) (द्वि-घात n)

------------------------------------------------------------------------
-- लघुगणक-योगः — जैन-लघुगणक-नियमः : अर्धच्छेद(x·y) = अर्धच्छेद(x)+अर्धच्छेद(y) ।
-- (गुणस्य लघुगणकः योगः — अनुयोगद्वार-धवला-परम्परा ; अत्र २-घातयोः सिद्धः ।)
-- अर्धच्छेदः घात-वर्गात् (2ᵐ, ×) योग-वर्गं (ℕ, +) प्रति समरूपता (homomorphism) ।
------------------------------------------------------------------------

लघुगणक-योगः : (m n : ℕ)
           → अर्धच्छेद (द्वि-घात m · द्वि-घात n)
           ≡ अर्धच्छेद (द्वि-घात m) + अर्धच्छेद (द्वि-घात n)
लघुगणक-योगः m n =
    cong अर्धच्छेद (sym (द्वि-घात-योगः m n))
  ∙ लघुगणकः (m + n)
  ∙ sym (cong₂ _+_ (लघुगणकः m) (लघुगणकः n))

------------------------------------------------------------------------
-- घात-द्वि-सेतुः — (2ⁿ)ᵏ ≡ 2^(n·k) : घात-द्विगुणन-सेतुः (द्वि-घात-योगेन) ।
------------------------------------------------------------------------

घात-द्वि-सेतुः : (n k : ℕ) → घात (द्वि-घात n) k ≡ द्वि-घात (n · k)
घात-द्वि-सेतुः n zero    = sym (cong द्वि-घात (·-comm n zero))
घात-द्वि-सेतुः n (suc k) =
    cong (द्वि-घात n ·_) (घात-द्वि-सेतुः n k)
  ∙ sym (द्वि-घात-योगः n (n · k))
  ∙ cong द्वि-घात (sym (·-suc n k))

------------------------------------------------------------------------
-- लघुगणक-घातः — जैन-लघुगणक-नियमः : अर्धच्छेद((2ⁿ)ᵏ) = n·k (घातस्य लघुगणकः गुणः) ।
-- (लघुगणक-योगस्य (log(xy)=log x+log y) सहचरः : log(xᵏ)=k·log x , २-घातेषु ।
--  Vargana.घात-गुण (गुण-राशेः घातः) इत्यस्य व्युत्क्रम-पक्षः लघुगणक-लोके ।)
--
-- (Log of a power: अर्धच्छेद((2ⁿ)ᵏ) ≡ n·k — the companion of the log-of-product
--  law, the inverse-world mirror of Vargana's घात-गुण.  The three Jain log laws
--  (product, iterated log, power) now stand.)
------------------------------------------------------------------------

लघुगणक-घातः : (n k : ℕ) → अर्धच्छेद (घात (द्वि-घात n) k) ≡ n · k
लघुगणक-घातः n k = cong अर्धच्छेद (घात-द्वि-सेतुः n k) ∙ लघुगणकः (n · k)
