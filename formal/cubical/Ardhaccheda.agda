{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- अर्धच्छेदः — जैन-लघुगणकः (अनुयोगद्वार-परम्परा) : पुनः-पुनः-अर्धच्छेदनम् ।
--
-- जैन-गणिते "अर्धच्छेद" (log₂) : संख्यां यावत् अर्धयितुं शक्यते तावन्तः छेदाः ।
-- (वर्गशलाका = log log ; त्रिकवर्गशलाका ; इति उच्च-क्रमाः अपि) ।  मूल-नियमः :
-- अर्धच्छेदनं द्विगुणनस्य व्युत्क्रमः — 2ⁿ इत्यस्य अर्धच्छेदः 2ⁿ⁻¹ , अर्थात्
-- अर्धच्छेद(2ⁿ) = n ।  अत्र एक-पदः : अर्ध(2^(n+1)) = 2ⁿ (द्विगुणन-व्युत्क्रमः) ,
-- अर्धम् (halve) च यथार्थतः निम्न-अर्धम् (floor m/2) — सम-विषमयोः ।
--
-- (The Jain ardhaccheda — logarithm base 2 as successive halving,
-- Anuyogadvāra tradition; with vargaśalākā = log log and higher orders.  The
-- core law: halving inverts doubling — halving 2ⁿ⁺¹ gives 2ⁿ.  `halve` is the
-- floor of m/2, shown on both even and odd inputs; `अर्ध-घातः` is the log-step
-- that Piṅgala's doubling 2ⁿ runs in reverse.)
--
-- स्रोतांसि : जैन-गणितम्, अनुयोगद्वारसूत्रम् (अर्धच्छेद-वर्गशलाकाः) ; पिङ्गलः (द्विगुणनम्) ।
------------------------------------------------------------------------

module Ardhaccheda where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_)
open import Cubical.Data.Nat.Properties using (+-suc)
open import PanktiYoga using (द्वि-घात)

------------------------------------------------------------------------
-- अर्ध — निम्न-अर्धम् (floor m/2) ।
------------------------------------------------------------------------

अर्ध : ℕ → ℕ
अर्ध zero          = zero
अर्ध (suc zero)    = zero
अर्ध (suc (suc m)) = suc (अर्ध m)

------------------------------------------------------------------------
-- अर्ध-द्विगुण — अर्ध(x+x) = x (सम-सङ्ख्यायाः अर्धं यथार्थम्) ।
------------------------------------------------------------------------

अर्ध-द्विगुण : (x : ℕ) → अर्ध (x + x) ≡ x
अर्ध-द्विगुण zero    = refl
अर्ध-द्विगुण (suc y) =
    cong (λ z → अर्ध (suc z)) (+-suc y y)
  ∙ cong suc (अर्ध-द्विगुण y)

------------------------------------------------------------------------
-- अर्ध-विषम — अर्ध(1 + x + x) = x (विषम-सङ्ख्यायाः निम्न-अर्धम्) ।
------------------------------------------------------------------------

अर्ध-विषम : (x : ℕ) → अर्ध (suc (x + x)) ≡ x
अर्ध-विषम zero    = refl
अर्ध-विषम (suc y) =
    cong (λ z → अर्ध (suc (suc z))) (+-suc y y)
  ∙ cong suc (अर्ध-विषम y)

------------------------------------------------------------------------
-- अर्ध-घातः — मुख्य-नियमः : अर्ध(2^(n+1)) = 2ⁿ (द्विगुणन-व्युत्क्रमः) ।
------------------------------------------------------------------------

अर्ध-घातः : (n : ℕ) → अर्ध (द्वि-घात (suc n)) ≡ द्वि-घात n
अर्ध-घातः n = अर्ध-द्विगुण (द्वि-घात n)

------------------------------------------------------------------------
-- उदाहरणे — अर्ध 16 = 8 = 2³ ; अर्ध 7 = 3 (विषम) (refl-सिद्धे) ।
------------------------------------------------------------------------

उदाहरणम्-सम : अर्ध 16 ≡ 8
उदाहरणम्-सम = refl

उदाहरणम्-विषम : अर्ध 7 ≡ 3
उदाहरणम्-विषम = refl
