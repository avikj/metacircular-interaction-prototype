{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- गुणधनम् — महावीरस्य गुणोत्तर-श्रेढी-योगः (गणितसारसङ्ग्रहः, ~८५०), आधारे २ ।
--
-- महावीरः (गणितसारसङ्ग्रहे, श्रेढी-व्यवहारे) गुणोत्तर-श्रेढेः योगम् (गुणधनम्) आह :
-- a + a·r + a·r² + … + a·rⁿ⁻¹ = a·(rⁿ−1)/(r−1) ।  अत्र a=१, r=२ इति विशेषः :
-- ∑_{k=0}^{n−1} 2ᵏ = 2ⁿ − १ ।  ऋण-रहित-रूपे : (∑ 2ᵏ) + १ = 2ⁿ (द्वि-घात n) ।
-- एषा एव पिङ्गलस्य शून्य-द्वि-स्थान-मान-नीतिः (binary place value) — यत्र प्रत्येकं
-- स्थानं पूर्व-स्थानानां योगात् एकेन अधिकम् ।  जननम्, न निर्णयः : द्वि-घात-अवतरणम् ।
--
-- (Mahāvīra's guṇadhana — the sum of a geometric progression, Gaṇitasāra-
-- saṅgraha ~850 — at a=1, r=2: ∑_{k<n} 2ᵏ = 2ⁿ−1, written subtraction-free as
-- (∑ 2ᵏ) + 1 = 2ⁿ.  This is also Piṅgala's binary place value: each place is one
-- more than the sum of all lower places.  Proved by induction on the doubling
-- द्वि-घात, no decision.)
--
-- स्रोतांसि : महावीरः, गणितसारसङ्ग्रहः (श्रेढी-व्यवहारः, गुणधनम्) ; पिङ्गलः (शून्य-द्वि) ।
------------------------------------------------------------------------

module Mula.GunaDhana where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_)
open import Cubical.Data.Nat.Properties using (+-assoc ; +-comm ; ·-comm ; ·-distribˡ ; ·-identityˡ)
open import PanktiYoga using (द्वि-घात)
open import Vargana using (घात)

------------------------------------------------------------------------
-- गुण-योग — गुणोत्तर-श्रेढेः आंशिक-योगः : ∑_{k=0}^{n−1} 2ᵏ ।
------------------------------------------------------------------------

गुण-योग : ℕ → ℕ
गुण-योग zero    = zero
गुण-योग (suc n) = गुण-योग n + द्वि-घात n

------------------------------------------------------------------------
-- गुण-नियमः — गुणधनम् (आधारे २) : (∑_{k<n} 2ᵏ) + 1 = 2ⁿ ।
------------------------------------------------------------------------

गुण-नियमः : (n : ℕ) → गुण-योग n + 1 ≡ द्वि-घात n
गुण-नियमः zero    = refl
गुण-नियमः (suc n) =
    ( sym (+-assoc (गुण-योग n) (द्वि-घात n) 1)
    ∙ cong (गुण-योग n +_) (+-comm (द्वि-घात n) 1)
    ∙ +-assoc (गुण-योग n) 1 (द्वि-घात n) )
  ∙ cong (_+ द्वि-घात n) (गुण-नियमः n)

------------------------------------------------------------------------
-- उदाहरणम् — 1+2+4+8+16 = 31 = 2⁵−1 (refl-सिद्धम्) ।
------------------------------------------------------------------------

गुण-५ : गुण-योग 5 ≡ 31
गुण-५ = refl

------------------------------------------------------------------------
-- गुणधनम् (सामान्य-आधारः) — महावीरस्य गुणोत्तर-श्रेढी-योगः यथेच्छ-आधारे r ।
-- ∑_{k=0}^{n−1} rᵏ = (rⁿ−1)/(r−1) , ऋण-रहित-रूपे : r·S + 1 = S + rⁿ ।
-- (Mahāvīra's general geometric-series sum: r·S + 1 = S + rⁿ, equivalently
--  (r−1)·S = rⁿ−1, subtraction-free over ℕ for any base r.  r=2 recovers गुण-नियमः.)
------------------------------------------------------------------------

गुण-योग-r : ℕ → ℕ → ℕ
गुण-योग-r r zero    = zero
गुण-योग-r r (suc n) = गुण-योग-r r n + घात r n

गुणधनम् : (r n : ℕ) → r · गुण-योग-r r n + 1 ≡ गुण-योग-r r n + घात r n
गुणधनम् r zero    = cong (_+ 1) (·-comm r zero)
गुणधनम् r (suc n) =
    cong (_+ 1) (sym (·-distribˡ r (गुण-योग-r r n) (घात r n)))
  ∙ ( sym (+-assoc (r · गुण-योग-r r n) (घात r (suc n)) 1)
    ∙ cong (r · गुण-योग-r r n +_) (+-comm (घात r (suc n)) 1)
    ∙ +-assoc (r · गुण-योग-r r n) 1 (घात r (suc n)) )
  ∙ cong (_+ घात r (suc n)) (गुणधनम् r n)

-- उदाहरणम् — आधारे ३ : 1+3+9 = 13 ; 3·13+1 = 40 = 13 + 27 (refl-सिद्धे) ।
गुण-r-३ : गुण-योग-r 3 3 ≡ 13
गुण-r-३ = refl

------------------------------------------------------------------------
-- गुण-योग-r-एक — आधारे १ (सीमा-स्थितिः) : ∑_{k<n} 1ᵏ = n ।
-- (r=1 इति गुणधन-सूत्रं (rⁿ−1)/(r−1) भग्नम् (०/०) ; तत्र योगः केवलं n , यतः
--  एकस्य कोऽपि घातः एकः (घात-एक : 1ᵏ = 1, जैन-घात-नियमः) ।)
--
-- (The r=1 boundary the closed form (rⁿ−1)/(r−1) cannot reach (0/0): there the
--  geometric sum is just n, since any power of 1 is 1 — घात-एक, the Jain index
--  law 1ᵏ = 1.)
------------------------------------------------------------------------

घात-एक : (k : ℕ) → घात 1 k ≡ 1
घात-एक zero    = refl
घात-एक (suc k) = ·-identityˡ (घात 1 k) ∙ घात-एक k

गुण-योग-r-एक : (n : ℕ) → गुण-योग-r 1 n ≡ n
गुण-योग-r-एक zero    = refl
गुण-योग-r-एक (suc n) =
    cong₂ _+_ (गुण-योग-r-एक n) (घात-एक n)
  ∙ +-comm n 1

------------------------------------------------------------------------
-- मुख-गुणः — महावीरस्य मुख-सहितं गुणधनम् : मुखेन (आदि-पदेन) a गुणोत्तर-श्रेढी
-- ∑_{k<n} a·rᵏ = a · (∑_{k<n} rᵏ) — मुखम् योगं रैखिकतया गुणयति ।
-- (महावीरः गुणधनं मुख-सहितम् आह ; अत्र मुखः a एककात् पृथक् : ∑ a·rᵏ = a·∑rᵏ ।
--  एककेन (गुणधनम्) सह पूर्णं महावीर-सूत्रम् : ∑ = a·(rⁿ−1)/(r−1) ।)
--
-- (Mahāvīra's guṇadhana with an explicit mukha (first term) a: the sum
--  ∑_{k<n} a·rᵏ factors as a·(∑_{k<n} rᵏ) — the first term scales the
--  geometric sum linearly.  With गुणधनम् (unit case) this gives Mahāvīra's
--  full formula a·(rⁿ−1)/(r−1).)
------------------------------------------------------------------------

गुण-योग-r-a : ℕ → ℕ → ℕ → ℕ
गुण-योग-r-a a r zero    = zero
गुण-योग-r-a a r (suc n) = गुण-योग-r-a a r n + a · घात r n

मुख-गुणः : (a r n : ℕ) → गुण-योग-r-a a r n ≡ a · गुण-योग-r r n
मुख-गुणः a r zero    = sym (·-comm a zero)
मुख-गुणः a r (suc n) =
    cong (_+ a · घात r n) (मुख-गुणः a r n)
  ∙ ·-distribˡ a (गुण-योग-r r n) (घात r n)

-- उदाहरणम् — आधारे ३, मुखे २ : 2+6+18 = 26 = 2·13 (गुण-r-३ = 13) ।
मुख-r-३ : गुण-योग-r-a 2 3 3 ≡ 2 · गुण-योग-r 3 3
मुख-r-३ = मुख-गुणः 2 3 3
