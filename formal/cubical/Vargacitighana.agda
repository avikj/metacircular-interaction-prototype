{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- वर्गचितिघनः — आर्यभटस्य वर्ग-सङ्कलितम् (आर्यभटीयम्, गणितपादः २२, ४९९ ई.) ।
--
-- आर्यभटः (गणितपादः २२) वर्गाणां योगम् उक्तवान् : ∑k² = n(n+1)(2n+1)/6 ।
-- विभाग-वर्जनार्थं, ऋण-वर्जनार्थं च योग-रूपेण : ६·∑k² + ३·n(n+1) = २·n(n+1)(n+2)
-- (यतः ६·∑k² = २·n(n+1)(n+2) − ३·n(n+1) = n(n+1)(2n+1)) ।
--
-- मूल-अन्तर्दृष्टिः : k² + k = k(k+1) = २·Tₖ ; अतः ∑k² + ∑k = २·(∑ त्रिकोणानि)
-- = २·चिति (योगद्वयम्) — योग-मात्रम्, न घन-क्रुक्सः ।  ततः Citighana.चितिघनः
-- (६·चिति = n(n+1)(n+2)) द्विगुण-सङ्कलितं च योजयित्वा वर्ग-योगः सिध्यति ।
--
-- (Āryabhaṭa's sum of squares, 2.22 — the verse-pair whose cube half is in
-- Sankalita.agda.  Given integrally and subtraction-free as 6·∑k² + 3·n(n+1)
-- ≡ 2·n(n+1)(n+2), equivalent to ∑k² = n(n+1)(2n+1)/6.  The key is k²+k =
-- k(k+1) = 2Tₖ, so ∑k²+∑k ≡ 2·citighana — an ADDITIVE identity, dodging the
-- cubic crux — then assembled from Citighana.चितिघनः and the doubling law.
-- Reuses Sankalita's ∑, द्विगुण and Citighana's चिति, चितिघनः: lane searched.)
--
-- स्रोतांसि : आर्यभटः, आर्यभटीयम्, गणितपादः २२ (वर्गचितिघन-सूत्रम्) ।
------------------------------------------------------------------------

module Vargacitighana where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_)
open import Cubical.Data.Nat.Properties
  using (·-distribˡ ; ·-assoc ; ·-suc ; +-assoc ; +-comm ; +-zero)
open import Mula.Sankalita_AryabhatasSeriesSumsAndTheCubeSumIsTheSquareOfTheSum  using (∑ ; द्विगुण-सङ्कलितम्)
open import Citighana using (चिति ; चितिघनः)

------------------------------------------------------------------------
-- ∑² — वर्गाणां योगः ।
------------------------------------------------------------------------

∑² : ℕ → ℕ
∑² zero    = zero
∑² (suc n) = suc n · suc n + ∑² n

------------------------------------------------------------------------
-- सहायकाः ।
------------------------------------------------------------------------

द्वि· : (x : ℕ) → 2 · x ≡ x + x
द्वि· x = cong (x +_) (+-zero x)

मध्य-विनिमयः : (a b c d : ℕ) → (a + b) + (c + d) ≡ (a + c) + (b + d)
मध्य-विनिमयः a b c d =
    sym (+-assoc a b (c + d))
  ∙ cong (a +_) (+-assoc b c d)
  ∙ cong (a +_) (cong (_+ d) (+-comm b c))
  ∙ cong (a +_) (sym (+-assoc c b d))
  ∙ +-assoc a c (b + d)

-- घ : (n+1)² + (n+1) = (n+1)(n+2) ।
घ : (n : ℕ) → suc n · suc n + suc n ≡ suc n · suc (suc n)
घ n = +-comm (suc n · suc n) (suc n) ∙ sym (·-suc (suc n) (suc n))

------------------------------------------------------------------------
-- योगद्वयम् — मूल-लेम्म : ∑k² + ∑k = २·चिति (k²+k = 2Tₖ इति सङ्कलितम्) ।
------------------------------------------------------------------------

योगद्वयम् : (n : ℕ) → ∑² n + ∑ n ≡ 2 · चिति n
योगद्वयम् zero    = refl
योगद्वयम् (suc n) =
    मध्य-विनिमयः (suc n · suc n) (∑² n) (suc n) (∑ n)
  ∙ cong₂ _+_ (घ n) (योगद्वयम् n)
  ∙ cong (_+ 2 · चिति n)
         (sym (द्वि· (∑ (suc n)) ∙ द्विगुण-सङ्कलितम् (suc n)))
  ∙ ·-distribˡ 2 (∑ (suc n)) (चिति n)

------------------------------------------------------------------------
-- तीन· — ६·∑n = ३·n(n+1) (द्विगुणनेन) ।
------------------------------------------------------------------------

तीन· : (n : ℕ) → 6 · ∑ n ≡ 3 · (n · suc n)
तीन· n = sym (·-assoc 3 2 (∑ n))
       ∙ cong (3 ·_) (द्वि· (∑ n) ∙ द्विगुण-सङ्कलितम् n)

------------------------------------------------------------------------
-- वर्गचितिघनः — मुख्य-सिद्धिः (योग-रूपम्) : ६·∑k² + ३·n(n+1) = २·n(n+1)(n+2) ।
------------------------------------------------------------------------

वर्गचितिघनः : (n : ℕ)
           → 6 · ∑² n + 3 · (n · suc n)
           ≡ 2 · (n · suc n · suc (suc n))
वर्गचितिघनः n =
    cong (6 · ∑² n +_) (sym (तीन· n))
  ∙ ·-distribˡ 6 (∑² n) (∑ n)
  ∙ cong (6 ·_) (योगद्वयम् n)
  ∙ ·-assoc 6 2 (चिति n)
  ∙ sym (·-assoc 2 6 (चिति n))
  ∙ cong (2 ·_) (चितिघनः n)

------------------------------------------------------------------------
-- उदाहरणम् — ∑1²..4² = 30 ; 6·30 + 3·(4·5) = 180+60 = 240 = 2·(4·5·6) (refl) ।
------------------------------------------------------------------------

उदाहरणम्-वर्गयोग : ∑² 4 ≡ 30
उदाहरणम्-वर्गयोग = refl

उदाहरणम्-योगरूपम् : 6 · ∑² 4 + 3 · (4 · 5) ≡ 240
उदाहरणम्-योगरूपम् = refl
