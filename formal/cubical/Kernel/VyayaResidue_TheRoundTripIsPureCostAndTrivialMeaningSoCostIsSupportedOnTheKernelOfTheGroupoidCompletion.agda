------------------------------------------------------------------------
-- ‡ß ¬ Cost on the round trip is 2¬len d.
------------------------------------------------------------------------

roundTripCost : {a b : Tm} (d : Derivation a b)
  ‚Üí len (d ++ revD d) ‚â° len d + len d
roundTripCost d = len-++ d (revD d) ‚àô cong (len d +_) (len-revD d)

------------------------------------------------------------------------
-- ‡® ¬ Meaning on the round trip is the trivial path.
--     A round trip is a loop a ‚ a; its meaning is a path
--     eval a œ ‚â° eval a œ, and ‚ï is a set, so it is refl.
------------------------------------------------------------------------

roundTripMeaningTrivial : {a b : Tm} (d : Derivation a b) (œÅ : Env)
  ‚Üí derivation-sound (d ++ revD d) œÅ ‚â° refl
roundTripMeaningTrivial {a} d œÅ =
  isSet‚Ñï (eval a œÅ) (eval a œÅ) (derivation-sound (d ++ revD d) œÅ) refl

------------------------------------------------------------------------
-- ‡© ¬ revD is a dagger, not an inverse: a nonempty round trip is not
--     the identity derivation.  A group inverse would force length 0.
------------------------------------------------------------------------

daggerNotInverse : {a b : Tm} (d : Derivation a b)
  ‚Üí (len d + len d ‚â° zero ‚Üí ‚ä•)      -- d is nonempty (its doubled cost is not 0)
  ‚Üí (d ++ revD d ‚â° done a ‚Üí ‚ä•)
daggerNotInverse d nz eq =
  nz (sym (roundTripCost d) ‚àô cong len eq)
  -- len done a = zero definitionally; cong len eq : len (d ++ revD d) ‚â° len (done a) = 0

------------------------------------------------------------------------
