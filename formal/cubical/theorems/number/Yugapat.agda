------------------------------------------------------------------------
-- ррр░рХрррр-c тФ (b┬c)-ррр▓ррпр тЯ c-ррр▓ррпрор : p┬(b┬c) = (p┬b)┬c р
------------------------------------------------------------------------

рдкреНрд░рдХреНрд╖реЗрдк-c : {b c X Y : тДХ} тЖТ X тЙИ Y [ b ┬╖ c ] тЖТ X тЙИ Y [ c ]
рдкреНрд░рдХреНрд╖реЗрдк-c {b} {c} {X} {Y} (p , q , eq) =
    p ┬╖ b , q ┬╖ b ,
    ( cong (X +_) (sym (┬╖-assoc p b c))
    тИЩ eq
    тИЩ cong (Y +_) (┬╖-assoc q b c) )

------------------------------------------------------------------------
-- ррр░рХрррр-b тФ (b┬c)-ррр▓ррпр тЯ b-ррр▓ррпрор : p┬(b┬c) = (p┬c)┬b р
------------------------------------------------------------------------

рдкреНрд░рдХреНрд╖реЗрдк-b : {b c X Y : тДХ} тЖТ X тЙИ Y [ b ┬╖ c ] тЖТ X тЙИ Y [ b ]
рдкреНрд░рдХреНрд╖реЗрдк-b {b} {c} {X} {Y} (p , q , eq) =
    p ┬╖ c , q ┬╖ c ,
    ( cong (X +_) (sym (рдкреБрдирд░реН-рдХреНрд░рдордГ p))
    тИЩ eq
    тИЩ cong (Y +_) (рдкреБрдирд░реН-рдХреНрд░рдордГ q) )
  where
    рдкреБрдирд░реН-рдХреНрд░рдордГ : (t : тДХ) тЖТ t ┬╖ (b ┬╖ c) тЙб (t ┬╖ c) ┬╖ b
    рдкреБрдирд░реН-рдХреНрд░рдордГ t = cong (t ┬╖_) (┬╖-comm b c) тИЩ ┬╖-assoc t c b

