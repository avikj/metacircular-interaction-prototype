--   8 = 2 + 2┬3  (рррр 2, рр╡р░рррирор 3) ;  8 = 3 + 1┬5  (рррр 3, рр╡р░рррирор 5) р
------------------------------------------------------------------------

рдпреБрддрд┐-рей : 8 тЙИ 2 [ 3 ]
рдпреБрддрд┐-рей = 0 , 2 , refl        -- 8 + 0┬╖3 тЙб 2 + 2┬╖3

рдпреБрддрд┐-рел : 8 тЙИ 3 [ 5 ]
рдпреБрддрд┐-рел = 0 , 1 , refl        -- 8 + 0┬╖5 тЙб 3 + 1┬╖5

-- ррр░рХрррр-ржррррЯр╛риррр : рпрр 15 (=3┬5)-ррр▓ррпрор, ррр 3-ррр▓ррпр 5-ррр▓ррпр р р
рдкреНрд░рдХреНрд╖реЗрдк-рджреГрд╖реНрдЯрд╛рдиреНрддрдГ : 8 тЙИ 23 [ 5 ]
рдкреНрд░рдХреНрд╖реЗрдк-рджреГрд╖реНрдЯрд╛рдиреНрддрдГ = рдкреНрд░рдХреНрд╖реЗрдк-c {3} {5} (1 , 0 , refl)   -- 8 тЙИ 23 [15] тЖТ [5]  (8+1┬╖15 тЙб 23)
