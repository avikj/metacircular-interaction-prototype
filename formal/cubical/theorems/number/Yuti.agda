------------------------------------------------------------------------
-- рпррр┐рр┐ржррзр┐р тФ р░ррЦр┐рХ-рррЧрорррп рр╛рХррр (ржрр╡р┐ржр┐рХр, рррр╡рр) р
------------------------------------------------------------------------

data рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ (a b c : тДХ) : Type where
  рд╡рд╛рдордпреБрддрд┐   : (X Y : тДХ) тЖТ a ┬╖ X тЙб b ┬╖ Y + c тЖТ рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ a b c
  рджрдХреНрд╖рд┐рдгрдпреБрддрд┐ : (X Y : тДХ) тЖТ b ┬╖ Y тЙб a ┬╖ X + c тЖТ рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ a b c

------------------------------------------------------------------------
-- рЧрррирор тФ ррррр┐ржррзр┐р m-рЧрррри рпррр┐рр┐ржррзр┐р рХр░рЛрр┐ (c тЙб g ┬ m) р
-- (scale a Bйzout witness by m to solve a┬X тЙб b┬Y + c when c тЙб g┬m.)
------------------------------------------------------------------------

рдЧреБрдгрдирдореН : {a b g : тДХ} тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a b g тЖТ (c m : тДХ) тЖТ c тЙб g ┬╖ m тЖТ рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ a b c
рдЧреБрдгрдирдореН {a} {b} {g} (рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ x y pf) c m ceq =
  рд╡рд╛рдордпреБрддрд┐ (x ┬╖ m) (y ┬╖ m)
    ( ┬╖-assoc a x m
    тИЩ cong (_┬╖ m) pf                                  -- (b┬╖y + g) ┬╖ m
    тИЩ рд╡рд┐рддрд░рдг (b ┬╖ y) g m                               -- (b┬╖y)┬╖m + g┬╖m
    тИЩ cong (_+ g ┬╖ m) (sym (┬╖-assoc b y m))                 -- b┬╖(y┬╖m) + g┬╖m
    тИЩ cong (b ┬╖ (y ┬╖ m) +_) (sym ceq) )               -- b┬╖(y┬╖m) + c
рдЧреБрдгрдирдореН {a} {b} {g} (рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ x y pf) c m ceq =
  рджрдХреНрд╖рд┐рдгрдпреБрддрд┐ (x ┬╖ m) (y ┬╖ m)
    ( ┬╖-assoc b y m
    тИЩ cong (_┬╖ m) pf                                  -- (a┬╖x + g) ┬╖ m
    тИЩ рд╡рд┐рддрд░рдг (a ┬╖ x) g m                               -- (a┬╖x)┬╖m + g┬╖m
    тИЩ cong (_+ g ┬╖ m) (sym (┬╖-assoc a x m))                 -- a┬╖(x┬╖m) + g┬╖m
    тИЩ cong (a ┬╖ (x ┬╖ m) +_) (sym ceq) )               -- a┬╖(x┬╖m) + c

------------------------------------------------------------------------
-- рпррр┐р тФ роррЦррпрр▓рор : рЧрр┐р рпржр┐ g ррр░рпррррр┐, р c тЙб g ┬ m, рр░ррр┐ р░ррЦр┐рХ-рррЧрор
-- a ┬ X тЙб b ┬ Y + c (р╡р╛ р╡р┐рр░ррпрпр) рр╛рзр┐рр р  рр рр╡ рр░ррпррЯрррп рХррЯррЯрХр р
-- (main result: if the gait resolves to g and c is a multiple of g, the
-- linear congruence a┬X тЙб c (mod b) is solved тФ ryabhaa's very kuaka.)
------------------------------------------------------------------------

рдпреБрддрд┐рдГ : (f a b g c m : тДХ)
      тЖТ рдлрд▓ (рдЧрддрд┐ f a b) тЙб рдЧреБрд░реБрдГ g
      тЖТ c тЙб g ┬╖ m
      тЖТ рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ a b c
рдпреБрддрд┐рдГ f a b g c m eq ceq = рдЧреБрдгрдирдореН (рдмреАрдЬрдЧрдгрд┐рддрдореН f a b g eq) c m ceq

------------------------------------------------------------------------
-- рр░р┐р╡р╛р░р тФ рр░ррпррЯрррп р╡р╛рррр╡р┐рХр рр▓рор : ри ррХр рр╛рзрирор, рХр┐риррр рририррр ррр░ррр р
-- ррХрррор╛рр рр╛рзрир╛рр (X, Y), ррр░рррпррХр k-рр░ррр, (X + k┬b, Y + k┬a) ррр┐ рр╛рзрирор тФ
-- рпрр a┬(k┬b) тЙб b┬(k┬a) (ррор╛рр╡р░рррирор) р  ррпрор рр╡ рХррЯррЯрХрррп рр╛рор╛риррп-рр╛рзрирор р
-- (the family тФ ryabhaa's actual result: not one solution but an infinite
-- arithmetic progression.  From one (X, Y), for every k, (X + k┬b, Y + k┬a)
-- also solves тФ because a┬(k┬b) тЙб b┬(k┬a).  This is the kuaka's general
-- solution, the one it was prized for.)
------------------------------------------------------------------------

-- ррор╛рр╡р░рррирор : a ┬ (k ┬ b) тЙб b ┬ (k ┬ a)
рддрд┐рд░реНрдпрдХреН : (a k b : тДХ) тЖТ a ┬╖ (k ┬╖ b) тЙб b ┬╖ (k ┬╖ a)
рддрд┐рд░реНрдпрдХреН a k b = ┬╖-assoc a k b тИЩ ┬╖-comm (a ┬╖ k) b тИЩ cong (b ┬╖_) (┬╖-comm a k)

рдкрд░рд┐рд╡рд╛рд░рдГ : {a b c : тДХ} тЖТ рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ a b c тЖТ (k : тДХ) тЖТ рдпреБрддрд┐рд╕рд┐рджреНрдзрд┐ a b c
рдкрд░рд┐рд╡рд╛рд░рдГ {a} {b} {c} (рд╡рд╛рдордпреБрддрд┐ X Y pf) k =
  рд╡рд╛рдордпреБрддрд┐ (X + k ┬╖ b) (Y + k ┬╖ a)
    ( рд╡рд╛рдо-рд╡рд┐рддрд░рдг a X (k ┬╖ b)
    тИЩ cong (_+ a ┬╖ (k ┬╖ b)) pf
    тИЩ +-рдордзреНрдп (b ┬╖ Y) c (a ┬╖ (k ┬╖ b))
    тИЩ cong (╬╗ z тЖТ (b ┬╖ Y + z) + c) (рддрд┐рд░реНрдпрдХреН a k b)
    тИЩ cong (_+ c) (sym (рд╡рд╛рдо-рд╡рд┐рддрд░рдг b Y (k ┬╖ a))) )
рдкрд░рд┐рд╡рд╛рд░рдГ {a} {b} {c} (рджрдХреНрд╖рд┐рдгрдпреБрддрд┐ X Y pf) k =
  рджрдХреНрд╖рд┐рдгрдпреБрддрд┐ (X + k ┬╖ b) (Y + k ┬╖ a)
    ( рд╡рд╛рдо-рд╡рд┐рддрд░рдг b Y (k ┬╖ a)
    тИЩ cong (_+ b ┬╖ (k ┬╖ a)) pf
    тИЩ +-рдордзреНрдп (a ┬╖ X) c (b ┬╖ (k ┬╖ a))
    тИЩ cong (╬╗ z тЖТ (a ┬╖ X + z) + c) (sym (рддрд┐рд░реНрдпрдХреН a k b))
    тИЩ cong (_+ c) (sym (рд╡рд╛рдо-рд╡рд┐рддрд░рдг a X (k ┬╖ b))) )
