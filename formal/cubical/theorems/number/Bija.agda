{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- ррррор тФ рХррЯррЯрХрррп р╡р╛рррр╡р┐рХр ррр░рпрЛррирор : р░ррЦр┐рХ-рроррХр░ррррп рр╛рзрирор р
-- (рЧрр░рррор рр рЙррр▓рор рр╡ р)  рр░ррпррЯр рЛррррЦррпр╛р ри ррр░р╛рпррЩррХрр тФ р╡р▓рр▓ррпр╛р
-- рр░ррпр╛рп-ржр┐рр╛ (alternating orientation) рр╡ ррр рр╛рзрпрр┐ р  ррр рррр░ рр░рр╡р
-- тХ-рорзррпр : ррр░рр┐рр╛ржр рЧрррХр рХрр╡р▓р ррЩррХр▓рирри рр░рЛррр, ржр┐рр╛ р ррор╛ррррр рир┐р░ррррр╛ р
--
-- ррррр┐ржррзр┐р ржрр╡р┐рзр╛ (р╡р▓рр▓ррпр╛р рр░ррпр╛рпр) :
--   р╡р╛рорр┐ржррзр┐р  x y : a ┬ x тЙб b ┬ y + g
--   ржрХррр┐ррр┐ржррзр┐р x y : b ┬ y тЙб a ┬ x + g
-- (Bйzout, the pulverizer's real purpose тФ gcd is only a byproduct.
-- ryabhaa used no negatives: the vall's alternating orientation solves
-- it.  So everything stays in тХ тФ coefficients climb by pure addition, the
-- orientation fixed by the terminal.  Two forms, the vall's alternation.)
--
-- ррррир╛ : "рЧрр░рррор g" ррр┐ рррр░ ри ррриррр┐ржррзрор (ррр GurutamaSiddha) ; рррр░
-- рХрр╡р▓р р░ррЦр┐рХ-рррпрЛрЧр a┬x, b┬y, g-ррр┐рр р  (here only the linear relation is
-- proved, for the SAME resolved g; that g is the gcd is GurutamaSiddha.)
------------------------------------------------------------------------

module Bija where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat
  using (тДХ ; zero ; suc ; _+_ ; _┬╖_ ; +-assoc ; +-comm ; ┬╖-comm ; ┬╖-identity╩│)
open import Cubical.Data.Sigma using (_,_ ; fst ; snd)
open import Cubical.Data.Empty using () renaming (rec to тКе-rec)
open import Cubical.Data.Unit using (tt)
open import LosslessReturn
  using (рд╡рд┐рд╡реЗрдХ ; рд╕рдо ; рд╡рд╛рдо ; рджрдХреНрд╖рд┐рдг ; рдЕрд╡рддрд░рдг ; рдЙрддреНрдерд╛рди ; рдкреБрдирд░рд╛рдЧрдордирдореН)
open import Gati using (рдЧреБрд░реБрдГ ; рдлрд▓ ; рдкрдж-рдЧрддрд┐ ; рдЧрддрд┐)
open import Gurutama using (рдХреНрд╖реЗрддреНрд░ ; рдорд╛рди)

------------------------------------------------------------------------
-- тХ-ррррЧрр┐р-ррр╛рпр╛р (the тХ algebra we need тФ all self-contained).
------------------------------------------------------------------------

-- ржрХррр┐р-р╡р┐рр░ррор : (a + b) ┬ m тЙб a ┬ m + b ┬ m
рд╡рд┐рддрд░рдг : (a b m : тДХ) тЖТ (a + b) ┬╖ m тЙб (a ┬╖ m) + (b ┬╖ m)
рд╡рд┐рддрд░рдг zero    b m = refl
рд╡рд┐рддрд░рдг (suc a) b m = cong (m +_) (рд╡рд┐рддрд░рдг a b m) тИЩ +-assoc m (a ┬╖ m) (b ┬╖ m)

-- р╡р╛ро-р╡р┐рр░ррор : a ┬ (x + y) тЙб a ┬ x + a ┬ y
рд╡рд╛рдо-рд╡рд┐рддрд░рдг : (a x y : тДХ) тЖТ a ┬╖ (x + y) тЙб (a ┬╖ x) + (a ┬╖ y)
рд╡рд╛рдо-рд╡рд┐рддрд░рдг a x y =
  ┬╖-comm a (x + y) тИЩ рд╡рд┐рддрд░рдг x y a тИЩ congтВВ _+_ (┬╖-comm x a) (┬╖-comm y a)

-- рорзррпр╡р┐рир┐рорпр : (p + g) + q тЙб (p + q) + g
+-рдордзреНрдп : (p g q : тДХ) тЖТ (p + g) + q тЙб (p + q) + g
+-рдордзреНрдп p g q = sym (+-assoc p g q) тИЩ cong (p +_) (+-comm g q) тИЩ +-assoc p q g

------------------------------------------------------------------------
-- ррррр┐ржррзр┐р тФ р░ррЦр┐рХ-рррпрЛрЧрррп рр╛рХррр, ржрр╡р┐ржр┐рХр (р╡р▓рр▓ррпр╛р рр░ррпр╛рпр) р
------------------------------------------------------------------------

data рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (a b g : тДХ) : Type where
  рд╡рд╛рдорд╕рд┐рджреНрдзрд┐   : (x y : тДХ) тЖТ a ┬╖ x тЙб b ┬╖ y + g тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a b g
  рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ : (x y : тДХ) тЖТ b ┬╖ y тЙб a ┬╖ x + g тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a b g

------------------------------------------------------------------------
-- рр░рЛррр рржр : рЧрррХр ррЩррХр▓рирри р╡р░ррзррр, ржр┐рр╛ р░рХррррпрр р
--   р╡р╛ро-рр : (a', b) тТ (b + a', b)   [рпррЧррор a = b + a' р░ррр]  X=x, Y=y+x
--   ржрХррр┐р-рр : (a, b') тТ (a, a + b')  [рпррЧррор b = a + b' р░ррр]  X=x+y, Y=y
------------------------------------------------------------------------

рд╡рд╛рдо-рдЪрдв : {a' b g : тДХ} тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a' b g тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (b + a') b g
рд╡рд╛рдо-рдЪрдв {a'} {b} {g} (рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ x y pf) =
  рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ x (y + x)
    ( рд╡рд┐рддрд░рдг b a' x
    тИЩ cong (b ┬╖ x +_) pf
    тИЩ ( +-assoc (b ┬╖ x) (b ┬╖ y) g )              -- (b┬╖x + b┬╖y) + g
    тИЩ cong (_+ g) (+-comm (b ┬╖ x) (b ┬╖ y))       -- (b┬╖y + b┬╖x) + g
    тИЩ cong (_+ g) (sym (рд╡рд╛рдо-рд╡рд┐рддрд░рдг b y x)) )      -- b┬╖(y+x) + g
рд╡рд╛рдо-рдЪрдв {a'} {b} {g} (рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ x y pf) =
  рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ x (y + x)
    ( рд╡рд╛рдо-рд╡рд┐рддрд░рдг b y x                             -- b┬╖(y+x) тЙб b┬╖y + b┬╖x
    тИЩ cong (_+ b ┬╖ x) pf                          -- (a'┬╖x + g) + b┬╖x
    тИЩ +-рдордзреНрдп (a' ┬╖ x) g (b ┬╖ x)                    -- (a'┬╖x + b┬╖x) + g
    тИЩ cong (_+ g) (sym (рд╡рд┐рддрд░рдг a' b x))            -- (a'+b)┬╖x + g
    тИЩ cong (╬╗ z тЖТ z ┬╖ x + g) (+-comm a' b) )      -- (b+a')┬╖x + g

рджрдХреНрд╖рд┐рдг-рдЪрдв : {a b' g : тДХ} тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a b' g тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a (a + b') g
рджрдХреНрд╖рд┐рдг-рдЪрдв {a} {b'} {g} (рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ x y pf) =
  рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ (x + y) y
    ( рд╡рд╛рдо-рд╡рд┐рддрд░рдг a x y                             -- a┬╖(x+y) тЙб a┬╖x + a┬╖y
    тИЩ cong (_+ a ┬╖ y) pf                          -- (b'┬╖y + g) + a┬╖y
    тИЩ +-рдордзреНрдп (b' ┬╖ y) g (a ┬╖ y)                    -- (b'┬╖y + a┬╖y) + g
    тИЩ cong (_+ g) (+-comm (b' ┬╖ y) (a ┬╖ y))       -- (a┬╖y + b'┬╖y) + g
    тИЩ cong (_+ g) (sym (рд╡рд┐рддрд░рдг a b' y)) )          -- (a+b')┬╖y + g
рджрдХреНрд╖рд┐рдг-рдЪрдв {a} {b'} {g} (рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ x y pf) =
  рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ (x + y) y
    ( рд╡рд┐рддрд░рдг a b' y                                -- (a+b')┬╖y тЙб a┬╖y + b'┬╖y
    тИЩ cong (a ┬╖ y +_) pf                          -- a┬╖y + (a┬╖x + g)
    тИЩ +-assoc (a ┬╖ y) (a ┬╖ x) g                   -- (a┬╖y + a┬╖x) + g
    тИЩ cong (_+ g) (+-comm (a ┬╖ y) (a ┬╖ x))        -- (a┬╖x + a┬╖y) + g
    тИЩ cong (_+ g) (sym (рд╡рд╛рдо-рд╡рд┐рддрд░рдг a x y)) )       -- a┬╖(x+y) + g

------------------------------------------------------------------------
-- ррр тФ рр░рЛрррор : рпрррор┐рир р▓ррЦр g ррор╛рр┐ррор, рррр░ ррррр┐ржррзр┐р ррррп рпррЧррорррп р
------------------------------------------------------------------------

рдмреАрдЬ : (f : тДХ) (v : рд╡рд┐рд╡реЗрдХ) (g : тДХ) тЖТ рдлрд▓ (рдкрдж-рдЧрддрд┐ f v) тЙб рдЧреБрд░реБрдГ g
    тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (fst (рдЙрддреНрдерд╛рди v)) (snd (рдЙрддреНрдерд╛рди v)) g
рдмреАрдЬ zero v g eq = тКе-rec (subst рдХреНрд╖реЗрддреНрд░ (sym eq) tt)
-- ррор : (d, d), g тЙб d ; р╡р╛рорр┐ржррзр┐ 1 0 : d┬1 тЙб d┬0 + d
рдмреАрдЬ (suc f) (рд╕рдо d) g eq =
  subst (╬╗ z тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ d d z) (cong рдорд╛рди eq)
    (рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ 1 0 (┬╖-identity╩│ d тИЩ sym (cong (_+ d) (┬╖-comm d 0))))
-- р╡р╛ро-ррриррпр : (suc k, 0), g тЙб suc k ; р╡р╛рорр┐ржррзр┐ 1 0 : (suc k)┬1 тЙб 0┬0 + suc k
рдмреАрдЬ (suc f) (рд╡рд╛рдо zero k) g eq =
  subst (╬╗ z тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (suc k) zero z) (cong рдорд╛рди eq)
    (рд╡рд╛рдорд╕рд┐рджреНрдзрд┐ 1 0 (┬╖-identity╩│ (suc k)))
-- ржрХррр┐р-ррриррпр : (0, suc k), g тЙб suc k ; ржрХррр┐ррр┐ржррзр┐ 0 1 : (suc k)┬1 тЙб 0┬0 + suc k
рдмреАрдЬ (suc f) (рджрдХреНрд╖рд┐рдг zero k) g eq =
  subst (╬╗ z тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ zero (suc k) z) (cong рдорд╛рди eq)
    (рджрдХреНрд╖рд┐рдгрд╕рд┐рджреНрдзрд┐ 0 1 (┬╖-identity╩│ (suc k)))
-- р╡р╛ро-рржр : рпррЧррор (suc d + suc k, suc d) = (b + a', b), a'=suc k, b=suc d
рдмреАрдЬ (suc f) (рд╡рд╛рдо (suc d) k) g eq =
  рд╡рд╛рдо-рдЪрдв (subst (╬╗ p тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (fst p) (snd p) g)
                (рдкреБрдирд░рд╛рдЧрдордирдореН (suc k) (suc d))
                (рдмреАрдЬ f (рдЕрд╡рддрд░рдг (suc k) (suc d)) g eq))
-- ржрХррр┐р-рржр : рпррЧррор (suc d, suc d + suc k) = (a, a + b'), a=suc d, b'=suc k
рдмреАрдЬ (suc f) (рджрдХреНрд╖рд┐рдг (suc d) k) g eq =
  рджрдХреНрд╖рд┐рдг-рдЪрдв (subst (╬╗ p тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (fst p) (snd p) g)
                  (рдкреБрдирд░рд╛рдЧрдордирдореН (suc d) (suc k))
                  (рдмреАрдЬ f (рдЕрд╡рддрд░рдг (suc d) (suc k)) g eq))

------------------------------------------------------------------------
-- ррррЧрр┐ррор тФ роррЦррпрр▓рор : рЧрр┐р рпржр┐ g ррр░рпррррр┐, рр░ррр┐ р░ррЦр┐рХ-рррпрЛрЧр
-- a┬x тЙб b┬y + g  (р╡р╛ р╡р┐рр░ррпрпр) тХ-рорзррпр рр┐ржррзр р  рр рр╡ рХррЯррЯрХр р
-- (main result: if the gait resolves to g, then the linear relation
-- a┬x тЙб b┬y + g (or its mirror) holds in тХ тФ this IS the pulverizer.)
------------------------------------------------------------------------

рдмреАрдЬрдЧрдгрд┐рддрдореН : (f a b g : тДХ) тЖТ рдлрд▓ (рдЧрддрд┐ f a b) тЙб рдЧреБрд░реБрдГ g тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ a b g
рдмреАрдЬрдЧрдгрд┐рддрдореН f a b g eq =
  subst (╬╗ p тЖТ рдмреАрдЬрд╕рд┐рджреНрдзрд┐ (fst p) (snd p) g)
        (рдкреБрдирд░рд╛рдЧрдордирдореН a b)
        (рдмреАрдЬ f (рдЕрд╡рддрд░рдг a b) g eq)
