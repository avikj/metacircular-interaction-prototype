рдЪреАрди-рд╢реЗрд╖рдГ : (b c u v rтВБ rтВВ : тДд) тЖТ b ┬╖ u + c ┬╖ v тЙб pos 1
        тЖТ ╬г тДд (╬╗ X тЖТ (X тЙИ rтВБ [ b ]) ├Ч (X тЙИ rтВВ [ c ]))
рдЪреАрди-рд╢реЗрд╖рдГ b c u v rтВБ rтВВ bz =
    X
  , ( u ┬╖ (rтВВ - rтВБ)
    , cong (╬╗ w тЖТ X - w) (sym (cong (rтВБ ┬╖_) bz тИЩ ┬╖IdR rтВБ))
    тИЩ рд╕рдорд┐рдХрд╛-b rтВБ rтВВ b u c v )
  , ( v ┬╖ (rтВБ - rтВВ)
    , cong (╬╗ w тЖТ X - w) (sym (cong (rтВВ ┬╖_) bz тИЩ ┬╖IdR rтВВ))
    тИЩ рд╕рдорд┐рдХрд╛-c rтВБ rтВВ b u c v )
  where
    X : тДд
    X = rтВБ ┬╖ (c ┬╖ v) + rтВВ ┬╖ (b ┬╖ u)

