-- рро-рррр тФ рХррЯррЯрХрррп ррр▓ррп-ррр-рроррриррзр (рр░ррпррЯрррп рЧрр░р-рпррр┐-ррр░рпрЛррирор) р
--
-- рр░ррпррЯр рХррЯррЯрХр рЧрр░р-рпррррпр░рррор (рпржр╛ ржрр╡р рЧрр░рр рр┐рирри-рр╡р░рррир рриррр ррор рррр
-- рХржр╛ ррр░р╛ррриррр) рр╡р┐рррХррр╡р╛рир тФ рррр ррр▓ррп-ррр-рЧрр┐ррор (modular arithmetic) р
-- рррр░ рЛр-р╡р░рррир ррр▓ррп-ррр-рроррриррзрор : x тЙИ y [m] тЯ║ тИ a b, x + a┬m = y + b┬m р
-- рр┐рзррприррр : рррррорр╛ (reflexive), р╡ррпррррХрр░рор (symmetric), рррХрр░рор (transitive),
-- рпрЛрЧ-рриррХрр▓рр╛ (+-cong), рЧррри-рриррХрр▓рр╛ (┬-cong), рЧррр┐р-р▓рЛрр (k┬m тЙИ 0) р
-- рр рХррЯррЯрХ-р▓р╛рир ррри-ррр-ррр░роррпрррп (CRT, рр░ррпррЯрррп р╡р╛рррр╡р┐рХ-ррр░рпрЛррирррп) рррор┐рХр╛ р
--
-- (The kuaka's same-remainder relation тФ ryabhaa's actual purpose was
-- planetary conjunction: when do two bodies of different periods share a
-- remainder?  That is modular arithmetic.  Subtraction-free congruence
-- x тЙИ y [m] тЯ║ тИ a b, x+a┬m = y+b┬m.  Proved an equivalence, compatible with +
-- and ┬, with multiples vanishing тФ the groundwork for CRT (the kuaka's real
-- application), to follow.)
--
-- ррр░рЛрр╛ррр┐ : рр░ррпррЯр, рр░ррпррЯррпрор, рЧрр┐ррр╛ржр рйритУрйрй (рХррЯррЯрХр, рЧрр░р-рпррр┐) р
------------------------------------------------------------------------

module Samasesha where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (тДХ ; zero ; suc ; _+_ ; _┬╖_)
open import Cubical.Data.Nat.Properties
  using (┬╖-distrib╩│ ; ┬╖-assoc ; ┬╖-comm ; +-assoc ; +-comm ; +-zero)
open import Cubical.Data.Sigma using (╬г ; _,_ ; fst ; snd)

------------------------------------------------------------------------
-- рро-ррр-рроррриррзр : x тЙИ y [ m ]  тЯ║  тИ a b, x + a┬m тЙб y + b┬m р
------------------------------------------------------------------------

_тЙИ_[_] : тДХ тЖТ тДХ тЖТ тДХ тЖТ Type
x тЙИ y [ m ] = ╬г тДХ (╬╗ a тЖТ ╬г тДХ (╬╗ b тЖТ x + a ┬╖ m тЙб y + b ┬╖ m))

------------------------------------------------------------------------
-- рррррорр╛, р╡ррпррррХрр░рор, рррХрр░рор тФ ррр▓ррпрр╛-рроррриррзр р
------------------------------------------------------------------------

рддрддреНрд╕рдорддрд╛ : (m x : тДХ) тЖТ x тЙИ x [ m ]
рддрддреНрд╕рдорддрд╛ m x = zero , zero , refl

рд╡реНрдпреБрддреНрдХреНрд░рдордГ : {m x y : тДХ} тЖТ x тЙИ y [ m ] тЖТ y тЙИ x [ m ]
рд╡реНрдпреБрддреНрдХреНрд░рдордГ (a , b , p) = b , a , sym p

рд╕рдВрдХреНрд░рдордГ : {m x y z : тДХ} тЖТ x тЙИ y [ m ] тЖТ y тЙИ z [ m ] тЖТ x тЙИ z [ m ]
рд╕рдВрдХреНрд░рдордГ {m} {x} {y} {z} (a , b , p) (c , d , q) =
    a + c , b + d ,
    ( cong (x +_) (sym (┬╖-distrib╩│ a c m))
    тИЩ +-assoc x (a ┬╖ m) (c ┬╖ m)
    тИЩ cong (_+ c ┬╖ m) p
    тИЩ sym (+-assoc y (b ┬╖ m) (c ┬╖ m))
    тИЩ cong (y +_) (+-comm (b ┬╖ m) (c ┬╖ m))
    тИЩ +-assoc y (c ┬╖ m) (b ┬╖ m)
    тИЩ cong (_+ b ┬╖ m) q
    тИЩ sym (+-assoc z (d ┬╖ m) (b ┬╖ m))
    тИЩ cong (z +_) (+-comm (d ┬╖ m) (b ┬╖ m))
    тИЩ cong (z +_) (┬╖-distrib╩│ b d m) )

------------------------------------------------------------------------
-- рпрЛрЧ-рриррХрр▓рр╛ тФ ррор рпрЛрррпр ррр▓ррпрр╛р р░рХрррр┐ р
------------------------------------------------------------------------

рдпреЛрдЧ-рдЕрдиреБрдХреВрд▓рддрд╛ : {m x y : тДХ} тЖТ x тЙИ y [ m ] тЖТ (z : тДХ) тЖТ (x + z) тЙИ (y + z) [ m ]
рдпреЛрдЧ-рдЕрдиреБрдХреВрд▓рддрд╛ {m} {x} {y} (a , b , p) z =
    a , b ,
    ( sym (+-assoc x z (a ┬╖ m))
    тИЩ cong (x +_) (+-comm z (a ┬╖ m))
    тИЩ +-assoc x (a ┬╖ m) z
    тИЩ cong (_+ z) p
    тИЩ sym (+-assoc y (b ┬╖ m) z)
    тИЩ cong (y +_) (+-comm (b ┬╖ m) z)
    тИЩ +-assoc y z (b ┬╖ m) )

------------------------------------------------------------------------
-- рЧррри-рриррХрр▓рр╛ тФ ррорри рЧрррир ррр▓ррпрр╛р р░рХрррр┐ р
------------------------------------------------------------------------

рдЧреБрдгрди-рдЕрдиреБрдХреВрд▓рддрд╛ : {m x y : тДХ} тЖТ x тЙИ y [ m ] тЖТ (z : тДХ) тЖТ (x ┬╖ z) тЙИ (y ┬╖ z) [ m ]
рдЧреБрдгрди-рдЕрдиреБрдХреВрд▓рддрд╛ {m} {x} {y} (a , b , p) z =
    a ┬╖ z , b ┬╖ z ,
    ( cong (x ┬╖ z +_) (рдкреБрдирд░реН-рдХреНрд░рдордГ a) тИЩ рдЕрдкрд╕рд╛рд░рдГ x a
    тИЩ cong (_┬╖ z) p
    тИЩ sym (рдЕрдкрд╕рд╛рд░рдГ y b) тИЩ cong (y ┬╖ z +_) (sym (рдкреБрдирд░реН-рдХреНрд░рдордГ b)) )
  where
    -- (t┬z)┬m тЙб (t┬m)┬z : рррир░р-рХрр░рор
    рдкреБрдирд░реН-рдХреНрд░рдордГ : (t : тДХ) тЖТ (t ┬╖ z) ┬╖ m тЙб (t ┬╖ m) ┬╖ z
    рдкреБрдирд░реН-рдХреНрд░рдордГ t =
        sym (┬╖-assoc t z m)
      тИЩ cong (t ┬╖_) (┬╖-comm z m)
      тИЩ ┬╖-assoc t m z
    -- w┬z + (t┬m)┬z тЙб (w + t┬m)┬z : рррр╛р░р (distribute z out)
    рдЕрдкрд╕рд╛рд░рдГ : (w t : тДХ) тЖТ w ┬╖ z + (t ┬╖ m) ┬╖ z тЙб (w + t ┬╖ m) ┬╖ z
    рдЕрдкрд╕рд╛рд░рдГ w t = ┬╖-distrib╩│ w (t ┬╖ m) z

------------------------------------------------------------------------
-- рЧррр┐р-р▓рЛрр тФ m-рЧррр┐рр ррриррпррр▓ррпрор : k┬m тЙИ 0 [ m ] р
------------------------------------------------------------------------

рдЧреБрдгрд┐рдд-рд▓реЛрдкрдГ : (m k : тДХ) тЖТ (k ┬╖ m) тЙИ 0 [ m ]
рдЧреБрдгрд┐рдд-рд▓реЛрдкрдГ m k = zero , k , +-zero (k ┬╖ m)
