{-# OPTIONS --cubical --safe #-}

------------------------------------------------------------------------
-- सङ्कलितम् — आर्यभटस्य श्रेढी-योगाः (आर्यभटीय-गणितपादः, ४९९ ई.) ।
--   एकोत्तर-सङ्कलितम् : 2·∑n = n(n+1) ।
--   घन-सङ्कलितम् (रत्नम्) : ∑k³ = (∑k)² — "घनचितिघनः वर्गचितेः वर्गः" ।
-- घनानां योगः योगस्य वर्गः — हस्त-साधनम् (वितरण-वाम-वितरणाभ्याम्), न साधकेन ।
--
-- (Āryabhaṭa's series sums, 499 CE: 2·∑k = n(n+1), and the gem
-- ∑k³ = (∑k)² — the sum of cubes is the square of the sum — proved here by
-- hand via left/right distributivity, since the ℕ solver chokes on suc.)
------------------------------------------------------------------------

module SourcedProofs.Sankalita_AryabhatasSeriesSumsAndTheCubeSumIsTheSquareOfTheSum where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat
  using (ℕ ; zero ; suc ; _+_ ; _·_ ; ·-suc ; ·-comm ; +-assoc)

------------------------------------------------------------------------
-- वितरणे — दक्षिण (a+b)·c ≡ a·c+b·c च वाम a·(b+c) ≡ a·b+a·c ।
------------------------------------------------------------------------

वितरण : (a b c : ℕ) → (a + b) · c ≡ (a · c) + (b · c)
वितरण zero    b c = refl
वितरण (suc a) b c = cong (c +_) (वितरण a b c) ∙ +-assoc c (a · c) (b · c)

वाम-वितरण : (a b c : ℕ) → a · (b + c) ≡ (a · b) + (a · c)
वाम-वितरण a b c =
  ·-comm a (b + c) ∙ वितरण b c a ∙ cong₂ _+_ (·-comm b a) (·-comm c a)

------------------------------------------------------------------------
-- सङ्कलितम् (∑ 1..n) च घन-सङ्कलितम् (∑ 1³..n³) ।
------------------------------------------------------------------------

∑ : ℕ → ℕ
∑ zero    = zero
∑ (suc n) = suc n + ∑ n

∑³ : ℕ → ℕ
∑³ zero    = zero
∑³ (suc n) = (suc n · (suc n · suc n)) + ∑³ n

------------------------------------------------------------------------
-- द्विगुण-सङ्कलितम् — 2·∑n = n(n+1) ।
------------------------------------------------------------------------

private
  समापन : (n : ℕ) → (suc n + suc n) + n · suc n ≡ suc n · suc (suc n)
  समापन n = sym
    ( ·-suc (suc n) (suc n)
    ∙ cong (suc n +_) (·-suc (suc n) n)
    ∙ cong (λ z → suc n + (suc n + z)) (·-comm (suc n) n)
    ∙ +-assoc (suc n) (suc n) (n · suc n) )

  पुनर्विन्यास : (a s : ℕ) → (a + s) + (a + s) ≡ (a + a) + (s + s)
  पुनर्विन्यास a s =
      +-assoc (a + s) a s
    ∙ cong (_+ s) (sym (+-assoc a s a) ∙ cong (a +_) (+-comm s a) ∙ +-assoc a a s)
    ∙ sym (+-assoc (a + a) s s)
    where open import Cubical.Data.Nat using (+-comm)

द्विगुण-सङ्कलितम् : (n : ℕ) → ∑ n + ∑ n ≡ n · suc n
द्विगुण-सङ्कलितम् zero    = refl
द्विगुण-सङ्कलितम् (suc n) =
    पुनर्विन्यास (suc n) (∑ n)
  ∙ cong ((suc n + suc n) +_) (द्विगुण-सङ्कलितम् n)
  ∙ समापन n

------------------------------------------------------------------------
-- घन-सङ्कलितम् — ∑k³ = (∑k)² (आर्यभटस्य रत्नम्) ।
-- क्रुक्सः : A³ + s² ≡ (A+s)²  यदा  s+s = n·A  (A = suc n) — यतः A + n·A
-- संरचनया A·A (suc n · suc n = suc n + n·suc n) ।
------------------------------------------------------------------------

-- अमूर्तेन A (न suc n) — स्थिरम्, अपचयं विना ; द्वे तथ्ये (h1, h2) दत्ते ।
private
  क्रुक्स : (A n s : ℕ) → s + s ≡ n · A → A + n · A ≡ A · A
         → A · (A · A) + s · s ≡ (A + s) · (A + s)
  क्रुक्स A n s h1 h2 = sym
    ( वितरण A s (A + s)
    ∙ cong (_+ s · (A + s)) (वाम-वितरण A A s)
    ∙ cong ((A · A + A · s) +_) (वाम-वितरण s A s)
    ∙ sym (+-assoc (A · A) (A · s) (s · A + s · s))
    ∙ cong (λ z → A · A + (A · s + (z + s · s))) (·-comm s A)
    ∙ cong (A · A +_) (+-assoc (A · s) (A · s) (s · s))
    ∙ cong (λ z → A · A + (z + s · s)) (sym (वाम-वितरण A s s))
    ∙ cong (λ z → A · A + (A · z + s · s)) h1
    ∙ +-assoc (A · A) (A · (n · A)) (s · s)
    ∙ cong (_+ s · s) (sym (वाम-वितरण A A (n · A)))
    ∙ cong (λ z → A · z + s · s) h2 )

घन-सङ्कलितम् : (n : ℕ) → ∑³ n ≡ ∑ n · ∑ n
घन-सङ्कलितम् zero    = refl
घन-सङ्कलितम् (suc n) =
    cong (λ z → suc n · (suc n · suc n) + z) (घन-सङ्कलितम् n)
  ∙ क्रुक्स (suc n) n (∑ n) (द्विगुण-सङ्कलितम् n) refl

------------------------------------------------------------------------
-- उदाहरणम् — ∑1..4 = 10 ; ∑1³..4³ = 100 = 10² (refl-सिद्धम्) ।
------------------------------------------------------------------------

उदाहरणम्-योग : ∑ 4 ≡ 10
उदाहरणम्-योग = refl

उदाहरणम्-घन : ∑³ 4 ≡ 100
उदाहरणम्-घन = refl

उदाहरणम्-रत्नम् : ∑³ 4 ≡ ∑ 4 · ∑ 4
उदाहरणम्-रत्नम् = घन-सङ्कलितम् 4

------------------------------------------------------------------------
-- त्रिकोण-वर्गः — वर्गः = द्वयोः क्रमागत-त्रिकोण-सङ्ख्ययोः योगः : T(n+1)+T(n) = (n+1)² ।
-- (∑ = त्रिकोण-सङ्ख्या ; द्वे क्रमागते मिलित्वा वर्गम् जनयतः — मेरु-द्विगुण-सङ्कलितात् ।
--  आकृति-सङ्ख्या-नियमः, न कश्चित् विशेष-श्लोकः अत्र दाव्यते ।)
--
-- (A square is the sum of two consecutive triangular numbers: ∑(n+1)+∑n ≡ (n+1)²,
-- straight from 2·∑n = n(n+1).  A figurate identity; no specific verse claimed.)
------------------------------------------------------------------------

त्रिकोण-वर्गः : (n : ℕ) → ∑ (suc n) + ∑ n ≡ suc n · suc n
त्रिकोण-वर्गः n =
    sym (+-assoc (suc n) (∑ n) (∑ n))
  ∙ cong (suc n +_) (द्विगुण-सङ्कलितम् n)

-- उदाहरणम् — T(4)+T(3) = 10+6 = 16 = 4² (refl-सिद्धम्) ।
त्रिकोण-वर्ग-४ : ∑ 4 + ∑ 3 ≡ 16
त्रिकोण-वर्ग-४ = refl
