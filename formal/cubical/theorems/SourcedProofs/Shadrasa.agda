{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- षड्रस-सङ्कलनम् — भास्करस्य रस-संयोग-गणना (लीलावती, ~११५० ई.) ।
--
-- भास्करः (लीलावती, अङ्कपाश-प्रकरणे) षण्णां रसानाम् (मधुर-अम्ल-लवण-कटु-तिक्त-
-- कषाय) संयोगान् गणयति : एकैकशः, द्वि-द्वि, … षट्-सर्वे — प्रत्येकं मानं
-- मेरु-सङ्ख्या C(6,k) ।  तेषां योगः = कुल-संयोगाः = 2⁶ = ६४ (रिक्तेन सह) ,
-- अरिक्ताः ६३ ।  एषा एव मेरु-पङ्क्ति-योग-नीतिः (PanktiYoga) — भास्करस्य रस-
-- दृष्टान्तः तस्याः विशेषः ।  (मेरु-सङ्ख्या भाज्य-क्रमात् न, गुरु-गणनातः , इति
-- छन्दो-मूलम् Dvipada-मध्ये ।)
--
-- (Bhāskara's six-tastes combinatorics, Līlāvatī ~1150: the ways to combine
-- the six rasas taken 1,2,…,6 at a time number C(6,k) each, and their sum is
-- the total 2⁶ = 64 (with the empty), 63 nonempty.  This IS the meru row-sum
-- (PanktiYoga); the six-taste case is Bhāskara's instance of it — combinations
-- decomposed by size sum to all subsets.)
--
-- स्रोतांसि : भास्कर II, लीलावती (षड्रस-संयोग-दृष्टान्तः) ; PanktiYoga (मेरु-योगः) ।
------------------------------------------------------------------------

module SourcedProofs.Shadrasa where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ)
open import Dvipada using (C)
open import PanktiYoga using (पूर्व ; द्वि-घात ; पङ्क्ति-योगः)

------------------------------------------------------------------------
-- रस-पङ्क्तिः — प्रति-परिमाण-संयोगाः C(6,k) : 1,6,15,20,15,6,1 (refl) ।
------------------------------------------------------------------------

एक-रसाः   : C 6 1 ≡ 6       -- एकैकशः
एक-रसाः   = refl

द्वि-रसाः  : C 6 2 ≡ 15      -- द्वि-द्वि
द्वि-रसाः  = refl

त्रि-रसाः  : C 6 3 ≡ 20      -- त्रि-त्रि (मध्यमः, महत्तमः)
त्रि-रसाः  = refl

------------------------------------------------------------------------
-- रस-योगः — कुल-संयोगाः = ∑ₖ C(6,k) = 2⁶ (मेरु-पङ्क्ति-योग-नीत्या) ।
------------------------------------------------------------------------

रस-योगः : पूर्व 6 6 ≡ द्वि-घात 6
रस-योगः = पङ्क्ति-योगः 6

षट्-कुलम् : पूर्व 6 6 ≡ 64        -- रिक्तेन सह सर्वे रस-संयोगाः
षट्-कुलम् = पङ्क्ति-योगः 6
