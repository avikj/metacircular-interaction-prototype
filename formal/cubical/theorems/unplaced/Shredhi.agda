{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- ррр░ррр-рр▓рор тФ рр░ррпррЯрррп ррор╛риррр░-ррр░ррр-рпрЛрЧр (рр░ррпррЯррпрор, рЧрр┐ррр╛ржр рзрп, ррпрп рИ.) р
--
-- рр░ррпррЯр (рЧрр┐ррр╛ржр рзрп) ррор╛риррр░-ррр░ррррпр╛р (роррЦ a, ррпр d, рржр╛рир┐ n) рпрЛрЧрор рр :
-- рорзррпрзрир Ч рржррЩррЦррпр╛ = рпрЛрЧр , рр░ррр╛рр S = n┬(2a + (nтИТ1)d)/2 р  р╡р┐рр╛рЧ-р╡р░рррир╛р░рррор :
-- ри┬S = n┬(2a) + n┬(nтИТ1)┬d р  ррр╛ рр░рр╡-ррор╛риррр░-ррр░ррррпр╛р рр╛рор╛риррпр╛ ; тИk (Sankalita)
-- ррррпр╛р a=1,d=1 р╡р┐рррр р
--
-- (ryabhaa's arithmetic-progression sum, 2.19: for first term a, common
-- difference d, n terms, S = n(2a+(nтИТ1)d)/2 тФ the mean times the count.  Given
-- integrally as 2S = n┬(2a) + n(nтИТ1)d.  This is the GENERAL arithmetic series,
-- of which тИk in Sankalita.agda is the a=1, d=1 case.  Proved by induction; the
-- quadratic in n uses ржрр╡р┐-рпрЛрЧр: 2n + n(nтИТ1) тЙб n(n+1).)
--
-- ррр░рЛрр╛ррр┐ : рр░ррпррЯр, рр░ррпррЯррпрор, рЧрр┐ррр╛ржр рзрп (рорзррпрзри-ррр░ррррр▓-ррррр░рор) р
------------------------------------------------------------------------

module Shredhi where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (тДХ ; zero ; suc ; _+_ ; _┬╖_ ; _тИ╕_)
open import Cubical.Data.Nat.Properties
  using (┬╖-distrib╦б ; ┬╖-distrib╩│ ; ┬╖-assoc ; ┬╖-comm ; ┬╖-suc ; +-assoc ; +-zero)

------------------------------------------------------------------------
-- ррр╛рпрХр р
------------------------------------------------------------------------

рджреНрд╡рд┐┬╖ : (x : тДХ) тЖТ 2 ┬╖ x тЙб x + x
рджреНрд╡рд┐┬╖ x = cong (x +_) (+-zero x)

-- ржрр╡р┐-рпрЛрЧр : 2n + n(nтИТ1) = n(n+1) р
рджреНрд╡рд┐-рдпреЛрдЧрдГ : (n : тДХ) тЖТ 2 ┬╖ n + n ┬╖ (n тИ╕ 1) тЙб n ┬╖ suc n
рджреНрд╡рд┐-рдпреЛрдЧрдГ zero    = refl
рджреНрд╡рд┐-рдпреЛрдЧрдГ (suc m) =
    cong (_+ suc m ┬╖ m) (рджреНрд╡рд┐┬╖ (suc m))
  тИЩ sym (+-assoc (suc m) (suc m) (suc m ┬╖ m))
  тИЩ cong (suc m +_) (sym (┬╖-suc (suc m) m))
  тИЩ sym (┬╖-suc (suc m) (suc m))

------------------------------------------------------------------------
-- ррр░ррр тФ ррор╛риррр░-ррр░ррррпр╛р рпрЛрЧр : a + (a+d) + (a+2d) + тж (n рржр╛рир┐) р
------------------------------------------------------------------------

рд╢реНрд░реЗрдвреА : тДХ тЖТ тДХ тЖТ тДХ тЖТ тДХ
рд╢реНрд░реЗрдвреА a d zero    = zero
рд╢реНрд░реЗрдвреА a d (suc n) = a + рд╢реНрд░реЗрдвреА (a + d) d n

------------------------------------------------------------------------
-- ррр░ррр-рр▓рор тФ роррЦррп-рр┐ржррзр┐р : ри┬S = n┬(2a) + n┬(nтИТ1)┬d р
------------------------------------------------------------------------

рд╢реНрд░реЗрдвреА-рдлрд▓рдореН : (a d n : тДХ)
          тЖТ 2 ┬╖ рд╢реНрд░реЗрдвреА a d n тЙб n ┬╖ (2 ┬╖ a) + (n ┬╖ (n тИ╕ 1)) ┬╖ d
рд╢реНрд░реЗрдвреА-рдлрд▓рдореН a d zero    = refl
рд╢реНрд░реЗрдвреА-рдлрд▓рдореН a d (suc n) =
    sym (┬╖-distrib╦б 2 a (рд╢реНрд░реЗрдвреА (a + d) d n))
  тИЩ cong (2 ┬╖ a +_) (рд╢реНрд░реЗрдвреА-рдлрд▓рдореН (a + d) d n)
  тИЩ cong (╬╗ z тЖТ 2 ┬╖ a + (z + (n ┬╖ (n тИ╕ 1)) ┬╖ d)) expand
  тИЩ regroup
  тИЩ congтВВ _+_ refl secondGroup
  where
    P Q R : тДХ
    P = n ┬╖ (2 ┬╖ a)
    Q = n ┬╖ (2 ┬╖ d)
    R = (n ┬╖ (n тИ╕ 1)) ┬╖ d
    expand : n ┬╖ (2 ┬╖ (a + d)) тЙб P + Q
    expand = cong (n ┬╖_) (sym (┬╖-distrib╦б 2 a d))
           тИЩ sym (┬╖-distrib╦б n (2 ┬╖ a) (2 ┬╖ d))
    regroup : 2 ┬╖ a + ((P + Q) + R) тЙб (2 ┬╖ a + P) + (Q + R)
    regroup = cong (2 ┬╖ a +_) (sym (+-assoc P Q R))
            тИЩ +-assoc (2 ┬╖ a) P (Q + R)
    secondGroup : Q + R тЙб (suc n ┬╖ n) ┬╖ d
    secondGroup =
        cong (_+ R) (┬╖-assoc n 2 d)
      тИЩ ┬╖-distrib╩│ (n ┬╖ 2) (n ┬╖ (n тИ╕ 1)) d
      тИЩ cong (_┬╖ d) (cong (_+ n ┬╖ (n тИ╕ 1)) (┬╖-comm n 2)
                    тИЩ рджреНрд╡рд┐-рдпреЛрдЧрдГ n
                    тИЩ ┬╖-comm n (suc n))

------------------------------------------------------------------------
-- рЙржр╛рр░ррор тФ 2,5,8,11,14 (a=2,d=3,n=5) : рпрЛрЧр = 40 ; 2┬40 = 80 = 5┬4 + 5┬4┬3 р
--   (тИ1..4 = 10 as the a=1,d=1 case : 2┬ррр░ррр 1 1 4 = 20 = 4┬2 + 4┬3┬1.)
------------------------------------------------------------------------

рдЙрджрд╛рд╣рд░рдгрдореН-рд╢реНрд░реЗрдвреА : рд╢реНрд░реЗрдвреА 2 3 5 тЙб 40
рдЙрджрд╛рд╣рд░рдгрдореН-рд╢реНрд░реЗрдвреА = refl

рдЙрджрд╛рд╣рд░рдгрдореН-тИС : рд╢реНрд░реЗрдвреА 1 1 4 тЙб 10          -- тИС1..4, the a=1 d=1 special case
рдЙрджрд╛рд╣рд░рдгрдореН-тИС = refl

------------------------------------------------------------------------
-- ррирр тФ ррор╛риррр░-ррр░ррррпр╛р рриррр┐ро-рржрор (n рржррр) : a + (nтИТ1)┬d р
------------------------------------------------------------------------

рдЕрдиреНрдд : тДХ тЖТ тДХ тЖТ тДХ тЖТ тДХ
рдЕрдиреНрдд a d n = a + (n тИ╕ 1) ┬╖ d

------------------------------------------------------------------------
-- рорзррпрзрирор тФ рр░ррпррЯрррп рорзррпрзри-р░рррор : 2┬S = n┬(рржр┐ + ррирр) = ррж-ррЩррЦррпр╛ Ч (роррЦ+рриррр┐ро) р
-- (рЧрр┐ррр╛ржр рзрп рпрр "рорзррпрзрир рржррЩррЦррпр╛-рЧррр┐рр" ррр┐ рр, ррр рррр тФ ррр░ррр-рр▓рррп
--  р╡р┐ррррр-р░ррр╛рр (n┬2a + n(nтИТ1)d) рорзррп-р░рррор р╡р╛ро-р╡р┐рр░ррри р)
--
-- (ryabhaa's madhyadhana form: 2S = n┬(first + last), the sum as number-of-
-- terms times the mean, which 2.19 states directly.  Derived from the expanded
-- ррр░ррр-рр▓рор by left-distribution and 2a = a + a.)
------------------------------------------------------------------------

рдордзреНрдпрдзрдирдореН : (a d n : тДХ) тЖТ 2 ┬╖ рд╢реНрд░реЗрдвреА a d n тЙб n ┬╖ (a + рдЕрдиреНрдд a d n)
рдордзреНрдпрдзрдирдореН a d n =
    рд╢реНрд░реЗрдвреА-рдлрд▓рдореН a d n
  тИЩ cong (n ┬╖ (2 ┬╖ a) +_) (sym (┬╖-assoc n (n тИ╕ 1) d))
  тИЩ ┬╖-distrib╦б n (2 ┬╖ a) ((n тИ╕ 1) ┬╖ d)
  тИЩ cong (n ┬╖_) (cong (_+ (n тИ╕ 1) ┬╖ d) (рджреНрд╡рд┐┬╖ a)
                  тИЩ sym (+-assoc a a ((n тИ╕ 1) ┬╖ d)))

-- рЙржр╛рр░ррор тФ 2,5,8,11,14 : 2┬40 = 80 = 5┬(2+14) = 5┬16 (refl-рр┐ржррзрор) р
рдордзреНрдп-рел : 2 ┬╖ рд╢реНрд░реЗрдвреА 2 3 5 тЙб 5 ┬╖ (2 + 14)
рдордзреНрдп-рел = refl

------------------------------------------------------------------------
-- рро-ррр░ррр тФ ррриррп-ррп-ррр░ррр (d=0) : n ррор╛ри-рржр╛рир╛р рпрЛрЧр = n┬a р  рр░ррпррЯрррп
-- ррр░ррррр▓р рЧрррирор ррр┐ р╡ррпр╛рррирЛрр┐ тФ рЧрррир ррор╛ри-ррр░ррррпр╛р рпрЛрЧр рр╡ (рррир░р╛р╡рррр-рпрЛрЧр) р
-- (ryabhaa's series with zero common difference: n equal terms sum to n┬a, so
--  the reh subsumes multiplication тФ n┬a is the sum of the constant series.)
------------------------------------------------------------------------

рд╕рдо-рд╢реНрд░реЗрдвреА : (a n : тДХ) тЖТ рд╢реНрд░реЗрдвреА a 0 n тЙб n ┬╖ a
рд╕рдо-рд╢реНрд░реЗрдвреА a zero    = refl
рд╕рдо-рд╢реНрд░реЗрдвреА a (suc n) =
    cong (╬╗ z тЖТ a + рд╢реНрд░реЗрдвреА z 0 n) (+-zero a)
  тИЩ cong (a +_) (рд╕рдо-рд╢реНрд░реЗрдвреА a n)

-- рЙржр╛рр░ррор тФ ррр░ррр 7 0 4 = 28 = 4┬7 (refl-рр┐ржррзрор) р
рд╕рдо-рек : рд╢реНрд░реЗрдвреА 7 0 4 тЙб 28
рд╕рдо-рек = refl
