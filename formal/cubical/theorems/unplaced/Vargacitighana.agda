module Vargacitighana where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (тДХ ; zero ; suc ; _+_ ; _┬╖_)
open import Cubical.Data.Nat.Properties
  using (┬╖-distrib╦б ; ┬╖-assoc ; ┬╖-suc ; +-assoc ; +-comm ; +-zero)
open import Sankalita_AryabhatasSeriesSumsAndTheCubeSumIsTheSquareOfTheSum  using (тИС ; рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН)
open import Citighana using (рдЪрд┐рддрд┐ ; рдЪрд┐рддрд┐рдШрдирдГ)

------------------------------------------------------------------------
-- тИ┬▓ тФ р╡р░ррЧр╛рр╛р рпрЛрЧр р
------------------------------------------------------------------------

тИС┬▓ : тДХ тЖТ тДХ
тИС┬▓ zero    = zero
тИС┬▓ (suc n) = suc n ┬╖ suc n + тИС┬▓ n

------------------------------------------------------------------------
-- ррр╛рпрХр╛р р
------------------------------------------------------------------------

рджреНрд╡рд┐┬╖ : (x : тДХ) тЖТ 2 ┬╖ x тЙб x + x
рджреНрд╡рд┐┬╖ x = cong (x +_) (+-zero x)

рдордзреНрдп-рд╡рд┐рдирд┐рдордпрдГ : (a b c d : тДХ) тЖТ (a + b) + (c + d) тЙб (a + c) + (b + d)
рдордзреНрдп-рд╡рд┐рдирд┐рдордпрдГ a b c d =
    sym (+-assoc a b (c + d))
  тИЩ cong (a +_) (+-assoc b c d)
  тИЩ cong (a +_) (cong (_+ d) (+-comm b c))
  тИЩ cong (a +_) (sym (+-assoc c b d))
  тИЩ +-assoc a c (b + d)

-- рШ : (n+1)┬▓ + (n+1) = (n+1)(n+2) р
рдШ : (n : тДХ) тЖТ suc n ┬╖ suc n + suc n тЙб suc n ┬╖ suc (suc n)
рдШ n = +-comm (suc n ┬╖ suc n) (suc n) тИЩ sym (┬╖-suc (suc n) (suc n))

------------------------------------------------------------------------
-- рпрЛрЧржрр╡рпрор тФ рорр▓-р▓ррорро : тИk┬▓ + тИk = ри┬рр┐рр┐ (k┬▓+k = 2TтЦ ррр┐ ррЩррХр▓р┐ррор) р
------------------------------------------------------------------------

рдпреЛрдЧрджреНрд╡рдпрдореН : (n : тДХ) тЖТ тИС┬▓ n + тИС n тЙб 2 ┬╖ рдЪрд┐рддрд┐ n
рдпреЛрдЧрджреНрд╡рдпрдореН zero    = refl
рдпреЛрдЧрджреНрд╡рдпрдореН (suc n) =
    рдордзреНрдп-рд╡рд┐рдирд┐рдордпрдГ (suc n ┬╖ suc n) (тИС┬▓ n) (suc n) (тИС n)
  тИЩ congтВВ _+_ (рдШ n) (рдпреЛрдЧрджреНрд╡рдпрдореН n)
  тИЩ cong (_+ 2 ┬╖ рдЪрд┐рддрд┐ n)
         (sym (рджреНрд╡рд┐┬╖ (тИС (suc n)) тИЩ рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН (suc n)))
  тИЩ ┬╖-distrib╦б 2 (тИС (suc n)) (рдЪрд┐рддрд┐ n)

------------------------------------------------------------------------
-- ррри┬ тФ р┬тИn = рй┬n(n+1) (ржрр╡р┐рЧрррирри) р
------------------------------------------------------------------------

рддреАрди┬╖ : (n : тДХ) тЖТ 6 ┬╖ тИС n тЙб 3 ┬╖ (n ┬╖ suc n)
рддреАрди┬╖ n = sym (┬╖-assoc 3 2 (тИС n))
       тИЩ cong (3 ┬╖_) (рджреНрд╡рд┐┬╖ (тИС n) тИЩ рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН n)

------------------------------------------------------------------------
-- р╡р░ррЧрр┐рр┐рШрир тФ роррЦррп-рр┐ржррзр┐р (рпрЛрЧ-р░рррор) : р┬тИk┬▓ + рй┬n(n+1) = ри┬n(n+1)(n+2) р
------------------------------------------------------------------------

рд╡рд░реНрдЧрдЪрд┐рддрд┐рдШрдирдГ : (n : тДХ)
           тЖТ 6 ┬╖ тИС┬▓ n + 3 ┬╖ (n ┬╖ suc n)
           тЙб 2 ┬╖ (n ┬╖ suc n ┬╖ suc (suc n))
рд╡рд░реНрдЧрдЪрд┐рддрд┐рдШрдирдГ n =
    cong (6 ┬╖ тИС┬▓ n +_) (sym (рддреАрди┬╖ n))
  тИЩ ┬╖-distrib╦б 6 (тИС┬▓ n) (тИС n)
  тИЩ cong (6 ┬╖_) (рдпреЛрдЧрджреНрд╡рдпрдореН n)
  тИЩ ┬╖-assoc 6 2 (рдЪрд┐рддрд┐ n)
  тИЩ sym (┬╖-assoc 2 6 (рдЪрд┐рддрд┐ n))
  тИЩ cong (2 ┬╖_) (рдЪрд┐рддрд┐рдШрдирдГ n)

