{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- त्रिकरणी — √3 वर्गप्रकृत्या (x² = 3y² + 1) ; शुल्ब-त्रिकोण-अनुपातः ।
--
-- द्विकरणी (√2) इव त्रिकरणी (√3) अपि वर्गप्रकृतिः x²−3y²=1 : मूल-साधनम् (2,1)
-- (4 = 3+1) , ततः भावनया (मूलेन (2,1) संयोजनेन) श्रेढी :
--   (2,1) → (7,4) → (26,15) → (97,56) → …
-- प्रत्येकं मानं १ रक्षति (वृद्धि-मानम्) — अंश/हर = √3-सन्निकर्षाः (7/4, 26/15, …) ।
-- √3 शुल्बे समभुज-त्रिकोणस्य उच्चतायाम् (त्रिकोण-वेदी-रचनायाम्) उपयुज्यते ।
--
-- (√3 as a vargaprakṛti x²=3y²+1, the √2 case's sibling: fundamental (2,1),
--  breeding by bhāvanā with (2,1) gives (7,4),(26,15),… — each norm-1, so each
--  a √3 convergent.  Composing (x,y) with the unit (2,1), i.e. (2x+3y, x+2y),
--  preserves x²−3y² (वृद्धि-मानम्, subtraction-free).  √3 is the śulba's
--  equilateral-triangle ratio.  A polynomial identity, Nat-solver-सिद्धा.)
--
-- स्रोतांसि : वर्गप्रकृति-परम्परा (ब्रह्मगुप्तादिः) ; शुल्बसूत्रम् (त्रिकोण-वेदी) ।
------------------------------------------------------------------------

module Trikarani where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; _+_ ; _·_)
open import Cubical.Data.Sigma using (_×_ ; _,_)
open import Cubical.Tactics.NatSolver.Reflection using (solveℕ!)

------------------------------------------------------------------------
-- भावना (N=3) — (a,b)*(c,d) = (ac+3bd, ad+cb) ।
------------------------------------------------------------------------

भावना-अंश : ℕ → ℕ → ℕ → ℕ → ℕ
भावना-अंश a b c d = a · c + 3 · (b · d)

भावना-हर : ℕ → ℕ → ℕ → ℕ → ℕ
भावना-हर a b c d = a · d + c · b

------------------------------------------------------------------------
-- साधनानि — x² = 3y² + 1 (√3-सन्निकर्ष-अंश-हराः) (refl-सिद्धानि) ।
------------------------------------------------------------------------

वर्गप्रकृतिः-२ : 2 · 2 ≡ 3 · (1 · 1) + 1        -- (2,1)   : 4 = 3+1
वर्गप्रकृतिः-२ = refl

वर्गप्रकृतिः-७ : 7 · 7 ≡ 3 · (4 · 4) + 1        -- (7,4)   : 49 = 48+1
वर्गप्रकृतिः-७ = refl

वर्गप्रकृतिः-२६ : 26 · 26 ≡ 3 · (15 · 15) + 1    -- (26,15) : 676 = 675+1
वर्गप्रकृतिः-२६ = refl

------------------------------------------------------------------------
-- चक्रम् — मूलेन (2,1) संयोजनम् : (2,1) → (7,4) → (26,15) (refl-सिद्धम्) ।
------------------------------------------------------------------------

चक्रम्-१ : (भावना-अंश 2 1 2 1 ≡ 7)  -- 4 + 3
         × (भावना-हर 2 1 2 1 ≡ 4)   -- 2 + 2
चक्रम्-१ = refl , refl

चक्रम्-२ : (भावना-अंश 7 4 2 1 ≡ 26)  -- 14 + 12
         × (भावना-हर 7 4 2 1 ≡ 15)   -- 7 + 8
चक्रम्-२ = refl , refl

------------------------------------------------------------------------
-- वृद्धि-मानम् — मान-रक्षा : मूलेन (2,1) संयोजनं x²−3y² रक्षति ।
-- ऋण-रहित-रूपे : (नव-अंश)² + 3y² = 3·(नव-हर)² + x² ।
------------------------------------------------------------------------

वृद्धि-मानम् : (x y : ℕ)
            → भावना-अंश x y 2 1 · भावना-अंश x y 2 1 + 3 · (y · y)
            ≡ 3 · (भावना-हर x y 2 1 · भावना-हर x y 2 1) + x · x
वृद्धि-मानम् x y = solveℕ!
