{-# OPTIONS --cubical --safe #-}

------------------------------------------------------------------------
-- ррЩррХр▓р┐ррор тФ рр░ррпррЯрррп ррр░ррр-рпрЛрЧр╛р (рр░ррпррЯррп-рЧрр┐ррр╛ржр, ррпрп рИ.) р
--   ррХрЛрррр░-ррЩррХр▓р┐ррор : 2┬тИn = n(n+1) р
--   рШри-ррЩррХр▓р┐ррор (р░рррирор) : тИk┬│ = (тИk)┬▓ тФ "рШрирр┐рр┐рШрир р╡р░ррЧрр┐ррр р╡р░ррЧр" р
-- рШрир╛рир╛р рпрЛрЧр рпрЛрЧрррп р╡р░ррЧр тФ рррр-рр╛рзрирор (р╡р┐рр░р-р╡р╛ро-р╡р┐рр░рр╛рррпр╛рор), ри рр╛рзрХрри р
--
-- (ryabhaa's series sums, 499 CE: 2┬тИk = n(n+1), and the gem
-- тИk┬│ = (тИk)┬▓ тФ the sum of cubes is the square of the sum тФ proved here by
-- hand via left/right distributivity, since the тХ solver chokes on suc.)
------------------------------------------------------------------------

module Sankalita_AryabhatasSeriesSumsAndTheCubeSumIsTheSquareOfTheSum where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat
  using (тДХ ; zero ; suc ; _+_ ; _┬╖_ ; ┬╖-suc ; ┬╖-comm ; +-assoc)

------------------------------------------------------------------------
-- р╡р┐рр░рр тФ ржрХррр┐р (a+b)┬c тЙб a┬c+b┬c р р╡р╛ро a┬(b+c) тЙб a┬b+a┬c р
------------------------------------------------------------------------

рд╡рд┐рддрд░рдг : (a b c : тДХ) тЖТ (a + b) ┬╖ c тЙб (a ┬╖ c) + (b ┬╖ c)
рд╡рд┐рддрд░рдг zero    b c = refl
рд╡рд┐рддрд░рдг (suc a) b c = cong (c +_) (рд╡рд┐рддрд░рдг a b c) тИЩ +-assoc c (a ┬╖ c) (b ┬╖ c)

рд╡рд╛рдо-рд╡рд┐рддрд░рдг : (a b c : тДХ) тЖТ a ┬╖ (b + c) тЙб (a ┬╖ b) + (a ┬╖ c)
рд╡рд╛рдо-рд╡рд┐рддрд░рдг a b c =
  ┬╖-comm a (b + c) тИЩ рд╡рд┐рддрд░рдг b c a тИЩ congтВВ _+_ (┬╖-comm b a) (┬╖-comm c a)

------------------------------------------------------------------------
-- ррЩррХр▓р┐ррор (тИ 1..n) р рШри-ррЩррХр▓р┐ррор (тИ 1┬│..n┬│) р
------------------------------------------------------------------------

тИС : тДХ тЖТ тДХ
тИС zero    = zero
тИС (suc n) = suc n + тИС n

тИС┬│ : тДХ тЖТ тДХ
тИС┬│ zero    = zero
тИС┬│ (suc n) = (suc n ┬╖ (suc n ┬╖ suc n)) + тИС┬│ n

------------------------------------------------------------------------
-- ржрр╡р┐рЧрр-ррЩррХр▓р┐ррор тФ 2┬тИn = n(n+1) р
------------------------------------------------------------------------

private
  рд╕рдорд╛рдкрди : (n : тДХ) тЖТ (suc n + suc n) + n ┬╖ suc n тЙб suc n ┬╖ suc (suc n)
  рд╕рдорд╛рдкрди n = sym
    ( ┬╖-suc (suc n) (suc n)
    тИЩ cong (suc n +_) (┬╖-suc (suc n) n)
    тИЩ cong (╬╗ z тЖТ suc n + (suc n + z)) (┬╖-comm (suc n) n)
    тИЩ +-assoc (suc n) (suc n) (n ┬╖ suc n) )

  рдкреБрдирд░реНрд╡рд┐рдиреНрдпрд╛рд╕ : (a s : тДХ) тЖТ (a + s) + (a + s) тЙб (a + a) + (s + s)
  рдкреБрдирд░реНрд╡рд┐рдиреНрдпрд╛рд╕ a s =
      +-assoc (a + s) a s
    тИЩ cong (_+ s) (sym (+-assoc a s a) тИЩ cong (a +_) (+-comm s a) тИЩ +-assoc a a s)
    тИЩ sym (+-assoc (a + a) s s)
    where open import Cubical.Data.Nat using (+-comm)

рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН : (n : тДХ) тЖТ тИС n + тИС n тЙб n ┬╖ suc n
рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН zero    = refl
рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН (suc n) =
    рдкреБрдирд░реНрд╡рд┐рдиреНрдпрд╛рд╕ (suc n) (тИС n)
  тИЩ cong ((suc n + suc n) +_) (рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН n)
  тИЩ рд╕рдорд╛рдкрди n

------------------------------------------------------------------------
-- рШри-ррЩррХр▓р┐ррор тФ тИk┬│ = (тИk)┬▓ (рр░ррпррЯрррп р░рррирор) р
-- рХрр░ррХррр : A┬│ + s┬▓ тЙб (A+s)┬▓  рпржр╛  s+s = n┬A  (A = suc n) тФ рпрр A + n┬A
-- ррр░ррирпр╛ A┬A (suc n ┬ suc n = suc n + n┬suc n) р
------------------------------------------------------------------------

-- ррорр░рррри A (ри suc n) тФ рррр┐р░рор, ррррпр р╡р┐рир╛ ; ржрр╡р ррррпр (h1, h2) ржрррр р
private
  рдХреНрд░реБрдХреНрд╕ : (A n s : тДХ) тЖТ s + s тЙб n ┬╖ A тЖТ A + n ┬╖ A тЙб A ┬╖ A
         тЖТ A ┬╖ (A ┬╖ A) + s ┬╖ s тЙб (A + s) ┬╖ (A + s)
  рдХреНрд░реБрдХреНрд╕ A n s h1 h2 = sym
    ( рд╡рд┐рддрд░рдг A s (A + s)
    тИЩ cong (_+ s ┬╖ (A + s)) (рд╡рд╛рдо-рд╡рд┐рддрд░рдг A A s)
    тИЩ cong ((A ┬╖ A + A ┬╖ s) +_) (рд╡рд╛рдо-рд╡рд┐рддрд░рдг s A s)
    тИЩ sym (+-assoc (A ┬╖ A) (A ┬╖ s) (s ┬╖ A + s ┬╖ s))
    тИЩ cong (╬╗ z тЖТ A ┬╖ A + (A ┬╖ s + (z + s ┬╖ s))) (┬╖-comm s A)
    тИЩ cong (A ┬╖ A +_) (+-assoc (A ┬╖ s) (A ┬╖ s) (s ┬╖ s))
    тИЩ cong (╬╗ z тЖТ A ┬╖ A + (z + s ┬╖ s)) (sym (рд╡рд╛рдо-рд╡рд┐рддрд░рдг A s s))
    тИЩ cong (╬╗ z тЖТ A ┬╖ A + (A ┬╖ z + s ┬╖ s)) h1
    тИЩ +-assoc (A ┬╖ A) (A ┬╖ (n ┬╖ A)) (s ┬╖ s)
    тИЩ cong (_+ s ┬╖ s) (sym (рд╡рд╛рдо-рд╡рд┐рддрд░рдг A A (n ┬╖ A)))
    тИЩ cong (╬╗ z тЖТ A ┬╖ z + s ┬╖ s) h2 )

рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН : (n : тДХ) тЖТ тИС┬│ n тЙб тИС n ┬╖ тИС n
рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН zero    = refl
рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН (suc n) =
    cong (╬╗ z тЖТ suc n ┬╖ (suc n ┬╖ suc n) + z) (рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН n)
  тИЩ рдХреНрд░реБрдХреНрд╕ (suc n) n (тИС n) (рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН n) refl

------------------------------------------------------------------------
-- рЙржр╛рр░ррор тФ тИ1..4 = 10 ; тИ1┬│..4┬│ = 100 = 10┬▓ (refl-рр┐ржррзрор) р
------------------------------------------------------------------------

рдЙрджрд╛рд╣рд░рдгрдореН-рдпреЛрдЧ : тИС 4 тЙб 10
рдЙрджрд╛рд╣рд░рдгрдореН-рдпреЛрдЧ = refl

рдЙрджрд╛рд╣рд░рдгрдореН-рдШрди : тИС┬│ 4 тЙб 100
рдЙрджрд╛рд╣рд░рдгрдореН-рдШрди = refl

рдЙрджрд╛рд╣рд░рдгрдореН-рд░рддреНрдирдореН : тИС┬│ 4 тЙб тИС 4 ┬╖ тИС 4
рдЙрджрд╛рд╣рд░рдгрдореН-рд░рддреНрдирдореН = рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН 4

------------------------------------------------------------------------
-- ррр░р┐рХрЛр-р╡р░ррЧр тФ р╡р░ррЧр = ржрр╡рпрЛр рХрр░рор╛рЧр-ррр░р┐рХрЛр-ррЩррЦррпрпрЛр рпрЛрЧр : T(n+1)+T(n) = (n+1)┬▓ р
-- (тИ = ррр░р┐рХрЛр-ррЩррЦррпр╛ ; ржрр╡р рХрр░рор╛рЧрр рор┐р▓р┐ррр╡р╛ р╡р░ррЧрор ррирпрр тФ рорр░р-ржрр╡р┐рЧрр-ррЩррХр▓р┐рр╛рр р
--  ррХррр┐-ррЩррЦррпр╛-рир┐рпрор, ри рХрррр┐рр р╡р┐ррр-ррр▓рЛрХр рррр░ ржр╛р╡ррпрр р)
--
-- (A square is the sum of two consecutive triangular numbers: тИ(n+1)+тИn тЙб (n+1)┬▓,
-- straight from 2┬тИn = n(n+1).  A figurate identity; no specific verse claimed.)
------------------------------------------------------------------------

рддреНрд░рд┐рдХреЛрдг-рд╡рд░реНрдЧрдГ : (n : тДХ) тЖТ тИС (suc n) + тИС n тЙб suc n ┬╖ suc n
рддреНрд░рд┐рдХреЛрдг-рд╡рд░реНрдЧрдГ n =
    sym (+-assoc (suc n) (тИС n) (тИС n))
  тИЩ cong (suc n +_) (рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН n)

-- рЙржр╛рр░ррор тФ T(4)+T(3) = 10+6 = 16 = 4┬▓ (refl-рр┐ржррзрор) р
рддреНрд░рд┐рдХреЛрдг-рд╡рд░реНрдЧ-рек : тИС 4 + тИС 3 тЙб 16
рддреНрд░рд┐рдХреЛрдг-рд╡рд░реНрдЧ-рек = refl
