{-# OPTIONS --cubical --safe #-}

------------------------------------------------------------------------
-- ррр░рррорЧрррррррп рр╛р╡рир╛ тФ р╡р░ррЧ-ррр░рХрррр рррпрЛрЧ-рир┐рпрор (ррр░р╛рррорррррЯрр┐ржррзр╛риррр, рриро рИ.) р
-- рор╛рирор (norm) : N(x, y) = x┬▓ тИТ N┬y┬▓ р  рр╛р╡рир╛ ржрр╡рпрЛр рр╛рзрирпрЛр рррпрЛрЧр, рпррр░
-- рор╛рир╛рир┐ рЧррррприррр : N(рррпрЛрЧр) = Nт ┬ Nт р  ррр╛ рр╡ "ррр░рррорЧрррр-рр┐ррЛрир╛рр"
-- ррор┐рХр╛, рЧр╛рЙрр-рррпрЛрЧрррп р ррХрр░р╡р╛р▓рррп (Pell) р рорр▓рор р
--
-- (Brahmagupta's bhvan тФ the composition law on the quadratic form
-- x┬▓ тИТ N┬y┬▓ (Brhmasphuasiddhnta, 628 CE).  Two solutions compose so
-- that their norms MULTIPLY: N(composite) = Nт┬Nт.  This is the
-- "BrahmaguptaтУFibonacci" identity, and the root of both Gauss composition
-- and the cakravla тФ the method that solves what Europe later miscalled
-- "Pell's equation" (Pell never solved it; Euler misattributed it).)
--
-- рор╛рир ри р╡р┐рр╛р░р тФ ррржррзр╛ р╡р▓рп-ррор┐рХр╛, т-р╡р▓рп-рр╛рзрХрри (solve) ррр░рор╛рр┐рр╛ р
-- (the identity is a pure ring equation, discharged by the т ring solver тФ
-- exact certified symbolic computation, which is proof, not measurement.)
------------------------------------------------------------------------

module Brahmagupta where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Int using (тДд ; pos ; _+_ ; _┬╖_ ; _-_)
open import Cubical.Algebra.CommRing.Instances.Int using (тДдCommRing)
open import Cubical.Tactics.CommRingSolver.Reflection using (solve!)

------------------------------------------------------------------------
-- рор╛рирор тФ р╡р░ррЧ-ррр░рХррр┐-рор╛рирор N(x, y) = x┬▓ тИТ N┬y┬▓ р
------------------------------------------------------------------------

рдорд╛рди : тДд тЖТ тДд тЖТ тДд тЖТ тДд
рдорд╛рди N x y = (x ┬╖ x) - (N ┬╖ (y ┬╖ y))

-- рриррр░-рр╛р╡рир╛ (ррор╛р-рр╛р╡рир╛рпр╛р ррр░рр┐р░рррор) : рЛр-рр┐рррирри ррр┐ рор╛рир╛рир┐ рЧррррприррр р
-- (the antara/difference bhvan: with the minus signs, norms still multiply.
-- Brahmagupta gave BOTH compositions тФ samsa and antara.)
рдЕрдиреНрддрд░-рдкреНрд░ : тДд тЖТ тДд тЖТ тДд тЖТ тДд тЖТ тДд тЖТ тДд
рдЕрдиреНрддрд░-рдкреНрд░ N x1 y1 x2 y2 = (x1 ┬╖ x2) - (N ┬╖ (y1 ┬╖ y2))

рдЕрдиреНрддрд░-рджреНрд╡рд┐ : тДд тЖТ тДд тЖТ тДд тЖТ тДд тЖТ тДд
рдЕрдиреНрддрд░-рджреНрд╡рд┐ x1 y1 x2 y2 = (x1 ┬╖ y2) - (x2 ┬╖ y1)

рдЕрдиреНрддрд░-рднрд╛рд╡рдирд╛-рдорд╛рди : (N x1 y1 x2 y2 : тДд)
                тЖТ рдорд╛рди N (рдЕрдиреНрддрд░-рдкреНрд░ N x1 y1 x2 y2) (рдЕрдиреНрддрд░-рджреНрд╡рд┐ x1 y1 x2 y2)
                тЙб (рдорд╛рди N x1 y1) ┬╖ (рдорд╛рди N x2 y2)
рдЕрдиреНрддрд░-рднрд╛рд╡рдирд╛-рдорд╛рди N x1 y1 x2 y2 = solve! тДдCommRing

------------------------------------------------------------------------
-- рррпрЛрЧ-ррр░рророр, рррпрЛрЧ-ржрр╡р┐рррпрор тФ рр╛р╡рир╛рпр╛р ржрр╡р ррЩррЧр р
--   ррр░рророр = xтxт + N┬yтyт ;  ржрр╡р┐рррпрор = xтyт + xтyт р
------------------------------------------------------------------------

рд╕рдВрдпреЛрдЧ-рдкреНрд░ : тДд тЖТ тДд тЖТ тДд тЖТ тДд тЖТ тДд тЖТ тДд
рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x1 y1 x2 y2 = (x1 ┬╖ x2) + (N ┬╖ (y1 ┬╖ y2))

рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ : тДд тЖТ тДд тЖТ тДд тЖТ тДд тЖТ тДд
рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x1 y1 x2 y2 = (x1 ┬╖ y2) + (x2 ┬╖ y1)

------------------------------------------------------------------------
-- рр╛р╡рир╛-рор╛рир тФ рорр▓рорирррр░рор : рррпрЛрЧрррп рор╛рир рор╛рирпрЛр рЧррр р
--   N(рр╛р╡рир╛) = N(xт,yт) ┬ N(xт,yт) р  р╡р▓рп-ррор┐рХр╛, solve-рр┐ржррзр╛ р
------------------------------------------------------------------------

рднрд╛рд╡рдирд╛-рдорд╛рди : (N x1 y1 x2 y2 : тДд)
          тЖТ рдорд╛рди N (рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x1 y1 x2 y2) (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x1 y1 x2 y2)
          тЙб (рдорд╛рди N x1 y1) ┬╖ (рдорд╛рди N x2 y2)
рднрд╛рд╡рдирд╛-рдорд╛рди N x1 y1 x2 y2 = solve! тДдCommRing

------------------------------------------------------------------------
-- ррХ┬ тФ рз ┬ n тЙб n (р╡р▓рпрр) р
------------------------------------------------------------------------

рдПрдХ┬╖ : (n : тДд) тЖТ (pos 1 ┬╖ n) тЙб n
рдПрдХ┬╖ n = solve! тДдCommRing

------------------------------------------------------------------------
-- ррХрр░р╡р╛р▓-ржрр╡р╛р░рор тФ р╡р░ррЧ-ррр░рХрррр ррорр-рир┐рпрор : рпржр┐ рЙрр рр╛рзрир рор╛рир рз,
-- рр░ррр┐ рррпрЛрЧр ррр┐ рор╛рир рз р  (x┬▓ тИТ N┬y┬▓ = 1 ррр┐ рр╛рзрир╛рир╛р рррпрЛрЧр рррир рр╛рзрирор тФ
-- рририррр╛рир┐ рр╛рзрир╛рир┐ ррХрррор╛рр, ррр░рррорЧрррррррп ржррррЯр┐р, ррХрр░р╡р╛р▓рррп ррррор р)
--
-- (the gateway to the cakravla: solutions of x┬▓ тИТ N┬y┬▓ = 1 form a group
-- under bhvan тФ compose two and you get another, so one solution breeds
-- infinitely many.  Brahmagupta's insight, the seed of the cakravla.)
------------------------------------------------------------------------

рдЪрдХреНрд░рд╡рд╛рд▓-рд╕рдВрдпреЛрдЧрдГ : (N x1 y1 x2 y2 : тДд)
              тЖТ рдорд╛рди N x1 y1 тЙб pos 1
              тЖТ рдорд╛рди N x2 y2 тЙб pos 1
              тЖТ рдорд╛рди N (рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x1 y1 x2 y2) (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x1 y1 x2 y2) тЙб pos 1
рдЪрдХреНрд░рд╡рд╛рд▓-рд╕рдВрдпреЛрдЧрдГ N x1 y1 x2 y2 h1 h2 =
    рднрд╛рд╡рдирд╛-рдорд╛рди N x1 y1 x2 y2
  тИЩ congтВВ _┬╖_ h1 h2
  тИЩ рдПрдХ┬╖ (pos 1)

------------------------------------------------------------------------
-- рЙржр╛рр░ррор тФ x┬▓ тИТ 2┬y┬▓ = 1 : рорр▓-рр╛рзрирор (3, 2) ; рр╛р╡рирпр╛ ррЧрр░р┐ророр (17, 12) р
-- ррХрррор╛рр рр╛рзрир╛рр рририррр╛рир┐ тФ ррр░рррорЧрррррррп ррорр-рир┐рпрор ррр░рррпрХррр р
-- (from one solution, infinitely many тФ the group law, concretely.)
------------------------------------------------------------------------

рдореВрд▓-рд╕рд╛рдзрдирдореН : рдорд╛рди (pos 2) (pos 3) (pos 2) тЙб pos 1     -- 9 тИТ 8 = 1
рдореВрд▓-рд╕рд╛рдзрдирдореН = refl

-- (17, 12) = рр╛р╡рир╛((3,2),(3,2)) ; 17┬▓ тИТ 2┬12┬▓ = 289 тИТ 288 = 1
рдЕрдЧреНрд░рд┐рдо-x : рд╕рдВрдпреЛрдЧ-рдкреНрд░ (pos 2) (pos 3) (pos 2) (pos 3) (pos 2) тЙб pos 17
рдЕрдЧреНрд░рд┐рдо-x = refl

рдЕрдЧреНрд░рд┐рдо-y : рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ (pos 3) (pos 2) (pos 3) (pos 2) тЙб pos 12
рдЕрдЧреНрд░рд┐рдо-y = refl

рдЕрдЧреНрд░рд┐рдо-рд╕рд╛рдзрдирдореН : рдорд╛рди (pos 2)
                 (рд╕рдВрдпреЛрдЧ-рдкреНрд░ (pos 2) (pos 3) (pos 2) (pos 3) (pos 2))
                 (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ (pos 3) (pos 2) (pos 3) (pos 2))
              тЙб pos 1
рдЕрдЧреНрд░рд┐рдо-рд╕рд╛рдзрдирдореН = рдЪрдХреНрд░рд╡рд╛рд▓-рд╕рдВрдпреЛрдЧрдГ (pos 2) (pos 3) (pos 2) (pos 3) (pos 2)
                              рдореВрд▓-рд╕рд╛рдзрдирдореН рдореВрд▓-рд╕рд╛рдзрдирдореН

------------------------------------------------------------------------
-- рЛр-рр╛р╡рир╛ тФ ррр░рррорЧрррррррп р╡р░ррЧ-ррр░рХррр┐-рХррЮррр┐рХр╛ : рор╛рир (тИТ1) рпрр рр╛рзрирор, ррр
-- ррр╡рри рр╛р╡р┐рр рор╛рир (+1) рр╛рзрир ржржр╛рр┐ (рпрр (тИТ1)┬(тИТ1) = 1) р  ррр x┬▓тИТN┬y┬▓=тИТ1
-- ррр┐ рр╛рзрир╛рр x┬▓тИТN┬y┬▓=1 рр╛рзрир рр╛рпрр р  (Brahmagupta's key: a norm тИТ1
-- solution composed with itself gives a norm +1 solution тФ the bridge
-- from x┬▓тИТNy┬▓=тИТ1 to the true Pell equation.)
------------------------------------------------------------------------

рд╡рд░реНрдЧ-рдЛрдг : (n : тДд) тЖТ (pos 0 - n) ┬╖ (pos 0 - n) тЙб n ┬╖ n
рд╡рд░реНрдЧ-рдЛрдг n = solve! тДдCommRing

рдЛрдг-рднрд╛рд╡рдирд╛ : (N x1 y1 x2 y2 : тДд)
         тЖТ рдорд╛рди N x1 y1 тЙб (pos 0 - pos 1)
         тЖТ рдорд╛рди N x2 y2 тЙб (pos 0 - pos 1)
         тЖТ рдорд╛рди N (рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x1 y1 x2 y2) (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x1 y1 x2 y2) тЙб pos 1
рдЛрдг-рднрд╛рд╡рдирд╛ N x1 y1 x2 y2 h1 h2 =
    рднрд╛рд╡рдирд╛-рдорд╛рди N x1 y1 x2 y2
  тИЩ congтВВ _┬╖_ h1 h2
  тИЩ рд╡рд░реНрдЧ-рдЛрдг (pos 1)
  тИЩ рдПрдХ┬╖ (pos 1)

-- рЙржр╛рр░ррор : x┬▓тИТ2y┬▓=тИТ1 ррр┐ (1,1) ; рЛр-рр╛р╡рирпр╛ (3,2), рор╛рир +1 р
рдЛрдг-рдореВрд▓рдореН : рдорд╛рди (pos 2) (pos 1) (pos 1) тЙб (pos 0 - pos 1)     -- 1 тИТ 2 = тИТ1
рдЛрдг-рдореВрд▓рдореН = refl

рдЛрдгрд╛рддреН-рд╕рд╛рдзрдирдореН : рдорд╛рди (pos 2)
                (рд╕рдВрдпреЛрдЧ-рдкреНрд░ (pos 2) (pos 1) (pos 1) (pos 1) (pos 1))
                (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ (pos 1) (pos 1) (pos 1) (pos 1))
             тЙб pos 1
рдЛрдгрд╛рддреН-рд╕рд╛рдзрдирдореН = рдЛрдг-рднрд╛рд╡рдирд╛ (pos 2) (pos 1) (pos 1) (pos 1) (pos 1)
                        рдЛрдг-рдореВрд▓рдореН рдЛрдг-рдореВрд▓рдореН

------------------------------------------------------------------------
-- ржрр╡р┐р╡р░ррЧ-рпрЛрЧ-рЧррр тФ ррр░рррорЧрррр-ррор┐рХр╛ (N = тИТ1) : ржрр╡рпрЛр р╡р░ррЧ-рпрЛрЧрпрЛр рЧррр
-- ррр┐ р╡р░ррЧ-рпрЛрЧр р  (a┬▓+b┬▓)(c┬▓+d┬▓) = (acтИТbd)┬▓ + (ad+bc)┬▓ р  ррр╛ рЧр╛рЙрр-ррр░ррр╛рЩррХ-
-- рор╛рирррп рЧррриррпрр╛ ; ржр┐рпрЛрр╛рирррр-ррр░рррорЧрррр-ррор┐рХр╛ ррр┐ рЦррпр╛рр╛ р
-- (BrahmaguptaтУFibonacci identity, the N = тИТ1 case: a product of two
-- sums of squares is itself a sum of squares тФ the multiplicativity of the
-- Gaussian-integer norm.)
------------------------------------------------------------------------

рджреНрд╡рд┐рд╡рд░реНрдЧ-рдЧреБрдгрдГ : (a b c d : тДд)
             тЖТ (a ┬╖ a + b ┬╖ b) ┬╖ (c ┬╖ c + d ┬╖ d)
             тЙб (a ┬╖ c - b ┬╖ d) ┬╖ (a ┬╖ c - b ┬╖ d) + (a ┬╖ d + b ┬╖ c) ┬╖ (a ┬╖ d + b ┬╖ c)
рджреНрд╡рд┐рд╡рд░реНрдЧ-рдЧреБрдгрдГ a b c d = solve! тДдCommRing

------------------------------------------------------------------------
-- рор╛ри-рррпррЧрро тФ рор╛рир y-рорзррпр рро-р░рррор : N(x, тИТy) = N(x, y) р  рррпррЧрро-р░ррир╛
-- (x,y)тж(x,тИТy) рор╛рир р░рХрррр┐ , рпрр рор╛рирор y-р╡р░ррЧр рр╡ ррррХрррр (y┬▓ = (тИТy)┬▓) р
--
-- рррр рр╡ ррррр рпрр р╡ррпррррХрр░рор (a,тИТb) ррррор┐рир рр╡ рор╛ри-р╡р░ррЧр рр┐рррарр┐ (CompositionSet.
-- р╡ррпррррХрр░ро) тФ рроррр рор╛ри-рриррЧрр (norm-graded) р  ррр░рррорЧрррррррп ржрр╡р рр╛р╡рир
-- (ррор╛р-рриррр░) ррирри ррХ-рорр▓р : рриррр░р = рррпррЧрро-ррор╛рр , ррор╛рир рор╛рирор р
--
-- (The norm is even in y: N(x,тИТy)=N(x,y), because it depends on y only
-- through y┬▓.  This is exactly why the conjugate inverse (a,тИТb) lands in the
-- same norm class тФ the group is graded by the norm.  Brahmagupta's two
-- bhvans, samsa and antara, share this root: the antara is composition
-- with the conjugate, and conjugation preserves the norm.)
------------------------------------------------------------------------

рдорд╛рди-рд╕рдВрдпреБрдЧреНрдо : (N x y : тДд) тЖТ рдорд╛рди N x (pos 0 - y) тЙб рдорд╛рди N x y
рдорд╛рди-рд╕рдВрдпреБрдЧреНрдо N x y = cong (╬╗ t тЖТ (x ┬╖ x) - (N ┬╖ t)) (рд╡рд░реНрдЧ-рдЛрдг y)

------------------------------------------------------------------------
-- рриррр░-рррпррЧррор тФ рриррр░-рр╛р╡рир╛ = рррпррЧрро-ррор╛р-рр╛р╡рир╛ (ррр░ррррр-ррр░рЛрХрррр ррр░рор╛ррор) р
-- рриррр░р (xт,yт)(xт,yт) = ррор╛рр (xт,yт)(xт,тИТyт) : ррр░ррор рир┐р░рржррр╛ррХр рпрр╛р╡рр ,
-- ржрр╡р┐рррпр рррпррЧрро-рр┐ррри-р╡ррпрррпрпрри (рриррр░-ржрр╡р┐ = тИТрррпрЛрЧ-ржрр╡р┐ рррпррЧррор) р  ррирри
-- ррр░рррорЧрррррррп ржрр╡р рр╛р╡рир ррХ-рорр▓р , рор╛ри-рррпррЧррорри (N(x,тИТy)=N(x,y)) ррор╛ри-рор╛рирор р
--
-- (Brahmagupta's antara bhvan IS the samsa bhvan against the conjugate
-- (xт,тИТyт): the first coordinate matches outright, the second up to the sign
-- conjugation introduces.  With рор╛ри-рррпррЧрро this is why both compositions share
-- one norm тФ the prose claim of the previous section, now a checked term.)
------------------------------------------------------------------------

рдЕрдиреНрддрд░-рд╕рдВрдпреБрдЧреНрдо-рдкреНрд░ : (N x1 y1 x2 y2 : тДд)
                 тЖТ рдЕрдиреНрддрд░-рдкреНрд░ N x1 y1 x2 y2 тЙб рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x1 y1 x2 (pos 0 - y2)
рдЕрдиреНрддрд░-рд╕рдВрдпреБрдЧреНрдо-рдкреНрд░ N x1 y1 x2 y2 = solve! тДдCommRing

рдЕрдиреНрддрд░-рд╕рдВрдпреБрдЧреНрдо-рджреНрд╡рд┐ : (N x1 y1 x2 y2 : тДд)
                 тЖТ рдЕрдиреНрддрд░-рджреНрд╡рд┐ x1 y1 x2 y2 тЙб (pos 0 - рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x1 y1 x2 (pos 0 - y2))
рдЕрдиреНрддрд░-рд╕рдВрдпреБрдЧреНрдо-рджреНрд╡рд┐ N x1 y1 x2 y2 = solve! тДдCommRing

------------------------------------------------------------------------
-- рриррр░-рор╛рир-рр╛р╡рир╛рр тФ рриррр░-рр╛р╡рир╛-рор╛рир ри ррр╡ррирррр░р , ррр┐ рр ррор╛р-рр╛р╡рир╛-рор╛рир╛рр
-- рррпррЧррорри рр╛рпрр р  ррр░рр╡р (рриррр░-рр╛р╡рир╛-рор╛ри) р╡р▓рп-рр╛рзрХрри ррр╡ррирррр░р рр╛рзр┐ррор ;
-- рррр░ ржр░ррр┐ррор : рр рр╡ рр╛р╡рир╛-рор╛рирррп (рррпррЧрро-ррр┐ррррп) рр░р┐рр╛рор тФ ржрр╡р рор╛ри-рир┐рпрор
-- ррХр рр╡ р  рор╛р░ррЧр : рриррр░р = рррпррЧрро-ррор╛рр (рриррр░-рррпррЧрро) , рор╛рир y-рро-р░рррор
-- (рор╛ри-рррпррЧрро) , ррр рр╛р╡рир╛-рор╛рир рррпррЧрро-рржр ррр░рпррррп рриррр░-рор╛рир р▓рррпрр р
--
-- (The antara norm-law is not independent: it follows from the samsa
-- norm-law by conjugation.  рриррр░-рр╛р╡рир╛-рор╛ри was proved by the ring solver on
-- its own; here it is re-derived from рр╛р╡рир╛-рор╛ри тФ via рриррр░ = conjugate-samsa
-- and the norm's evenness in y тФ exhibiting the two as ONE theorem.  This
-- reduces two facts to one, the collision resolved rather than left doubled.)
------------------------------------------------------------------------

рдЕрдиреНрддрд░-рдорд╛рдирдГ-рднрд╛рд╡рдирд╛рддрдГ : (N x1 y1 x2 y2 : тДд)
                  тЖТ рдорд╛рди N (рдЕрдиреНрддрд░-рдкреНрд░ N x1 y1 x2 y2) (рдЕрдиреНрддрд░-рджреНрд╡рд┐ x1 y1 x2 y2)
                  тЙб (рдорд╛рди N x1 y1) ┬╖ (рдорд╛рди N x2 y2)
рдЕрдиреНрддрд░-рдорд╛рдирдГ-рднрд╛рд╡рдирд╛рддрдГ N x1 y1 x2 y2 =
    congтВВ (рдорд╛рди N) (рдЕрдиреНрддрд░-рд╕рдВрдпреБрдЧреНрдо-рдкреНрд░ N x1 y1 x2 y2) (рдЕрдиреНрддрд░-рд╕рдВрдпреБрдЧреНрдо-рджреНрд╡рд┐ N x1 y1 x2 y2)
  тИЩ рдорд╛рди-рд╕рдВрдпреБрдЧреНрдо N (рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x1 y1 x2 (pos 0 - y2)) (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x1 y1 x2 (pos 0 - y2))
  тИЩ рднрд╛рд╡рдирд╛-рдорд╛рди N x1 y1 x2 (pos 0 - y2)
  тИЩ cong ((рдорд╛рди N x1 y1) ┬╖_) (рдорд╛рди-рд╕рдВрдпреБрдЧреНрдо N x2 y2)

------------------------------------------------------------------------
-- ррр▓ррп-рр╛р╡рир╛ тФ рр╛рррХр░рррп "ррорпрЛр рр╛р╡рир╛" (ррррЧрр┐ррор, ррХрр░р╡р╛р▓рор) : рр╛рзрир ррр╡рри
-- рр╛р╡р┐ррор р  рррр▓ррп-рр╛р╡рир╛ (ржрр╡рпрЛр рррорпрЛр рр╛рзрирпрЛр, рЙрр░р┐рррЯр╛рр рр╛р╡рир╛-рор╛ри) ррр┐
-- рр┐риррир╛ ; ррр▓ррп-рр╛р╡рир╛ рр ррХрррп рр╡ рррро-рррпрЛрЧр р  рржр ржрр╡р┐рЧррр┐рр :
--   ррр▓ррп-ррр░рророр = x┬▓ + N┬y┬▓ ,  ррр▓ррп-ржрр╡р┐рррпрор = x┬y + x┬y (= 2xy) ,
-- рор╛рир р р╡р░ррЧр┐ррор : N(ррр▓ррп) = (N(x,y))┬▓ р  рпрр рХррррр k, ррр ррр▓ррпр k┬▓ рр╡рр┐ тФ
-- ррирри рр╛рррХр░р ррХрр░р╡р╛р▓р рХррррр р╡р░ррЧ-р░рррр рирпрр┐, ррр р╡р┐рррирри рр░рЛррр┐ р
--
-- (Bhskara's tulya-bhvan, "composition of equals" (Bjagaita, cakravla):
--  a solution composed with ITSELF, as opposed to atulya-bhvan of two
--  UNEQUAL solutions (рр╛р╡рир╛-рор╛ри above).  The doubled coordinates are
--  (x┬▓+Ny┬▓, 2xy) and the kepa squares: N(tulya) = (N(x,y))┬▓.  A kepa k
--  becomes k┬▓, which is how the cakravla drives the additive term to a
--  square and then descends by division.  The closed coordinate forms are
--  definitional here; the norm-square is the general lemma at xт=xт, yт=yт.)
------------------------------------------------------------------------

рддреБрд▓реНрдп-рдкреНрд░рдердордореН : (N x y : тДд) тЖТ рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x y x y тЙб (x ┬╖ x) + (N ┬╖ (y ┬╖ y))
рддреБрд▓реНрдп-рдкреНрд░рдердордореН N x y = refl

рддреБрд▓реНрдп-рджреНрд╡рд┐рддреАрдпрдореН : (x y : тДд) тЖТ рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x y x y тЙб (x ┬╖ y) + (x ┬╖ y)
рддреБрд▓реНрдп-рджреНрд╡рд┐рддреАрдпрдореН x y = refl

рддреБрд▓реНрдп-рднрд╛рд╡рдирд╛-рдорд╛рди : (N x y : тДд)
               тЖТ рдорд╛рди N (рд╕рдВрдпреЛрдЧ-рдкреНрд░ N x y x y) (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ x y x y)
               тЙб (рдорд╛рди N x y) ┬╖ (рдорд╛рди N x y)
рддреБрд▓реНрдп-рднрд╛рд╡рдирд╛-рдорд╛рди N x y = рднрд╛рд╡рдирд╛-рдорд╛рди N x y x y

-- рЙржр╛рр░ррор тФ рХррррр р╡р░ррЧ-р░ррр рр╡рр┐ : N=3, (1,1) рХррррр тИТ2 ; ррр▓ррп-рр╛р╡рирпр╛
-- (4,2), рХррррр 16тИТ12 = 4 = (тИТ2)┬▓ р  (a non-┬1 kepa squaring under tulya.)
рддреБрд▓реНрдп-рдореВрд▓рдореН : рдорд╛рди (pos 3) (pos 1) (pos 1) тЙб (pos 0 - pos 2)     -- 1 тИТ 3 = тИТ2
рддреБрд▓реНрдп-рдореВрд▓рдореН = refl

рддреБрд▓реНрдп-рдХреНрд╖реЗрдк-рд╡рд░реНрдЧрдГ : рдорд╛рди (pos 3)
                    (рд╕рдВрдпреЛрдЧ-рдкреНрд░ (pos 3) (pos 1) (pos 1) (pos 1) (pos 1))
                    (рд╕рдВрдпреЛрдЧ-рджреНрд╡рд┐ (pos 1) (pos 1) (pos 1) (pos 1))
                 тЙб pos 4                                        -- 16 тИТ 12 = 4 = (тИТ2)┬▓
рддреБрд▓реНрдп-рдХреНрд╖реЗрдк-рд╡рд░реНрдЧрдГ = refl
