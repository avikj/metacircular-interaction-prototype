{-# OPTIONS --cubical --safe #-}

------------------------------------------------------------------------
-- ррр▓рррор тФ рррзр╛рприрррп ррр▓ррррррр░рор (~роржрж рИ.рр.) : рХр░рр-р░р╛рр┐р р  "ржрр░ррШрррр░ррр░рррп
-- ррХрррррпр╛ р░ррррр рр╛р░рррр╡рор╛рир рр┐р░ррпрЩррор╛рир р рпрр ррррЧр рррр рХрр░ррр рржрррпр рХр░рЛрр┐" тФ
-- рр░ррр╛рр рХр░ррр╡р░ррЧр = рр╛р░рррр╡р╡р░ррЧр + рр┐р░ррпрЧрр╡р░ррЧр (c┬▓ = a┬▓ + b┬▓) р  р╡рржр-р░ррир╛р░ррр
-- рХр░рр-ррр░р┐рХр╛рр┐ (Pythagorean triples) ржрррр╛рир┐ : (рй,р,р), (р,рзри,рзрй) тж р
--
-- рррр ррИрр╛рЧрЛр░рр╛рр (~ррйрж рИ.рр.) ррр░рр╡рор ; ррИрр╛рЧрЛр░рр р ржрр-ррр░рорррр▓р ррррр р
-- рр░рр╡-ррр░р┐рХ-рририрор : (m┬▓тИТn┬▓, 2mn, m┬▓+n┬▓) тФ р╡р▓рп-ррор┐рХр╛ (solve-рр┐ржррзр╛) р
--
-- (Baudhyana's ulba-stra (~800 BCE): the diagonal-cord relation
-- c┬▓ = a┬▓ + b┬▓, with Pythagorean triples given for altar construction тФ
-- before Pythagoras (~530 BCE), himself a traveler.  The triple
-- parametrization (m┬▓тИТn┬▓, 2mn, m┬▓+n┬▓) is a checked ring identity.)
------------------------------------------------------------------------

module Sulba where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Int using (тДд ; pos ; _+_ ; _┬╖_ ; _-_)
open import Cubical.Algebra.CommRing.Instances.Int using (тДдCommRing)
open import Cubical.Tactics.CommRingSolver.Reflection using (solve!)
open import Cubical.Data.Sigma using (_├Ч_ ; _,_)

------------------------------------------------------------------------
-- рХр░рр-ррр░р┐рХ-рририрор тФ (m┬▓тИТn┬▓)┬▓ + (2mn)┬▓ тЙб (m┬▓+n┬▓)┬▓ (рр░рр╡-рржр┐-ррр░р┐рХ-ррирХр) р
------------------------------------------------------------------------

рдкрд╛рд░реНрд╢реНрд╡ : тДд тЖТ тДд тЖТ тДд           -- m┬▓ тИТ n┬▓
рдкрд╛рд░реНрд╢реНрд╡ m n = m ┬╖ m - n ┬╖ n

рддрд┐рд░реНрдпрдХреН : тДд тЖТ тДд тЖТ тДд           -- 2mn
рддрд┐рд░реНрдпрдХреН m n = (pos 2 ┬╖ m) ┬╖ n

рдХрд░реНрдг : тДд тЖТ тДд тЖТ тДд             -- m┬▓ + n┬▓
рдХрд░реНрдг m n = m ┬╖ m + n ┬╖ n

рд╢реБрд▓реНрдм-рд╕рдорд┐рдХрд╛ : (m n : тДд)
            тЖТ (рдкрд╛рд░реНрд╢реНрд╡ m n ┬╖ рдкрд╛рд░реНрд╢реНрд╡ m n) + (рддрд┐рд░реНрдпрдХреН m n ┬╖ рддрд┐рд░реНрдпрдХреН m n)
            тЙб (рдХрд░реНрдг m n ┬╖ рдХрд░реНрдг m n)
рд╢реБрд▓реНрдм-рд╕рдорд┐рдХрд╛ m n = solve! тДдCommRing

------------------------------------------------------------------------
-- рЙржр╛рр░ррор тФ рррзр╛рприрррп ррр░р┐рХр╛рр┐ (refl-рр┐ржррзр╛рир┐) р
--   m=2,n=1 тТ (3,4,5) ;  m=3,n=2 тТ (5,12,13) р
------------------------------------------------------------------------

рддреНрд░рд┐рдХ-рейрекрел : (pos 3 ┬╖ pos 3) + (pos 4 ┬╖ pos 4) тЙб (pos 5 ┬╖ pos 5)
рддреНрд░рд┐рдХ-рейрекрел = refl

рддреНрд░рд┐рдХ-релрезреирезрей : (pos 5 ┬╖ pos 5) + (pos 12 ┬╖ pos 12) тЙб (pos 13 ┬╖ pos 13)
рддреНрд░рд┐рдХ-релрезреирезрей = refl

-- ррирХр╛рр: m=2,n=1 рпрр╛р░рррр (3,4,5) ррирпрр┐ р
рдЬрдирдХ-рейрекрел : (рдкрд╛рд░реНрд╢реНрд╡ (pos 2) (pos 1) тЙб pos 3)
        ├Ч (рддрд┐рд░реНрдпрдХреН (pos 2) (pos 1) тЙб pos 4)
        ├Ч (рдХрд░реНрдг (pos 2) (pos 1) тЙб pos 5)
рдЬрдирдХ-рейрекрел = refl , refl , refl

------------------------------------------------------------------------
-- рриррр░-р╡р░ррЧр тФ р╡р░ррЧр╛риррр░-рХр░ррррп ррррор : (a+b)(aтИТb) = a┬▓ тИТ b┬▓ р
-- рррзр╛рприр (ррр▓ррррррр░рор) рпрр р╡р░ррЧр ржрр╡рпрЛр р╡р░ррЧрпрЛр рриррр░р ррр р░ррпрр┐ ; ррррп
-- ррпр-р░рррор (a+b)Ч(aтИТb) р╡р░ррЧр╛риррр░р a┬▓тИТb┬▓ ржржр╛рр┐ тФ рржрор рр╡ ррр ррррор р
-- (Baudhyana's caturara-karaa for the DIFFERENCE of two squares: the
--  rectangle (a+b)Ч(aтИТb) has area a┬▓тИТb┬▓, the algebra behind turning a
--  difference of squares into one square.  A ring identity, solve-рр┐ржррзр╛.)
------------------------------------------------------------------------

рдЕрдиреНрддрд░-рд╡рд░реНрдЧрдГ : (a b : тДд) тЖТ (a + b) ┬╖ (a - b) тЙб a ┬╖ a - b ┬╖ b
рдЕрдиреНрддрд░-рд╡рд░реНрдЧрдГ a b = solve! тДдCommRing

------------------------------------------------------------------------
-- ррпр-ррорррр░ррр░рор тФ ррпррррп ррорррр░ррр░-рХр░ррор : 4┬ab = (a+b)┬▓ тИТ (aтИТb)┬▓ р
-- ррпрр (aЧb) ррорррр░ррр░р рХр░рррр ррр▓ррр : ррррп рррр░р-рЧррр┐р-рХрррррр░рор ржрр╡рпрЛр
-- р╡р░ррЧрпрЛр рриррр░рор тФ (a+b)┬▓ тИТ (aтИТb)┬▓ = 4ab р  (рррр░р-рЧрррир рр░ррзррррржр р╡р╛р░рпрр┐,
-- т-рорзррпр ррррИр░ррпр╛рп р)  рриррр░-р╡р░ррЧр╛рр ррирррррор, ррр╡ррирррр░р р рХрр┐ррор р
-- (Squaring the rectangle: 4┬(area) of an aЧb rectangle is the difference of
--  two squares, (a+b)┬▓тИТ(aтИТb)┬▓ = 4ab тФ the ulba turning a rectangle into a
--  square, scaled by 4 to stay integral.  A ring identity over т.)
------------------------------------------------------------------------

рдЖрдпрдд-рд╕рдордЪрддреБрд░рд╕реНрд░рдореН : (a b : тДд)
                тЖТ pos 4 ┬╖ (a ┬╖ b) тЙб (a + b) ┬╖ (a + b) - (a - b) ┬╖ (a - b)
рдЖрдпрдд-рд╕рдордЪрддреБрд░рд╕реНрд░рдореН a b = solve! тДдCommRing

------------------------------------------------------------------------
-- р╡р░ррЧ-ррорррррпр тФ ррр▓рр-ррорррррп-рХр░ррор : (a+b)┬▓-ррорррр░ррр░р ржрр╡рпрЛр р╡р░ррЧрпрЛр ржрр╡рпрЛррр
-- ррпррпрЛр ррорррррпр тФ (a+b)┬▓ = (a┬▓ + b┬▓) + (ab + ab) р  роррр-ррорррр░ррр░р (рр╛р░рррр╡р
-- a+b) рррр░ррзр╛ р╡р┐ррХрррор : a-р╡р░ррЧр, b-р╡р░ррЧр, ржрр╡р aЧb-ррпрр р  рриррр░-р╡р░ррЧрррп
-- (рпрЛрЧ-р░рр┐р-ррХрррррп) ррорррррп-ррр░рр┐ррХррр тФ ррр▓ррр рХрррррр░-рррпрЛррирор р
--
-- (The ulba's samuccaya construction: the square on (a+b) is the assembly of
--  two squares and two rectangles тФ (a+b)┬▓ = (a┬▓+b┬▓) + (ab+ab).  The big
--  square (side a+b) is cut into the a-square, the b-square, and two aЧb
--  rectangles.  The addition-side complement of the difference identities:
--  combining regions rather than subtracting them.)
------------------------------------------------------------------------

рд╡рд░реНрдЧ-рд╕рдореБрдЪреНрдЪрдпрдГ : (a b : тДд)
            тЖТ (a + b) ┬╖ (a + b) тЙб (a ┬╖ a + b ┬╖ b) + (a ┬╖ b + a ┬╖ b)
рд╡рд░реНрдЧ-рд╕рдореБрдЪреНрдЪрдпрдГ a b = solve! тДдCommRing
