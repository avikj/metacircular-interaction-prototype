{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- पूर्ण-मोड — the full twist.
--
-- THE QUESTION.  The braid group on three strands has a celebrated
-- center, generated by the full twist Δ² = (σ₁σ₂)³.  What does the
-- center act as, in the quarter-turn representation?  Computed:
--
--   §1  THE FULL TWIST IS THE GLOBAL HALF-WAVE — (σ₁σ₂)³ turns every
--       strand by exactly half, and the identification is refl.
--
--   §2  IT IS CENTRAL BY REFL: the full twist commutes with both
--       generators definitionally — no path algebra, the normal forms
--       coincide.
--
--   §3  IT HAS ORDER EXACTLY TWO: its square is the identity (by the
--       four-cycle on every coordinate), and it is not the identity
--       (refuted at a named state).
--
-- THE STRUCTURAL READING, and it is sharp.  CaturamsaBhramana proved
-- the half-wave DESCENDS to each single sense while the quarter turn
-- descends to neither.  Here the half-wave reappears as the CENTER of
-- the braid action: what every strand can carry alone (the
-- involution) is exactly what commutes with every crossing, and what
-- only the interdependent pair can carry (the quarter turn) is
-- exactly what braids.  The descendable part of the coherence is the
-- central part; the non-descendable residue is the braiding itself.
-- Abelian phase = per-strand property; non-abelian statistics =
-- pair property — one theorem-pair, both halves terms.
--
-- SYĀT — THE CLAIM, EXACTLY.  Centrality is proved against the two
-- generators on this state space; the general equivalence
-- center-equals-descendable is a conjecture this pair of theorems
-- instantiates, and is the next construction.
------------------------------------------------------------------------

module PurnaModa_TheFullTwistIsTheGlobalHalfWaveCentralByReflOfOrderTwoAndNotTheIdentity where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Bool using (Bool ; true ; false ; notnot ; true≢false)
open import Cubical.Data.Sigma using (_×_ ; _,_ ; fst ; snd)
open import Cubical.Data.Empty using (⊥)

open import CaturamsaBhramana_TheQuarterWaveLivesOnlyOnTheInterdependentPairAndEachSenseCarriesExactlyItsSquare
  using (caturaṃśa ; ardha)
open import VeniBandha_TheSuppliedCoherenceIsTheQuarterTurnTheTwistedSwapBraidsByReflAndTheGeneratorHasExactOrderEight
  using (Sūtra ; veṇī₁₂ ; veṇī₂₃)

Traya : Type₀
Traya = Sūtra × (Sūtra × Sūtra)

-- σ₁σ₂, and the full twist (σ₁σ₂)³.
moda : Traya → Traya
moda t = veṇī₁₂ (veṇī₂₃ t)

pūrṇa-moda : Traya → Traya
pūrṇa-moda t = moda (moda (moda t))

------------------------------------------------------------------------
-- १ · The full twist is the global half-wave, by refl.
------------------------------------------------------------------------

ardha-sarvatra : Traya → Traya
ardha-sarvatra (x , (y , z)) = ardha x , (ardha y , ardha z)

pūrṇa-ardha : (t : Traya) → pūrṇa-moda t ≡ ardha-sarvatra t
pūrṇa-ardha t = refl

------------------------------------------------------------------------
-- २ · Central, by refl, against both generators.
------------------------------------------------------------------------

kendra₁₂ : (t : Traya) → pūrṇa-moda (veṇī₁₂ t) ≡ veṇī₁₂ (pūrṇa-moda t)
kendra₁₂ t = refl

kendra₂₃ : (t : Traya) → pūrṇa-moda (veṇī₂₃ t) ≡ veṇī₂₃ (pūrṇa-moda t)
kendra₂₃ t = refl

------------------------------------------------------------------------
-- ३ · Order exactly two.
------------------------------------------------------------------------

dvi-pūrṇa : (t : Traya) → pūrṇa-moda (pūrṇa-moda t) ≡ t
dvi-pūrṇa ((a , b) , ((c , d) , (e , f))) i =
  (notnot a i , notnot b i) , ((notnot c i , notnot d i) , (notnot e i , notnot f i))

na-tulya : ((t : Traya) → pūrṇa-moda t ≡ t) → ⊥
na-tulya h =
  true≢false (sym (cong (λ q → fst (fst q))
    (h ((true , true) , ((true , true) , (true , true))))))
