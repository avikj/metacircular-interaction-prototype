{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- р╡р░ррЧ-рЧрр▓ррор тФ ррр▓рр-рЧрр▓рро-р░ррир╛рпр╛р ррЩррХрЧрр┐ррор : рУр-рпрЛрЧр = р╡р░ррЧр (тИ р╡р┐ррор╛р = n┬▓) р
--
-- ррр▓рр-ррррр░ррр (рррзр╛рприр╛ржр┐рр) ррорррр░ррр░р "рЧрр▓ррорИр" (gnomon, L-ррХр╛р░-р╡рржррзр┐рр┐р)
-- р╡р░ррзрр : nЧn-р╡р░ррЧр (n+1)Ч(n+1)-р╡р░ррЧр рХр░рррр рпрр рпрЛрррпрр, ррр рЧрр▓ррор , ррррп
-- рор╛рирор = 2n+1 (р╡р┐рро-ррЩррЦррпр╛) р  ррр ррр░ррор╛рир╛р n р╡р┐ррор╛рр╛р рпрЛрЧр = nЧn р╡р░ррЧр р
-- рррр рЧрр▓рро-р░ррир╛рпр╛р ррЩррХ-р░рррор : рУр-рпрЛрЧ n тЙб n ┬ n р  (рЛр-р░рр┐ррор, тХ-рорзррпр р)
--
-- (The arithmetic behind the ulba gnomon construction: a square is grown by
-- gnomons тФ L-shaped borders тФ the k-th of which has size 2k+1, the next odd
-- number, so n gnomons build an nЧn square.  Hence the sum of the first n odd
-- numbers is n┬▓: рУр-рпрЛрЧ n тЙб n ┬ n, subtraction-free over тХ.  The gnomon
-- (samacaturara grown by gulma) is the ulba tradition's; no specific verse is
-- claimed for this arithmetic identity, only the construction it counts.)
--
-- ррр░рЛрр╛ррр┐ : рррзр╛рпри-ррр▓ррррррр░рор (ррорррр░ррр░-р╡рржррзр┐р, рЧрр▓рро-р░ррир╛) р
------------------------------------------------------------------------

module VargaGulma where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (тДХ ; zero ; suc ; _+_ ; _┬╖_)
open import Cubical.Data.Nat.Properties using (+-assoc ; +-comm ; +-suc ; ┬╖-suc ; +-zero ; ┬╖-distrib╦б)
open import Sankalita_AryabhatasSeriesSumsAndTheCubeSumIsTheSquareOfTheSum using (тИС ; тИС┬│ ; рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН)

------------------------------------------------------------------------
-- рУр тФ k-ррор р╡р┐ррор (0-рржр┐р) : рУр k = 2k+1 = suc(k+k) р
------------------------------------------------------------------------

рдУрдЬ : тДХ тЖТ тДХ
рдУрдЬ k = suc (k + k)

------------------------------------------------------------------------
-- рУр-рпрЛрЧ тФ ррр░ррор╛рир╛р n р╡р┐ррор╛рр╛р рпрЛрЧр : тИ_{k=0}^{nтИТ1} (2k+1) р
------------------------------------------------------------------------

рдУрдЬ-рдпреЛрдЧ : тДХ тЖТ тДХ
рдУрдЬ-рдпреЛрдЧ zero    = zero
рдУрдЬ-рдпреЛрдЧ (suc n) = рдУрдЬ-рдпреЛрдЧ n + рдУрдЬ n

------------------------------------------------------------------------
-- р╡р░ррЧ-рЧрр▓ррор тФ роррЦррп-рир┐рпрор : рУр-рпрЛрЧ n тЙб n ┬ n (n рЧрр▓ррор╛р тТ nЧn р╡р░ррЧр) р
------------------------------------------------------------------------

private
  -- (n+1)┬▓ = n┬▓ + (2n+1) : ррХ-рЧрр▓рро-р╡рржррзр┐р р
  рдкрджрдГ : (n : тДХ) тЖТ suc n ┬╖ suc n тЙб n ┬╖ n + suc (n + n)
  рдкрджрдГ n =
      cong (suc n +_) (┬╖-suc n n)
    тИЩ cong suc (+-assoc n n (n ┬╖ n))
    тИЩ cong suc (+-comm (n + n) (n ┬╖ n))
    тИЩ sym (+-suc (n ┬╖ n) (n + n))

рд╡рд░реНрдЧ-рдЧреБрд▓реНрдордГ : (n : тДХ) тЖТ рдУрдЬ-рдпреЛрдЧ n тЙб n ┬╖ n
рд╡рд░реНрдЧ-рдЧреБрд▓реНрдордГ zero    = refl
рд╡рд░реНрдЧ-рдЧреБрд▓реНрдордГ (suc n) =
    cong (_+ рдУрдЬ n) (рд╡рд░реНрдЧ-рдЧреБрд▓реНрдордГ n)
  тИЩ sym (рдкрджрдГ n)

------------------------------------------------------------------------
-- рЙржр╛рр░рр тФ 1+3+5+7 = 16 = 4┬▓ ; 1+3+5+7+9 = 25 = 5┬▓ (refl-рр┐ржррзр) р
------------------------------------------------------------------------

рдЧреБрд▓реНрдо-рек : рдУрдЬ-рдпреЛрдЧ 4 тЙб 16
рдЧреБрд▓реНрдо-рек = refl

рдЧреБрд▓реНрдо-рел : рдУрдЬ-рдпреЛрдЧ 5 тЙб 25
рдЧреБрд▓реНрдо-рел = refl

------------------------------------------------------------------------
-- рпррЧрро-рЧрр▓ррор тФ ррпррррр░ррр░рррп рЧрр▓рро-р░ррир╛ : рпррЧрро-рпрЛрЧр = рУр-рпрЛрЧр + n = n(n+1) р
--
-- ррр▓ррр ржрр╡р р░ррр рЧрр▓ррорИр р╡р░ррзррр : ррорррр░ррр░р (р╡р░ррЧр, р╡р┐рро-рЧрр▓ррорИр, р╡р░ррЧ-рЧрр▓ррор) р
-- ррпррррр░ррр░р (nЧ(n+1)-ррпрр, рпррЧрро-рЧрр▓ррорИр) р  ррр░рр┐ рпррЧрро-рЧрр▓ррор ррр-рррЧр-рУр-рЧрр▓ррор╛рр
-- ррХрри ррзр┐рХр (рпррЧрро k = suc(рУр k) = 2k+2) , ррр n рЧрр▓рроррр рпррЧрро-рпрЛрЧ = рУр-рпрЛрЧ + n р
-- ррр р╡р░ррЧ-рЧрр▓ррорри рпррЧрро-рпрЛрЧ n = n┬n + n = n┬(n+1) тФ ррпр-ррЩррЦррпр╛ (oblong) р
--
-- (The ulba grows two figures by gnomons: the square (samacaturara, odd
-- gnomons тФ р╡р░ррЧ-рЧрр▓ррор) and the oblong nЧ(n+1) (yatacaturara, even gnomons).
-- Each even gnomon exceeds its odd counterpart by one (рпррЧрро k = suc(рУр k)), so
-- over n gnomons рпррЧрро-рпрЛрЧ n тЙб рУр-рпрЛрЧ n + n, and with the square law that is
-- n(n+1) тФ the oblong number.  The genuinely new content is the oddтФeven gnomon
-- relation; the value n(n+1) also follows from Sankalita's 2┬тИk.)
------------------------------------------------------------------------

рдпреБрдЧреНрдо : тДХ тЖТ тДХ
рдпреБрдЧреНрдо k = suc (suc (k + k))

рдпреБрдЧреНрдо-рдпреЛрдЧ : тДХ тЖТ тДХ
рдпреБрдЧреНрдо-рдпреЛрдЧ zero    = zero
рдпреБрдЧреНрдо-рдпреЛрдЧ (suc n) = рдпреБрдЧреНрдо-рдпреЛрдЧ n + рдпреБрдЧреНрдо n

-- ррпр-р╡р░ррЧ-рриррр░рор тФ рпррЧрро-рпрЛрЧ n тЙб рУр-рпрЛрЧ n + n (рпррЧрро-рЧрр▓ррор рУр-рЧрр▓ррор╛рр ррХр╛рзр┐рХр) р
рдЖрдпрдд-рд╡рд░реНрдЧ-рдЕрдиреНрддрд░рдореН : (n : тДХ) тЖТ рдпреБрдЧреНрдо-рдпреЛрдЧ n тЙб рдУрдЬ-рдпреЛрдЧ n + n
рдЖрдпрдд-рд╡рд░реНрдЧ-рдЕрдиреНрддрд░рдореН zero    = refl
рдЖрдпрдд-рд╡рд░реНрдЧ-рдЕрдиреНрддрд░рдореН (suc n) =
    cong (_+ рдпреБрдЧреНрдо n) (рдЖрдпрдд-рд╡рд░реНрдЧ-рдЕрдиреНрддрд░рдореН n)
  тИЩ +-suc (рдУрдЬ-рдпреЛрдЧ n + n) (рдУрдЬ n)
  тИЩ cong suc (sym (+-assoc (рдУрдЬ-рдпреЛрдЧ n) n (рдУрдЬ n)))
  тИЩ cong suc (cong (рдУрдЬ-рдпреЛрдЧ n +_) (+-comm n (рдУрдЬ n)))
  тИЩ cong suc (+-assoc (рдУрдЬ-рдпреЛрдЧ n) (рдУрдЬ n) n)
  тИЩ sym (+-suc (рдУрдЬ-рдпреЛрдЧ n + рдУрдЬ n) n)

-- ррпр-рир┐рпрор тФ рпррЧрро-рпрЛрЧ n тЙб n ┬ suc n (ррпр-ррЩррЦррпр╛) , р╡р░ррЧ-рЧрр▓ррор╛рр р
рдЖрдпрдд-рдирд┐рдпрдордГ : (n : тДХ) тЖТ рдпреБрдЧреНрдо-рдпреЛрдЧ n тЙб n ┬╖ suc n
рдЖрдпрдд-рдирд┐рдпрдордГ n =
    рдЖрдпрдд-рд╡рд░реНрдЧ-рдЕрдиреНрддрд░рдореН n
  тИЩ cong (_+ n) (рд╡рд░реНрдЧ-рдЧреБрд▓реНрдордГ n)
  тИЩ +-comm (n ┬╖ n) n
  тИЩ sym (┬╖-suc n n)

-- рЙржр╛рр░ррор тФ 2+4+6+8 = 20 = 4┬5 (refl-рр┐ржррзрор) р
рдЖрдпрдд-рек : рдпреБрдЧреНрдо-рдпреЛрдЧ 4 тЙб 20
рдЖрдпрдд-рек = refl

------------------------------------------------------------------------
-- рУр-рШрир тФ рир┐рХрЛрор╛рЦрЛрр-р░рррор : ррр░ррор╛рир╛р T(n) р╡р┐ррор╛рр╛р рпрЛрЧр = ррр░ррор╛рир╛р n рШрир╛рир╛р рпрЛрЧр р
-- рУр-рпрЛрЧ(тИ n) тЙб тИ┬│ n , рпрр рЙрр (тИ n)┬▓ тФ ррр▓рр-рЧрр▓рро-р╡р░ррЧр (р╡р░ррЧ-рЧрр▓ррор) р рр░ррпррЯрррп
-- рШри-р░рррирор (тИk┬│=(тИk)┬▓, рШри-ррЩррХр▓р┐ррор) ррХррр░ рор┐р▓рр р  р╡р┐рро-ррр░ррр рШри-ррр░рррр р╡ррр┐ р
--
-- (Nicomachus's theorem in odd-number form: the sum of the first T(n) odd
-- numbers equals the sum of the first n cubes, рУр-рпрЛрЧ(тИ n) тЙб тИ┬│ n тФ both are
-- (тИn)┬▓, where the ulba gnomon-square law and ryabhaa's cube gem тИk┬│=(тИk)┬▓
-- meet.  The odd-number series carries the cube series.)
------------------------------------------------------------------------

рдУрдЬ-рдШрдирдГ : (n : тДХ) тЖТ рдУрдЬ-рдпреЛрдЧ (тИС n) тЙб тИС┬│ n
рдУрдЬ-рдШрдирдГ n = рд╡рд░реНрдЧ-рдЧреБрд▓реНрдордГ (тИС n) тИЩ sym (рдШрди-рд╕рдЩреНрдХрд▓рд┐рддрдореН n)

------------------------------------------------------------------------
-- рШри-рЧрр▓ррор тФ рШри-рЧрр▓рро-р░ррир╛ (ррр░р┐-рор┐р-рХрЛр) : (n+1)┬│ = n┬│ + 3n(n+1) + 1 р
-- рШрир (рро-рШрир) ррр░р┐-рор┐р-рЧрр▓ррорИр (L-рХрЛррИр) р╡р░ррзрр ; n-ррор рХрЛрр = 3n(n+1)+1 р
-- (The cube grown by 3-D gnomons (corner shells): (n+1)┬│ тИТ n┬│ = 3n(n+1)+1, so
--  suc n ┬ (suc n ┬ suc n) тЙб n┬(n┬n) + (3┬n(n+1) + 1), written additively over тХ.
--  Hand-proved: the expansion is one ┬-distrib╦б, then suc n + n┬n тЙб n┬suc n + 1.)
------------------------------------------------------------------------

рдШрди-рдЧреБрд▓реНрдордГ : (n : тДХ) тЖТ suc n ┬╖ (suc n ┬╖ suc n)
          тЙб n ┬╖ (n ┬╖ n) + (n ┬╖ suc n + (n ┬╖ suc n + (n ┬╖ suc n + 1)))
рдШрди-рдЧреБрд▓реНрдордГ n =
    sym (┬╖-distrib╦б (suc n) (suc n) (n ┬╖ suc n))
  тИЩ cong (╬╗ z тЖТ (suc n + P) + (P + z)) qexp
  тИЩ +-assoc (suc n + P) P (R + Q)
  тИЩ +-assoc ((suc n + P) + P) R Q
  тИЩ cong (_+ Q) step1
  тИЩ cong (╬╗ z тЖТ (z + (P + P)) + Q) keyfact
  тИЩ +-comm ((P + 1) + (P + P)) Q
  тИЩ cong (Q +_) step2
  where
    P = n ┬╖ suc n
    R = n ┬╖ n
    Q = n ┬╖ (n ┬╖ n)
    one : (x : тДХ) тЖТ x + 1 тЙб suc x
    one x = +-suc x 0 тИЩ cong suc (+-zero x)
    qexp : n ┬╖ (n ┬╖ suc n) тЙб R + Q
    qexp = cong (n ┬╖_) (┬╖-suc n n) тИЩ sym (┬╖-distrib╦б n n (n ┬╖ n))
    keyfact : suc n + R тЙб P + 1
    keyfact = sym (cong (_+ 1) (┬╖-suc n n) тИЩ one (n + n ┬╖ n))
    step1 : ((suc n + P) + P) + R тЙб (suc n + R) + (P + P)
    step1 = cong (_+ R) (sym (+-assoc (suc n) P P))
          тИЩ sym (+-assoc (suc n) (P + P) R)
          тИЩ cong (suc n +_) (+-comm (P + P) R)
          тИЩ +-assoc (suc n) R (P + P)
    step2 : (P + 1) + (P + P) тЙб P + (P + (P + 1))
    step2 = sym (+-assoc P 1 (P + P))
          тИЩ cong (P +_) (+-comm 1 (P + P))
          тИЩ cong (P +_) (sym (+-assoc P P 1))

-- рЙржр╛рр░ррор тФ 4┬│ = 64 = 3┬│ + 3┬3┬4 + 1 = 27 + 36 + 1 (refl-рр┐ржррзрор) р
рдШрди-рек : suc 3 ┬╖ (suc 3 ┬╖ suc 3) тЙб 64
рдШрди-рек = refl

------------------------------------------------------------------------
-- рШри-рпрЛрЧ-рир┐рпрор тФ рШри-рЧрр▓рро-рХрЛрр╛рир╛р рпрЛрЧр = рШрир : тИ (3k(k+1)+1) = n┬│ р
-- (рпрр╛ р╡р┐рро-рЧрр▓ррор╛р р╡р░ррЧр р░ррприррр┐, ррр╛ ррр░р┐-рор┐р-рШри-рЧрр▓ррор╛р рШрир р░ррприррр┐ тФ
--  рШри-рпрЛрЧ n тЙб n┬│ , рШри-рЧрр▓ррор╛рр ррр░рр┐-рХрЛррор р  рУр-рпрЛрЧ=n┬▓ ррррпрррп ррр░р┐-рор┐р-р░рррор р)
--
-- (As the odd gnomons build the square, the 3-D cube gnomons build the cube:
--  the sum of the shells 3k(k+1)+1 over k<n is n┬│, telescoping through рШри-рЧрр▓ррор.
--  The three-dimensional analogue of рУр-рпрЛрЧ = n┬▓.)
------------------------------------------------------------------------

рдШрди-рдпреЛрдЧ : тДХ тЖТ тДХ
рдШрди-рдпреЛрдЧ zero    = zero
рдШрди-рдпреЛрдЧ (suc n) = рдШрди-рдпреЛрдЧ n + (n ┬╖ suc n + (n ┬╖ suc n + (n ┬╖ suc n + 1)))

рдШрди-рдпреЛрдЧ-рдирд┐рдпрдордГ : (n : тДХ) тЖТ рдШрди-рдпреЛрдЧ n тЙб n ┬╖ (n ┬╖ n)
рдШрди-рдпреЛрдЧ-рдирд┐рдпрдордГ zero    = refl
рдШрди-рдпреЛрдЧ-рдирд┐рдпрдордГ (suc n) =
    cong (_+ (n ┬╖ suc n + (n ┬╖ suc n + (n ┬╖ suc n + 1)))) (рдШрди-рдпреЛрдЧ-рдирд┐рдпрдордГ n)
  тИЩ sym (рдШрди-рдЧреБрд▓реНрдордГ n)

-- рЙржр╛рр░ррор тФ 1 + 7 + 19 + 37 = 64 = 4┬│ (refl-рр┐ржррзрор) р
рдШрди-рдпреЛрдЧ-рек : рдШрди-рдпреЛрдЧ 4 тЙб 64
рдШрди-рдпреЛрдЧ-рек = refl
