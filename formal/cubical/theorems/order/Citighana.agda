рдЪрд┐рддрд┐ : тДХ тЖТ тДХ
рдЪрд┐рддрд┐ zero    = zero
рдЪрд┐рддрд┐ (suc n) = тИС (suc n) + рдЪрд┐рддрд┐ n

------------------------------------------------------------------------
-- ррр╛рпрХр╛р тФ ри┬x = x+x ; р┬тИ(suc n) = рй┬(suc n ┬ suc(suc n)) р
------------------------------------------------------------------------

рджреНрд╡рд┐┬╖ : (x : тДХ) тЖТ 2 ┬╖ x тЙб x + x
рджреНрд╡рд┐┬╖ x = cong (x +_) (+-zero x)

рд╖рдбреНтИС : (n : тДХ) тЖТ 6 ┬╖ тИС (suc n) тЙб 3 ┬╖ (suc n ┬╖ suc (suc n))
рд╖рдбреНтИС n = sym (┬╖-assoc 3 2 (тИС (suc n)))
       тИЩ cong (3 ┬╖_) (рджреНрд╡рд┐┬╖ (тИС (suc n)) тИЩ рджреНрд╡рд┐рдЧреБрдг-рд╕рдЩреНрдХрд▓рд┐рддрдореН (suc n))

------------------------------------------------------------------------
-- рХрр░ррХрр тФ рШри-рржрор : 3┬A + (n┬suc n)┬suc(suc n) тЙб A┬suc(suc(suc n)),
-- A = suc n ┬ suc(suc n) р  (3+n) = suc(suc(suc n)) ррр┐ ррр╡рпррр┐ржррзрор р
------------------------------------------------------------------------

рдХреНрд░реБрдХреНрд╕ : (n : тДХ)
       тЖТ 3 ┬╖ (suc n ┬╖ suc (suc n)) + (n ┬╖ suc n) ┬╖ suc (suc n)
       тЙб suc n ┬╖ suc (suc n) ┬╖ suc (suc (suc n))
рдХреНрд░реБрдХреНрд╕ n =
    cong (3 ┬╖ (suc n ┬╖ suc (suc n)) +_)
         (sym (┬╖-assoc n (suc n) (suc (suc n))))
  тИЩ ┬╖-distrib╩│ 3 n (suc n ┬╖ suc (suc n))
  тИЩ ┬╖-comm (3 + n) (suc n ┬╖ suc (suc n))

------------------------------------------------------------------------
-- рр┐рр┐рШрир тФ роррЦррп-рр┐ржррзр┐р : р┬(тИ ррр░р┐рХрЛрр╛рир┐) = n(n+1)(n+2) р
------------------------------------------------------------------------

рдЪрд┐рддрд┐рдШрдирдГ : (n : тДХ) тЖТ 6 ┬╖ рдЪрд┐рддрд┐ n тЙб n ┬╖ suc n ┬╖ suc (suc n)
рдЪрд┐рддрд┐рдШрдирдГ zero    = refl
рдЪрд┐рддрд┐рдШрдирдГ (suc n) =
    sym (┬╖-distrib╦б 6 (тИС (suc n)) (рдЪрд┐рддрд┐ n))
  тИЩ congтВВ _+_ (рд╖рдбреНтИС n) (рдЪрд┐рддрд┐рдШрдирдГ n)
  тИЩ рдХреНрд░реБрдХреНрд╕ n

