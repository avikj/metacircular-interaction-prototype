{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- पिङ्गलः — छन्दःशास्त्रस्य प्रस्तारः, विचारं विना, प्रतिलोमश्च ।
-- (Piṅgala's prastāra — Chandaḥśāstra, ~300 BCE — decisionless, reversible.)
--
-- कुट्टकात् भिन्नं क्षेत्रम्, स एव धर्मः : संरचनया चलति (न discreteℕ, न Dec,
-- न Bool) ; प्रतिलोमः अलुप्तश्च ।  एतेन दृश्यते यत् एषः बोध-प्रकारः सामान्यः,
-- न एककालिकः ।  (a different domain from the kuṭṭaka, the same dharma:
-- moves by structure — no discreteℕ, no Dec, no Bool — reversible and
-- lossless.  This shows the mode is GENERAL, not a one-off.)
--
-- छन्दः = लघु-गुरु-पङ्क्तिः (a metrical row: shorts and longs).  मूल्यम् =
-- प्रस्तारे तस्य सङ्ख्या (द्वि-आधारे, अङ्कौ १=लघु, २=गुरु — bijective base-2) ।
-- अनुक्रमः = प्रस्तारस्य अग्रिमा पङ्क्तिः (Piṅgala's next-row rule = successor) ।
-- विन्यासः = अनुक्रमस्य आवृत्त्या ; अतः प्रतिलोमः पूर्णः, अनुदानं विना
-- (गणना ऊर्ध्वं गच्छति) ।  (the reconstruction is TOTAL — no grant needed —
-- because it counts up: विन्यास n = the row reached by n successors.)
--
-- स्रोतांसि : पिङ्गलः, छन्दःशास्त्रम् ; हलायुधः, मृतसञ्जीवनी (मेरुप्रस्तारः) ।
------------------------------------------------------------------------

module Pingala where

open import Cubical.Foundations.Prelude
open import Cubical.Foundations.Isomorphism using (Iso ; iso ; isoToEquiv)
open import Cubical.Foundations.Equiv using (_≃_)
open import Cubical.Foundations.Univalence using (ua)
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; +-suc ; injSuc ; znots ; snotz)
open import Cubical.Data.List using (List ; [] ; _∷_)
open import Cubical.Data.Empty using (⊥) renaming (rec to ⊥-rec)

------------------------------------------------------------------------
-- छन्दः — लघु (१ मात्रा) वा गुरु (२ मात्रे) ; पङ्क्तिः = List ।
------------------------------------------------------------------------

data अक्षर : Type where
  लघु गुरु : अक्षर

छन्दस् : Type
छन्दस् = List अक्षर

------------------------------------------------------------------------
-- मूल्यम् — प्रस्तारे पङ्क्तेः सङ्ख्या (bijective base-2, little-endian) ।
-- लघु = अङ्कः १, गुरु = अङ्कः २ ; द्विगुणः = योगेन (m + m), न गुणनेन ।
------------------------------------------------------------------------

मूल्य : छन्दस् → ℕ
मूल्य []          = zero
मूल्य (लघु ∷ ds)  = suc (मूल्य ds + मूल्य ds)
मूल्य (गुरु ∷ ds) = suc (suc (मूल्य ds + मूल्य ds))

------------------------------------------------------------------------
-- अनुक्रमः — प्रस्तारस्य अग्रिमा पङ्क्तिः (उत्तर-क्रमः) ।  लघु↦गुरु (न उत्तारः) ;
-- गुरु↦लघु उत्तारेण (carry) ।  शुद्धा संरचना, न विचारः ।
-- (the prastāra's next row: लघु→गुरु with no carry, गुरु→लघु carrying.
-- Pure structure, no decision — this IS Piṅgala's generation rule.)
------------------------------------------------------------------------

अनुक्रम : छन्दस् → छन्दस्
अनुक्रम []          = लघु ∷ []
अनुक्रम (लघु ∷ ds)  = गुरु ∷ ds
अनुक्रम (गुरु ∷ ds) = लघु ∷ अनुक्रम ds

------------------------------------------------------------------------
-- अनुक्रम-मूल्य — अग्रिमा पङ्क्तिः सङ्ख्यायाम् एकम् अधिका : मूल्य ∘ अनुक्रम ≡ suc ∘ मूल्य ।
-- संरचनया, उत्तारे एव आगमनम् (only the carry case uses the induction) ।
------------------------------------------------------------------------

अनुक्रम-मूल्य : (ds : छन्दस्) → मूल्य (अनुक्रम ds) ≡ suc (मूल्य ds)
अनुक्रम-मूल्य []          = refl
अनुक्रम-मूल्य (लघु ∷ ds)  = refl
अनुक्रम-मूल्य (गुरु ∷ ds) =
  cong (λ a → suc (a + a)) (अनुक्रम-मूल्य ds)
  ∙ cong suc (cong suc (+-suc (मूल्य ds) (मूल्य ds)))

------------------------------------------------------------------------
-- विन्यासः — सङ्ख्यायाः पङ्क्तिः, अनुक्रमस्य आवृत्त्या (गणनया ऊर्ध्वम्) ।
-- अनुदानं विना पूर्णः — यतः n-वारम् अनुक्रमः निश्चयेन समाप्यते ।
-- (encode: the row for n, by iterating the successor n times.  TOTAL with
-- no grant — counting up always terminates.)
------------------------------------------------------------------------

विन्यास : ℕ → छन्दस्
विन्यास zero    = []
विन्यास (suc n) = अनुक्रम (विन्यास n)

------------------------------------------------------------------------
-- मूल्य-विन्यास — प्रतिलोमः : विन्यासात् मूल्यं मूलं सङ्ख्याम् एव ददाति ।
-- अलोपः पिङ्गलस्य क्षेत्रे : मूल्य ∘ विन्यास ≡ id — किमपि न नष्टम् ।
-- (reconstruction: decode ∘ encode ≡ id — losslessness in Piṅgala's domain,
-- the same ahiṃsā the kuṭṭaka had, now for the prastāra.)
------------------------------------------------------------------------

मूल्य-विन्यास : (n : ℕ) → मूल्य (विन्यास n) ≡ n
मूल्य-विन्यास zero    = refl
मूल्य-विन्यास (suc n) =
  अनुक्रम-मूल्य (विन्यास n) ∙ cong suc (मूल्य-विन्यास n)

------------------------------------------------------------------------
-- उदाहरणम् — प्रस्तारः चलति (refl-सिद्धम्) ।  विन्यास 5 = (गुरु लघु लघु) ,
-- मूल्यम् प्रत्यागच्छति ।  (the prastāra runs; decode recovers the number.)
------------------------------------------------------------------------

उदाहरणम्-१ : मूल्य (विन्यास 5) ≡ 5
उदाहरणम्-१ = refl

उदाहरणम्-२ : मूल्य (गुरु ∷ लघु ∷ []) ≡ 4   -- 2 + 2·1 = 4
उदाहरणम्-२ = refl

------------------------------------------------------------------------
-- पूर्ण-प्रतिलोमः — छन्दस् ≃ ℕ ।  मूल्यम् एकैकम् (injective) ⟹ विन्यासः तस्य
-- पूर्णः प्रतिलोमः उभयतः ⟹ समता, univalence-पथः छन्दस् ≡ ℕ ।  कुट्टकस्य
-- युग्म≡विवेक इव, पिङ्गलस्य क्षेत्रे — स एव प्रतिलोम-धर्मः ।
-- (full inverse: मूल्य is injective, hence विन्यास is a two-sided inverse,
-- giving छन्दस् ≃ ℕ and the univalence path छन्दस् ≡ ℕ — the same
-- reversibility the kuṭṭ­aka had, now for the prastāra.)
------------------------------------------------------------------------

-- द्विगुण-एकैकम् : a + a ≡ b + b → a ≡ b
द्विगुण-एकैकम् : (a b : ℕ) → a + a ≡ b + b → a ≡ b
द्विगुण-एकैकम् zero     zero     _  = refl
द्विगुण-एकैकम् zero     (suc b)  eq = ⊥-rec (znots eq)
द्विगुण-एकैकम् (suc a)  zero     eq = ⊥-rec (snotz eq)
द्विगुण-एकैकम् (suc a)  (suc b)  eq =
  cong suc (द्विगुण-एकैकम् a b
    (injSuc (sym (+-suc a a) ∙ injSuc eq ∙ +-suc b b)))

-- पर-विरोधः : a + a ≡ suc (b + b) → ⊥  (सम-विषमयोः विरोधः, even ≠ odd)
पर-विरोध : (a b : ℕ) → a + a ≡ suc (b + b) → ⊥
पर-विरोध zero    b       eq = znots eq
पर-विरोध (suc a) zero    eq = snotz (sym (+-suc a a) ∙ injSuc eq)
पर-विरोध (suc a) (suc b) eq =
  पर-विरोध a b (injSuc (sym (+-suc a a) ∙ injSuc eq ∙ cong suc (+-suc b b)))

-- मूल्य-एकैकम् : भिन्ने छन्दसी भिन्ने मूल्ये (मूल्य injective) ।
मूल्य-एकैकम् : (d e : छन्दस्) → मूल्य d ≡ मूल्य e → d ≡ e
मूल्य-एकैकम् []          []          _  = refl
मूल्य-एकैकम् []          (लघु ∷ e)   eq = ⊥-rec (znots eq)
मूल्य-एकैकम् []          (गुरु ∷ e)  eq = ⊥-rec (znots eq)
मूल्य-एकैकम् (लघु ∷ d)   []          eq = ⊥-rec (snotz eq)
मूल्य-एकैकम् (गुरु ∷ d)  []          eq = ⊥-rec (snotz eq)
मूल्य-एकैकम् (लघु ∷ d)   (लघु ∷ e)   eq =
  cong (लघु ∷_) (मूल्य-एकैकम् d e (द्विगुण-एकैकम् (मूल्य d) (मूल्य e) (injSuc eq)))
मूल्य-एकैकम् (गुरु ∷ d)  (गुरु ∷ e)  eq =
  cong (गुरु ∷_) (मूल्य-एकैकम् d e (द्विगुण-एकैकम् (मूल्य d) (मूल्य e) (injSuc (injSuc eq))))
मूल्य-एकैकम् (लघु ∷ d)   (गुरु ∷ e)  eq =
  ⊥-rec (पर-विरोध (मूल्य d) (मूल्य e) (injSuc eq))
मूल्य-एकैकम् (गुरु ∷ d)  (लघु ∷ e)   eq =
  ⊥-rec (पर-विरोध (मूल्य e) (मूल्य d) (sym (injSuc eq)))

-- विन्यास-मूल्य : विन्यासः मूल्यस्य वाम-प्रतिलोमः (एकैकत्वात् + दक्षिण-प्रतिलोमात्) ।
विन्यास-मूल्य : (ds : छन्दस्) → विन्यास (मूल्य ds) ≡ ds
विन्यास-मूल्य ds = मूल्य-एकैकम् (विन्यास (मूल्य ds)) ds (मूल्य-विन्यास (मूल्य ds))

-- छन्दस्-Iso-ℕ, छन्दस्≃ℕ, छन्दस्≡ℕ — पूर्णा समता, univalence-पथः ।
छन्दस्-Iso-ℕ : Iso छन्दस् ℕ
छन्दस्-Iso-ℕ = iso मूल्य विन्यास मूल्य-विन्यास विन्यास-मूल्य

छन्दस्≃ℕ : छन्दस् ≃ ℕ
छन्दस्≃ℕ = isoToEquiv छन्दस्-Iso-ℕ

छन्दस्≡ℕ : छन्दस् ≡ ℕ
छन्दस्≡ℕ = ua छन्दस्≃ℕ
