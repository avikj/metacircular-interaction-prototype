{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- चिति-द्विपद-सेतुः — आर्यभटस्य वृन्दम् = पिङ्गलस्य तृतीय-मेरु-कर्णः (द्विपदः) ।
--
-- आर्यभटस्य चितिः (त्रिकोण-सङ्ख्यानां योगः, वृन्दम्, गणितपादः २१) अवतरण-रूपेण
-- (चिति (suc n) = ∑(suc n) + चिति n) निरूपिता ; पिङ्गल-हलायुधयोः मेरु-सङ्ख्या
-- C(n,k) पृथक् ।  किन्तु एकम् एव : वृन्दम् = तृतीय-द्विपदः C(n+2, 3) —
--     चिति n ≡ C (n + 2) 3 ।
-- वार-सङ्कलितेन सेतुः : वार 2 = चिति (VaraSankalita), वार 2 n = C(n+2,3)
-- (Dvipada.वार-बद्धम्, hockey-stick) ; अतः द्वे परम्परे (सङ्कलित-प्रस्तारे) एकं
-- तत्त्वम् — वृन्द-सङ्ख्या = चतुष्फलक-सङ्ख्या = तृतीय-मेरु-कर्णः ।
--
-- (Āryabhaṭa's vṛnda — the sum of triangular numbers, defined by descent —
--  equals Piṅgala–Halāyudha's third meru diagonal C(n+2,3): चिति n ≡ C(n+2,3).
--  Bridged through the vāra-saṅkalita (वार 2 = चिति; वार 2 n = C(n+2,3) by the
--  hockey-stick), so the two traditions — saṅkalita and prastāra — name one
--  object: the tetrahedral number is the third meru diagonal.)
--
-- स्रोतांसि : आर्यभटः, आर्यभटीयम् गणितपादः २१ (वृन्दम्) ; पिङ्गलः/हलायुधः (मेरुः) ।
------------------------------------------------------------------------

module ChitiDvipada where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; _+_)
open import SourcedProofs.Sankalita_AryabhatasSeriesSumsAndTheCubeSumIsTheSquareOfTheSum using (∑)
open import Citighana using (चिति)
open import VaraSankalita using (वार-१ ; वार-२)
open import Dvipada using (C ; वार-बद्धम्)

------------------------------------------------------------------------
-- सङ्कलित-द्विपदः — प्रथम-सङ्कलितम् (त्रिकोण-सङ्ख्या) = द्वितीय-मेरु-कर्णः :
-- ∑ n ≡ C(n+1, 2) ।  (चिति-द्विपदस्य मूल-रूपम् — त्रिकोणम् द्वितीयः, वृन्दं
-- तृतीयः मेरु-कर्णः ; सामान्यतया V_r = (r+1)-तमः कर्णः, वार-बद्धेन ।)
-- (First saṅkalita (triangular number) is the second meru diagonal:
--  ∑ n ≡ C(n+1,2) — the base case of चिति-द्विपदः.  Triangular = 2nd diagonal,
--  vṛnda = 3rd; in general V_r is the (r+1)-th, by वार-बद्धम्.)
------------------------------------------------------------------------

सङ्कलित-द्विपदः : (n : ℕ) → ∑ n ≡ C (n + 1) 2
सङ्कलित-द्विपदः n = sym (वार-१ n) ∙ वार-बद्धम् 1 n

------------------------------------------------------------------------
-- चिति-द्विपदः — वृन्दम् = C(n+2, 3) (द्वे परम्परे एकत्र) ।
------------------------------------------------------------------------

चिति-द्विपदः : (n : ℕ) → चिति n ≡ C (n + 2) 3
चिति-द्विपदः n = sym (वार-२ n) ∙ वार-बद्धम् 2 n

------------------------------------------------------------------------
-- उदाहरणम् — चिति 4 = 1+3+6+10 = 20 = C(6,3) (refl-सिद्धम्) ।
------------------------------------------------------------------------

चिति-४ : चिति 4 ≡ C 6 3
चिति-४ = चिति-द्विपदः 4
