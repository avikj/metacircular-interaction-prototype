module Visvarupa_TheObjectClassifierIsTheFibreLawAndBothBindingsTotaliseToTheDomain where

open import Cubical.Foundations.Prelude
open import Cubical.Foundations.Equiv using (_≃_ ; fiber ; invEquiv ; compEquiv ; idEquiv)
open import Cubical.Foundations.Isomorphism using (Iso ; iso ; isoToEquiv)
open import Cubical.Foundations.Univalence using (ua ; uaβ)
open import Cubical.Foundations.Transport using (substComposite)
open import Cubical.Data.Sigma using (Σ-syntax ; _,_ ; fst ; snd ; Σ-contractSnd)
open import Cubical.Functions.Fibration using (fiberEquiv ; totalEquiv ; fibrationEquiv)

private
  variable
    ℓ : Level

------------------------------------------------------------------------
-- §1.  THE CLASSIFIER, CITED AND INSTANTIATED.
--
-- One object — the universe — and every map into a base is a family out of
-- it.  Not reproved here; named, so that what follows has something to
-- stand on.
------------------------------------------------------------------------

the-object-classifier :
  (B : Type₀) → (Σ[ E ∈ Type₀ ] (E → B)) ≃ (B → Type₀)
the-object-classifier B = fibrationEquiv B ℓ-zero

-- and the fibre law is what it classifies BY: the forward direction of the
-- equivalence sends a map to its family of fibres, on the nose.
classification-is-taking-fibres :
  {B : Type₀} {E : Type₀} (p : E → B) (b : B)
  → fst (the-object-classifier B) (E , p) b ≡ fiber p b
classification-is-taking-fibres p b = refl

------------------------------------------------------------------------
-- §2.  BOTH BINDINGS TOTALISE TO THE DOMAIN, FOR DIFFERENT REASONS.
------------------------------------------------------------------------

-- THE FREE BINDING.  `Carrier`'s own: bind the output and every summand is
-- contractible, so the total space collapses back to A summand by summand.
binding-the-output-totalises :
  {A B : Type₀} (f : A → B) → (Σ[ a ∈ A ] singl (f a)) ≃ A
binding-the-output-totalises f = Σ-contractSnd (λ a → isContrSingl (f a))

-- THE COSTLY BINDING.  Bind the input and no summand need be contractible;
-- the total space is A anyway, because the fibres reassemble.  HoTT 4.8.2.
binding-the-input-totalises :
  {A B : Type₀} (f : A → B) → (Σ[ b ∈ B ] fiber f b) ≃ A
binding-the-input-totalises f = invEquiv (totalEquiv f)

-- SO THE TWO TOTAL SPACES AGREE, AND THE AGREEMENT CARRIES NO INFORMATION
-- ABOUT f.  Everything the fibre law measures is in how A is cut, never in
-- how much of it there is.
both-bindings-totalise-alike :
  {A B : Type₀} (f : A → B)
  → (Σ[ a ∈ A ] singl (f a)) ≃ (Σ[ b ∈ B ] fiber f b)
both-bindings-totalise-alike f =
  compEquiv (binding-the-output-totalises f)
            (invEquiv (binding-the-input-totalises f))

------------------------------------------------------------------------
-- §3.  MONODROMY: TRANSPORT AROUND A LOOP, AND ITS ACTION LAW.
--
-- The flat part of the gauge picture, and it computes.  No connection is
-- supplied: the family IS the transport, which is exactly why what one gets
-- is the flat case.
------------------------------------------------------------------------

module _ {A : Type₀} (P : A → Type₀) where

  monodromy : {a : A} → a ≡ a → P a → P a
  monodromy p = subst P p

  -- The action law.  Path-ordered transport composes along concatenation,
  -- strictly.  This is what "flat" means here.
  monodromy-composes :
    {a : A} (p q : a ≡ a) (u : P a)
    → monodromy (p ∙ q) u ≡ monodromy q (monodromy p u)
  monodromy-composes p q u = substComposite P p q u

  -- and the constant loop acts trivially.
  monodromy-refl : {a : A} (u : P a) → monodromy refl u ≡ u
  monodromy-refl u = substRefl {B = P} u

------------------------------------------------------------------------
-- §4.  THE ITERATION IS WELL-FOUNDED: ONE ROUND TRIP IS THE IDENTITY.
--
-- Family ↦ total space ↦ fibres of the projection ↦ family.  HoTT 4.8.1.
-- So a tower built by iterating the fibre law never re-derives a stage it
-- already has; each stage is a genuinely new choice.
------------------------------------------------------------------------

round-trip : {B : Type₀} (P : B → Type₀) (b : B)
           → fiber {A = Σ[ x ∈ B ] P x} fst b ≃ P b
round-trip P b = fiberEquiv P b

-- The closure statement in the form the owner's sentence needs: the total
-- space of a family is itself a base with a map into the old one, so the
-- construction can be applied again, and §1 classifies the result.
the-universe-is-closed-under-the-operation :
  {B : Type₀} (P : B → Type₀) → Σ[ E ∈ Type₀ ] (E → B)
the-universe-is-closed-under-the-operation {B} P = (Σ[ x ∈ B ] P x) , fst

closure-classifies-back :
  {B : Type₀} (P : B → Type₀) (b : B)
  → fst (the-object-classifier B) (the-universe-is-closed-under-the-operation P) b
    ≃ P b
closure-classifies-back P b = round-trip P b
