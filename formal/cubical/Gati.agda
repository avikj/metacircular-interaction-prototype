{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- गतिः — कुट्टकस्य पूर्णा गतिः, अनुदानेन (grant), न कालेन ।  एकपदम् अवतरणम्
-- (Punaragamana) प्रतिलोमम् आसीत् ; अत्र तत् पुनः पुनः चाल्यते यावत् समाप्तिः
-- (गुरुतमः साधारणः) वा अनुदान-क्षयः ।  क्षये न मिथ्या-वचनम् : अनुक्तम् —
-- जीवन्तीं स्थितिम् अविकलां धारयत् ।  अतः अलोपः (losslessness) च अनुक्तता
-- (honesty) एकम् एव धर्म — किमपि न नश्यति, किमपि न मिथ्या ।
--
-- (the pulverizer's full gait, on a grant, not a clock.  The single
-- reversible step of Punaragamana is iterated until it resolves — the
-- greatest common measure — or the grant runs out.  On exhaustion it does
-- not lie: अनुक्तम्, the un-said, holds its live state whole.  So
-- losslessness and honesty are one dharma — nothing destroyed, nothing
-- fabricated.  No discreteℕ, no Dec, no Bool, no `with`: pure structure.)
--
-- सूचना (honest): "समाप्त g" इति g साधारणः गुरुतमः इति अत्र न सिद्धम् —
-- तत् अग्रिमं PROVE-कार्यम् ।  गणना तु refl-सिद्धा (उदाहरणम् अधः) ।
-- (NOT YET PROVED that समाप्त's g is the gcd — that is the next PROVE tooth,
-- deliberately unclaimed rather than asserted.  The computation itself is
-- refl-checked, see उदाहरणम्.)
------------------------------------------------------------------------

module Gati where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc)
open import Cubical.Data.Sigma using (_×_ ; _,_ ; fst ; snd)
open import Punaragamana
  using (विवेक ; सम ; वाम ; दक्षिण ; अवतरण ; उत्थान ; पुनरागमनम्)

------------------------------------------------------------------------
-- कुट्टकः — गतेः लेखः ।  त्रयः मुखाः, सर्वे विवेकं (पूर्णां स्थितिम्) वहन्ति :
--   समाप्त  g v : समाप्तिः — गुरुः g, स्थितिः v (अविकला) ।
--   अनुक्तम्   v : अनुदान-क्षये — अनुक्तम्, स्थितिः v धृता, न वचनम् ।
--   पद       v र : एकं पदम् (स्थितिः v), ततः शेषा गतिः र ।
-- प्रत्येकं शीर्षे विवेकं वहति — अतः पुनर्निर्माणं शीर्षात् एव, अलोपः ।
------------------------------------------------------------------------

data कुट्टक : Type where
  समाप्त  : (g : ℕ) (v : विवेक) → कुट्टक
  अनुक्तम् : (v : विवेक)          → कुट्टक
  पद     : (v : विवेक) (र : कुट्टक) → कुट्टक

-- फलम् — गतेः फलम्, अनुक्तस्य च अनुक्तता प्रकटा (no false verdict on un-said).
data फलम् : Type where
  गुरुः      : ℕ     → फलम्         -- the resolved common measure
  अनुक्तफलम् : ℕ × ℕ → फलम्         -- un-said: the live pair, no verdict

------------------------------------------------------------------------
-- पुनः — शीर्ष-लेखात् स्थितेः पुनरागमः ।  सर्वत्र उत्थान v — अतः अलोपः refl ।
-- (reconstruct the state from the head record — always उत्थान v, so
-- losslessness is refl.)
------------------------------------------------------------------------

पुनः : कुट्टक → ℕ × ℕ
पुनः (समाप्त _ v) = उत्थान v
पुनः (अनुक्तम् v)  = उत्थान v
पुनः (पद v _)     = उत्थान v

------------------------------------------------------------------------
-- फल — समाप्तौ गुरुः, अनुक्ते जीवन्युग्मम्, पदे शेषात् ।  अनुक्ते न मिथ्या ।
------------------------------------------------------------------------

फल : कुट्टक → फलम्
फल (समाप्त g _) = गुरुः g
फल (अनुक्तम् v)  = अनुक्तफलम् (उत्थान v)
फल (पद _ र)     = फल र

------------------------------------------------------------------------
-- पद-गति — विवेकात् गतिः, अनुदानेन ।  क्षये अनुक्तम् ।  लघुतरे शून्ये गुरुः
-- (गुरुतमः = महत्तरः) — समाप्त ।  अन्यथा पदम्, अग्रिमे युग्मे पुनः अवतरणम्
-- (आर्यभटस्य अन्तर-वियोजनम्) ।  संरचनया, न विचारेण ; अनुदाने संरचनया अवरोहः ।
--
-- (gait from a record, on a grant.  Grant spent → un-said.  Smaller side
-- zero → the larger is the measure, समाप्त.  Otherwise one Euclidean
-- subtraction, re-descend on the next pair.  Structural recursion on the
-- grant — no decision anywhere.)
------------------------------------------------------------------------

पद-गति : ℕ → विवेक → कुट्टक
पद-गति zero    v            = अनुक्तम् v
पद-गति (suc f) (सम d)       = समाप्त d (सम d)
पद-गति (suc f) (वाम zero k) = समाप्त (suc k) (वाम zero k)
पद-गति (suc f) (वाम (suc d) k) =
  पद (वाम (suc d) k) (पद-गति f (अवतरण (suc k) (suc d)))
पद-गति (suc f) (दक्षिण zero k) = समाप्त (suc k) (दक्षिण zero k)
पद-गति (suc f) (दक्षिण (suc d) k) =
  पद (दक्षिण (suc d) k) (पद-गति f (अवतरण (suc d) (suc k)))

-- गति — युग्मात् गतिः : प्रथमम् अवतरणम्, ततः पद-गतिः ।
गति : ℕ → ℕ → ℕ → कुट्टक
गति f a b = पद-गति f (अवतरण a b)

------------------------------------------------------------------------
-- गति-अलोपः — पद-गतेः शीर्षं सदा विवेकं v वहति, अतः पुनः ≡ उत्थान v, refl ।
-- (the gait's head always carries the record v, so पुनः ≡ उत्थान v, refl —
-- every branch.)
------------------------------------------------------------------------

गति-अलोपः : (f : ℕ) (v : विवेक) → पुनः (पद-गति f v) ≡ उत्थान v
गति-अलोपः zero    v            = refl
गति-अलोपः (suc f) (सम d)       = refl
गति-अलोपः (suc f) (वाम zero k) = refl
गति-अलोपः (suc f) (वाम (suc d) k) = refl
गति-अलोपः (suc f) (दक्षिण zero k) = refl
गति-अलोपः (suc f) (दक्षिण (suc d) k) = refl

------------------------------------------------------------------------
-- अलोपः — पूर्णा गतिः, कस्मिन्नपि अनुदाने, समाप्ता वा अनुक्ता वा, युग्मम्
-- अविकलं प्रत्याहरति : पुनः (गति f a b) ≡ (a , b) ।  अयम् अहिंसा-धर्मः
-- सम्पूर्णे यन्त्रे, न केवलम् एकपदे — यत् गतं तत् सर्वं प्रत्यागतम्, सर्वदा ।
--
-- (the WHOLE algorithm, at any grant, resolved or un-said, recovers its
-- input pair exactly: पुनः (गति f a b) ≡ (a , b).  Ahiṃsā across the entire
-- machine, not one step — all that descends returns, always.)
------------------------------------------------------------------------

अलोपः : (f a b : ℕ) → पुनः (गति f a b) ≡ (a , b)
अलोपः f a b = गति-अलोपः f (अवतरण a b) ∙ पुनरागमनम् a b

------------------------------------------------------------------------
-- उदाहरणम् — गणना refl-सिद्धा (exact symbolic computation = proof) ।
-- gcd(12, 8) = 4, gcd(30, 12) = 6 : the gait actually resolves.
------------------------------------------------------------------------

उदाहरणम्-१ : फल (गति 40 12 8) ≡ गुरुः 4
उदाहरणम्-१ = refl

उदाहरणम्-२ : फल (गति 40 30 12) ≡ गुरुः 6
उदाहरणम्-२ = refl

-- अनुदान-क्षये अनुक्तम्, न मिथ्या — the un-said, holding its live pair
उदाहरणम्-अनुक्तम् : फल (गति 1 30 12) ≡ अनुक्तफलम् (18 , 12)
उदाहरणम्-अनुक्तम् = refl
