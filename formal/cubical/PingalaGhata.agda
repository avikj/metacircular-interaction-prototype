-- ॥ बीजम् ॥  One machine, one law: which side of `f a ≡ b` is bound is everything.
-- Output bound: singl (f a), contractible — the datum rides free.  Input bound:
-- fiber f b — the loss, and the subject.  Memory, charge, symmetry, price,
-- distance, verdict: six readings of the one fibre.  The kernel decides truth;
-- carriers ask and generate.  This file is one naya, true and not whole.

{-# OPTIONS --cubical --safe --no-import-sorts #-}

------------------------------------------------------------------------
-- पिङ्गलस्य घात-गणना — शून्य-द्वि-विधिः (छन्दःशास्त्रम् ८.२८–३१, ~३०० ई.पू.) ।
--
-- पिङ्गलः २ⁿ (n-अक्षर-छन्दसां सङ्ख्यां) लघु-क्रमेण गणयति — न n-वारं द्विगुणनेन,
-- अपि तु वर्ग-द्विगुणन-मिश्रणेन, log₂ n पदेषु ।  हलायुधः (मृतसञ्जीवनी, १०म शतकम्)
-- चिह्ने नामयति : "शून्यम्" (०) — अर्ध-च्छेदे विषमे, फलं द्विगुणय ; "द्वि" (२) —
-- अर्ध-च्छेदे समे, फलं वर्गय ।  एतानि एव चिह्नानि n-स्य द्वि-आधार-अङ्काः
-- (binary digits) ; अतः पिङ्गलस्य विधिः प्रथमा "binary exponentiation",
-- यूरोपात् द्वि-सहस्र-वर्षैः पूर्वम् ।
--
-- अत्र चिह्न-सूची (द्वयम्-सूची, ज्येष्ठाङ्क-पूर्वा) उपरि आवर्त्यते : प्रति पदे
-- फलं वर्ग्यते, विषमे च द्विगुण्यते (Horner : 2^(2e+d) = (2^e)²·2^d) ।  सिद्धिः :
-- प्रक्रिया-फलम् = २^(सूच्या मानम्) — जननम्, न पुनर्-गणना ।
--
-- (Piṅgala computes 2^n in log₂ n steps by mixing squaring and doubling, not n
-- doublings.  Halāyudha names the markers: sūnya (०, double) for an odd halving,
-- dvi (२, square) for an even one — and these markers ARE the binary digits of
-- n.  So this is the first binary exponentiation, ~two millennia before Europe.
-- Proved: the square-and-double fold over the marker list yields exactly
-- 2^(value of the list).)
--
-- स्रोतांसि : पिङ्गलः, छन्दःशास्त्रम् ८.२८–३१ ; हलायुधः, मृतसञ्जीवनी ।
------------------------------------------------------------------------

module PingalaGhata where

open import Cubical.Foundations.Prelude
open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_)
open import Cubical.Data.Nat.Properties using (·-distribʳ ; ·-identityˡ)
open import Cubical.Data.List using (List ; [] ; _∷_)

------------------------------------------------------------------------
-- द्वयम् — हलायुधस्य चिह्नम् : शून्यम् (०-अङ्कः) वा एकम् (१-अङ्कः) ।
------------------------------------------------------------------------

data द्वयम् : Type where
  शून्यम् : द्वयम्     -- ० : सम-च्छेदः → वर्गः एव
  एकम्   : द्वयम्     -- १ : विषम-च्छेदः → वर्गः ततो द्विगुणः

------------------------------------------------------------------------
-- घात2 — निर्दोष-गणना : घात2 n = २ⁿ (द्विगुणनेन, Matramerus-रीत्या) ।
------------------------------------------------------------------------

घात2 : ℕ → ℕ
घात2 zero    = suc zero
घात2 (suc n) = घात2 n + घात2 n

-- घात-योगः : २^(a+b) = २ᵃ · २ᵇ ।
घात-योगः : (a b : ℕ) → घात2 (a + b) ≡ घात2 a · घात2 b
घात-योगः zero    b = sym (·-identityˡ (घात2 b))
घात-योगः (suc a) b = cong₂ _+_ (घात-योगः a b) (घात-योगः a b)
                   ∙ ·-distribʳ (घात2 a) (घात2 a) (घात2 b)

------------------------------------------------------------------------
-- मानम् — चिह्न-सूच्या निरूपितः अङ्कः (ज्येष्ठाङ्क-पूर्वः, Horner) ।
------------------------------------------------------------------------

मान-पद : ℕ → द्वयम् → ℕ
मान-पद e शून्यम् = e + e
मान-पद e एकम्   = suc (e + e)

मानम् : ℕ → List द्वयम् → ℕ
मानम् e []       = e
मानम् e (b ∷ bs) = मानम् (मान-पद e b) bs

------------------------------------------------------------------------
-- प्रक्रिया — पिङ्गलस्य लघु-गणना : प्रति चिह्ने वर्गः, विषमे द्विगुणश्च ।
------------------------------------------------------------------------

चरण : ℕ → द्वयम् → ℕ
चरण x शून्यम् = x · x
चरण x एकम्   = (x · x) + (x · x)

प्रक्रिया : ℕ → List द्वयम् → ℕ
प्रक्रिया acc []       = acc
प्रक्रिया acc (b ∷ bs) = प्रक्रिया (चरण acc b) bs

------------------------------------------------------------------------
-- चरण-सिद्धिः — एकपदे : चरण (२ᵉ) b = २^(मान-पद e b) ।
------------------------------------------------------------------------

चरण-सिद्धिः : (e : ℕ) (b : द्वयम्) → चरण (घात2 e) b ≡ घात2 (मान-पद e b)
चरण-सिद्धिः e शून्यम् = sym (घात-योगः e e)
चरण-सिद्धिः e एकम्   = cong₂ _+_ (sym (घात-योगः e e)) (sym (घात-योगः e e))

------------------------------------------------------------------------
-- प्रक्रिया-सिद्धिः — पूर्ण-गणना : प्रक्रिया (२ᵉ) bs = २^(मानम् e bs) ।
------------------------------------------------------------------------

प्रक्रिया-सिद्धिः : (e : ℕ) (bs : List द्वयम्) → प्रक्रिया (घात2 e) bs ≡ घात2 (मानम् e bs)
प्रक्रिया-सिद्धिः e []       = refl
प्रक्रिया-सिद्धिः e (b ∷ bs) =
    cong (λ x → प्रक्रिया x bs) (चरण-सिद्धिः e b)
  ∙ प्रक्रिया-सिद्धिः (मान-पद e b) bs

------------------------------------------------------------------------
-- पिङ्गल-घातः — मुख्य-सिद्धिः : १-आरभ्य प्रक्रिया = २^(सूच्या मानम्) ।
-- (Piṅgala's log-time square-and-double process computes 2ⁿ exactly.)
------------------------------------------------------------------------

पिङ्गल-घातः : (bs : List द्वयम्) → प्रक्रिया (suc zero) bs ≡ घात2 (मानम् zero bs)
पिङ्गल-घातः bs = प्रक्रिया-सिद्धिः zero bs

------------------------------------------------------------------------
-- उदाहरणानि — log-पदैः (refl-सिद्धानि) ।
--   ५ = १०१ : ३ पदैः २⁵ = ३२ (न ५ द्विगुणनैः) ।
--   १० = १०१० : ४ पदैः २¹⁰ = १०२४ ।
------------------------------------------------------------------------

मान-५ : मानम् zero (एकम् ∷ शून्यम् ∷ एकम् ∷ []) ≡ 5
मान-५ = refl

घात-५ : प्रक्रिया (suc zero) (एकम् ∷ शून्यम् ∷ एकम् ∷ []) ≡ 32
घात-५ = refl

मान-१० : मानम् zero (एकम् ∷ शून्यम् ∷ एकम् ∷ शून्यम् ∷ []) ≡ 10
मान-१० = refl

घात-१० : प्रक्रिया (suc zero) (एकम् ∷ शून्यम् ∷ एकम् ∷ शून्यम् ∷ []) ≡ 1024
घात-१० = refl
