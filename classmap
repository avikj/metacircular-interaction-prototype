#!/bin/sh
# Equivalence-class map from /tmp/rows.txt (OBJ/SUB <key> <name>).
# Two declarations/sub-objects share a class iff their normalised types are
# byte-identical (LF definitional identity). Grouping is by sort — keys are
# never passed as arguments (they can be very large).
set -eu
ROWS="${1:-/tmp/rows.txt}"
OUT="${2:-/tmp/classmap.txt}"
export LC_ALL=C

# key \t name, sorted by key so equal keys are adjacent
awk -F'\t' '$1=="OBJ"{print $2"\t"$3}' "$ROWS" | sort -t"$(printf '\t')" -k1,1 > /tmp/obj.sorted
awk -F'\t' '$1=="SUB"{print $2"\t"$3}' "$ROWS" | sort -t"$(printf '\t')" -k1,1 > /tmp/sub.sorted

# collapse each key-group into: <count>\t<name1|name2|...>  (only |class|>1)
collapse() {  # collapse <sorted-file>
  awk -F'\t' '
    NR==1 { key=$1; names=$2; c=1; next }
    $1==key { names=names " | " $2; c++; next }
    { if (c>1) print c "\t" names; key=$1; names=$2; c=1 }
    END { if (c>1) print c "\t" names }
  ' "$1" | sort -rn -k1,1
}

nobj=$(wc -l < /tmp/obj.sorted)
ncls=$(cut -f1 /tmp/obj.sorted | uniq | wc -l)
collapse /tmp/obj.sorted > /tmp/obj.classes
collapse /tmp/sub.sorted > /tmp/sub.classes
nnt=$(wc -l < /tmp/obj.classes)

{
  echo "════════ EQUIVALENCE-CLASS MAP — LF (definitional) type identity ════════"
  echo "whole-type objects        : $nobj declarations"
  echo "equivalence classes       : $ncls"
  echo "non-trivial classes (>1)  : $nnt   (declarations that are literally the same type)"
  echo "sub-object non-trivial cls: $(wc -l < /tmp/sub.classes)"
  echo
  echo "A class with N members = N declarations whose types normalise to the"
  echo "same normal form: identical up to α,β,δ,ι. Genuine identities."
  echo
  echo "──────── whole-type identity classes, largest first ────────"
  awk -F'\t' '{printf "\n[%s ≡] %s\n", $1, $2}' /tmp/obj.classes
} > "$OUT"
echo "wrote $OUT ($(wc -l < "$OUT") lines)"
echo "--- summary ---"; head -8 "$OUT"
echo "--- top classes ---"; sed -n '9,45p' "$OUT"
