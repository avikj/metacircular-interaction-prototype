#!/bin/sh
# Reject commits outside the one canonical branch.
# MATH_ALLOW_NON_MAIN=1 exists only for the one-time branch-consolidation
# commit that installed this guard; ordinary work must never set it.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
if [ "$branch" != "main" ] && [ "${MATH_ALLOW_NON_MAIN:-}" != "1" ]; then
  printf 'BLOCKED: main is the only workstream; current branch is %s.\n' \
    "${branch:-DETACHED}" >&2
  printf 'Use the canonical shared checkout and run ./sync.\n' >&2
  exit 1
fi

# Reject Python at the commit boundary — the layer that catches agents whose
# harness has no PreToolUse hook (Codex lineage, supervisor-launched minds,
# anything driving Git directly).
#
# Human owner directive, 2026-08-13. Enabled per-repository with
#     git config core.hooksPath .githooks
# which is repo-level config and therefore applies to the canonical checkout.
#
# Scope: blocks ADDED and MODIFIED .py/.pyi/.ipynb. Deletions are always
# allowed — migrating away from the 660 existing files is the point.
#
# Escape hatch: MATH_ALLOW_PYTHON=1 git commit ...
# It exists so in-flight work is never destroyed (PROTOCOL §5). Using it is a
# recorded decision; say so in your journal and a message.

if [ "${MATH_ALLOW_PYTHON:-}" = "1" ]; then
  printf 'no-python: OVERRIDDEN via MATH_ALLOW_PYTHON=1 — record this.\n' >&2
  exit 0
fi

offenders=$(git diff --cached --name-only --diff-filter=AM | grep -E '\.(py|pyi|ipynb)$' || true)

if [ -n "$offenders" ]; then
  printf 'BLOCKED: Python is banned in this repository (human owner, 2026-08-13).\n\n' >&2
  printf 'These staged files are Python:\n' >&2
  printf '%s\n' "$offenders" | sed 's/^/    /' >&2
  printf '\n' >&2
  printf 'The substrate is Agda: formal/cubical/ (--cubical --safe, no postulates,\n' >&2
  printf 'no holes). The analytic lane uses Lean: formal/pairfield/.\n\n' >&2
  printf 'A script that prints a number is an assertion a reader must trust.\n' >&2
  printf 'A checked term is the thing itself. CLAUDE.md already draws this line:\n' >&2
  printf 'exact/certified symbolic computation IS proof; everything else stands in\n' >&2
  printf 'for an error analysis you have not done.\n\n' >&2
  printf 'To unstage and keep working:   git restore --staged <file>\n' >&2
  printf 'If you truly cannot proceed:    MATH_ALLOW_PYTHON=1 git commit ...\n' >&2
  printf '  (then record it in your journal and a message — otherwise you are\n' >&2
  printf '   lying to the collaboration)\n' >&2
  exit 1
fi

# Board forecast-citation guard (2026-08-15). Only runs when collab/STATE.md is
# staged. Rationale, scope and its exercised behaviour: see the script header
# and notes/FORECAST_LEDGER_AUDIT.md. Fires on the pre-correction row 205 text;
# 0 hits on the whole corrected board.
if git diff --cached --name-only --diff-filter=AM | grep -qx 'collab/STATE.md'; then
  tmp_board=$(git rev-parse --git-dir)/STATE.staged.$$
  git show :collab/STATE.md > "$tmp_board" 2>/dev/null || true
  if [ -s "$tmp_board" ] && [ -x .githooks/check-forecast-citations.sh ]; then
    if ! ./.githooks/check-forecast-citations.sh "$tmp_board"; then
      rm -f "$tmp_board"
      exit 1
    fi
  fi
  rm -f "$tmp_board"
fi

# --- the unscoped commit takes the shared index --------------------------
# ADVISORY. Never blocks. Added 2026-08-20.
#
# Four lanes had staged work swept into other lanes' commits on 2026-08-20 --
# 6b200f55, c9726ed1, 14cb41a5, acf4dcda -- and machine/dosa.lekha 0013 and
# 0014 record the commands. Every one was `git add <one-path> && git commit`.
# The add was correctly scoped. `git commit` has no pathspec by default and
# takes the ENTIRE INDEX, and sixteen processes here share one index, so the
# scoped add protected nothing.
#
# .claude/hooks/Nasti_TheIndexIsSharedAndCommitTakesAllOfIt.sh refuses this at
# PreToolUse, where the index can be read BEFORE the command's own `git add`
# runs and the foreign paths are therefore known exactly. This layer exists for
# the commits that hook never sees: Codex-lineage agents with no PreToolUse,
# supervisor-launched minds, and scripts driving git directly.
#
# It only ADVISES, because here the pre-state is gone: by the time a pre-commit
# runs, this commit's own `add` has already happened and nothing distinguishes
# a foreign staged path from one this agent staged in an earlier call. That is
# a judgement call, and a blocking guard on a judgement call is an outage
# wearing enforcement's name.
#
# Scoped commits are detected by GIT_INDEX_FILE, which git points at a
# temporary `next-index-<pid>` for a partial commit. Verified in a scratch repo
# before this was written, both directions.
case "${GIT_INDEX_FILE:-}" in
  *next-index*) ;;                      # -o / --only / -- <paths>: already scoped
  *)
    swept=$(git diff --cached --name-only | wc -l | tr -d ' ')
    if [ "${swept:-0}" -gt 1 ]; then
      printf 'note: unscoped commit, %s paths from the shared index:\n' "$swept" >&2
      git diff --cached --name-only | sed 's/^/    /' >&2
      printf 'If any of these are another lane'"'"'s, they land under YOUR message and\n' >&2
      printf 'git log --follow will report them introduced by it. Prefer:\n' >&2
      printf '    git commit -o <your paths> -m %s\n' "'...'" >&2
      printf 'Note that -o scopes which PATHS, not which VERSION: it commits the\n' >&2
      printf 'working-tree content, so another lane%s unstaged edits in a shared file\n' "'s" >&2
      printf 'ride along, and that belongs in your message.\n' >&2
    fi
    ;;
esac

exit 0
