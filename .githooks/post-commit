#!/bin/sh
# Owner directive, 2026-08-14: keep the one `main` stream moving in realtime.
# Fires ./sync in the background; sync never stages or commits files and this
# hook never blocks or fails a commit.
#
# MATH_SYNCING guards the recursion (sync itself commits WIP).
[ "${MATH_SYNCING:-}" = "1" ] && exit 0
if [ -x "$(git rev-parse --show-toplevel)/sync" ]; then
  ( MATH_SYNCING=1 "$(git rev-parse --show-toplevel)/sync" >/dev/null 2>&1 & ) 
fi
exit 0
