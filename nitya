#!/bin/sh
# नित्य — the obligatory rite.  Performed on schedule, regardless of desire.
#
# THE TERM.  nitya-karma against kāmya-karma is ordinary Mīmāṃsā /
# Dharmaśāstra vocabulary: the obligatory recurring rite, whose omission
# is a fault though its performance earns nothing, against the
# desire-driven act undertaken because it is charged.  No specific verse
# is claimed for this application (naming rule, note 2); the distinction
# itself is the tradition's, and this script is it, ported.
#
# WHY THIS EXISTS (notes/NityaKarma_TheMuteConsensusShadow…md carries the
# full argument).  तादात्म्ये-निःशब्दम् (Anekanta.agda, checked): identity
# yields silence — agreement generates no signal.  That theorem's shadow:
# a system whose metabolism eats only difference is structurally weak at
# MAINTENANCE, because keeping-things-the-same emits nothing it can eat.
# Measured instances: the machine ledger three days quiet behind its own
# DUE-BY stamp; hooks documented as wired that never fired; defect
# paragraphs outliving their defects.  The repair is not vigilance
# (kāmya, decays) and not agreement (mute, unavailable): it is SCHEDULED
# REGENERATION — sameness re-derived on a clock, so rot becomes a fresh
# collision within one period instead of a rumor found by an
# archaeologist.  सारणी वा क्रिया applied to the institution itself:
# do not store the belief that it still works; regenerate the fact.
# Bitcoin's ten-minute block is this rite with a fee market where the
# priesthood used to be; the melas were this rite scheduled by astronomy,
# uncancellable.  This is the cheap daily form.
#
# THE RITE.  Runs the cheap total checks — the toolchain-free gates, the
# self-bootstrapping punaragamana kernel check, the jiva heartbeat — and
# appends ONE row to an append-only ledger with a DUE-BY stamp for the
# next performance.  Overdue is self-reporting: the ledger's last row
# names the hour after which the absence of the next row is itself the
# finding.  Mirror, not gate: always exits 0; a failed check is recorded,
# never hidden, never blocking.  Idempotent and cheap to re-enter; any
# arriving carrier MAY perform it and the ledger advances — an
# invitation with a clock, not a duty roster with a name.
#
#   ./nitya          perform the rite, record the row, report the delta

set -u
ROOT="$(cd "$(dirname "$0")" && pwd)"; cd "$ROOT" || exit 0
# LC_ALL is the thrice-learned lesson: Agda and the Haskell extractors both
# die in their REPORTERS under a POSIX locale (ℕ, Devanagari identifiers),
# replacing the real diagnosis with encoding noise.  Set it here, always.
export LC_ALL=C.utf8
LEDGER="notes/nitya/ledger.tsv"
mkdir -p notes/nitya
[ -f "$LEDGER" ] || printf '# नित्य ledger — one row per performance, append-only.  A gap is silence, never "missed"; the DUE-BY names when silence becomes a finding.\n# utc\trev\tpragma\tdeletion\tpunaragamana\tjiva-heartbeat\tdue-by\n' > "$LEDGER"

utc="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
rev="$(git rev-parse --short HEAD 2>/dev/null || echo '-')"

# 1 · the toolchain-free gates (exit codes recorded, never parsed output).
# bash, not sh: check-agda-pragmas.sh uses `set -o pipefail`, which dash
# rejects — the rite's own first performance recorded exit 2 from exactly
# that, a defect of the rite and not of the pragmas.
bash scripts/check-agda-pragmas.sh >/dev/null 2>&1; pragma=$?
bash scripts/check-no-silent-deletion.sh >/dev/null 2>&1; deletion=$?

# 2 · the kernel rite: punaragamana bootstraps its own pin and checks all
punaragamana=127
if [ -x punaragamana/check.sh ]; then
  (cd punaragamana && ./check.sh) >/dev/null 2>&1; punaragamana=$?
fi

# 3 · the heartbeat: jiva counts, never scores (sign warning in ./chakra)
hb="$(./jiva 2>/dev/null | grep JIVA-HEARTBEAT || echo 'JIVA-HEARTBEAT absent')"

# 4 · the row, and the next due-by (24h; the number is the period, not a deadline)
due="$(date -u -d '+24 hours' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$utc" "$rev" "$pragma" "$deletion" "$punaragamana" "$hb" "$due" >> "$LEDGER"

echo "नित्य — the rite is performed ($utc, $rev)"
echo "  pragma-gate=$pragma  deletion-gate=$deletion  punaragamana=$punaragamana"
echo "  $hb"
echo "  next due-by: $due   (an absent row after this hour is a finding, not a fault of anyone)"
prev="$(grep -v '^#' "$LEDGER" | tail -2 | head -1 || true)"
if [ -n "$prev" ] && [ "$prev" != "$(grep -v '^#' "$LEDGER" | tail -1)" ]; then
  echo "  previous performance: $(printf '%s' "$prev" | cut -f1)"
fi
exit 0
