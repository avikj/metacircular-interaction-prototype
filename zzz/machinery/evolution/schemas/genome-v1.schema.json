{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private:math-dgm-genome-v1",
  "title": "MathDGM genome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "genome_id",
    "created_at",
    "parent_genome_ids",
    "base_revision",
    "base_snapshot_sha256",
    "objective_sha256s",
    "dependency_sha256s",
    "dependency_closure_sha256",
    "reconstruction_manifest_sha256",
    "mutations"
  ],
  "properties": {
    "format": {"const": "math-dgm-genome-v1"},
    "genome_id": {"$ref": "#/$defs/hash"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "parent_genome_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "base_revision": {
      "type": "string",
      "pattern": "^(git-sha1:[0-9a-f]{40}|git-sha256:[0-9a-f]{64})$"
    },
    "base_snapshot_sha256": {"$ref": "#/$defs/hash"},
    "objective_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "dependency_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "dependency_closure_sha256": {"$ref": "#/$defs/hash"},
    "reconstruction_manifest_sha256": {"$ref": "#/$defs/hash"},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/mutation"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "before_sha256", "after_sha256", "rationale_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!.*(/\\.git(/|$)|/\\.claude(/|$)|/\\.codex(/|$)|/agents\\.md(/|$)))collab/evolution/candidates/[a-z0-9][a-z0-9._-]{0,127}(/[a-z0-9][a-z0-9._-]{0,127})*$",
          "maxLength": 512
        },
        "operation": {"enum": ["add", "modify"]},
        "before_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "after_sha256": {"$ref": "#/$defs/hash"},
        "rationale_sha256": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "add"}}},
          "then": {"properties": {"before_sha256": {"type": "null"}}},
          "else": {"properties": {"before_sha256": {"$ref": "#/$defs/hash"}}}
        }
      ]
    }
  }
}
