set -u
cd "$(dirname "$0")"

MODE="${1:-once}"
INTERVAL="${2:-600}"

CUBICAL=formal/cubical
LEDGER=collab/orchestration/machine-ledger.tsv
FIBERS=collab/orchestration/open-fibers.md
STAMP() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# GNU `timeout` is not present on the macOS host used by this workspace.  A
# missing watchdog must not turn every mathematical check into exit 127.
# Prefer a real watchdog where available; otherwise run the check directly and
# preserve its actual exit code.  The outer supervisor still keeps the loop
# alive, while the ledger records genuine Agda results instead of command
# lookup failures.
run_checked() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 900 "$@"
    elif command -v gtimeout >/dev/null 2>&1; then
        gtimeout 900 "$@"
    else
        "$@"
    fi
}

# ---------------------------------------------------------------------
# GATE MUTEX — one cycle writes `_build` at a time.
#
# The gate typechecks into the SHARED `formal/cubical/_build/`.  Two
# cycles running at once (a foreground run next to a --supervise loop, or
# two supervisors in the same shared checkout — all three were live on
# 2026-08-16) build the same module into the same `.agdai` concurrently.
# Agda 2.6.3 takes no cross-process lock on that file, so an interleaved
# write is read back as a corrupt interface: a FALSE fiber on a module
# that checks fine single-writer.  That is the false-red this whole file
# is built to prevent, arriving through the filesystem instead of through
# a misread exit code.  So the gate is serialized: a second cycle that
# finds the lock held skips cleanly rather than racing.  Skipping is the
# correct behavior, not a failure — the header's whole design is that a
# cycle is idempotent and cheap to re-enter, so a skipped one costs
# nothing and the holder's row is the true one.
GATE_LOCK="$CUBICAL/_build/.gate.lock"
acquire_gate() {
    mkdir -p "$CUBICAL/_build" 2>/dev/null
    if mkdir "$GATE_LOCK" 2>/dev/null; then
        echo "$$" > "$GATE_LOCK/pid"
        return 0
    fi
    # Reap a lock whose owner is gone (a cycle killed mid-gate, e.g. the
    # container reaped it — the same death mode this file already treats
    # as expected).  A dead owner's lock must not wedge every future
    # cycle.
    local owner
    owner=$(cat "$GATE_LOCK/pid" 2>/dev/null)
    if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
        rm -rf "$GATE_LOCK" 2>/dev/null
        if mkdir "$GATE_LOCK" 2>/dev/null; then
            echo "$$" > "$GATE_LOCK/pid"
            return 0
        fi
    fi
    return 1
}
release_gate() { [ "$(cat "$GATE_LOCK/pid" 2>/dev/null)" = "$$" ] && rm -rf "$GATE_LOCK" 2>/dev/null; return 0; }

mkdir -p collab/orchestration
[ -f "$LEDGER" ] || printf 'utc\tcycle\ttoolchain\tmodules\tgreen\tfiber\tfiber_env\taggregate\twalk_frontier\n' > "$LEDGER"

cycle_number() { [ -f "$LEDGER" ] && echo $(( $(wc -l < "$LEDGER") - 1 )) || echo 0; }

# ---------------------------------------------------------------------
# 1. SYNC
# ---------------------------------------------------------------------
phase_sync() { [ -x ./sync ] && ./sync >/dev/null 2>&1; return 0; }

# ---------------------------------------------------------------------
# 2. GATE — per module, exit code recorded, never inferred from output
# ---------------------------------------------------------------------
phase_gate() {
    GREEN=0; FIBER=0; FIBER_ENV=0; FIBER_LIST=""; ENV_LIST=""

    # The toolchain is part of the observation, so it is captured first
    # and written into the row.  Without it, a container event (agda
    # absent, cycle 4) is indistinguishable from a mathematical state
    # (corpus dead), which is exactly the confusion the 2026-08-14T17:19Z
    # row caused.
    TOOLCHAIN=$(agda --version 2>/dev/null | head -1 | awk '{print "agda-" $3}')
    if [ -z "$TOOLCHAIN" ]; then
        TOOLCHAIN="absent"
        AGG="-"
        return 0     # 0 checks performed, not N failed ones.
    fi

    while IFS= read -r f; do
        rel="${f#"$CUBICAL"/}"
        ( cd "$CUBICAL" && LC_ALL=C.UTF-8 run_checked agda -i . "$rel" ) >/dev/null 2>&1
        RC=$?
        if [ "$RC" -eq 0 ]; then
            GREEN=$((GREEN+1))
        elif [ "$RC" -ge 124 ]; then
            # 124 watchdog timeout, 125/126/127 could-not-run, 128+n
            # signal death: the environment's exit, not Agda's verdict.
            FIBER_ENV=$((FIBER_ENV+1))
            ENV_LIST="${ENV_LIST}${rel} (exit ${RC})"$'\n'
        else
            FIBER=$((FIBER+1))
            FIBER_LIST="${FIBER_LIST}${rel}"$'\n'
        fi
    done < <(find "$CUBICAL" -name '*.agda' -not -path '*/_build/*' -not -path '*/Control/*' | sort)

    # `Control/` is excluded BECAUSE its contents must fail to typecheck
    # (NaturalMachine.agda's own header says so).  Counting deliberate
    # refutations as fibers would be a false red, which is the same
    # failure as a false green with the sign flipped.

    ( cd "$CUBICAL" && LC_ALL=C.UTF-8 run_checked agda -i . NaturalMachine.agda ) >/dev/null 2>&1
    AGG=$?
}

# ---------------------------------------------------------------------
# 3. LEDGER — append-only; and the open fibers written where they are read
# ---------------------------------------------------------------------
phase_ledger() {
    # A due-by stamp makes death self-reporting: no process is needed in
    # order to detect that no process is running.
    DUE_BY=$(date -u -d "+$(( INTERVAL + 300 )) seconds" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
             || echo "unknown")
    N=$(cycle_number)
    TOTAL=$((GREEN + FIBER + FIBER_ENV))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(STAMP)" "$N" "$TOOLCHAIN" "$TOTAL" "$GREEN" "$FIBER" "$FIBER_ENV" \
        "$AGG" "$WALK" >> "$LEDGER"

    {
        echo "# Open fibers — regenerated every cycle, do not hand-edit"
        echo
        echo "Cycle $N, $(STAMP). Toolchain: \`$TOOLCHAIN\` (pin: Agda 2.8.0 +"
        echo "cubical v0.9, \`formal/cubical/BUILD.md\`). Aggregate"
        echo "\`NaturalMachine.agda\` exit: **$AGG**."
        echo "Modules invoked individually: $TOTAL. Green: $GREEN."
        echo "Mathematical fibers: $FIBER. Environment events: $FIBER_ENV."
        echo
        echo "**Last cycle $(STAMP); the next one was expected by $DUE_BY.**"
        echo "If you are reading this later than that, what you know is exactly"
        echo "this: **no cycle has been recorded since then.** That is an"
        echo "absence of cycles. It is not a statement about the corpus, and it"
        echo "is not a statement about anyone. Running one is cheap and"
        echo "idempotent if you want the number refreshed:"
        echo '`./run_the_natural_machine_forever`.'
        echo
        echo "The stamp exists because a loop that has stopped and a loop that"
        echo "is quiet are indistinguishable from the repository unless the loop"
        echo "says when it expected to be back (msg 0463)."
        echo
        if [ "$TOOLCHAIN" = "absent" ]; then
            echo "**No agda on PATH: this cycle checked nothing.** The row it"
            echo "wrote is a statement about this container, not about the"
            echo "mathematics — zero modules were invoked, so the corpus's last"
            echo "known state is the previous row written by a container that"
            echo "had a toolchain."
        elif [ "$TOOLCHAIN" != "agda-2.8.0" ]; then
            echo "**Toolchain differs from the pin.** Fibers listed below may be"
            echo "version skew (BUILD.md \"Where the skew bites\"), which is"
            echo "evidence about the container, not the tree. Align the"
            echo "container with the pin before treating any fiber below as a"
            echo "reconstruction question; do not edit modules to appease the"
            echo "wrong toolchain."
            echo
        fi
        if [ "$TOOLCHAIN" != "absent" ]; then
            if [ "$FIBER" -eq 0 ]; then
                echo "No open fibers. Every module under \`formal/cubical/\` that"
                echo "this toolchain can judge returns exit 0 on its own, not"
                echo "merely as part of an aggregate."
            else
                echo "Delta 15 C15.82: each of these is a reconstruction question,"
                echo "not an error. The module named is the one whose fiber is"
                echo "noncontractible or empty; that fiber is the assignment."
                echo
                printf '%s' "$FIBER_LIST" | sed '/^$/d' | sed 's/^/- `/;s/$/`/'
            fi
            if [ "$FIBER_ENV" -gt 0 ]; then
                echo
                echo "Environment events (NOT fibers — the container failed, the"
                echo "module was never judged; exit 124 = watchdog timeout,"
                echo "125-127 = could not run, 128+n = killed by signal n):"
                echo
                printf '%s' "$ENV_LIST" | sed '/^$/d' | sed 's/^/- `/;s/$/`/'
            fi
        fi
    } > "$FIBERS"
}

# ---------------------------------------------------------------------
#    the walk's own frontier, read from what is CHECKED, not recomputed
# ---------------------------------------------------------------------
phase_walk() {
    WALK=$(grep -ho 'next [0-9]* ≡ [0-9]*' \
            "$CUBICAL"/NaturalMachine/WalkBridge.agda 2>/dev/null \
           | tail -1 | tr -d ' ' )
    [ -n "$WALK" ] || WALK="-"
}

# ---------------------------------------------------------------------
# 4. DRAW — a fresh uncurated door, so the next arrival does not enter
#    through the conspicuous documents
# ---------------------------------------------------------------------
phase_draw() {
    S=random_entry_seeder_so_agents_dont_cluster
    [ -x "$S/seed.sh" ] || return 0
    mkdir -p collab/orchestration/draws
    "$S/seed.sh" "machine-cycle-$(cycle_number)" \
        > "collab/orchestration/draws/next-door.txt" 2>/dev/null
    return 0
}

run_cycle() {
    phase_sync
    phase_walk
    if ! acquire_gate; then
        echo "MACHINE cycle skipped: another cycle holds the gate ($(cat "$GATE_LOCK/pid" 2>/dev/null)) — not racing the shared _build; the holder writes this cycle's true row — $(STAMP)"
        return 0
    fi
    trap 'release_gate' EXIT
    phase_gate
    phase_ledger
    release_gate
    trap - EXIT
    phase_draw
    phase_sync
    echo "MACHINE cycle $(( $(cycle_number) - 1 )) [${TOOLCHAIN}]: ${GREEN} green, ${FIBER} fibers, ${FIBER_ENV} env events, aggregate ${AGG}, walk ${WALK} — $(STAMP)"
}

case "$MODE" in
    --supervise)
        # For environments where processes DO persist.  A cycle that
        # returns nonzero never stops the loop — T15.81 again: there is no
        # failure branch, only a fiber.  Note this does not save you from
        # the supervisor itself being reaped, which is exactly what
        # happened in this container; the due-by stamp covers that case.
        echo "MACHINE: supervised loop started, every ${INTERVAL}s (pid $$)"
        while :; do
            ( run_cycle ) || echo "MACHINE: cycle nonzero; continuing"
            sleep "$INTERVAL"
        done
        ;;
    --daemon)
        echo "MACHINE: hands-free loop started, every ${INTERVAL}s (pid $$)"
        while :; do run_cycle; sleep "$INTERVAL"; done
        ;;
    *)
        run_cycle
        ;;
esac
