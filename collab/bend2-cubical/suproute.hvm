// Prelude
// -------
data List { #Nil #Cons{head tail} }
data Nat { #Z #S{n} }
data Pair { #P{fst snd} }
@fix(&f) = (f @fix(f))
@main = @main$

// Bend to HVM Compiler Output
// ---------------------------

@main$ = (@supRoute$() @SUP(0 1 1))
@neg$ = λ&x (~x {0:1 _:0})
@negI$ = λ&x (~x {0:λ&i 0 _:λ&i 1})
@notPath$ = *
@supRoute$ = λ&p @DUP(0 p λ&t0 λ&t1 @SUP(0 (~t0 {0:1 _:0}) t1))

