// Same real codas; only the rhythm (shape) is read. Equal shapes are ONE node.
@sum   = λ{[]: 0; <>: λh. λt. (h + @sum(t))}
@scale = λ&T. λ{[]: []; <>: λh. λt. (((h * 1000) + (T / 2)) / T) <> @scale(T, t)}
@shape = λ&c. @scale(@sum(c), c)
@codas = &L{&L{&L{&L{[357, 350, 347, 363], [284, 296, 302, 304]}, &L{[271, 276, 278, 294], [242, 231, 171, 145]}}, &L{&L{[378, 364, 159, 156], [435, 410, 184, 184]}, &L{[358, 323, 336], &L{[365, 314, 307], [269, 259, 287]}}}}, &L{&L{&L{[89, 92, 77, 71], [81, 77, 74, 80]}, &L{[102, 95, 75, 66], [102, 68]}}, &L{&L{[87, 103], [46, 72]}, &L{[263, 154, 106], &L{[247, 163, 100], [251, 151, 109]}}}}}
@main = @shape(@codas)
