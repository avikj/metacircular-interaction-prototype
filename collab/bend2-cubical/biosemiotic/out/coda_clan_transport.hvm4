// EC2 5R3 → EC1 5R1 by transport along the fibre; EC1 median 5R1 tempo 329 ms, median intervals [94, 92, 74, 68]; ε = 6 ms
@sum   = λ{[]: 0; <>: λh. λt. (h + @sum(t))}
@scale = λ&T. λ&R. λ{[]: []; <>: λh. λt. (((h * R) + (T / 2)) / T) <> @scale(T, R, t)}
@lens  = λR. λ&c. @scale(@sum(c), R, c)
@mulT  = λ&T. λ{[]: []; <>: λh. λt. (((h * T) + 500) / 1000) <> @mulT(T, t)}
@toEC1 = λc. @mulT(329, @lens(1000, c))
@ad    = λ&a. λ&b. λ{0: (b - a); _: λp. (a - b)}(a > b)
@near  = λ{[]: λq. 1; <>: λh. λt. λ{[]: 0; <>: λk. λu. (@near(t, u) .&. (@ad(h, k) < 7))}}
@keep  = λ&c. λ{0: &{}; _: λp. #Translated{c, @toEC1(c)}}(@near(@toEC1(c), [94, 92, 74, 68]))
@src   = &L{[318, 307, 303, 322], &L{[311, 299, 301, 312], &L{[281, 288, 295, 295], &L{[269, 277, 275, 277], &L{[258, 251, 249, 278], &L{[253, 243, 249, 265], &L{[261, 255, 257, 250], &L{[249, 234, 239, 257], &L{[257, 241, 238, 249], &L{[245, 255, 241, 267], &L{[241, 252, 251, 266], &L{[315, 334, 320, 357], &L{[327, 321, 330, 339], &L{[339, 334, 337, 329], &L{[342, 332, 332, 338], &L{[328, 326, 340, 334], &L{[345, 337, 325, 338], &L{[336, 322, 332, 337], &L{[332, 335, 335, 339], &L{[338, 328, 338, 338], &L{[332, 327, 342, 337], &L{[280, 282, 282, 282], &L{[274, 261, 265, 254], [293, 274, 292, 294]}}}}}}}}}}}}}}}}}}}}}}}
@main  = @keep(@src)
