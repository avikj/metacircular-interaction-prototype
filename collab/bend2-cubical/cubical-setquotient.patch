+-- Peel the relation R out of a fe-method type ∀a:A. ∀b:A. R a b -> P.
+-- Returns R (a two-argument function A -> A -> Set) when the type has that
+-- shape and R a b is a spine App (App R a) b.
+peelQuotRel :: Int -> Book -> Term -> Maybe Term
+peelQuotRel d book t = case force book t of
+  All _ g1 -> case force book (appLam g1 (Var "a" d)) of
+    All _ g2 -> case force book (appLam g2 (Var "b" (d+1))) of
+      All rab _ -> case force book rab of
+        App (App rHead _) _ -> Just rHead
+        _                   -> Nothing
+      _ -> Nothing
+    _ -> Nothing
+  _ -> Nothing
+  where appLam (Lam _ f) x = f x
+        appLam f         x = App f x
+
 refHeaded :: Term -> Bool
 refHeaded t = case cut t of
   App f _ -> refHeaded f
