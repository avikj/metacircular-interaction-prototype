+parseQuotKw :: Parser Term
+parseQuotKw = label "Quotient type" $ do
+  _ <- try $ keyword "Quotient" <* symbol "("
+  a <- parseTerm
+  _ <- symbol ","
+  r <- parseTerm
+  _ <- symbol ")"
+  return (Quot a r)
+
+-- | Syntax: qin(a) — the point constructor [ a ]
+parseQIn :: Parser Term
+parseQIn = label "qin" $ do
+  _ <- try $ keyword "qin" <* symbol "("
+  a <- parseTerm
+  _ <- symbol ")"
+  return (QIn a)
+
+-- | Syntax: qeq(a, b, r) — the path constructor eq/ a b r
+parseQEq :: Parser Term
+parseQEq = label "qeq" $ do
+  _ <- try $ keyword "qeq" <* symbol "("
+  a <- parseTerm
+  _ <- symbol ","
+  b <- parseTerm
+  _ <- symbol ","
+  r <- parseTerm
+  _ <- symbol ")"
+  return (QEq a b r)
+
+-- | Syntax: qsquash(x, y, p, q) — the set-truncation 2-cell
+parseQSq :: Parser Term
+parseQSq = label "qsquash" $ do
+  _ <- try $ keyword "qsquash" <* symbol "("
+  x <- parseTerm
+  _ <- symbol ","
