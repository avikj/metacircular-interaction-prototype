+-- SetQuotient recursor into a set B:
+--   rec [a]          = fp a
+--   rec (eq/ a b r)  = fe a b r          (a path in B, via cong)
+--   rec (hcomp ...)  = hcomp over B of rec (commute) — left stuck (fhcom)
+-- where fp : A -> B and fe : ∀a b. R a b -> Path B (fp a) (fp b).
+whnfQuotM :: EvalLevel -> Book -> Term -> Term -> Term -> Term
+whnfQuotM lv book x fp fe =
+  case whnf lv book x of
+    QIn a               -> whnf lv book (App fp a)
+    -- eq/ a b r applied at interval i: cong the recursor through the path
+    PAp (QEq a b r) i   -> whnf lv book (PAp (App (App (App fe a) b) r) i)
+    QEq a b r           -> whnf lv book (App (App (App fe a) b) r)
+    x'                  -> QuotM x' fp fe
+
