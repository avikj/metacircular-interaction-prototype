+  _ <- symbol ","
+  p <- parseTerm
+  _ <- symbol ","
+  q <- parseTerm
+  _ <- symbol ")"
+  return (QSq x y p q)
+
+-- | Syntax: qelim(x, fp, fe) — the set-quotient recursor into a set
+parseQuotM :: Parser Term
+parseQuotM = label "qelim" $ do
+  _ <- try $ keyword "qelim" <* symbol "("
+  x <- parseTerm
+  _ <- symbol ","
+  fp <- parseTerm
+  _ <- symbol ","
+  fe <- parseTerm
+  _ <- symbol ")"
+  return (QuotM x fp fe)
+
