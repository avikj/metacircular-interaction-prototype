@findClass$ = λ&reps λ&s λ&d λ&idx (~reps {#Nil:idx #Cons:λ&r λ&rest (~((@shapeEq$() r) s) {0:((((@findClass$() rest) s) d) #S{idx}) _:idx})})
@futureEqD$ = λ&a λ&b λ&d (((@bisimD$() a) b) d)
@kidsEq$ = λ&a λ&b (~a {#Nil:(~b {#Nil:1 #Cons:λ&y λ&ys 0}) #Cons:λ&x λ&xs (~b {#Nil:0 #Cons:λ&y λ&ys ((@and2$() ((@shapeEq$() x) y)) ((@kidsEq$() xs) ys))})})
@main$ = ((@numClasses$() @corpusShapes$()) #Z{})
@max$ = λ&a λ&b (~a {#Z:b #S:λ&p (~b {#Z:#S{p} #S:λ&q #S{((@max$() p) q)}})})
@nthOr$ = λ&xs λ&n λ&fb (~xs {#Nil:fb #Cons:λ&x λ&rest (~n {#Z:x #S:λ&p (((@nthOr$() rest) p) fb)})})
@numClasses$ = λ&shapes λ&d ((@List__length$() @Shape$()) (((@buildReps$() shapes) []) d))
@obs$ = λ&s ! _x3 = s
(~_x3 {#N$:λ&code λ&kids code &_x3:1})
@run$ = λ&s λ&w (~w {#Nil:s #Cons:λ&a λ&rest ((@run$() ((@childAt$() s) a)) rest)})
@shapeEq$ = λ&a λ&b ! _x4 = a
(~_x4 {#N$:λ&ca λ&ka ! _x10 = b
(~_x10 {#N$:λ&cb λ&kb (~((@Nat__eql$() ca) cb) {0:0 _:((@kidsEq$() ka) kb)}) &_x10:1}) &_x4:1})

