// Prelude
// -------
data List { #Nil #Cons{head tail} }
data Nat { #Z #S{n} }
data Pair { #P{fst snd} }
@fix(&f) = (f @fix(f))
// cubical: a universe path is a Church pair (fwd, bwd); coe projects a direction
@cub_idfn = λ&x x
@cub_idPath = λ&k ((k @cub_idfn) @cub_idfn)
@cub_pathFwd = λ&p λ&x ((p λ&f λ&g f) x)
@cub_pathBwd = λ&p λ&x ((p λ&f λ&g g) x)
@main = @main$

// Bend to HVM Compiler Output
// ---------------------------

data Shape$ { #N${code kids} }
@Shape$ = *

@List__append$ = λ&A λ&xs λ&y (~xs {#Nil:[y] #Cons:λ&x λ&rest #Cons{x (((@List__append$() A) rest) y)}})
@List__length$ = λ&A λ&xs (~xs {#Nil:#Z{} #Cons:λ&x λ&xs #S{((@List__length$() A) xs)}})
@Nat__eql$ = λ&a λ&b (~a {#Z:(~b {#Z:1 #S:λ&q 0}) #S:λ&p (~b {#Z:0 #S:λ&q ((@Nat__eql$() p) q)})})
@actionsEq$ = λ&a λ&b λ&m λ&d (~m {#Z:1 #S:λ&k (λ&here ((@and2$() here) ((((@actionsEq$() a) b) k) d)) (((@bisimD$() ((@childAt$() a) k)) ((@childAt$() b) k)) d))})
@and2$ = λ&a λ&b (~a {0:0 _:b})
@and3$ = λ&a λ&b λ&c ((@and2$() a) ((@and2$() b) c))
@arity$ = λ&s ! _x3 = s
(~_x3 {#N$:λ&code λ&kids ((@List__length$() @Shape$()) kids) &_x3:1})
@behavior$ = λ&s λ&w (@obs$() ((@run$() s) w))
@bisimD$ = λ&a λ&b λ&d (~d {#Z:((@Nat__eql$() (@obs$() a)) (@obs$() b)) #S:λ&d2 (~((@Nat__eql$() (@obs$() a)) (@obs$() b)) {0:0 _:(λ&m (λ&selfTail ((@and2$() selfTail) ((((@actionsEq$() a) b) m) d2)) (((@bisimD$() a) b) d2)) ((@max$() (@arity$() a)) (@arity$() b)))})})
@buildReps$ = λ&shapes λ&reps λ&d (~shapes {#Nil:reps #Cons:λ&s λ&rest (λ&c (~((@Nat__eql$() c) ((@List__length$() @Shape$()) reps)) {0:(((@buildReps$() rest) reps) d) _:(((@buildReps$() rest) (((@List__append$() @Shape$()) reps) s)) d)}) ((((@findClass$() reps) s) d) #Z{}))})
@childAt$ = λ&s λ&n ! _x4 = s
(~_x4 {#N$:λ&code λ&kids (((@nthOr$() kids) n) s) &_x4:1})
@classIds$ = λ&shapes λ&reps λ&d (~shapes {#Nil:[] #Cons:λ&s λ&rest #Cons{((((@findClass$() reps) s) d) #Z{}) (((@classIds$() rest) reps) d)}})
@corpusShapes$ = [#N${#S{#S{#S{#S{#S{#S{#Z{}}}}}}} []} #N${#S{#S{#S{#S{#S{#S{#Z{}}}}}}} []} #N${#S{#S{#S{#S{#S{#S{#Z{}}}}}}} []} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#Z{} []}]} #N${#S{#S{#Z{}}} []}]}]} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#S{#S{#S{#S{#Z{}}}}}}} []} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#Z{}}} []} #N${#Z{} []}]} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#Z{} []}]} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#Z{} []} #N${#S{#S{#Z{}}} []} #N${#Z{} []}]}]} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#Z{} []}]}]}]}]} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]}]} #N${#S{#S{#S{#S{#S{#Z{}}}}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []}]} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} []} #N${#S{#S{#Z{}}} [#N${#S{#S{#Z{}}} []} #N${#