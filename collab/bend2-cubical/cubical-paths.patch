   show (Era)           = "*"
   show (Sup l a b)     = "&" ++ show l ++ "{" ++ show a ++ "," ++ show b ++ "}"
   show (SupM x l f)    = "~ " ++ show x ++ " { &" ++ show l ++ "{,}:" ++ show f ++ " }"
diff --git a/src/Core/WHNF.hs b/src/Core/WHNF.hs
index 953410d..71ff3fe 100644
--- a/src/Core/WHNF.hs
