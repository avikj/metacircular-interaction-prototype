+       r <- parseTerm
+       _ <- symbol ")"
+       return (INot r)
+  , do _ <- try $ keyword "iand" <* symbol "("
+       r <- parseTerm
+       _ <- symbol ","
+       t <- parseTerm
+       _ <- symbol ")"
+       return (IAnd r t)
+  , do _ <- try $ keyword "ior" <* symbol "("
+       r <- parseTerm
+       _ <- symbol ","
+       t <- parseTerm
+       _ <- symbol ")"
+       return (IOr r t) ]
+
+-- | Syntax: p @ r   (path application)
+parsePAp :: Term -> Parser Term
+parsePAp t = do
+  _ <- try $ symbol "@" <* notFollowedBy (satisfy (\c -> c == '{'))
+  r <- parseTerm
+  return (PAp t r)
