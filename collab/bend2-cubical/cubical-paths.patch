diff --git a/corpus_calculus.bend b/corpus_calculus.bend
new file mode 100644
index 0000000..2888f4e
--- /dev/null
+++ b/corpus_calculus.bend
@@ -0,0 +1,42 @@
+# Translation of formal/cubical/theorems/residue/CorpusCalculus.agda
+# Point = Σ[ A ∈ Type ] A ; Question s = Σ[ B ∈ Type ] (fst s → B)
+# target, Event, step, twoSteps — refl theorems check by computation.
+
+def Point() -> Set:
+  any A: Set. A
+
+def point(A: Set, a: A) -> Point():
+  (A, a)
+
+def Src(s: Point()) -> Set:
+  match s:
+    case (A, a):
+      A
+
+def src(s: Point()) -> Src(s):
+  match s:
+    case (A, a):
+      a
+
+def Question(s: Point()) -> Set:
+  any B: Set. (Src(s) -> B)
+
+def target(s: Point(), q: Question(s)) -> Point():
+  match q:
+    case (B, f):
+      (B, f(src(s)))
+
+# Event s q s' = target s q ≡ s'   (as a Path)
+def Event(s: Point(), q: Question(s), s2: Point()) -> Set:
+  Path(Point(), target(s, q), s2)
+
+# step : fst (target (point a) (B , f)) ≡ B with value f a  — by refl
+def step(A: Set, B: Set, a: A, f: A -> B) -> Path(Point(), target(point(A, a), (B, f)), point(B, f(a))):
+  <i> target(point(A, a), (B, f))
+
+# twoSteps : target (target (point a) (B,f)) (C,g) ≡ point (g (f a)) — by refl
+def twoSteps(A: Set, B: Set, C: Set, a: A, f: A -> B, g: B -> C) -> Path(Point(), target(target(point(A, a), (B, f)), (C, g)), point(C, g(f(a)))):
+  <i> point(C, g(f(a)))
+
+def main() -> Nat:
+  0n
diff --git a/corpus_lossless.bend b/corpus_lossless.bend
new file mode 100644
index 0000000..8a8d71c
--- /dev/null
+++ b/corpus_lossless.bend
@@ -0,0 +1,44 @@
+# The repo's lossless presentation lemma, in Bend2's fragment.
+#
+# Agda (cubical):  lossless : A ≃ Σ B (fiber f),  a ↦ (f a , a , refl)
+# Bend2 has no paths/univalence, but the section-retraction half and the
+# visible-projection law are expressible with Eql + Sigma.
+
+# Presentation of A through f: an observation b, a source a, a witness f a == b.
+def Pres(A: Set, B: Set, f: A -> B) -> Set:
+  any b: B. any a: A. B{f(a) == b}
+
+# encode: the codec, a ↦ (f a, a, {==})
+def encode(A: Set, B: Set, f: A -> B, a: A) -> Pres(A, B, f):
+  (f(a), a, {==})
+
+# decode: drop the determined fields
+def decode(A: Set, B: Set, f: A -> B, p: Pres(A, B, f)) -> A:
+  match p:
+    case (b, a, e):
+      a
+
+# retraction: decode(encode(a)) == a, definitionally
+def lossless_retract(A: Set, B: Set, f: A -> B, a: A) -> A{decode(A, B, f, encode(A, B, f, a)) == a}:
+  {==}
+
+# the observation is the visible projection, definitionally
+def obs(A: Set, B: Set, f: A -> B, p: Pres(A, B, f)) -> B:
+  match p:
+    case (b, a, e):
+      b
+
+# the observation is the visible projection, definitionally
+def visible_projection(A: Set, B: Set, f: A -> B, a: A) -> B{obs(A, B, f, encode(A, B, f, a)) == f(a)}:
+  {==}
+
+def main() -> Nat:
+  0n
+
+# section: encode(decode(p)) == p, by eliminating the witness (J).
+# In cubical Agda this is  λ i → p i , a , λ j → p (i ∧ j).
+def lossless_section(A: Set, B: Set, f: A -> B, p: Pres(A, B, f)) -> Pres(A, B, f){encode(A, B, f, decode(A, B, f, p)) == p}:
+  match p:
+    case (b, a, e):
+      rewrite e
+      finally
diff --git a/cubical_test.bend b/cubical_test.bend
new file mode 100644
index 0000000..98a5d20
--- /dev/null
+++ b/cubical_test.bend
@@ -0,0 +1,49 @@
+# Cubical primitives in Bend2: Path types, interval, connections.
+# Acceptance: funext (unprovable with Eql) and the corpus's lossless
+# rightInv, transliterated from cubical Agda term for term.
+
+# refl as a path
+def prefl(A: Set, a: A) -> Path(A, a, a):
+  <i> a
+
+# symmetry, via interval negation: (sym p) i = p (~ i)
+def psym(A: Set, a: A, b: A, p: Path(A, a, b)) -> Path(A, b, a):
+  <i> p @ inot(i)
+
+# congruence: cong f p = λ i. f (p i)
+def pcong(A: Set, B: Set, f: A -> B, a: A, b: A, p: Path(A, a, b)) -> Path(B, f(a), f(b)):
+  <i> f(p @ i)
+
+# function extensionality — the theorem Eql cannot prove
+def funext(A: Set, B: Set, f: A -> B, g: A -> B, h: all x:A. Path(B, f(x), g(x))) -> Path(A -> B, f, g):
+  <i> lambda x. h(x) @ i
+
+# connection square: λ i. p (i ∧ j) degenerates correctly
+def conn_left(A: Set, a: A, b: A, p: Path(A, a, b)) -> Path(A, a, b):
+  <i> p @ iand(i, i1)
+
+# ---- the corpus lemma, cubical version ----
+# Pres A B f = Σ b:B. Σ a:A. Path(B, f a, b)
+def PresP(A: Set, B: Set, f: A -> B) -> Set:
+  any b: B. any a: A. Path(B, f(a), b)
+
+def encodeP(A: Set, B: Set, f: A -> B, a: A) -> PresP(A, B, f):
+  (f(a), a, <i> f(a))
+
+def decodeP(A: Set, B: Set, f: A -> B, p: PresP(A, B, f)) -> A:
+  match p:
+    case (b, a, e):
+      a
+
+# Agda:  Iso.rightInv losslessIso (b , a , p) i = p i , a , λ j → p (i ∧ j)
+def rightInv(A: Set, B: Set, f: A -> B, p: PresP(A, B, f)) -> Path(PresP(A, B, f), encodeP(A, B, f, decodeP(A, B, f, p)), p):
+  match p:
+    case (b, a, e):
+      <i> (e @ i, a, <j> e @ iand(i, j))
+
+# Agda:  Iso.leftInv losslessIso a = refl
+def leftInv(A: Set, B: Set, f: A -> B, a: A) -> Path(A, decodeP(A, B, f, encodeP(A, B, f, a)), a):
+  <i> a
+
+def main() -> Nat:
+  0n
diff --git a/cubical_test2.bend b/cubical_test2.bend
new file mode 100644
index 0000000..91d9797
--- /dev/null
+++ b/cubical_test2.bend
@@ -0,0 +1,40 @@
+# Layer 2: PathP, coe (transport), J with definitional refl, ua.
+
+# transport along a line of types
+def transport(P: Interval -> Set, t: P(i0)) -> P(i1):
+  coe(P, i0, i1, t)
+
+# subst: transport along a path in the base of a family
+def subst(A: Set, C: A -> Set, a: A, b: A, p: Path(A, a, b), d: C(a)) -> C(b):
+  coe(lambda i. C(p @ i), i0, i1, d)
+
+# J, defined by coe along the connection square (no hcomp needed)
+def J(A: Set, a: A, C: all b:A. (Path(A, a, b) -> Set), d: C(a, <_> a), b: A, p: Path(A, a, b)) -> C(b, p):
+  coe(lambda i. C(p @ i, <j> p @ iand(i, j)), i0, i1, d)
+
+# J computes on refl definitionally (regularity)
+def J_refl(A: Set, a: A, C: all b:A. (Path(A, a, b) -> Set), d: C(a, <_> a)) -> Path(C(a, <_> a), J(A, a, C, d, a, <_> a), d):
+  <i> d
+
+# PathP: dependent path over a line of types
+def pathp_const(A: Set, a: A) -> PathP(lambda i. A, a, a):
+  <i> a
+
+# transport along ua computes to the function
+def ua_beta(A: Set, B: Set, f: A -> B, g: B -> A, gf: all x:A. Path(A, g(f(x)), x), fg: all y:B. Path(B, f(g(y)), y), x: A) -> Path(B, transport(lambda i. ua(A, B, f, g, gf, fg) @ i, x), f(x)):
+  <i> f(x)
+
+# transport backwards along ua computes to the inverse
+def ua_beta_inv(A: Set, B: Set, f: A -> B, g: B -> A, gf: all x:A. Path(A, g(f(x)), x), fg: all y:B. Path(B, f(g(y)), y), y: B) -> Path(A, coe(lambda i. ua(A, B, f, g, gf, fg) @ i, i1, i0, y), g(y)):
+  <i> g(y)
+
+# transport in a Pi type (function transport)
+def transport_pi(A: Set, B: Set, C: Set, p: Path(Set, A, B)) -> ((A -> C) -> (B -> C)):
+  lambda h. coe(lambda i. (p @ i) -> C, i0, i1, h)
+
+# transport in a Sigma
+def transport_sig(A: Set, C: Set, D: Set, p: Path(Set, C, D), t: any x:A. C) -> any x:A. D:
+  coe(lambda i. any x:A. (p @ i), i0, i1, t)
+
+def main() -> Nat:
+  0n
diff --git a/cubical_test3.bend b/cubical_test3.bend
new file mode 100644
index 0000000..7cd66c7
--- /dev/null
+++ b/cubical_test3.bend
@@ -0,0 +1,56 @@
+# Layer 3: derived path algebra, and the ISC coalgebra via Fix.
+
+def subst3(A: Set, C: A -> Set, a: A, b: A, p: Path(A, a, b), d: C(a)) -> C(b):
+  coe(lambda i. C(p @ i), i0, i1, d)
+
+# path composition, derived from transport (no hcomp needed)
+def pcomp(A: Set, a: A, b: A, c: A, p: Path(A, a, b), q: Path(A, b, c)) -> Path(A, a, c):
+  subst3(A, lambda x. Path(A, a, x), b, c, q, p)
+
+# groupoid laws come out by J; e.g. right unit
+def prunit(A: Set, a: A, b: A, p: Path(A, a, b)) -> Path(Path(A, a, b), pcomp(A, a, b, b, p, <_> b), p):
+  <i> p
+
+# ---- the interactive coalgebra (Fibre.Samvada ISC), one-field form ----
+# ISC Q O E w  =  (q : Q w) -> Σ w'. Σ o : O w q w'. E w q w' o × ISC w'
+# Coinduction via Fix: productivity is not checked (Bend2 has no totality),
+# exactly as Bend2 checks any recursive definition.
+
+def Point3() -> Set:
+  any A: Set. A
+
+def Src3(s: Point3()) -> Set:
+  match s:
+    case (A, a):
+      A
+
+def src3(s: Point3()) -> Src3(s):
+  match s:
+    case (A, a):
+      a
+
+def Question3(s: Point3()) -> Set:
+  any B: Set. (Src3(s) -> B)
+
+def target3(s: Point3(), q: Question3(s)) -> Point3():
+  match q:
+    case (B, f):
+      (B, f(src3(s)))
+
+# Corpus process: at every state, every question gets target + exact
+# residual receipt (a Path) + continuation. Nu-type via Fix.
+def Corpus3(s: Point3()) -> Set:
+  all q: Question3(s).
+  any s2: Point3().
+  any e: Path(Point3(), target3(s, q), s2).
+  Corpus3(s2)
+
+def run3(s: Point3()) -> Corpus3(s):
+  lambda q. (target3(s, q), <_> target3(s, q), run3(target3(s, q)))
+
+# finite observation: two demanded steps compute by refl
+def obs2(A: Set, B: Set, C: Set, a: A, f: A -> B, g: B -> C) -> Path(Point3(), target3(target3((A, a), (B, f)), (C, g)), (C, g(f(a)))):
+  <i> (C, g(f(a)))
+
+def main() -> Nat:
+  0n
diff --git a/cubical_test4.bend b/cubical_test4.bend
new file mode 100644
index 0000000..4690383
--- /dev/null
+++ b/cubical_test4.bend
@@ -0,0 +1,36 @@
+# Layer 4: hcomp (definitional composition), full iso-univalence, Sup x Path.
+
+def neg4(x: Bool) -> Bool:
+  if x:
+    False
+  else:
+    True
+
+def neg_inv(x: Bool) -> Path(Bool, neg4(neg4(x)), x):
+  if x:
+    <i> True
+  else:
+    <i> False
+
+# full iso-univalence: Bool = Bool by negation, with both coherences
+def notPath() -> Path(Set, Bool, Bool):
+  ua(Bool, Bool, lambda x. neg4(x), lambda x. neg4(x), lambda x. neg_inv(x), lambda x. neg_inv(x))
+
+# transport along it computes: True goes to False, definitionally
+def notPath_beta() -> Path(Bool, coe(lambda i. notPath() @ i, i0, i1, True), False):
+  <i> False
+
+# hcomp: definitional path composition
+def pcompH(A: Set, a: A, b: A, c: A, p: Path(A, a, b), q: Path(A, b, c)) -> Path(A, a, c):
+  <i> hcomp(A, i, <j> a, <j> q @ j, p @ i)
+
+# Sup x Path: transport along a superposed line routes by label:
+# the first universe transports along notPath (negation), the second is constant.
+def supLine() -> Interval -> Set:
+  lambda i. &0{notPath() @ i, Bool}
+
+def sup_transport() -> Path(&0{Bool, Bool}, coe(lambda i. supLine()(i), i0, i1, &0{True, True}), &0{False, True}):
+  <i> &0{False, True}
+
+def main() -> Nat:
+  0n
diff --git a/cubical_test5.bend b/cubical_test5.bend
new file mode 100644
index 0000000..c87fae5
--- /dev/null
+++ b/cubical_test5.bend
@@ -0,0 +1,35 @@
+# Univalence, finished: both computation rules for ua.
+#   uaβ  : transport along ua e computes to e (definitional; test2/test4)
+#   uaIdEquiv : ua of the identity iso IS refl (conversion)
+#   uaη  : ua(pathToIso p) = p for every p (theorem, by J)
+
+# Iso as a Σ-family
+def Iso5(A: Set, B: Set) -> Set:
+  any f: A -> B.
+  any g: B -> A.
+  any gf: (all x:A. Path(A, g(f(x)), x)).
+  (all y:B. Path(B, f(g(y)), y))
+
+def idIso5(A: Set) -> Iso5(A, A):
+  (lambda x. x, lambda x. x, lambda x. <_> x, lambda y. <_> y)
+
+def ua5(A: Set, B: Set, e: Iso5(A, B)) -> Path(Set, A, B):
+  match e:
+    case (f, g, gf, fg):
+      ua(A, B, f, g, gf, fg)
+
+# a path in Set yields an iso, by transport of the identity iso
+def pathToIso(A: Set, B: Set, p: Path(Set, A, B)) -> Iso5(A, B):
+  coe(lambda i. Iso5(A, p @ i), i0, i1, idIso5(A))
+
+# ua of the identity iso is refl — the missing Glue law, now conversion
+def uaIdEquiv(A: Set) -> Path(Path(Set, A, A), ua5(A, A, idIso5(A)), <_> A):
+  <i> <_> A
+
+# the eta round trip: ua(pathToIso(p)) = p, by path induction (J inlined
+# as coe along the connection square)
+def uaEta(A: Set, B: Set, p: Path(Set, A, B)) -> Path(Path(Set, A, B), ua5(A, B, pathToIso(A, B, p)), p):
+  coe(lambda i. Path(Path(Set, A, p @ i), ua5(A, p @ i, pathToIso(A, p @ i, <j> p @ iand(i, j))), <j> p @ iand(i, j)), i0, i1, <i> <_> A)
+
+def main() -> Nat:
+  0n
diff --git a/equiv.bend b/equiv.bend
new file mode 100644
index 0000000..8c01b74
--- /dev/null
+++ b/equiv.bend
@@ -0,0 +1,31 @@
+# Coherent equivalence (contractible-fibre isEquiv) — the formulation the
+# review named as required for BOTH univalence round trips.
+
+def isContr(A: Set) -> Set:
+  any c: A. (all x: A. Path(A, c, x))
+
+def fiber(A: Set, B: Set, f: A -> B, y: B) -> Set:
+  any x: A. Path(B, f(x), y)
+
+def isEquiv(A: Set, B: Set, f: A -> B) -> Set:
+  all y: B. isContr(fiber(A, B, f, y))
+
+def Equiv(A: Set, B: Set) -> Set:
+  any f: A -> B. isEquiv(A, B, f)
+
+# Contractibility of the singleton  Σ x. Path(A, x, a)  — the key lemma:
+# centre (a, refl); every (x,p) connects to it by the connection square.
+def isContrSingl(A: Set, a: A) -> isContr(fiber(A, A, lambda x. x, a)):
+  ( (a, <_> a)
+  , lambda w.
+      match w:
+        case (x, p):
+          <i> ( p @ inot(i) , <j> p @ ior(inot(i), j) )
+  )
+
+# hence the identity map is an equivalence
+def idEquiv(A: Set) -> Equiv(A, A):
+  ( lambda x. x , lambda y. isContrSingl(A, y) )
+
+def main() -> Nat:
+  0n
