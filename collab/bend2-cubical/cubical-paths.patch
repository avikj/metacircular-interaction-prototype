+                bAt i = case whnf Full book (App pP i) of { Sup _ _ b -> b ; x -> x }
+                (t0, t1) = dup book labAt t
+            in Sup labAt (Coe (Lam "i" (\i -> aAt i)) r' s' t0)
+                         (Coe (Lam "i" (\i -> bAt i)) r' s' t1)
