 -- Normalizes a let binding
+whnfPAp :: EvalLevel -> Book -> Term -> Term -> Term
+whnfPAp lv book p r =
+  case whnf lv book p of
+    PLm _ f      -> whnf lv book (f r)
+    Ua a b f g gf fg -> case whnf lv book r of
+      I0 -> whnf lv book a
+      I1 -> whnf lv book b
+      r' -> PAp (Ua a b f g gf fg) r'
+    p'           -> PAp p' r
