# Lossless recovery-by-projection of bwv846 ON THE SUBSTRATE (#25: recovery is a projection).
# figs = figuration fibre (per measure), harm = harmonic projection. recon rebuilds every note.
def nth(i: Nat, xs: Nat[]) -> Nat:
  match i:
    case 0n: ~ xs { []: 0n ; <>: lambda h. lambda t. h ; }
    case 1n+j: ~ xs { []: 0n ; <>: lambda h. lambda t. nth(j, t) ; }
def app(a: Nat[], b: Nat[]) -> Nat[]:
  ~ a { []: b ; <>: lambda h. lambda t. h <> app(t, b) ; }
def reconM(fig: Nat[], harm: Nat[]) -> Nat[]:
  ~ fig { []: [] ; <>: lambda i. lambda t. nth(i, harm) <> reconM(t, harm) ; }
def recon(figs: (Nat[])[], harms: (Nat[])[]) -> Nat[]:
  ~ figs { []: [] ;
           <>: lambda f. lambda ft. (~ harms { []: [] ; <>: lambda h. lambda ht. app(reconM(f, h), recon(ft, ht)) ; }) ; }
