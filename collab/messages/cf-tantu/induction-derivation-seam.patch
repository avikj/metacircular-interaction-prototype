+-- What the kernel actually certified, kept so that later certificates can
+-- re-emit this one as a dependency lemma.
+data CertProof = CRefl | CInd Deriv
+
+type Certs = M.Map (Term,Term) (String, CertProof)
+
+-- variable printing for clause bodies.  The environment holds exactly the
+-- names the clause binds; key -1 is the eigenconstant # (the induction
+-- variable's bound name in the step clause), key -2 the cong hole.  A
+-- term mentioning anything else does not print, and the candidate is
+-- skipped — an unbound variable in an emitted proof would be Agda's
+-- scope error anyway, so the guard is just the same refusal, earlier.
+agdaTermV :: M.Map Int String -> Term -> Maybe String
+agdaTermV env (V i) = M.lookup i env
+agdaTermV env (F "#" []) = M.lookup (-1) env
+agdaTermV env (F "?" []) = M.lookup (-2) env
+agdaTermV _ (F "0" []) = Just "zero"
+agdaTermV env (F "s" [t]) = (\u -> "suc (" ++ u ++ ")") <$> agdaTermV env t
+agdaTermV env (F "+" [a,b]) = binV env "+" a b
+agdaTermV env (F "*" [a,b]) = binV env "·" a b
+agdaTermV _ _ = Nothing
+
+binV :: M.Map Int String -> String -> Term -> Term -> Maybe String
+binV env op a b = do
+  x <- agdaTermV env a
+  y <- agdaTermV env b
+  pure ("(" ++ x ++ " " ++ op ++ " " ++ y ++ ")")
+
+replaceAt :: Term -> [Int] -> Term -> Term
+replaceAt _ [] u = u
+replaceAt (F f ts) (i:p) u =
+  F f [ if j == i then replaceAt t p u else t | (j,t) <- zip [0..] ts ]
+replaceAt t _ _ = t
+
+varName :: Int -> Maybe String
+varName i | i >= 0 && i < 6 = Just [ "xyzuvw" !! i ]
+          | otherwise = Nothing
+
+lemVars :: (Term,Term) -> [Int]
+lemVars (l,r) = ordNub (vars l ++ vars r)
+
+-- The machine's defining equations of + and · with their preamble names.
+-- These are the only rules the emitter treats as primitive; max, -, gcd,
+-- le and invented concepts are outside the certificate fragment.
+machineArithDefs :: [(Rule, (String, [Int]))]
+machineArithDefs =
+  [ ((bin "+" x_ zero_,  x_),                          ("addZero", [0]))
+  , ((bin "+" x_ (su y_), su (bin "+" x_ y_)),         ("addSuc",  [0,1]))
+  , ((bin "*" x_ zero_,  zero_),                       ("mulZero", [0]))
+  , ((bin "*" x_ (su y_), bin "+" (bin "*" x_ y_) x_), ("mulSuc",  [0,1]))
+  ]
+
+-- every fired rule is one of three things, or the candidate is skipped
+data StepRef
+  = RDef String [Term]                       -- preamble lemma, instantiated
+  | RIH  Bool (M.Map Int Term)               -- recursive call; True = reversed
+  | RLem Bool String (Term,Term) (M.Map Int Term)  -- certified lemma; True = reversed
+
+classifyStep :: (Term,Term) -> Certs -> TraceStep -> Maybe StepRef
+classifyStep hyp certs st =
+  case lookup rl machineArithDefs of
+    Just (nm, is) -> Just (RDef nm [ M.findWithDefault (V i) i sub | i <- is ])
+    Nothing
+      | rl == hyp      -> Just (RIH False sub)
+      | rl == swap hyp -> Just (RIH True sub)
+      | otherwise ->
+          case M.lookup rl certs of
+            Just (nm,_) -> Just (RLem False nm rl sub)
+            Nothing -> case M.lookup (swap rl) certs of
+              Just (nm,_) -> Just (RLem True nm (swap rl) sub)
+              Nothing -> Nothing
+  where
+    rl = tsRule st
+    sub = tsSub st
+    swap (a,b) = (b,a)
+
+-- one trace step becomes one path piece: the named equality, instantiated,
+-- reversed if the rule fired right-to-left, and transported to its redex
+-- position by `cong` with the surrounding term as the context.
+stepPath :: M.Map Int String -> String -> [Int] -> Int -> (Term,Term) -> Certs
+         -> TraceStep -> Maybe String
+stepPath env self selfVars v hyp certs st = do
+  ref <- classifyStep hyp certs st
+  inner <- case ref of
+    RDef nm args -> do
+      as <- mapM (agdaTermV env) args
+      pure (unwords (nm : map paren as))
+    RIH rev sub -> do
+      as <- mapM (argFor sub) selfVars
+      pure (sym' rev (unwords (self : map paren as)))
+    RLem rev nm goal sub -> do
+      as <- mapM (\i -> agdaTermV env (M.findWithDefault (V i) i sub)) (lemVars goal)
+      pure (sym' rev (unwords (nm : map paren as)))
+  case tsPos st of
+    [] -> pure inner
+    p  -> do
+      ctx <- agdaTermV (M.insert (-2) "h" env) (replaceAt (tsBefore st) p (F "?" []))
+      pure ("cong (λ h → " ++ ctx ++ ") (" ++ inner ++ ")")
+  where
+    paren s = "(" ++ s ++ ")"
+    sym' True  s = "sym (" ++ s ++ ")"
+    sym' False s = s
+    argFor sub i
+      | i == v = M.lookup (-1) env
+      | otherwise = agdaTermV env (M.findWithDefault (V i) i sub)
+
+-- a clause's whole proof: the left trace forward, the right trace
+-- reversed, composed.  No steps at all means the two sides met without
+-- help — definitionally — and the path is refl.
+clausePath :: M.Map Int String -> String -> [Int] -> Int -> (Term,Term) -> Certs
+           -> [TraceStep] -> [TraceStep] -> Maybe String
+clausePath env self selfVars v hyp certs ltr rtr = do
+  ls <- mapM (stepPath env self selfVars v hyp certs) ltr
+  rs <- mapM (stepPath env self selfVars v hyp certs) rtr
+  pure $ case ls ++ map (\p -> "sym (" ++ p ++ ")") (reverse rs) of
+    [] -> "refl"
+    ps -> intercalate " ∙ " ps
+
+emitLemma :: Certs -> String -> (Term,Term) -> CertProof -> Maybe String
+emitLemma certs nm goal@(gl,gr) prf = do
+  let ivs = lemVars goal
+  vns <- mapM varName ivs
+  let envAll = M.fromList (zip ivs vns)
+      quant = if null vns then ""
+              else "(" ++ unwords vns ++ " : ℕ) → "
+  sigL <- agdaTermV envAll gl
+  sigR <- agdaTermV envAll gr
+  let sig = nm ++ " : " ++ quant ++ sigL ++ " ≡ " ++ sigR
+  case prf of
+    CRefl -> pure (unlines [ sig, unwords (nm : vns) ++ " = refl" ])
+    CInd d -> do
+      let v = dVar d
+      vn <- varName v
+      let baseEnv  = M.delete v envAll
+          basePats = [ if i == v then "zero" else n | (i,n) <- zip ivs vns ]
+          stepEnv  = M.insert (-1) vn (M.delete v envAll)
+          stepPats = [ if i == v then "(suc " ++ n ++ ")" else n
+                     | (i,n) <- zip ivs vns ]
+      basePf <- clausePath baseEnv nm ivs v (dHyp d) certs (dBaseL d) (dBaseR d)
+      stepPf <- clausePath stepEnv nm ivs v (dHyp d) certs (dStepL d) (dStepR d)
+      pure (unlines
+        [ sig
+        , unwords (nm : basePats) ++ " = " ++ basePf
+        , unwords (nm : stepPats) ++ " = " ++ stepPf
+        ])
+
+-- the certified lemmas a derivation's traces cite, transitively
+transDeps :: Certs -> (Term,Term) -> Deriv -> Maybe [(Term,Term)]
+transDeps certs = \hyp d -> direct hyp d >>= go []
+  where
+    direct hyp d = do
+      refs <- mapM (classifyStep hyp certs)
+                   (dBaseL d ++ dBaseR d ++ dStepL d ++ dStepR d)
+      pure (ordNub [ g | RLem _ _ g _ <- refs ])
+    go seen [] = Just seen
+    go seen (g:gs)
+      | g `elem` seen = go seen gs
+      | otherwise = case M.lookup g certs of
+          Nothing -> Nothing
+          Just (_, CRefl) -> go (g:seen) gs
+          Just (_, CInd d') -> do
+            ds <- direct (dHyp d') d'
+            go (g:seen) (ds ++ gs)
+
+lemIndex :: String -> Int
+lemIndex nm = case reads (drop 3 nm) of
+                [(n,"")] -> n
+                _        -> maxBound
+
+agdaHeader :: [String]
+agdaHeader =
+  [ "{-# OPTIONS --cubical --guardedness --safe --no-import-sorts #-}"
+  , "module Candidate where"
+  , "open import Cubical.Foundations.Prelude"
+  , "open import Cubical.Data.Nat using (ℕ ; zero ; suc ; _+_ ; _·_)"
+  ]
+
+-- the machine's defining equations of + and · — second-argument
+-- recursion — proved once over the library's first-argument definitions.
+-- addAssoc is the one auxiliary mulSuc's step needs.
+agdaPreamble :: [String]
+agdaPreamble =
+  [ "addZero : (a : ℕ) → (a + zero) ≡ a"
+  , "addZero zero = refl"
+  , "addZero (suc a) = cong suc (addZero a)"
+  , "addSuc : (a b : ℕ) → (a + suc (b)) ≡ suc (a + b)"
+  , "addSuc zero b = refl"
+  , "addSuc (suc a) b = cong suc (addSuc a b)"
+  , "addAssoc : (a b c : ℕ) → ((a + b) + c) ≡ (a + (b + c))"
+  , "addAssoc zero b c = refl"
+  , "addAssoc (suc a) b c = cong suc (addAssoc a b c)"
+  , "mulZero : (a : ℕ) → (a · zero) ≡ zero"
+  , "mulZero zero = refl"
+  , "mulZero (suc a) = mulZero a"
+  , "mulSuc : (a b : ℕ) → (a · suc (b)) ≡ ((a · b) + a)"
+  , "mulSuc zero b = refl"
+  , "mulSuc (suc a) b ="
+  , "  cong (λ h → suc (b + h)) (mulSuc a b)"
+  , "  ∙ cong suc (sym (addAssoc b (a · b) a))"
+  , "  ∙ sym (addSuc (b + (a · b)) a)"
+  ]
+
+inductionModule :: Certs -> (Term,Term) -> Deriv -> Either String String
+inductionModule certs goal d =
+  case build of
+    Just src -> Right src
+    Nothing  -> Left "derivation leaves the certified fragment"
+  where
+    build = do
+      deps <- transDeps certs (dHyp d) d
+      let ordered = sortOn (\(nm,_,_) -> lemIndex nm)
+            [ (nm, g, p) | g <- deps, Just (nm,p) <- [M.lookup g certs] ]
+      lems <- mapM (\(nm,g,p) -> emitLemma certs nm g p) ordered
+      body <- emitLemma certs "candidate" goal (CInd d)
+      pure (unlines (agdaHeader ++ agdaPreamble) ++ concat lems ++ body)
+
+-- write, check, clean up.  A missing agda binary is a KERNEL-ERROR and a
+-- refusal, never a crash and never an acceptance: a machine that cannot
