# Generic initial derivation object over an arbitrary Bend state type.
#
# This is the language-level form of AdiBija.  Unlike the old kernel port it is
# NOT tied to the toy Tm grammar: the atom is parameterized by the actual
# object's state type and its proof-relevant primitive motion family.
#
# A derivation is the free category generated by Step.  Every structural
# reading is therefore one fold; adding a receiver does not add a second
# traversal or a second notion of execution.

type Derivation(A: Set, Step: A -> A -> Set, src: A, dst: A):
  case @done:
    at: A
    witness: Path(A, src, dst)
  case @thenStep:
    mid: A
    step: Step(src, mid)
    rest: Derivation(A, Step, mid, dst)

type Receiver(A: Set, Step: A -> A -> Set):
  case @receiver:
    Motion: A -> A -> Set
    epsilon: all t: A. Motion(t, t)
    prepend: all a: A. all b: A. all c: A.
             Step(a, b) -> Motion(b, c) -> Motion(a, c)

def foldType(A: Set, Step: A -> A -> Set,
            R: Receiver(A, Step), src: A, dst: A,
            d: Derivation(A, Step, src, dst)) -> Set:
  match R:
    case @receiver{Motion, epsilon, prepend}:
      Motion(src, dst)

# The executable fold is specialized by a receiver's result carrier. Bend's
# dependent eliminator computes directly on the same Derivation object.
def foldValue(
    A: Set,
    Step: A -> A -> Set,
    Motion: A -> A -> Set,
    epsilon: all t: A. Motion(t,t),
    prepend: all a: A. all b: A. all c: A.
             Step(a,b) -> Motion(b,c) -> Motion(a,c),
    src: A, dst: A,
    d: Derivation(A,Step,src,dst)) -> Motion(src,dst):
  match d:
    case @done{at, witness}:
      # dst is propositionally at; transport epsilon(at) to the indexed target.
      coe(lambda i. Motion(src, witness @ i), i0, i1, epsilon(src))
    case @thenStep{mid, step, rest}:
      prepend(src, mid, dst, step,
              foldValue(A,Step,Motion,epsilon,prepend,mid,dst,rest))

# A path itself is the maximally intrinsic primitive motion: no certificate
# wrapper is needed because formation of the value is already the witness.
def PathStep(A: Set, a: A, b: A) -> Set:
  Path(A,a,b)

# Every path is therefore immediately a one-step derivation in the universal
# object. Higher cubical structure remains inside the Path value itself.
def pathDerivation(A: Set, a: A, b: A, p: Path(A,a,b)) ->
  Derivation(A,PathStep(A),a,b):
  @thenStep{b, p, @done{b, <_> b}}
