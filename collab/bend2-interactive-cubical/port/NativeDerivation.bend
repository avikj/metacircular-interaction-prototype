# Native derivation semantics: executable counterpart of Core.WHNF.NativeStep.
#
# The compiler owns the concrete Core.Term syntax. This Bend object gives its
# mathematical shape: a native motion has source and target in the SAME state
# type, and a run is the free derivation generated by those motions.
#
# No toy expression grammar appears here.
import UniversalDerivation
import UniversalElucidator
import UniversalPresentation

type NativeMotion(A: Set, x: A, y: A):
  case @nativePath:
    path: Path(A,x,y)

# Cubical identities are native motions directly.
def fromPath(A: Set, x: A, y: A, p: Path(A,x,y)) -> NativeMotion(A,x,y):
  @nativePath{p}

def nativePath(A: Set, x: A, y: A, m: NativeMotion(A,x,y)) -> Path(A,x,y):
  match m:
    case @nativePath{p}: p

def nativeDerivation(A: Set, x: A, y: A, m: NativeMotion(A,x,y)) ->
  Derivation(A,NativeMotion(A),x,y):
  @then{y,m,@done{{==}}}

# Meaning is literally the composed cubical identity carried by the derivation.
def meaning(A: Set, x: A, y: A,
            d: Derivation(A,NativeMotion(A),x,y)) -> Path(A,x,y):
  match d:
    case @done{ez}:
      match ez:
        case {==}: <_> x
    case @then{mid,step,rest}:
      compPath(A,x,mid,y,nativePath(A,x,mid,step),meaning(A,mid,y,rest))

# Cost is a receiver of the same derivation.
def cost(A: Set, x: A, y: A,
         d: Derivation(A,NativeMotion(A),x,y)) -> Nat:
  unitCost(A,NativeMotion(A),x,y,d)

# Observing an endpoint never destroys the source distinction.
def observeEndpoint(A: Set, B: Set, f: A -> B, x: A) -> FibreElement(A,B,f):
  presentMap(A,B,f,x)

def main() -> Nat:
  cost(Nat,2n,2n,nativeDerivation(Nat,2n,2n,fromPath(Nat,2n,2n,<_> 2n)))
