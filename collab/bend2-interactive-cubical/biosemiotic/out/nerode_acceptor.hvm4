@acc = λ&prev. λ{[]: 1; <>: λ&h. λt. λ{0: 0; _: λp. @acc(h, t)}(@ok((prev * 1000) + h))}
@run = λ{[]: 1; <>: λ&h. λt. @acc(h, t)}
@keep = λ&s. λ{0: &{}; _: λp. #Accepted{s}}(@run(s))
@seqs = &L{&L{&L{[12, 1, 154, 12], [155, 155, 155, 155, 156, 155, 155]}, &L{[67, 53, 13, 29, 144, 32], &L{[1, 1, 1, 1, 1, 1, 1, 1], [96, 152, 153]}}}, &L{&L{[1, 1, 1], [1, 29, 1, 1]}, &L{[61, 42, 1, 1, 25, 59, 7], &L{[16, 17, 41, 1], [96, 152, 153]}}}}
@main = @keep(@seqs)
