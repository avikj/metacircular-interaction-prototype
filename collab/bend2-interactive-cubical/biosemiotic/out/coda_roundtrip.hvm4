// round trip through another whale's tempo, on a superposition of 18 real codas (R = 1000)
@sum   = λ{[]: 0; <>: λh. λt. (h + @sum(t))}
@scale = λ&T. λ&R. λ{[]: []; <>: λh. λt. (((h * R) + (T / 2)) / T) <> @scale(T, R, t)}
@lens  = λR. λ&c. @scale(@sum(c), R, c)
@mulT  = λ&T. λ{[]: []; <>: λh. λt. (((h * T) + 500) / 1000) <> @mulT(T, t)}
@ad    = λ&a. λ&b. λ{0: (b - a); _: λp. (a - b)}(a > b)
@sesa  = λ{[]: λq. 0; <>: λh. λt. λ{[]: 0; <>: λk. λu. (@ad(h, k) + @sesa(t, u))}}
@rt    = λ&c. λTB. @mulT(@sum(c), @lens(1000, @mulT(TB, @lens(1000, c))))
@trip  = λ&c. λTB. #Trip{@sesa(c, @rt(c, TB)), c}
@pairs = &L{@trip([293, 282, 298, 315], 1125), &L{@trip([287, 265, 299, 274], 1090), &L{@trip([264, 253, 297, 276], 1090), &L{@trip([269, 265, 271, 285], 1101), &L{@trip([273, 267, 266, 295], 1088), &L{@trip([278, 270, 269, 271], 1138), &L{@trip([269, 293, 287, 289], 1130), &L{@trip([279, 277, 280, 294], 1132), &L{@trip([284, 278, 280, 290], 1132), &L{@trip([297, 277, 275, 283], 208), &L{@trip([63, 62, 83], 339), &L{@trip([90, 77, 76, 96], 295), &L{@trip([62, 84, 63, 86], 270), &L{@trip([62, 63, 62, 83], 323), &L{@trip([67, 68, 62, 61, 65], 359), &L{@trip([73, 72, 63, 65, 86], 438), &L{@trip([81, 79, 76, 63, 139], 347), @trip([70, 58, 62, 67, 90], 1188)}}}}}}}}}}}}}}}}}
@main  = @pairs
