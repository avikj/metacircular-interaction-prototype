diff --git a/src/Core/WHNF.hs b/src/Core/WHNF.hs
--- a/src/Core/WHNF.hs
+++ b/src/Core/WHNF.hs
@@ -1413,6 +1413,14 @@
         pa <- lineRep a
         pb <- lineRep (b depMarker)
         Just (cubSig pa pb)
+      -- A CCHM univalence line
+      --   Glue(B, [(inot i, A, e), (i, B, idEquiv B)])
+      -- carries exactly the two maps the runtime pair is made of, so read
+      -- them off the equivalence on the face that is not the marker's own
+      -- endpoint. Without this case `ua` can only reach the runtime as the
+      -- primitive Ua, which is the only reason that primitive still exists.
+      Glu b fs | Just e <- uaGlueFace b fs ->
+        Just (cubPair (equivFun e) (equivInv e))
       HCm a0 fs base | Set <- cut a0 -> case [ (p, u) | (p, u) <- fs, isMarkerFace p ] of
         [(_, u)] | not (occursMarker u), all constTube [ u0 | (p, u0) <- fs, not (isMarkerFace p) ] -> do
           pb <- lineRep base
@@ -1421,6 +1429,22 @@
         _ -> Nothing
       _ -> Nothing
   where
+    -- exactly the two-face ua shape, in either order, with the dimension
+    -- appearing nowhere but the two faces: one `inot i` carrying the
+    -- equivalence, one `i` carrying the identity on the base.
+    uaGlueFace b fs
+      | not (occursMarker b)
+      , [(pn, tn, en), (pp, tp, ep)] <- ordered fs
+      , isNotMarker pn, isMarkerFace pp
+      , not (any occursMarker [tn, en, tp, ep])
+      = Just en
+      | otherwise = Nothing
+    ordered fs = case fs of
+      [f1@(p1,_,_), f2] | isMarkerFace p1 -> [f2, f1]
+      _                                   -> fs
+    isNotMarker p = case cut p of
+      INot v -> isCoeMarker (cut v)
+      _      -> False
     isMarkerFace p = case cut p of { Var "__coe_i__" (-1) -> True; _ -> False }
     constTube u = case cut u of
       PLm _ f -> let b = f depMarker in not (occursDep b) && not (occursMarker b)
