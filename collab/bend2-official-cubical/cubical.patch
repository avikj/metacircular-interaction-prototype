+-- ============================================================================
+-- BEND-CUBICAL — the interval of the cubical core, as bend.ts implements it
+-- ============================================================================
+--
+-- The cubical core of Bend 2 (cubical.patch) adds an interval to the
+-- language: i0, i1, -r, r /\ s, r \/ s over atoms (a bound dimension or
+-- any stuck term of type Interval). Two interval terms are convertible
+-- when they are equal in the free De Morgan algebra on their atoms, which
+-- is what CCHM cubical type theory requires of its interval.
+--
+-- bend.ts decides that equality by a finite table: it evaluates both
+-- terms under every valuation of their atoms in the four-element De Morgan
+-- algebra DM4 and asks whether they agree (itv_eq). This file is the
+-- specification and the proofs behind that procedure:
+--
+--   §1 DM4 is a De Morgan algebra (every law, by finite case analysis)
+--   §2 interval terms, their evaluation, and Eq (agreement under every
+--      DM4 valuation): an equivalence relation and a congruence
+--   §3 the constant folds term_wnf applies (Ineg, Imin, Imax cases) are
+--      sound: a fold never changes the value under any valuation
+--   §4 why DM4 and not {0, 1}: the two-valued table validates i /\ -i = i0,
+--      which is not a law of the interval; DM4 refuses it, and every DM4
+--      equality is a two-valued equality (the finer table refines the
+--      coarser)
+--   §5 canonicity of the interval: a closed interval term (no atoms) is
+--      convertible to i0 or to i1, and the folds reach it
+--   §6 the cubical fragment: its syntax, its reduction (the rules of
+--      term_wnf, coe_step, hcm_step) and its typing (the rules of
+--      term_infer and term_check), as inductive relations. This is the
+--      specification the TypeScript is audited against; its metatheory
+--      (canonicity for the fragment) is not carried here.
+--
+-- What is cited, not proved here: the variety of De Morgan algebras is
+-- generated by DM4 (Kalman 1958), so agreement under every DM4 valuation
+-- is exactly equality in the free De Morgan algebra. §2's Eq is therefore
+-- the specification of interval conversion, and itv_eq computes it.
+--
+-- Checked with Lean 4 (no imports beyond the core).
+
+namespace BendCubical
+
+-- ============================================================================
+-- §1 DM4
+-- ============================================================================
+
+-- 0 < a, b < 1 with a and b incomparable; negation swaps 0 and 1 and
+-- fixes a and b.
+inductive DM4 : Type
+  | zero | a | b | one
+  deriving DecidableEq, Repr
+
+namespace DM4
+
+def neg : DM4 → DM4
+  | zero => one
+  | a    => a
+  | b    => b
+  | one  => zero
+
+def min : DM4 → DM4 → DM4
+  | zero, _    => zero
+  | _,    zero => zero
+  | one,  y    => y
+  | x,    one  => x
+  | a,    a    => a
+  | b,    b    => b
+  | a,    b    => zero
+  | b,    a    => zero
+
+def max : DM4 → DM4 → DM4
+  | one,  _    => one
+  | _,    one  => one
+  | zero, y    => y
+  | x,    zero => x
+  | a,    a    => a
+  | b,    b    => b
+  | a,    b    => one
+  | b,    a    => one
+
+-- the lattice laws
+theorem min_comm (x y : DM4) : min x y = min y x := by cases x <;> cases y <;> rfl
+theorem max_comm (x y : DM4) : max x y = max y x := by cases x <;> cases y <;> rfl
+theorem min_assoc (x y z : DM4) : min (min x y) z = min x (min y z) := by
+  cases x <;> cases y <;> cases z <;> rfl
+theorem max_assoc (x y z : DM4) : max (max x y) z = max x (max y z) := by
+  cases x <;> cases y <;> cases z <;> rfl
+theorem min_idem (x : DM4) : min x x = x := by cases x <;> rfl
+theorem max_idem (x : DM4) : max x x = x := by cases x <;> rfl
+theorem absorb_min (x y : DM4) : min x (max x y) = x := by cases x <;> cases y <;> rfl
+theorem absorb_max (x y : DM4) : max x (min x y) = x := by cases x <;> cases y <;> rfl
+theorem distrib (x y z : DM4) : min x (max y z) = max (min x y) (min x z) := by
+  cases x <;> cases y <;> cases z <;> rfl
+theorem min_zero (x : DM4) : min zero x = zero := by cases x <;> rfl
+theorem min_one (x : DM4) : min one x = x := by cases x <;> rfl
+theorem max_zero (x : DM4) : max zero x = x := by cases x <;> rfl
+theorem max_one (x : DM4) : max one x = one := by cases x <;> rfl
+
+-- the De Morgan laws
+theorem neg_neg (x : DM4) : neg (neg x) = x := by cases x <;> rfl
+theorem neg_min (x y : DM4) : neg (min x y) = max (neg x) (neg y) := by
+  cases x <;> cases y <;> rfl
+theorem neg_max (x y : DM4) : neg (max x y) = min (neg x) (neg y) := by
+  cases x <;> cases y <;> rfl
+
+-- and the law DM4 does not have: it is not Boolean
+theorem not_boolean : ∃ x : DM4, min x (neg x) ≠ zero := ⟨a, by decide⟩
+
+end DM4
+
+-- ============================================================================
+-- §2 Interval terms and Eq
+-- ============================================================================
+
+-- an atom is named by a number (bend.ts keys it by its syntax)
+inductive Itv : Type
+  | atom : Nat → Itv
+  | i0   : Itv
+  | i1   : Itv
+  | neg  : Itv → Itv
+  | min  : Itv → Itv → Itv
+  | max  : Itv → Itv → Itv
+  deriving DecidableEq, Repr
+
+-- a valuation of the atoms in DM4
+def Val : Type := Nat → DM4
+
+def Itv.eval (ρ : Val) : Itv → DM4
+  | atom n  => ρ n
+  | i0      => DM4.zero
+  | i1      => DM4.one
+  | neg r   => DM4.neg (eval ρ r)
+  | min r s => DM4.min (eval ρ r) (eval ρ s)
+  | max r s => DM4.max (eval ρ r) (eval ρ s)
+
+-- conversion of interval terms: agreement under every valuation
+def Itv.Eq (r s : Itv) : Prop := ∀ ρ : Val, r.eval ρ = s.eval ρ
+
+namespace Itv
+
+theorem Eq.refl (r : Itv) : Eq r r := fun _ => rfl
+theorem Eq.symm {r s : Itv} (h : Eq r s) : Eq s r := fun ρ => (h ρ).symm
+theorem Eq.trans {r s t : Itv} (h : Eq r s) (k : Eq s t) : Eq r t :=
+  fun ρ => (h ρ).trans (k ρ)
+
+theorem Eq.neg {r s : Itv} (h : Eq r s) : Eq (neg r) (neg s) :=
+  fun ρ => by simp [eval, h ρ]
+theorem Eq.min {r r' s s' : Itv} (h : Eq r r') (k : Eq s s') :
+    Eq (min r s) (min r' s') :=
+  fun ρ => by simp [eval, h ρ, k ρ]
+theorem Eq.max {r r' s s' : Itv} (h : Eq r r') (k : Eq s s') :
+    Eq (max r s) (max r' s') :=
+  fun ρ => by simp [eval, h ρ, k ρ]
+
+-- the interval's laws, as Eq: the term algebra modulo Eq is a De Morgan
+-- algebra (each is DM4's law under every valuation)
+theorem law_min_comm (r s : Itv) : Eq (min r s) (min s r) :=
+  fun ρ => by simp [eval, DM4.min_comm]
+theorem law_max_comm (r s : Itv) : Eq (max r s) (max s r) :=
+  fun ρ => by simp [eval, DM4.max_comm]
+theorem law_min_assoc (r s t : Itv) : Eq (min (min r s) t) (min r (min s t)) :=
+  fun ρ => by simp [eval, DM4.min_assoc]
+theorem law_max_assoc (r s t : Itv) : Eq (max (max r s) t) (max r (max s t)) :=
+  fun ρ => by simp [eval, DM4.max_assoc]
+theorem law_min_idem (r : Itv) : Eq (min r r) r :=
+  fun ρ => by simp [eval, DM4.min_idem]
+theorem law_max_idem (r : Itv) : Eq (max r r) r :=
+  fun ρ => by simp [eval, DM4.max_idem]
+theorem law_absorb_min (r s : Itv) : Eq (min r (max r s)) r :=
+  fun ρ => by simp [eval, DM4.absorb_min]
+theorem law_absorb_max (r s : Itv) : Eq (max r (min r s)) r :=
+  fun ρ => by simp [eval, DM4.absorb_max]
+theorem law_distrib (r s t : Itv) : Eq (min r (max s t)) (max (min r s) (min r t)) :=
+  fun ρ => by simp [eval, DM4.distrib]
+theorem law_neg_neg (r : Itv) : Eq (neg (neg r)) r :=
+  fun ρ => by simp [eval, DM4.neg_neg]
+theorem law_de_morgan_min (r s : Itv) : Eq (neg (min r s)) (max (neg r) (neg s)) :=
+  fun ρ => by simp [eval, DM4.neg_min]
+theorem law_de_morgan_max (r s : Itv) : Eq (neg (max r s)) (min (neg r) (neg s)) :=
+  fun ρ => by simp [eval, DM4.neg_max]
+theorem law_neg_i0 : Eq (neg i0) i1 := fun _ => rfl
+theorem law_neg_i1 : Eq (neg i1) i0 := fun _ => rfl
+
+end Itv
+
+-- ============================================================================
+-- §3 The folds of term_wnf
+-- ============================================================================
+
+-- term_wnf's Ineg, Imin and Imax cases rewrite by exactly these rules
+-- (after normalizing the operands), and leave any other shape stuck.
+inductive Fold : Itv → Itv → Prop
+  | neg_i0            : Fold (.neg .i0) .i1
+  | neg_i1            : Fold (.neg .i1) .i0
+  | neg_neg (r)       : Fold (.neg (.neg r)) r
+  | min_i0_l (r)      : Fold (.min .i0 r) .i0
+  | min_i0_r (r)      : Fold (.min r .i0) .i0
+  | min_i1_l (r)      : Fold (.min .i1 r) r
+  | min_i1_r (r)      : Fold (.min r .i1) r
+  | max_i1_l (r)      : Fold (.max .i1 r) .i1
+  | max_i1_r (r)      : Fold (.max r .i1) .i1
+  | max_i0_l (r)      : Fold (.max .i0 r) r
+  | max_i0_r (r)      : Fold (.max r .i0) r
+
+-- every fold is an Eq: term_wnf's interval normalization is sound for
+-- conversion
+theorem fold_sound {r s : Itv} (h : Fold r s) : Itv.Eq r s := by
+  intro ρ
+  cases h with
+  | neg_i0 => rfl
+  | neg_i1 => rfl
+  | neg_neg r => exact DM4.neg_neg _
+  | min_i0_l r => exact DM4.min_zero _
+  | min_i0_r r => simp only [Itv.eval]; rw [DM4.min_comm]; exact DM4.min_zero _
+  | min_i1_l r => exact DM4.min_one _
+  | min_i1_r r => simp only [Itv.eval]; rw [DM4.min_comm]; exact DM4.min_one _
+  | max_i1_l r => exact DM4.max_one _
+  | max_i1_r r => simp only [Itv.eval]; rw [DM4.max_comm]; exact DM4.max_one _
+  | max_i0_l r => exact DM4.max_zero _
+  | max_i0_r r => simp only [Itv.eval]; rw [DM4.max_comm]; exact DM4.max_zero _
+
+-- ============================================================================
+-- §4 Why DM4 and not the two-valued table
+-- ============================================================================
+
+-- a Boolean valuation takes atoms to 0 or 1 only
+def Val.Boolean (ρ : Val) : Prop := ∀ n, ρ n = DM4.zero ∨ ρ n = DM4.one
+
+-- the two-valued procedure: agreement under Boolean valuations only
+def Itv.EqBool (r s : Itv) : Prop := ∀ ρ : Val, ρ.Boolean → r.eval ρ = s.eval ρ
+
+-- Eq refines EqBool: whatever DM4 identifies, the two-valued table did too
+theorem Itv.Eq.toBool {r s : Itv} (h : Itv.Eq r s) : Itv.EqBool r s :=
+  fun ρ _ => h ρ
+
+-- and strictly: i /\ -i and i0 agree under every Boolean valuation but not
+-- under the valuation sending the atom to a. The two-valued table is
+-- therefore not conversion in the free De Morgan algebra, and a checker
+-- using it would accept {==} at {i /\ -i == i0 : Interval}.
+def counter_l : Itv := .min (.atom 0) (.neg (.atom 0))
+def counter_r : Itv := .i0
+
+theorem counter_bool : Itv.EqBool counter_l counter_r := by
+  intro ρ hρ
+  simp only [counter_l, counter_r, Itv.eval]
+  rcases hρ 0 with h | h <;> simp [h, DM4.neg, DM4.min]
+
+theorem counter_not_eq : ¬ Itv.Eq counter_l counter_r := by
+  intro h
+  have := h (fun _ => DM4.a)
+  simp [counter_l, counter_r, Itv.eval, DM4.neg, DM4.min] at this
+
+-- so Eq is strictly finer than EqBool
+theorem eq_strictly_finer : ∃ r s, Itv.EqBool r s ∧ ¬ Itv.Eq r s :=
+  ⟨counter_l, counter_r, counter_bool, counter_not_eq⟩
+
+-- ============================================================================
+-- §5 Canonicity of the interval
+-- ============================================================================
+
+def Itv.Closed : Itv → Prop
+  | atom _  => False
+  | i0      => True
+  | i1      => True
+  | neg r   => Closed r
+  | min r s => Closed r ∧ Closed s
+  | max r s => Closed r ∧ Closed s
+
+-- a closed term's value does not depend on the valuation
+theorem Itv.closed_eval {r : Itv} (h : r.Closed) (ρ σ : Val) : r.eval ρ = r.eval σ := by
+  induction r with
+  | atom n => exact absurd h id
+  | i0 => rfl
+  | i1 => rfl
+  | neg r ih => simp only [Itv.eval]; rw [ih h]
+  | min r s ihr ihs => simp only [Itv.eval]; rw [ihr h.1, ihs h.2]
+  | max r s ihr ihs => simp only [Itv.eval]; rw [ihr h.1, ihs h.2]
+
+-- and is an endpoint: a closed interval term is i0 or i1 up to conversion
+theorem Itv.closed_endpoint {r : Itv} (h : r.Closed) : Itv.Eq r .i0 ∨ Itv.Eq r .i1 := by
+  induction r with
+  | atom n => exact absurd h id
+  | i0 => exact Or.inl (Itv.Eq.refl _)
+  | i1 => exact Or.inr (Itv.Eq.refl _)
+  | neg r ih =>
+    rcases ih h with e | e
+    · exact Or.inr (fun ρ => by simp only [Itv.eval]; rw [e ρ]; rfl)
+    · exact Or.inl (fun ρ => by simp only [Itv.eval]; rw [e ρ]; rfl)
+  | min r s ihr ihs =>
+    rcases ihr h.1 with er | er <;> rcases ihs h.2 with es | es
+    · exact Or.inl (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+    · exact Or.inl (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+    · exact Or.inl (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+    · exact Or.inr (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+  | max r s ihr ihs =>
+    rcases ihr h.1 with er | er <;> rcases ihs h.2 with es | es
+    · exact Or.inl (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+    · exact Or.inr (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+    · exact Or.inr (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+    · exact Or.inr (fun ρ => by simp only [Itv.eval]; rw [er ρ, es ρ]; rfl)
+
+-- the folds compute it: term_wnf normalizes the operands first, so on a
+-- closed term every operand is an endpoint and one of the fold rules
+-- fires. Fold1 is a fold applied anywhere under the operators; Folds is
+-- its reflexive-transitive closure.
+inductive Fold1 : Itv → Itv → Prop
+  | here {r s} : Fold r s → Fold1 r s
+  | neg {r r'} : Fold1 r r' → Fold1 (.neg r) (.neg r')
+  | min_l {r r' s} : Fold1 r r' → Fold1 (.min r s) (.min r' s)
+  | min_r {r s s'} : Fold1 s s' → Fold1 (.min r s) (.min r s')
+  | max_l {r r' s} : Fold1 r r' → Fold1 (.max r s) (.max r' s)
+  | max_r {r s s'} : Fold1 s s' → Fold1 (.max r s) (.max r s')
+
+inductive Folds : Itv → Itv → Prop
+  | refl (r) : Folds r r
+  | step {r s t} : Fold1 r s → Folds s t → Folds r t
+
+theorem Folds.trans {r s t : Itv} (h : Folds r s) (k : Folds s t) : Folds r t := by
+  induction h with
+  | refl _ => exact k
+  | step f _ ih => exact Folds.step f (ih k)
+
+theorem Folds.one {r s : Itv} (h : Fold1 r s) : Folds r s := Folds.step h (Folds.refl _)
+
+theorem Folds.neg {r r' : Itv} (h : Folds r r') : Folds (.neg r) (.neg r') := by
+  induction h with
+  | refl _ => exact Folds.refl _
+  | step f _ ih => exact Folds.step (Fold1.neg f) ih
+
+theorem Folds.min_l {r r' s : Itv} (h : Folds r r') : Folds (.min r s) (.min r' s) := by
+  induction h with
+  | refl _ => exact Folds.refl _
+  | step f _ ih => exact Folds.step (Fold1.min_l f) ih
+
+theorem Folds.min_r {r s s' : Itv} (k : Folds s s') : Folds (.min r s) (.min r s') := by
+  induction k with
+  | refl _ => exact Folds.refl _
+  | step f _ ih => exact Folds.step (Fold1.min_r f) ih
+
+theorem Folds.max_l {r r' s : Itv} (h : Folds r r') : Folds (.max r s) (.max r' s) := by
+  induction h with
+  | refl _ => exact Folds.refl _
+  | step f _ ih => exact Folds.step (Fold1.max_l f) ih
+
+theorem Folds.max_r {r s s' : Itv} (k : Folds s s') : Folds (.max r s) (.max r s') := by
+  induction k with
+  | refl _ => exact Folds.refl _
+  | step f _ ih => exact Folds.step (Fold1.max_r f) ih
+
+theorem Folds.min {r r' s s' : Itv} (h : Folds r r') (k : Folds s s') :
+    Folds (.min r s) (.min r' s') := (Folds.min_l h).trans (Folds.min_r k)
+
+theorem Folds.max {r r' s s' : Itv} (h : Folds r r') (k : Folds s s') :
+    Folds (.max r s) (.max r' s') := (Folds.max_l h).trans (Folds.max_r k)
+
+-- every fold under the operators is sound too
+theorem fold1_sound {r s : Itv} (h : Fold1 r s) : Itv.Eq r s := by
+  induction h with
+  | here f => exact fold_sound f
+  | neg _ ih => exact ih.neg
+  | min_l _ ih => exact ih.min (Itv.Eq.refl _)
+  | min_r _ ih => exact (Itv.Eq.refl _).min ih
+  | max_l _ ih => exact ih.max (Itv.Eq.refl _)
+  | max_r _ ih => exact (Itv.Eq.refl _).max ih
+
+theorem folds_sound {r s : Itv} (h : Folds r s) : Itv.Eq r s := by
+  induction h with
+  | refl _ => exact Itv.Eq.refl _
+  | step f _ ih => exact (fold1_sound f).trans ih
+
+def Itv.IsEnd : Itv → Prop
+  | i0 => True
+  | i1 => True
+  | _  => False
+
+-- canonicity: the folds take every closed interval term to an endpoint
+theorem Itv.closed_folds {r : Itv} (h : r.Closed) : ∃ e, e.IsEnd ∧ Folds r e := by
+  induction r with
+  | atom n => exact absurd h id
+  | i0 => exact ⟨.i0, trivial, Folds.refl _⟩
+  | i1 => exact ⟨.i1, trivial, Folds.refl _⟩
+  | neg r ih =>
+    obtain ⟨e, he, f⟩ := ih h
+    cases e with
+    | i0 => exact ⟨.i1, trivial, (Folds.neg f).trans (Folds.one (Fold1.here Fold.neg_i0))⟩
+    | i1 => exact ⟨.i0, trivial, (Folds.neg f).trans (Folds.one (Fold1.here Fold.neg_i1))⟩
+    | _ => exact absurd he id
+  | min r s ihr ihs =>
+    obtain ⟨e1, he1, f1⟩ := ihr h.1
+    obtain ⟨e2, he2, f2⟩ := ihs h.2
+    cases e1 with
+    | i0 => exact ⟨.i0, trivial, (Folds.min f1 f2).trans (Folds.one (Fold1.here (Fold.min_i0_l _)))⟩
+    | i1 => exact ⟨e2, he2, (Folds.min f1 f2).trans (Folds.one (Fold1.here (Fold.min_i1_l _)))⟩
+    | _ => exact absurd he1 id
+  | max r s ihr ihs =>
+    obtain ⟨e1, he1, f1⟩ := ihr h.1
+    obtain ⟨e2, he2, f2⟩ := ihs h.2
+    cases e1 with
+    | i1 => exact ⟨.i1, trivial, (Folds.max f1 f2).trans (Folds.one (Fold1.here (Fold.max_i1_l _)))⟩
+    | i0 => exact ⟨e2, he2, (Folds.max f1 f2).trans (Folds.one (Fold1.here (Fold.max_i0_l _)))⟩
+    | _ => exact absurd he1 id
+
+-- ============================================================================
+-- §6 The cubical fragment: syntax, reduction, typing
+-- ============================================================================
+--
+-- The fragment bend.ts adds, over an abstract term language. Dimensions
+-- are de Bruijn: Itv.atom 0 is the innermost bound dimension; a path
+-- lambda binds one. Term binders (Lam, All) are left to bend.lean's core;
+-- here a term is a node of the fragment or an opaque core term, and the
+-- rules that need a term substitution take the substituted result as a
+-- premise (Insts), the way bend.lean states its own.
+
+-- dimension substitution on interval terms: atom 0 := v, the rest shift down
+def Itv.substD (v : Itv) : Itv → Itv
+  | atom 0       => v
+  | atom (n + 1) => atom n
+  | i0           => i0
+  | i1           => i1
+  | neg r        => neg (substD v r)
+  | min r s      => min (substD v r) (substD v s)
+  | max r s      => max (substD v r) (substD v s)
+
+def Itv.shiftD : Itv → Itv
+  | atom n  => atom (n + 1)
+  | i0      => i0
+  | i1      => i1
+  | neg r   => neg (shiftD r)
+  | min r s => min (shiftD r) (shiftD s)
+  | max r s => max (shiftD r) (shiftD s)
+
+-- a face: a conjunction of constraints r = d
+abbrev Face := List (Itv × Bool)
+
+inductive CTerm : Type
+  | core  : Nat → CTerm                              -- an opaque core term (a Var, Ref, Lam.. of bend.lean)
+  | app   : CTerm → CTerm → CTerm                    -- application (also path application)
+  | ann   : CTerm → CTerm → CTerm                    -- {x : T}, the checker's annotation
+  | itv   : CTerm                                    -- Interval
+  | dim   : Itv → CTerm                              -- a dimension term
+  | eql   : CTerm → CTerm → CTerm → CTerm            -- {a == b : T}
+  | eqlP  : CTerm → CTerm → CTerm → CTerm            -- {a == b : i => T}, T under a bound dimension
+  | rfl   : CTerm                                    -- {==}
+  | plam  : CTerm → CTerm                            -- i => t, t under a bound dimension
+  | rwt   : CTerm → CTerm → CTerm → CTerm            -- %e : P; f
+  | coe   : CTerm → Itv → Itv → CTerm → CTerm        -- coe(A, r, s, x), A under a bound dimension
+  | hcm   : CTerm → CTerm → List (Face × CTerm) → CTerm  -- hcomp(A, x, [(f) u]), u under a bound dimension
+  | glu   : CTerm → List (Face × CTerm × CTerm) → CTerm  -- Glue(A, [(f) (T, e)])
+  | gle   : CTerm → List (Face × CTerm) → CTerm      -- glue(x, [(f) t])
+  | ung   : CTerm → CTerm                            -- unglue(g)
+
+-- dimension substitution on terms (dimension binders shift the substitute)
+mutual
+def CTerm.substD (v : Itv) : CTerm → CTerm
+  | .core n     => .core n
+  | .app f x    => .app (substD v f) (substD v x)
+  | .ann x T    => .ann (substD v x) (substD v T)
+  | .itv        => .itv
+  | .dim r      => .dim (r.substD v)
+  | .eql a b T  => .eql (substD v a) (substD v b) (substD v T)
+  | .eqlP a b T => .eqlP (substD v a) (substD v b) (substD v.shiftD T)
+  | .rfl        => .rfl
+  | .plam t     => .plam (substD v.shiftD t)
+  | .rwt e P f  => .rwt (substD v e) (substD v P) (substD v f)
+  | .coe A r s x => .coe (substD v.shiftD A) (r.substD v) (s.substD v) (substD v x)
+  | .hcm A x sys => .hcm (substD v A) (substD v x) (substFaces v sys)
+  | .glu A sys  => .glu (substD v A) (substGFaces v sys)
+  | .gle x sys  => .gle (substD v x) (substFaces v sys)
+  | .ung g      => .ung (substD v g)
+def CTerm.substFaces (v : Itv) : List (Face × CTerm) → List (Face × CTerm)
+  | [] => []
+  | (f, u) :: rest => (f.map (fun (r, d) => (r.substD v, d)), CTerm.substD v.shiftD u) :: substFaces v rest
+def CTerm.substGFaces (v : Itv) : List (Face × CTerm × CTerm) → List (Face × CTerm × CTerm)
+  | [] => []
+  | (f, T, e) :: rest => (f.map (fun (r, d) => (r.substD v, d)), CTerm.substD v T, CTerm.substD v e) :: substGFaces v rest
+end
+
+-- a face holds when every constraint is an endpoint that agrees; it is
+-- dead when some constraint is the other endpoint (a symbolic constraint
+-- is neither)
+def Face.Holds (f : Face) : Prop := ∀ c ∈ f, Itv.Eq c.1 (if c.2 then .i1 else .i0)
+def Face.Dead  (f : Face) : Prop := ∃ c ∈ f, Itv.Eq c.1 (if c.2 then .i0 else .i1)
+
+theorem Face.holds_not_dead {f : Face} (h : f.Holds) : ¬ f.Dead := by
+  rintro ⟨c, hc, e⟩
+  have k := (h c hc).symm.trans e
+  have v := k (fun _ => DM4.zero)
+  revert v
+  cases c.2 <;> exact fun v => nomatch v
+
+-- the line A(v): the body at dimension v
+def CTerm.at (A : CTerm) (v : Itv) : CTerm := A.substD v
+def CTerm.mentionsD : CTerm → Prop := fun t => t.substD .i0 ≠ t.substD .i1
+
+-- ----------------------------------------------------------------------------
+-- Reduction: the rules term_wnf, coe_step and hcm_step apply to the
+-- fragment (the Kan rules by type shape refer to bend.lean's core for the
+-- function and constructor cases, and are stated there in Part III of the
+-- report; here are the rules that need only the fragment)
+-- ----------------------------------------------------------------------------
+
+inductive Step : CTerm → CTerm → Prop
+  -- path application: a path lambda at a dimension is its body there
+  | papp_beta (t : CTerm) (r : Itv) :
+      Step (.app (.plam t) (.dim r)) (t.substD r)
+  -- a term annotated at a path type, at a literal endpoint, is that endpoint
+  | papp_end0 (x a b T : CTerm) :
+      Step (.app (.ann x (.eql a b T)) (.dim .i0)) a
+  | papp_end1 (x a b T : CTerm) :
+      Step (.app (.ann x (.eql a b T)) (.dim .i1)) b
+  | pappP_end0 (x a b T : CTerm) :
+      Step (.app (.ann x (.eqlP a b T)) (.dim .i0)) a
+  | pappP_end1 (x a b T : CTerm) :
+      Step (.app (.ann x (.eqlP a b T)) (.dim .i1)) b
+  -- J on the constant path is its body; on a path it is transport along
+  -- the connection square (P applied to the endpoint and the path to it)
+  | rwt_refl (P f : CTerm) :
+      Step (.rwt .rfl P f) f
+  | rwt_const (e P f : CTerm) :
+      ¬ e.mentionsD → Step (.rwt (.plam e) P f) f
+  -- (P mentions no dimension, so under the line's binder it is itself;
+  -- inside the inner path lambda the line's dimension is atom 1)
+  | rwt_path (e P f : CTerm) :
+      e.mentionsD →
+      Step (.rwt (.plam e) P f)
+        (.coe (.app (.app P (.app (.plam e) (.dim (.atom 0))))
+                    (.plam (.app (.plam e) (.dim (.min (.atom 1) (.atom 0))))))
+              .i0 .i1 f)
+  -- coe: equal endpoints, or a line that does not mention its dimension
+  | coe_eq (A : CTerm) (r s : Itv) (x : CTerm) :
+      Itv.Eq r s → Step (.coe A r s x) x
+  | coe_const (A : CTerm) (r s : Itv) (x : CTerm) :
+      ¬ A.mentionsD → Step (.coe A r s x) x
+  -- hcomp: a face that holds is its tube at i1
+  | hcm_face (A x : CTerm) (sys : List (Face × CTerm)) (f : Face) (u : CTerm) :
+      (f, u) ∈ sys → f.Holds → Step (.hcm A x sys) (u.substD .i1)
+  -- Glue and glue: a face that holds is its partial type / section
+  | glu_face (A : CTerm) (sys) (f : Face) (T e : CTerm) :
+      (f, T, e) ∈ sys → f.Holds → Step (.glu A sys) T
+  | glu_none (A : CTerm) (sys) :
+      (∀ p ∈ sys, (p.1 : Face).Dead) → Step (.glu A sys) A
+  | gle_face (x : CTerm) (sys) (f : Face) (t : CTerm) :
+      (f, t) ∈ sys → f.Holds → Step (.gle x sys) t
+  | gle_none (x : CTerm) (sys) :
+      (∀ p ∈ sys, (p.1 : Face).Dead) → Step (.gle x sys) x
+  -- unglue of a glue is its base
+  | ung_gle (x : CTerm) (sys) :
+      Step (.ung (.gle x sys)) x
+
+-- the two endpoint rules never both apply, and a face that fires hcm_face
+-- is not a face gle_none/glu_none would drop
+theorem step_faces_exclusive {f : Face} (h : f.Holds) (d : f.Dead) : False :=
+  Face.holds_not_dead h d
+
+-- ----------------------------------------------------------------------------
+-- Typing: the judgments of term_infer and term_check on the fragment.
+-- Γ is a context of dimension binders (their count) and term binders
+-- (abstract); Conv is bend.lean's conversion, extended by Itv.Eq on
+-- dimensions; Ty is "a type" (a kind judgment) and Of is the core's
+-- typing, both abstract here.
+-- ----------------------------------------------------------------------------
+
+structure Judg where
+  Conv : CTerm → CTerm → Prop           -- conversion (term_compare EQ)
+  Of   : Nat → CTerm → CTerm → Prop     -- Γ ⊢ t : T for core terms (bend.lean's Check), Γ its dimension count
+  Ty   : Nat → CTerm → Prop             -- Γ ⊢ T : Type
+
+-- the fragment's rules, parametric in the core's judgments
+inductive Has (J : Judg) : Nat → CTerm → CTerm → Prop
+  -- infer-itv, infer-dim
+  | itv (n) : Has J n .itv .itv               -- Interval : Data, written as its own type here
+  | dim (n) (r : Itv) : Has J n (.dim r) .itv -- (the atoms are the n bound dimensions)
+  -- infer-eql: a path type over a type, or over a line
+  | eql (n) (a b T : CTerm) :
+      J.Ty n T → Has J n a T → Has J n b T → J.Ty n (.eql a b T)
+      → Has J n (.eql a b T) (.core 0)
+  | eqlP (n) (a b T : CTerm) :
+      J.Ty (n + 1) T → Has J n a (T.at .i0) → Has J n b (T.at .i1)
+      → Has J n (.eqlP a b T) (.core 0)
+  -- check-path: the body under a fresh dimension, at the carrier there,
+  -- with both faces convertible to the endpoints
+  | plam (n) (t a b T : CTerm) :
+      Has J (n + 1) t T
+      → J.Conv (t.substD .i0) a → J.Conv (t.substD .i1) b
+      → Has J n (.plam t) (.eql a b T)
+  | plamP (n) (t a b T : CTerm) :
+      Has J (n + 1) t T
+      → J.Conv (t.substD .i0) a → J.Conv (t.substD .i1) b
+      → Has J n (.plam t) (.eqlP a b T)
+  -- infer-papp
+  | papp (n) (p a b T : CTerm) (r : Itv) :
+      Has J n p (.eql a b T) → Has J n (.app p (.dim r)) T
+  | pappP (n) (p a b T : CTerm) (r : Itv) :
+      Has J n p (.eqlP a b T) → Has J n (.app p (.dim r)) (T.at r)
+  -- the constant path
+  | rfl (n) (a b T : CTerm) :
+      J.Conv a b → Has J n .rfl (.eql a b T)
+  -- infer-coe: a line (a type under a dimension), two dimensions, a value
+  -- at the line's start; the result at its end
+  | coe (n) (A : CTerm) (r s : Itv) (x : CTerm) :
+      J.Ty (n + 1) A → Has J n x (A.at r) → Has J n (.coe A r s x) (A.at s)
+  -- infer-hcomp: each tube a line in A on its face, agreeing with the base
+  -- at i0 and with each other where faces meet
+  | hcm (n) (A x : CTerm) (sys : List (Face × CTerm)) :
+      J.Ty n A → Has J n x A
+      → (∀ p, p ∈ sys → Has J (n + 1) p.2 A)
+      → (∀ p, p ∈ sys → J.Conv (p.2.substD .i0) x)
+      → Has J n (.hcm A x sys) A
+  -- infer-glue: partial types with equivalences into the base (the
+  -- equivalence's type is Base's Equiv, a core term)
+  | glu (n) (A : CTerm) (sys : List (Face × CTerm × CTerm)) (Equiv : CTerm → CTerm → CTerm) :
+      J.Ty n A → (∀ p, p ∈ sys → J.Ty n p.2.1)
+      → (∀ p, p ∈ sys → Has J n p.2.2 (Equiv p.2.1 A))
+      → Has J n (.glu A sys) (.core 0)
+  -- check-glue: a base and a section on every face, mapping to the base
+  -- under the face's equivalence (the map is a core application, abstract)
+  -- (sec picks the section written for each face of the type)
+  | gle (n) (x : CTerm) (sysT : List (Face × CTerm × CTerm)) (sys : List (Face × CTerm)) (A : CTerm)
+      (fun_ : CTerm → CTerm → CTerm) (sec : Face → CTerm) :
+      Has J n x A
+      → (∀ p, p ∈ sysT → (p.1, sec p.1) ∈ sys)
+      → (∀ p, p ∈ sysT → Has J n (sec p.1) p.2.1)
+      → (∀ p, p ∈ sysT → J.Conv (fun_ p.2.2 (sec p.1)) x)
+      → Has J n (.gle x sys) (.glu A sysT)
+  -- infer-unglue
+  | ung (n) (g A : CTerm) (sysT) :
+      Has J n g (.glu A sysT) → Has J n (.ung g) A
+  -- J: the motive over the path's type, the body at the reflexive case
+  | rwt (n) (e a b T P f Pab Paa : CTerm) :
+      Has J n e (.eql a b T)
+      → J.Of n P (.core 1)      -- P : @_:T -> @e:{a == _ : T} -> Type, abstract
+      → J.Conv Paa (.app (.app P a) .rfl) → Has J n f Paa
+      → J.Conv Pab (.app (.app P b) e)
+      → Has J n (.rwt e P f) Pab
+
+-- the fragment's rules are the ones the report states; a checker that
+-- implements them (bend.ts) is audited against this list
+
+end BendCubical
