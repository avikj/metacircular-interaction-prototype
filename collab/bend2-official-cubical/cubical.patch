+def Equiv.iso.sq(~A: Data, ~B: Data, ~f: A -> B, ~g: B -> A, ~t: @x: A -> {g(f(x)) == x : A}, +y: B, +x0: A, +p0: {f(x0) == y : B}, +x1: A, +p1: {f(x1) == y : B}, -i: Interval, -j: Interval) -> A:
+  hcomp(A, Equiv.iso.fill2(~A, ~B, ~f, ~g, ~t, y, x0, p0, x1, p1, i, j), [(i == i1) k => Equiv.iso.fill0(~A, ~B, ~f, ~g, ~t, y, x1, p1, j, -k), (i == i0) k => Equiv.iso.fill0(~A, ~B, ~f, ~g, ~t, y, x0, p0, j, -k), (j == i1) k => t(Equiv.iso.fill2(~A, ~B, ~f, ~g, ~t, y, x0, p0, x1, p1, i, i1))(-k), (j == i0) k => g(y)])
+
+def Equiv.iso.sq1(~A: Data, ~B: Data, ~f: A -> B, ~g: B -> A, ~s: @y: B -> {f(g(y)) == y : B}, ~t: @x: A -> {g(f(x)) == x : A}, +y: B, +x0: A, +p0: {f(x0) == y : B}, +x1: A, +p1: {f(x1) == y : B}, -i: Interval, -j: Interval) -> B:
+  hcomp(B, f(Equiv.iso.sq(~A, ~B, ~f, ~g, ~t, y, x0, p0, x1, p1, i, j)), [(i == i1) k => s(p1(-j))(k), (i == i0) k => s(p0(-j))(k), (j == i1) k => s(f(Equiv.iso.fill2(~A, ~B, ~f, ~g, ~t, y, x0, p0, x1, p1, i, i1)))(k), (j == i0) k => s(y)(k)])
+
+def Equiv.iso.lem(~A: Data, ~B: Data, ~f: A -> B, ~g: B -> A, ~s: @y: B -> {f(g(y)) == y : B}, ~t: @x: A -> {g(f(x)) == x : A}, +y: B, +x0: A, +p0: {f(x0) == y : B}, +x1: A, +p1: {f(x1) == y : B}) -> {(x0, p0) == (x1, p1) : fiber(&2, &2, A, B, f, y)}:
+  i => (Equiv.iso.fill2(~A, ~B, ~f, ~g, ~t, y, x0, p0, x1, p1, i, i1), j => Equiv.iso.sq1(~A, ~B, ~f, ~g, ~s, ~t, y, x0, p0, x1, p1, i, -j))
+
+def Equiv.iso.contr(~A: Data, ~B: Data, ~f: A -> B, ~g: B -> A, ~s: @y: B -> {f(g(y)) == y : B}, ~t: @x: A -> {g(f(x)) == x : A}, +y: B, w: fiber(&2, &2, A, B, f, y)) -> {(g(y), s(y)) == w : fiber(&2, &2, A, B, f, y)}:
+  match w:
+    case Tuple{+x, +p}:
+      Equiv.iso.lem(~A, ~B, ~f, ~g, ~s, ~t, y, g(y), s(y), x, p)
+
+def Equiv.from_iso(~A: Data, ~B: Data, ~f: A -> B, ~g: B -> A, ~s: @y: B -> {f(g(y)) == y : B}, ~t: @x: A -> {g(f(x)) == x : A}) -> Equiv(&2, &2, A, B):
+  (x => f(x), +y => ((g(y), s(y)), w => Equiv.iso.contr(~A, ~B, ~f, ~g, ~s, ~t, y, w)))
+
+# contractibility over Data is a proposition (a 4-face composite in the
+# carrier), so being an equivalence is one, pointwise
+def isContr.prop(-A: Data, +c0: isContr(&2, A), +c1: isContr(&2, A)) -> {c0 == c1 : isContr(&2, A)}:
+  match c0 c1:
+    case Tuple{+a0, +p0} Tuple{+a1, +p1}:
+      i => (p0(a1)(i), +x => j => hcomp(A, a0, [(i == i0) k => p0(p0(x)(j))(k), (i == i1) k => p0(p1(x)(j))(k), (j == i0) k => p0(p0(a1)(i))(k), (j == i1) k => p0(x)(k)]))
+
+def isEquiv.prop(-A: Data, -B: Data, -f: A -> B, h0: isEquiv(&2, &2, A, B, f), h1: isEquiv(&2, &2, A, B, f)) -> {h0 == h1 : isEquiv(&2, &2, A, B, f)}:
+  i => +y => isContr.prop(fiber(&2, &2, A, B, f, y), h0(y), h1(y))(i)
+
+def ua(a, -A: Kind(a), -B: Kind(a), e: Equiv(a, a, A, B)) -> {A == B : Kind(a)}:
+  i => Glue(B, [(i == i0) (A, e), (i == i1) (B, Equiv.id(a, B))])
+
+# a path between types is an equivalence: the identity carried along it
+def Equiv.of_path(a, -A: Kind(a), -B: Kind(a), p: {A == B : Kind(a)}) -> Equiv(a, a, A, B):
+  coe(i => Equiv(a, a, A, p(i)), i0, i1, Equiv.id(a, A))
+
