+// a path type's carrier family, through its lines
+export function eql_carrier(book: Book, t: HTerm): Extract<HTerm, { $: "ADT" }> | null {
+  let c = term_wnf(book, t);
+  while (c.$ === "Eql") {
+    c = term_wnf(book, c.T);
+    if (c.$ === "Lam") {
+      c = term_wnf(book, term_apply(c, SENT));
+    }
+  }
+  return c.$ === "ADT" ? c : null;
