+            const ty: HTerm = Tw.$ === "Lam" ? term_apply(Tw, Dim(xs.d)) : w.T;
+            const end = go(term_lower(xs.d === 0 ? w.a : w.b, d), d);
+            return end.$ === "Lam" ? end : Ann(end, Var("_", -1, undefined, ty), t.s, true);
+          }
+        }
+        return App(f, x, t.s);
+      }
+      case "Sub": return Sub(t.i, t.v.$ === "PVar" || t.v.$ === "PCtr" ? t.v : go(t.v, d), go(t.f, d), t.s);
+      case "Let": return Let(t.k, t.i, t.v.map((v) => go(v, d)), go(t.f, d + t.k.length), t.s, t.q);
+      case "Typ": return Typ(go(t.g, d), t.s);
+      case "Min": return Min(go(t.a, d), go(t.b, d), t.s);
+      case "All": return All(t.q, t.k, t.i, go(t.A, d), go(t.B, d + 1), t.s);
+      case "Lam": return Lam(t.k, t.i, go(t.f, d + 1), t.s, t.q);
+      case "ADT": return ADT(t.k, t.x.map((x) => go(x, d)), t.s, t.r);
+      case "Ctr": return Ctr(t.k, t.x.map((x) => go(x, d)), t.s);
+      case "Mat": return Mat(t.k, go(t.h, d), go(t.m, d), t.s);
+      case "Eql": return Eql(go(t.a, d), go(t.b, d), go(t.T, d), t.s);
+      case "Rwt": return Rwt(go(t.e, d), go(t.p, d), go(t.f, d), t.s);
+      case "Ineg": return Ineg(go(t.a, d), t.s);
+      case "Imin": return Imin(go(t.a, d), go(t.b, d), t.s);
+      case "Imax": return Imax(go(t.a, d), go(t.b, d), t.s);
+      case "Coe": return Coe(go(t.A, d), go(t.r, d), go(t.e, d), go(t.x, d), t.s);
+      case "Hcm": return Hcm(go(t.A, d), go(t.x, d), face_map(t.sys, (u) => go(u, d)), t.s);
+      case "Glu": return Glu(go(t.A, d), gface_map(t.sys, (u) => go(u, d)), t.s);
+      case "Gle": return Gle(go(t.x, d), face_map(t.sys, (u) => go(u, d)), t.s);
+      case "Ung": return Ung(go(t.g, d), t.s);
+      default: return t;
+    }
+  }
+  return go(tm, d);
+}
+
+// Runtime transport
+// =================
+// the compiler erases types, so a live Kan operation is elaborated into
+// ordinary code before emission: a coe along a line whose body (at a fresh
+// dimension) is a function, a datatype, a Glue or a kind steps by the
+// checker's own rules with the value symbolic; a datatype line with a
+// symbolic value becomes a minted transport def, a lambda-match pushing
+// the transport into every constructor's fields (recursive lines reach
+// the def itself); an hcomp, glue or unglue with decided faces is its
+// value there; a rewrite along a path is J as transport. What is left is
+// a transport along a variable path in Type, which no runtime value
+// carries, and the compiler refuses it by name.
+
+export type Mint = { book: Book; memo: Map<string, Name>; local: Map<string, Name>; n: number };
+
+export function mint_new(book: Book): Mint {
+  return { book, memo: new Map(), local: new Map(), n: 0 };
+}
+
+function term_open(t: HTerm): boolean {
+  function go(x: LTerm): boolean {
+    switch (x.$) {
+      case "Var": return x.i >= 0 && x.i < SENT_I;
+      case "Ref": case "Qnt": case "Qua": case "Efq": case "Rfl": case "Hol": case "Itv": case "Dim": return false;
+      case "Sub": return (x.v.$ !== "PVar" && x.v.$ !== "PCtr" && go(x.v)) || go(x.f);
+      case "Let": return x.v.some(go) || go(x.f);
+      case "Typ": return go(x.g);
+      case "Min": case "Imin": case "Imax": return go(x.a) || go(x.b);
+      case "Ineg": return go(x.a);
+      case "All": return go(x.A) || go(x.B);
+      case "Lam": return go(x.f);
+      case "App": return go(x.f) || go(x.x);
+      case "ADT": case "Ctr": return x.x.some(go);
+      case "Mat": return go(x.h) || go(x.m);
+      case "Eql": return go(x.a) || go(x.b) || go(x.T);
+      case "Rwt": return go(x.e) || go(x.p) || go(x.f);
+      case "Ann": return go(x.x) || go(x.T);
+      case "Coe": return go(x.A) || go(x.r) || go(x.e) || go(x.x);
+      case "Hcm": return go(x.A) || go(x.x) || x.sys.some((e) => go(e.u) || e.f.some(([r]) => go(r)));
+      case "Glu": return go(x.A) || x.sys.some((e) => go(e.T) || go(e.e) || e.f.some(([r]) => go(r)));
+      case "Gle": return go(x.x) || x.sys.some((e) => go(e.u) || e.f.some(([r]) => go(r)));
+      case "Ung": return go(x.g);
+    }
+  }
+  return go(term_lower(t, 1 << 24));
+}
+
+function kan_die(book: Book, what: string, t: HTerm): never {
+  throw Err(book, ctx_nil(), "a transport the runtime carries (" + what + ")", t, t.s, undefined,
+    "Note: a path in Type has no runtime value; transport along ua(e), a line of\n"
+    + "datatypes, functions or paths compiles, a variable path in Type does not.");
+}
+
+// a structural transport def for a datatype line, minted once per line
+function mint_adt(m: Mint, L: HTerm, r: HTerm, s: HTerm, adt: Extract<HTerm, { $: "ADT" }>): Name {
+  const key = term_key(term_lower(term_snf(m.book, term_apply(L, SENT)), 1 << 24)) + "|" + term_key(term_lower(r, 1 << 24)) + "|" + term_key(term_lower(s, 1 << 24));
+  const memo = term_open(L) || term_open(r) || term_open(s) ? m.local : m.memo;
+  const got = memo.get(key);
+  if (got !== undefined) {
+    return got;
+  }
+  const name = "coe~" + String(m.n++);
+  memo.set(key, name);
+  const fam = m.book.tlds[adt.k] as ADT;
+  const T: HTerm = All(Lone(), "x", 0, term_apply(L, r), () => term_apply(L, s));
+  m.book.tlds[name] = { $: "Def", n: 1, x: 0, T, v: Efq() };
+  let body: HTerm = Efq();
+  for (const c of fam.c.slice().reverse()) {
+    if ((c.p ?? 0) > 0) {
+      continue;
+    }
+    const lines: HTerm[] = [];
+    const fields = (xs: HTerm[]): HTerm => {
+      const j = xs.length;
+      if (j === c.n) {
+        return Ann(Ctr(c.k, xs.map((f, j) => kan_run(m, Coe(lines[j], r, s, f)))), term_cell(term_apply(L, s)), undefined, true);
+      }
+      lines.push(coe_line(L, (Tj, i) => {
+        const a = term_wnf(m.book, Tj) as Extract<HTerm, { $: "ADT" }>;
+        let tel = tele_fill(m.book, c.T, a.x, ctx_nil());
+            for (let q = 0; q < j; q++) {
+          tel = tele_head(m.book, tel, ctx_nil()).B(Coe(lines[q], r, i, xs[q]));
+        }
+        return tele_head(m.book, tel, ctx_nil()).A;
+      }));
+      return Lam("f" + String(j), 0, (x: HTerm) => fields(xs.concat([x])));
+    };
+    // the arm annotated at its type: the fields' telescope at the
+    // parameters of L(r), tipped at L(s)
+    const arm_ty = (tel: HTerm, n: number): HTerm => {
+      if (n === 0) {
+        return term_apply(L, s);
+      }
+      const h = tele_head(m.book, tel, ctx_nil());
+      return All(h.q, h.k, 0, h.A, (x: HTerm) => arm_ty(h.B(x), n - 1));
+    };
+    const arm = c.n === 0 ? fields([]) : Ann(fields([]), term_cell(arm_ty(tele_fill(m.book, c.T, adt.x, ctx_nil()), c.n)), undefined, true);
+    body = Mat(c.k, arm, body);
+  }
+  const e = term_lower(body, 1);
+  m.book.tlds[name] = { $: "Def", n: 1, x: 0, T, v: body, e };
+  return name;
+}
+
+// a Kan node with the value symbolic, run to code with no Kan node left
+export function kan_run(m: Mint, t: HTerm): HTerm {
+  // the node's own type annotates its code (a generated lambda or
+  // constructor needs it for its layout)
+  const f = term_force(t);
+  const ty: HTerm | null = f.$ === "Coe" ? term_apply(f.A, f.e) : f.$ === "Hcm" ? f.A : null;
+  const out = kan_run_go(m, t);
+  return ty === null || out.$ === "Ann" ? out : Ann(out, term_cell(ty), undefined, true);
+}
+
+function kan_run_go(m: Mint, t: HTerm): HTerm {
+  const book = m.book;
+  const w = term_wnf(book, t);
+  switch (w.$) {
+    case "Coe": {
+      const body = term_wnf(book, term_apply(w.A, SENT));
+      if (body.$ === "ADT") {
+        return App(Ref(mint_adt(m, w.A, w.r, w.e, body)), kan_walk(m, w.x));
+      }
+      return kan_die(book, "coe along " + expr_show(book, body), t);
+    }
+    case "Hcm": {
+      if (w.sys.every((e) => face_dead(book, e.f))) {
+        return kan_walk(m, w.x);
+      }
+      return kan_die(book, "hcomp with an undecided face", t);
+    }
+    case "Gle": {
+      if (w.sys.every((e) => face_dead(book, e.f))) {
+        return kan_walk(m, w.x);
+      }
+      return kan_die(book, "glue with an undecided face", t);
+    }
+    case "Ung": {
+      return kan_die(book, "unglue of a value whose Glue type is undecided", t);
+    }
+    case "Rwt": {
+      // J as transport along the connection square, its equation a live
+      // path variable: the line's body decides
+      const P = w.p;
+      const e = w.e;
+      return kan_run(m, Coe(Lam("i", 0, (i: HTerm) => term_apply(term_apply(P, App(e, i)), Lam("j", 0, (j: HTerm) => App(e, Imin(i, j))))), Dim(0), Dim(1), w.f));
+    }
+    default: {
+      return kan_walk(m, w);
+    }
+  }
+}
+
+// a term's Kan nodes run, its other nodes kept (through the HOAS tree)
+export function kan_walk(m: Mint, t: HTerm): HTerm {
+  const x = term_force(t);
+  switch (x.$) {
+    case "Coe": case "Hcm": case "Gle": case "Ung": case "Rwt": return kan_run(m, x);
+    case "Ann": return Ann(kan_walk(m, x.x), x.T, x.s, x.a);
+    case "Let": return Let(x.k, x.i, x.v.map((v) => kan_walk(m, v)), (xs: HTerm[]) => kan_walk(m, x.f(xs)), x.s, x.q);
+    case "All": return All(x.q, x.k, x.i, x.A, (y: HTerm) => kan_walk(m, x.B(y)), x.s);
+    case "Lam": return Lam(x.k, x.i, (y: HTerm) => kan_walk(m, x.f(y)), x.s, x.q);
+    case "App": return App(kan_walk(m, x.f), kan_walk(m, x.x), x.s);
+    case "Ctr": return Ctr(x.k, x.x.map((y) => kan_walk(m, y)), x.s);
+    case "Mat": return Mat(x.k, kan_walk(m, x.h), kan_walk(m, x.m), x.s);
+    default: return x;
+  }
+}
+
+// the compiler-facing pass over a checked tree: every Kan node run
+export function term_uncoe(m: Mint, e: LTerm): LTerm {
+  function has(x: LTerm): boolean {
+    switch (x.$) {
+      case "Coe": case "Hcm": case "Gle": case "Ung": case "Rwt": return true;
+      case "Ann": return has(x.x);
+      case "Sub": return (x.v.$ !== "PVar" && x.v.$ !== "PCtr" && has(x.v)) || has(x.f);
+      case "Let": return x.v.some(has) || has(x.f);
+      case "Lam": return has(x.f);
+      case "App": return has(x.f) || has(x.x);
+      case "Ctr": return x.x.some(has);
+      case "Mat": return has(x.h) || has(x.m);
+      default: return false;
+    }
+  }
+  if (!has(e)) {
+    return e;
+  }
+  return term_lower(kan_walk(m, term_higher(e, null, true)));
+}
+
+// Interval
+// ========
+// the interval is De Morgan: i0, i1, -r, r /\ s, r \/ s over interval
+// atoms (a bound variable, or any stuck term of type Interval). term_wnf
+// folds the constants; two interval terms are equal when they agree on
+// every assignment of their atoms (a truth table, the atoms keyed by
+// their syntax), which decides the free De Morgan algebra exactly.
+// SENT is the sentinel dimension a line is opened at: coe_step and the
+// rewrite rule apply a line to it and ask whether the body mentions it.
+
+export const SENT_I = 1 << 30;
+export const SENT: HTerm = Var("i", SENT_I);
+
+// t with the sentinel dimension replaced by v: lowered above every index
+// in use, re-bound with the other variables kept
+export function term_sent(t: HTerm, v: HTerm): HTerm {
+  return term_higher(term_lower(t, 1 << 24), list_set(null, SENT_I, v), true);
+}
+
+export function term_mentions(t: HTerm, i: number = SENT_I): boolean {
+  function go(x: LTerm): boolean {
+    switch (x.$) {
+      case "Var": return x.i === i;
+      case "Ref": case "Qnt": case "Qua": case "Efq": case "Rfl": case "Hol": case "Itv": case "Dim": return false;
+      case "Sub": return (x.v.$ !== "PVar" && x.v.$ !== "PCtr" && go(x.v)) || go(x.f);
+      case "Let": return x.v.some(go) || go(x.f);
+      case "Typ": return go(x.g);
+      case "Min": case "Imin": case "Imax": return go(x.a) || go(x.b);
+      case "Ineg": return go(x.a);
+      case "All": return go(x.A) || go(x.B);
+      case "Lam": return go(x.f);
+      case "App": return go(x.f) || go(x.x);
+      case "ADT": case "Ctr": return x.x.some(go);
+      case "Mat": return go(x.h) || go(x.m);
+      case "Eql": return go(x.a) || go(x.b) || go(x.T);
+      case "Rwt": return go(x.e) || go(x.p) || go(x.f);
+      case "Ann": return go(x.x) || go(x.T);
+      case "Coe": return go(x.A) || go(x.r) || go(x.e) || go(x.x);
+      case "Hcm": return go(x.A) || go(x.x) || x.sys.some((e) => go(e.u) || e.f.some(([r]) => go(r)));
+      case "Glu": return go(x.A) || x.sys.some((e) => go(e.T) || go(x.$ === "Glu" ? e.e : e.e) || e.f.some(([r]) => go(r)));
+      case "Gle": return go(x.x) || x.sys.some((e) => go(e.u) || e.f.some(([r]) => go(r)));
+      case "Ung": return go(x.g);
+    }
+  }
+  return go(term_lower(t));
+}
+
+export function itv_is(t: HTerm): boolean {
+  return t.$ === "Dim" || t.$ === "Ineg" || t.$ === "Imin" || t.$ === "Imax";
+}
+
+function itv_key(x: HTerm): string {
+  return x.$ === "Var" ? "v" + String(x.i) : term_key(term_lower(x));
+}
+
+function itv_atoms(book: Book, t: HTerm, atoms: Set<string>): void {
+  const x = term_wnf(book, t);
+  switch (x.$) {
+    case "Dim": return;
+    case "Ineg": return itv_atoms(book, x.a, atoms);
+    case "Imin": case "Imax": {
+      itv_atoms(book, x.a, atoms);
+      itv_atoms(book, x.b, atoms);
+      return;
+    }
+    default: {
+      atoms.add(itv_key(x));
+    }
+  }
+}
+
+function itv_eval(book: Book, t: HTerm, env: Map<string, number>): number {
+  const x = term_wnf(book, t);
+  switch (x.$) {
+    case "Dim": return x.d;
+    case "Ineg": return 1 - itv_eval(book, x.a, env);
+    case "Imin": return Math.min(itv_eval(book, x.a, env), itv_eval(book, x.b, env));
+    case "Imax": return Math.max(itv_eval(book, x.a, env), itv_eval(book, x.b, env));
+    default: return env.get(itv_key(x)) ?? 0;
+  }
+}
+
+export function itv_eq(book: Book, a: HTerm, b: HTerm): boolean {
+  const atoms = new Set<string>();
+  itv_atoms(book, a, atoms);
+  itv_atoms(book, b, atoms);
+  const ks = [...atoms];
+  if (ks.length > 16) {
+    return false;
+  }
+  for (let m = 0; m < (1 << ks.length); m++) {
+    const env = new Map<string, number>();
+    ks.forEach((k, j) => env.set(k, (m >> j) & 1));
+    if (itv_eval(book, a, env) !== itv_eval(book, b, env)) {
+      return false;
+    }
   }
+  return true;
+}
+
+// Coe
+// ===
+// coe(A, r, s, x) transports x : A(r) to A(s) along the line A, by the
+// shape of the line's body at a fresh dimension:
+//   r = s, or a line that does not mention its dimension  ->  x
+//   a kind, Quant, Interval                                ->  x
+//   @y:D -> C   ->  y => coe(i => C(i)[coe(D, s, i, y)], r, s, x(coe(D, s, r, y)))
+//   K<p(i)..>   ->  a constructor coerces fieldwise, each field's line the
+//                   constructor's telescope at the parameters of i, opened
+//                   on the earlier fields carried to i
+//   else stuck (a path type and Glue wait on composition)
+
+function coe_line(A: HTerm, f: (T: HTerm, i: HTerm) => HTerm): HTerm {
+  return Lam("i", 0, (i: HTerm) => f(term_apply(A, i), i));
+}
+
+export function coe_step(book: Book, tm: Extract<HTerm, { $: "Coe" }>): HTerm | null {
+  const r = term_wnf(book, tm.r);
+  const s = term_wnf(book, tm.e);
+  if (itv_eq(book, r, s)) {
+    return tm.x;
+  }
+  const body = term_wnf(book, term_apply(tm.A, SENT));
+  if (!term_mentions(body)) {
+    return tm.x;
+  }
+  switch (body.$) {
+    case "Typ": case "Qnt": case "Qua": case "Itv": {
+      return tm.x;
+    }
+    case "All": {
+      const A = tm.A;
+      const dom = coe_line(A, (T) => (term_wnf(book, T) as Extract<HTerm, { $: "All" }>).A);
+      return Lam(body.k, 0, (y: HTerm) => {
+        const cod = coe_line(A, (T, i) => (term_wnf(book, T) as Extract<HTerm, { $: "All" }>).B(Coe(dom, s, i, y)));
+        return Coe(cod, r, s, App(tm.x, Coe(dom, s, r, y)));
+      }, tm.s);
+    }
+    case "Eql": {
+      // along a line of path types: reparametrize the line from r to s
+      // onto i0 to i1, transport the path pointwise, and compose with the
+      // endpoints' own transports on the faces of the new path
+      const L = Lam("i", 0, (i: HTerm) => term_apply(tm.A, Imax(Imin(Ineg(i), r), Imin(i, s))));
+      const eq = (i: HTerm) => term_wnf(book, term_apply(L, i)) as Extract<HTerm, { $: "Eql" }>;
+      return Lam("j", 0, (j: HTerm) => {
+        const T = coe_line(L, (E) => {
+          const e = term_wnf(book, E) as Extract<HTerm, { $: "Eql" }>;
+          const Tw = term_wnf(book, e.T);
+          return Tw.$ === "Lam" ? term_apply(Tw, j) : e.T;
+        });
+        return Hcm(term_apply(T, Dim(1)), Coe(T, Dim(0), Dim(1), App(tm.x, j)), [
+          { f: [[j, 0]], u: Lam("i", 0, (i: HTerm) => Coe(T, i, Dim(1), eq(i).a)) },
+          { f: [[j, 1]], u: Lam("i", 0, (i: HTerm) => Coe(T, i, Dim(1), eq(i).b)) },
+        ], tm.s);
+      }, tm.s);
+    }
+    case "Glu": {
+      // CCHM transport through Glue: unglue at r (the equivalence's
+      // function on a true face), transport the base along the A-line, and
+      // on each face live at s take t1 = e^-1(a1') from the fibre's centre,
+      // correcting a1' along the centre's path so that fst(e)(t1) = a1
+      // there; glue [faces at s -> t1] a1
+      const at = (i: HTerm): [HTerm, Array<GFace<HTerm>>] => {
+        const g = term_sent(body, i);
+        return g.$ === "Glu" ? [g.A, g.sys] : [term_apply(tm.A, i), []];
+      };
+      const live = (fs: Array<GFace<HTerm>>) => fs.filter((e) => !face_dead(book, e.f));
+      const [aR, fsR] = at(r);
+      const [aS, fsS] = at(s);
+      const aLn = Lam("i", 0, (i: HTerm) => at(i)[0]);
+      const lr = live(fsR);
+      const tr = lr.find((e) => face_holds(book, e.f));
+      const aR0: HTerm = lr.length === 0 ? tm.x : tr !== undefined ? App(equiv_fun(tr.e, tr.T, aR), tm.x) : Ung(tm.x);
+      const a1p = term_wnf(book, Coe(aLn, r, s, aR0));
+      const faces = live(fsS).map((e) => ({ f: e.f, e: e.e, T: e.T, t1: App(equiv_inv(e.e, e.T, aS), a1p) }));
+      const a1 = Hcm(aS, a1p, faces.map((fc) => ({ f: fc.f, u: Lam("j", 0, (j: HTerm) => App(App(equiv_sec(fc.e, fc.T, aS), fc.t1), Ineg(j))) })), tm.s);
+      return Gle(a1, faces.map((fc) => ({ f: fc.f, u: fc.t1 })), tm.s);
+    }
+    case "ADT": {
+      const x0 = term_wnf(book, tm.x);
+      // transport commutes with an hcomp cell of the family
+      if (x0.$ === "Hcm") {
+        return Hcm(term_apply(tm.A, s), Coe(tm.A, r, s, x0.x),
