+# Cubical
+# -------
+# the coherent equivalences: contractible fibres. Glue reads Equiv, Equiv.id
+# and Base's Tuple; ua is a path in Type between the types an equivalence
+# joins, and transport along it is the equivalence's function.
+
+def isContr(-A: Type) -> Type:
+  &c: A -> (@w: A -> {c == w : A})
+
+def fiber(-A: Type, -B: Type, f: A -> B, y: B) -> Type:
+  &x: A -> {f(x) == y : B}
+
+def isEquiv(-A: Type, -B: Type, f: A -> B) -> Type:
+  @y: B -> isContr(fiber(A, B, f, y))
+
+def Equiv(-A: Type, -B: Type) -> Type:
+  &f: (A -> B) -> isEquiv(A, B, f)
+
+def Equiv.id.contr(-A: Type, -y: A, w: fiber(A, A, x => x, y)) -> {(y, {==}) == w : fiber(A, A, x => x, y)}:
+  match w:
+    case Tuple{x, +p}:
+      i => (p(-i), j => p(-i \/ j))
+
+def Equiv.id(-A: Type) -> Equiv(A, A):
+  (x => x, y => ((y, {==}), w => Equiv.id.contr(A, y, w)))
+
+def Equiv.fun(-A: Type, -B: Type, e: Equiv(A, B)) -> A -> B:
+  (f, h) = e
